-- 10. ТОСТЫ (справа снизу): достижения и сообщения
-- ============================================================================
local toastHolder = Instance.new("Frame")
toastHolder.Name = "Toasts"
toastHolder.BackgroundTransparency = 1
toastHolder.AnchorPoint = Vector2.new(1, 1)
toastHolder.Size = UDim2.new(0, 340, 0, 300)
toastHolder.Position = UDim2.new(1, -16, 1, -110)
toastHolder.Parent = screenGui
responsive(toastHolder)
local toastLayout = Instance.new("UIListLayout")
toastLayout.Padding = UDim.new(0, 8)
toastLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
toastLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
toastLayout.SortOrder = Enum.SortOrder.LayoutOrder
toastLayout.Parent = toastHolder
local toastOrder = 0

local TOAST_ICON: { [string]: string } = {
	["\u{2728}"] = "Star", ["\u{2B50}"] = "Star", ["\u{1F3C6}"] = "Trophy", ["\u{1F451}"] = "Crown",
	["\u{1F4B0}"] = "MoneyBag", ["\u{1F48E}"] = "Diamond", ["\u{26A1}"] = "Bolt", ["\u{1F3C5}"] = "Medal",
	["\u{1F4AA}"] = "Muscle", ["\u{1F340}"] = "Clover", ["\u{1F525}"] = "Target", ["\u{1F3AF}"] = "Target",
	["\u{1F463}"] = "Feet", ["\u{26CF}\u{FE0F}"] = "Pickaxe", ["\u{26CF}"] = "Pickaxe",
}
for _, a in ipairs(ProgressionConfig.ACHIEVEMENTS) do
	if a.Icon and ACH_ICON[a.Id] then TOAST_ICON[a.Icon] = ACH_ICON[a.Id] end
end
for sid, sk in pairs(ProgressionConfig.SKILLS) do
	if sk.Icon and SKILL_ICON[sid] then TOAST_ICON[sk.Icon] = SKILL_ICON[sid] end
end

local function showToast(icon: string, title: string, sub: string, accent: Color3, life: number?)
	toastOrder += 1
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.new(1, 0, 0, sub ~= "" and 66 or 46)
	holder.LayoutOrder = toastOrder
	holder.ClipsDescendants = false
	holder.Parent = toastHolder

	local t = panel(holder, "Toast", UDim2.new(1, 0, 1, 0), UDim2.new(1.2, 0, 0, 0), accent, 0.15)
	local tkey = TOAST_ICON[icon] or (ICONS[icon] and icon) or nil
	if tkey then
		refTile(t, tkey, icon, accent:Lerp(C.White, 0.15), accent:Lerp(C.Bg, 0.45), sub ~= "" and 48 or 34, UDim2.new(0, 8, 0.5, sub ~= "" and -24 or -17))
	else
		iconTile(t, icon, accent, accent:Lerp(C.Bg, 0.5), sub ~= "" and 48 or 34, UDim2.new(0, 8, 0.5, sub ~= "" and -24 or -17))
	end
	local left = sub ~= "" and 66 or 50
	label(t, title, UDim2.new(1, -left - 8, 0, 22), UDim2.new(0, left, 0, sub ~= "" and 9 or 12), accent:Lerp(C.White, 0.3), 15)
	if sub ~= "" then
		label(t, sub, UDim2.new(1, -left - 8, 0, 20), UDim2.new(0, left, 0, 34), C.White, 13)
	end

	TweenService:Create(t, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 0, 0, 0) }):Play()
	task.delay(life or 4.0, function()
		local out = TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(1.2, 0, 0, 0) })
		out:Play()
		out.Completed:Once(function() holder:Destroy() end)
	end)
end

-- ============================================================================
-- 10b. v50: «NEXT GOAL» TRACKER, COMBO METER AND POWER-FRENZY TIMER (top right,
--      under the Coins card). The goal is always the first unfinished achievement.
-- ============================================================================
local refreshGoal: () -&gt; () = function() end
local showCombo: (count: number, window: number, bonusCoins: number) -&gt; () = function() end
local showFrenzy: (seconds: number) -&gt; () = function() end
do
	local funHud = Instance.new("Frame")
	funHud.Name = "FunHud"
	funHud.BackgroundTransparency = 1
	funHud.AnchorPoint = Vector2.new(1, 0)
	funHud.Size = UDim2.fromOffset(250, 230)
	funHud.Position = UDim2.new(1, -14, 0, 102)
	funHud.Parent = screenGui
	responsive(funHud)
	local funLayout = Instance.new("UIListLayout")
	funLayout.Padding = UDim.new(0, 10)
	funLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	funLayout.SortOrder = Enum.SortOrder.LayoutOrder
	funLayout.Parent = funHud

	-- Next goal ------------------------------------------------------------------
	local goalPanel = panel(funHud, "NextGoal", UDim2.fromOffset(250, 78), UDim2.new(), C.Gold, 0.1)
	goalPanel.LayoutOrder = 1
	local goalScale = Instance.new("UIScale")
	goalScale.Parent = goalPanel
	local goalHdr = label(goalPanel, "🎯 NEXT GOAL", UDim2.new(0, 130, 0, 16), UDim2.fromOffset(12, 7), C.Gold, 12)
	goalHdr.TextWrapped = false
	local goalReward = label(goalPanel, "", UDim2.new(0, 110, 0, 16), UDim2.new(1, -122, 0, 7), C.Gold:Lerp(C.White, 0.35), 12, Enum.TextXAlignment.Right)
	goalReward.TextWrapped = false
	local goalName = label(goalPanel, "", UDim2.new(1, -24, 0, 22), UDim2.fromOffset(12, 25), C.White, 16)
	goalName.TextWrapped = false
	goalName.TextTruncate = Enum.TextTruncate.AtEnd
	local _, goalFill, goalTxt = progressBar(goalPanel, UDim2.new(1, -24, 0, 16), UDim2.fromOffset(12, 52), C.Green, Color3.fromRGB(20, 130, 60))
	local goalBtn = Instance.new("TextButton")
	goalBtn.Name = "OpenAchievements"
	goalBtn.BackgroundTransparency = 1
	goalBtn.Text = ""
	goalBtn.Size = UDim2.fromScale(1, 1)
	goalBtn.ZIndex = 6
	goalBtn.Parent = goalPanel
	goalBtn.MouseButton1Click:Connect(function()
		playSound(Sounds.Click)
		openWindow("AchievementsWindow")
	end)

	local shownGoalId: string? = nil
	refreshGoal = function()
		local nextAch: ProgressionConfig.AchievementInfo? = nil
		for _, ach in ipairs(ProgressionConfig.ACHIEVEMENTS) do
			if State.Achievements[ach.Id] ~= true then
				nextAch = ach
				break
			end
		end
		if not nextAch then
			goalName.Text = "All goals complete! 🏆"
			goalReward.Text = ""
			goalTxt.Text = ""
			setBar(goalFill, 1)
			return
		end
		local goal = ProgressionConfig.GetAchievementGoal(nextAch)
		local value = math.min(State.AchievementProgress[nextAch.Id] or 0, goal)
		local rewards = {}
		if nextAch.RewardCoins &gt; 0 then table.insert(rewards, string.format("+%s 💰", formatNumber(nextAch.RewardCoins))) end
		if nextAch.RewardSkillPoints &gt; 0 then table.insert(rewards, string.format("+%d ✨", nextAch.RewardSkillPoints)) end
		goalName.Text = nextAch.Description
		goalReward.Text = table.concat(rewards, " ")
		goalTxt.Text = string.format("%s / %s", formatNumber(value), formatNumber(goal))
		setBar(goalFill, value / math.max(1, goal))
		if shownGoalId ~= nil and shownGoalId ~= nextAch.Id then
			-- a new goal appeared: little pop so the player notices it
			goalScale.Scale = 1.18
			TweenService:Create(goalScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
		shownGoalId = nextAch.Id
	end

	-- Combo meter ------------------------------------------------------------------
	local comboPanel = panel(funHud, "ComboMeter", UDim2.fromOffset(210, 64), UDim2.new(), Color3.fromRGB(255, 150, 50), 0.1)
	comboPanel.LayoutOrder = 2
	comboPanel.Visible = false
	local comboScale = Instance.new("UIScale")
	comboScale.Parent = comboPanel
	local comboStroke = comboPanel:FindFirstChildOfClass("UIStroke")
	local comboTitle = label(comboPanel, "", UDim2.new(1, -16, 0, 28), UDim2.fromOffset(8, 5), C.White, 24, Enum.TextXAlignment.Center)
	comboTitle.Font = Enum.Font.GothamBlack
	comboTitle.TextWrapped = false
	local comboSub = label(comboPanel, "", UDim2.new(1, -16, 0, 16), UDim2.fromOffset(8, 32), C.Muted, 12, Enum.TextXAlignment.Center)
	comboSub.TextWrapped = false
	local _, comboFill = progressBar(comboPanel, UDim2.new(1, -24, 0, 7), UDim2.fromOffset(12, 51), Color3.fromRGB(255, 220, 90), Color3.fromRGB(255, 120, 40))
	local comboToken = 0

	local function comboColor(count: number): Color3
		if count &gt;= 25 then return Color3.fromRGB(200, 110, 255) end
		if count &gt;= 10 then return Color3.fromRGB(255, 90, 90) end
		if count &gt;= 5 then return Color3.fromRGB(255, 150, 50) end
		return C.Gold
	end

	showCombo = function(count: number, window: number, bonusCoins: number)
		comboToken += 1
		local my = comboToken
		if count &lt; 2 then
			comboPanel.Visible = false
			return
		end
		local col = comboColor(count)
		local xpPct = math.floor(math.min(count - 1, GameConfig.COMBO.XPBonusMaxSteps) * GameConfig.COMBO.XPBonusPerStep * 100 + 0.5)
		comboTitle.Text = string.format("%s ×%d", count &gt;= 25 and "🔥 MEGA COMBO" or "🔥 COMBO", count)
		comboTitle.TextColor3 = col:Lerp(C.White, 0.25)
		comboSub.Text = bonusCoins &gt; 0 and string.format("+%s 💰 combo bonus!", formatNumber(bonusCoins)) or string.format("+%d%% XP  ·  keep digging!", xpPct)
		comboSub.TextColor3 = bonusCoins &gt; 0 and C.Gold or C.Muted
		if comboStroke then comboStroke.Color = col end
		comboPanel.Visible = true

		comboScale.Scale = bonusCoins &gt; 0 and 1.3 or 1.14
		TweenService:Create(comboScale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		playSound(Sounds.Click, math.min(2.4, 1.3 + count * 0.04))
		if bonusCoins &gt; 0 then
			burstSparks(UDim2.new(1, -120, 0, 230), { col, C.Gold, C.White }, 8)
		end

		comboFill.Size = UDim2.fromScale(1, 1)
		TweenService:Create(comboFill, TweenInfo.new(window, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
		task.delay(window, function()
			if my == comboToken then comboPanel.Visible = false end
		end)
	end

	-- Power Frenzy timer (Lucky Block prize) ---------------------------------------
	local frenzyPanel = panel(funHud, "FrenzyTimer", UDim2.fromOffset(210, 38), UDim2.new(), Color3.fromRGB(255, 110, 50), 0.1)
	frenzyPanel.LayoutOrder = 3
	frenzyPanel.Visible = false
	local frenzyLbl = label(frenzyPanel, "", UDim2.new(1, -16, 1, 0), UDim2.fromOffset(8, 0), Color3.fromRGB(255, 200, 120), 15, Enum.TextXAlignment.Center)
	frenzyLbl.TextWrapped = false
	local frenzyToken = 0

	showFrenzy = function(seconds: number)
		frenzyToken += 1
		local my = frenzyToken
		frenzyPanel.Visible = true
		task.spawn(function()
			for left = math.floor(seconds), 1, -1 do
				if my ~= frenzyToken then return end
				frenzyLbl.Text = string.format("🔥 POWER FRENZY ×%d  ·  %d s", GameConfig.SPECIAL_BLOCKS.FrenzyDamageMultiplier, left)
				task.wait(1)
			end
			if my == frenzyToken then frenzyPanel.Visible = false end
		end)
	end
end

-- ============================================================================
-- 11. ОБНОВЛЕНИЕ ВСЕГО ИНТЕРФЕЙСА
-- ============================================================================
local function setButtonState(btn: TextButton, grad: UIGradient, enabled: boolean, c0: Color3, c1: Color3, text: string?)
	if enabled then
		grad.Color = ColorSequence.new(c0, c1)
		btn.TextTransparency = 0
	else
		grad.Color = ColorSequence.new(C.Gray, C.GrayDark)
		btn.TextTransparency = 0.25
	end
	if text then btn.Text = text end
end

local function fmtBonus(info: ProgressionConfig.SkillInfo, level: number): string
	return string.format("+%s%s", tostring(info.PerLevel * level), info.Suffix)
end

refreshAll = function()
	-- Навыки (v33 reference style)
	local prestigePct = math.floor((ProgressionConfig.GetPrestigeMultiplier(State.Prestige) - 1) * 100 + 0.5)
	pointsLbl.Text = string.format("Skill Points: %d", State.SkillPoints)
	skillsInfoLbl.Text = string.format("Level %d   •   Prestige %d (+%d%% to all)", State.Level, State.Prestige, prestigePct)

	for skillId, refs in pairs(SkillRows) do
		local info = ProgressionConfig.SKILLS[skillId]
		local lvl = ProgressionConfig.GetSkillLevel(State.Skills, skillId)
		local maxed = lvl &gt;= ProgressionConfig.SKILL_MAX_LEVEL
		refs.LevelLbl.Text = string.format("Lv. %d / %d", lvl, ProgressionConfig.SKILL_MAX_LEVEL)
		if maxed then
			refs.DescLbl.Text = string.format("%s: %s  ★ MAX", info.Description, fmtBonus(info, lvl))
		else
			refs.DescLbl.Text = string.format("%s: %s", info.Description, fmtBonus(info, lvl))
		end
		setBar(refs.Fill, lvl / ProgressionConfig.SKILL_MAX_LEVEL)
		refs.BarTxt.Text = string.format("%d%%", math.floor(lvl / ProgressionConfig.SKILL_MAX_LEVEL * 100))

		local can = (not maxed) and State.SkillPoints &gt; 0
		refBtnState(refs.UpBtn, refs.UpGrad, can or State.SkillPoints == 0 and not maxed, REF.Green0, REF.Green1, maxed and "MAXED" or "Upgrade")
		refBtnState(refs.MaxBtn, refs.MaxGrad, can or State.SkillPoints == 0 and not maxed, REF.Max0, REF.Max1, nil)
	end

	skillsBadge.Visible = State.SkillPoints &gt; 0
	skillsBadgeLbl.Text = State.SkillPoints &gt; 99 and "99+" or tostring(State.SkillPoints)

	-- Достижения (v33 reference style)
	local done = 0
	for _, ach in ipairs(ProgressionConfig.ACHIEVEMENTS) do
		local refs = AchRows[ach.Id]
		local goal = ProgressionConfig.GetAchievementGoal(ach)
		local unlocked = State.Achievements[ach.Id] == true
		local value = math.min(State.AchievementProgress[ach.Id] or 0, goal)
		if unlocked then
			done += 1
			value = goal
			refs.RowGrad.Color = ColorSequence.new(Color3.fromRGB(214, 132, 34), Color3.fromRGB(128, 66, 16))
			refs.RowStroke.Color = Color3.fromRGB(255, 210, 84)
			refs.RowStroke.Transparency = 0
			refs.RowStroke.Thickness = 3
			refs.TileGrad.Color = ColorSequence.new(REF.GoldT0, REF.GoldT1)
			refs.TileStroke.Color = REF.GoldRim
			refs.FillGrad.Color = ColorSequence.new(Color3.fromRGB(255, 236, 110), Color3.fromRGB(240, 150, 20))
			refs.DescLbl.TextColor3 = REF.Cream
			refs.StatusLbl.Visible = false
			refs.Check.Visible = true
		else
			refs.RowGrad.Color = ColorSequence.new(REF.RowTop, REF.RowBot)
			refs.RowStroke.Color = REF.AchBorder
			refs.RowStroke.Transparency = 0.3
			refs.RowStroke.Thickness = 2.5
			local apal = ACH_PAL[ach.Id]
			if apal then
				refs.TileGrad.Color = ColorSequence.new(apal[1], apal[2])
				refs.TileStroke.Color = apal[1]:Lerp(C.White, 0.5)
			else
				refs.TileGrad.Color = ColorSequence.new(REF.Blue0, REF.Blue1)
				refs.TileStroke.Color = REF.BlueRim
			end
			refs.FillGrad.Color = ColorSequence.new(Color3.fromRGB(110, 236, 255), Color3.fromRGB(28, 150, 240))
			refs.DescLbl.TextColor3 = REF.Lav
			refs.StatusLbl.Visible = true
			refs.StatusLbl.Text = string.format("%d%%", math.floor(value / math.max(1, goal) * 100))
			refs.Check.Visible = false
		end
		setBar(refs.Fill, value / math.max(1, goal))
		refs.BarTxt.Text = string.format("%s / %s", formatNumber(value), formatNumber(goal))
	end
	achCountLbl.Text = string.format("Completed: %d / %d   •   Rewards are given automatically", done, #ProgressionConfig.ACHIEVEMENTS)
	refreshGoal()

	-- Престиж
	local maxP = ProgressionConfig.PRESTIGE_MAX
	local req = ProgressionConfig.PRESTIGE_REQUIRED_LEVEL
	local aura = ProgressionConfig.GetAura(State.Prestige)
	prestigeBig.Text = string.format("Prestige %d / %d", State.Prestige, maxP)
	prestigeSideLbl.Text = State.Prestige &gt; 0 and string.format("Prestige %d", State.Prestige) or "Prestige"
	if levelPlusBadge then
		levelPlusBadge.Visible = State.Level &gt;= req and State.Prestige &lt; maxP -- v26: "!" when prestige is ready
	end
	if aura then
		auraLbl.Text = "Aura: " .. aura.Name
		auraLbl.TextColor3 = aura.Colors[1]
		auraGrad.Color = ColorSequence.new(aura.Colors[1], aura.Colors[#aura.Colors])
		if aura.Rainbow then
			local kps = {}
			for i, c in ipairs(aura.Colors) do
				table.insert(kps, ColorSequenceKeypoint.new((i - 1) / (#aura.Colors - 1), c))
			end
			auraGrad.Color = ColorSequence.new(kps)
		end
	else
		auraLbl.Text = "Aura: none (unlocks at Prestige 1)"
		auraLbl.TextColor3 = C.Muted
		auraGrad.Color = ColorSequence.new(C.Gray, C.GrayDark)
	end

	local nowPct = math.floor((ProgressionConfig.GetPrestigeMultiplier(State.Prestige) - 1) * 100 + 0.5)
	local nextPct = math.floor((ProgressionConfig.GetPrestigeMultiplier(math.min(maxP, State.Prestige + 1)) - 1) * 100 + 0.5)
	bonusLbl.Text = State.Prestige &gt;= maxP
		and string.format("Bonus: +%d%% to all (max!)", nowPct)
		or string.format("Bonus: +%d%% → +%d%% to all", nowPct, nextPct)

	reqLbl.Text = string.format("Requires level %d (now: %d)", req, State.Level)
	setBar(reqFill, State.Level / req)
	reqTxt.Text = string.format("%d / %d", math.min(State.Level, req), req)

	local nextAura: ProgressionConfig.AuraInfo? = nil
	for _, a in ipairs(ProgressionConfig.PRESTIGE_AURAS) do
		if a.MinPrestige &gt; State.Prestige then
			nextAura = a
			break
		end
	end
	nextAuraLbl.Text = nextAura and string.format("Next aura: %s (at Prestige %d)", nextAura.Name, nextAura.MinPrestige) or "All auras unlocked! 🌈"

	if os.clock() &gt;= confirmUntil then
		if State.Prestige &gt;= maxP then
			setButtonState(prestigeBtn, prestigeBtnGrad, false, C.Pink, C.PinkDark, "👑 MAX PRESTIGE")
		elseif State.CanPrestige then
			setButtonState(prestigeBtn, prestigeBtnGrad, true, C.Pink, C.PinkDark, "👑 PRESTIGE NOW")
		else
			setButtonState(prestigeBtn, prestigeBtnGrad, false, C.Pink, C.PinkDark, string.format("🔒 Level %d required", req))
		end
	end
end

-- ============================================================================
-- 12. СОБЫТИЯ С СЕРВЕРА
-- ============================================================================
local firstSync = true
SyncPlayerData.OnClientEvent:Connect(function(data: any)
	if type(data) ~= "table" then return end
	State.Level = data.Level or State.Level
	State.XP = data.XP or State.XP
	State.RequiredXP = data.RequiredXP or State.RequiredXP
	State.Coins = data.Coins or State.Coins
	State.SkillPoints = data.SkillPoints or State.SkillPoints
	State.Skills = data.Skills or State.Skills
	State.Prestige = data.Prestige or State.Prestige
	State.Achievements = data.Achievements or State.Achievements
	State.AchievementProgress = data.AchievementProgress or State.AchievementProgress
	if data.CanPrestige ~= nil then State.CanPrestige = data.CanPrestige end
	refreshAll()
	if firstSync then
		firstSync = false
		if State.SkillPoints &gt; 0 then
			showToast("✨", string.format("You have %d skill points!", State.SkillPoints), "Open ⚡ Skills [K] to upgrade", C.Purple)
		end
	end
end)

ProgressionEvent.OnClientEvent:Connect(function(eventType: string, payload: any)
	if type(payload) ~= "table" then payload = {} end

	if eventType == "LevelUp" then
		playLevelUpSound()
		local gained = tonumber(payload.LevelsGained) or 1
		local sub = string.format("+%d ✨ skill point  ·  +%s 💰  ·  ❤️ Health restored", gained, formatNumber(tonumber(payload.BonusCoins) or 0))
		if payload.CanPrestige then
			sub ..= "\n👑 PRESTIGE available!"
		end
		showPopup(string.format("🎉 Level Up! [%d]", tonumber(payload.Level) or State.Level), sub, C.Gold, { C.Gold, C.White, Color3.fromRGB(255, 170, 40) })

	elseif eventType == "Achievement" then
		playSound(Sounds.Achievement, 1.05)
		local parts = {}
		if (tonumber(payload.RewardCoins) or 0) &gt; 0 then table.insert(parts, string.format("+%s 💰", formatNumber(payload.RewardCoins))) end
		if (tonumber(payload.RewardSkillPoints) or 0) &gt; 0 then table.insert(parts, string.format("+%d ✨", payload.RewardSkillPoints)) end
		showToast(tostring(payload.Icon or "🏆"), "🏆 Achievement Unlocked: " .. tostring(payload.Name or ""), "Reward: " .. table.concat(parts, "  "), C.Gold)
		if OpenWindowName ~= "AchievementsWindow" then
			achBadge.Visible = true
			task.delay(6, function() achBadge.Visible = false end)
		end

	elseif eventType == "Prestige" then
		playSound(Sounds.Prestige, 0.9)
		closeWindow()
		local aura = ProgressionConfig.GetAura(tonumber(payload.Prestige) or 0)
		local colors = aura and aura.Colors or { C.Pink }
		showPopup(
			string.format("👑 PRESTIGE %d!", tonumber(payload.Prestige) or 0),
			string.format("Aura: %s  ·  Bonus +%d%% to all!", tostring(payload.AuraName or ""), tonumber(payload.BonusPercent) or 0),
			colors[1], colors
		)

	elseif eventType == "SkillUpgraded" then
		local refs = SkillRows[tostring(payload.SkillId)]
		if refs then
			local sc = refs.Tile:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
			sc.Parent = refs.Tile
			sc.Scale = 1.25
			TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			local info = ProgressionConfig.SKILLS[tostring(payload.SkillId)]
			local plus = label(refs.Tile, string.format("+%d", tonumber(payload.Added) or 1), UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 0, -6), info and info.Color or C.White, 20, Enum.TextXAlignment.Center)
			plus.ZIndex = 8
			local t = TweenService:Create(plus, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 0, 0, -34), TextTransparency = 1, TextStrokeTransparency = 1,
			})
			t:Play()
			t.Completed:Once(function() plus:Destroy() end)
		end

	elseif eventType == "Toast" then
		local col = typeof(payload.Color) == "Color3" and payload.Color or C.White
		local sub = tostring(payload.Sub or "")
		showToast("💬", tostring(payload.Text or ""), sub, col, sub ~= "" and 8 or nil)

	-- v50: combo meter, surprise blocks, daily reward, first-visit hints
	elseif eventType == "Combo" then
		showCombo(tonumber(payload.Count) or 0, tonumber(payload.Window) or GameConfig.COMBO.WindowSeconds, tonumber(payload.BonusCoins) or 0)

	elseif eventType == "Special" then
		local col = typeof(payload.Color) == "Color3" and payload.Color or C.Gold
		local kind = tostring(payload.Kind or "")
		local icon = (kind == "TNT" and "💥") or (kind == "Treasure" and "💰") or "🍀"
		playSound(Sounds.Achievement, kind == "TNT" and 0.8 or 1.25)
		showToast(icon, tostring(payload.Title or ""), tostring(payload.Sub or ""), col, 5)
		if (tonumber(payload.Frenzy) or 0) &gt; 0 then
			showFrenzy(tonumber(payload.Frenzy) or 0)
		end

	elseif eventType == "DailyReward" then
		playSound(Sounds.Achievement, 1.15)
		local sub = string.format("+%s 💰", formatNumber(tonumber(payload.Coins) or 0))
		if (tonumber(payload.SkillPoints) or 0) &gt; 0 then
			sub ..= string.format("  ·  +%d ✨ skill point", tonumber(payload.SkillPoints) or 0)
		end
		sub ..= "\nCome back tomorrow for a bigger gift!"
		showPopup(string.format("🎁 Daily Reward: Day %d", tonumber(payload.Day) or 1), sub, C.Gold, { C.Gold, C.White, C.Green })

	elseif eventType == "Welcome" then
		showToast("⛏️", "Dig!", "Walk through the MINE gate and tap blocks", C.Green, 12)
		showToast("💰", "Sell!", "Stand on the $ SELL pad to get coins", C.Gold, 12)
		showToast("🎯", "Follow your goals", "Top right: your next reward", C.Purple, 12)
	end
end)

-- ============================================================================
-- 13. ГОРЯЧИЕ КЛАВИШИ: [K] Навыки · [J] Достижения · [P] Престиж
-- ============================================================================
UserInputService.InputBegan:Connect(function(input: InputObject, gpe: boolean)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.K then
		openWindow("SkillsWindow")
	elseif input.KeyCode == Enum.KeyCode.J then
		openWindow("AchievementsWindow")
	elseif input.KeyCode == Enum.KeyCode.P then
		openWindow("PrestigeWindow")
	end
end)


-- ============================================================================
-- v32: NIGHT MERCHANT WINDOW — exactly like the reference:
-- starry night panel, 🌙 title + subtitle, coin pill, red round ✖,
-- 3×2 neon cards (round icon, name, description, price, colored button),
-- bottom bar with the red backpack icon ("Backpack is empty" / sell 70%).
-- ============================================================================
do
	local NMRemote = Remotes:WaitForChild("NightMerchant", 20) :: RemoteEvent?
	local okIB, IB = pcall(function() return require(Modules:WaitForChild("InputBlocker")) end)
	local okSM, SM = pcall(function() return require(Modules:WaitForChild("SoundManager")) end)
	local okGC, GC = pcall(function() return require(Modules:WaitForChild("GameConfig")) end)
	if NMRemote then
		local NIGHT_0 = Color3.fromRGB(30, 26, 66)
		local NIGHT_1 = Color3.fromRGB(12, 12, 34)
		local CARD_0 = Color3.fromRGB(30, 28, 62)
		local CARD_1 = Color3.fromRGB(16, 15, 38)
		local GOLD = Color3.fromRGB(255, 205, 90)
		local CREAM = Color3.fromRGB(255, 236, 196)
		local MUTED = Color3.fromRGB(176, 172, 214)
		local GREY = Color3.fromRGB(96, 94, 120)
		local WHITE = Color3.new(1, 1, 1)

		local function mCorner(p: Instance, r: number)
			local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = p
		end
		local function mStroke(p: Instance, col: Color3, th: number, tr: number?): UIStroke
			local s = Instance.new("UIStroke"); s.Color = col; s.Thickness = th; s.Transparency = tr or 0
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = p
			return s
		end
		local function mGrad(p: Instance, c0: Color3, c1: Color3, rot: number?): UIGradient
			local g = Instance.new("UIGradient"); g.Color = ColorSequence.new(c0, c1); g.Rotation = rot or 90; g.Parent = p
			return g
		end
		local function mLabel(parent: Instance, text: string, size: UDim2, pos: UDim2, ts: number, col: Color3, font: Enum.Font?, xa: Enum.TextXAlignment?): TextLabel
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = size; t.Position = pos
			t.Text = text; t.TextSize = ts; t.TextColor3 = col
			t.Font = font or Enum.Font.GothamBold
			t.TextXAlignment = xa or Enum.TextXAlignment.Left
			t.TextYAlignment = Enum.TextYAlignment.Center
			t.TextWrapped = true
			t.Parent = parent
			return t
		end
		local function press(btn: GuiObject)
			local sc = btn:FindFirstChild("PressScale") :: UIScale?
			if not sc then
				local ns = Instance.new("UIScale"); ns.Name = "PressScale"; ns.Parent = btn
				sc = ns
			end
			;(sc :: UIScale).Scale = 0.92
			TweenService:Create(sc :: UIScale, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			if okSM and SM and SM.PlayUISound then pcall(SM.PlayUISound, "UIClick") end
		end

		local gui = Instance.new("ScreenGui")
		gui.Name = "NightMerchantGui"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 30
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = player:WaitForChild("PlayerGui")

		local dim = Instance.new("Frame")
		dim.Size = UDim2.fromScale(1, 1)
		dim.BackgroundColor3 = Color3.fromRGB(4, 4, 14)
		dim.BackgroundTransparency = 1
		dim.Visible = false
		dim.Active = true
		dim.Parent = gui

		local W, H = 812, 600
		local panel = Instance.new("Frame")
		panel.Name = "NightMerchantWindow"
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.Position = UDim2.fromScale(0.5, 0.5)
		panel.Size = UDim2.fromOffset(W, H)
		panel.BackgroundColor3 = WHITE
		panel.ClipsDescendants = false
		panel.Parent = dim
		mCorner(panel, 22)
		mGrad(panel, NIGHT_0, NIGHT_1, 90)
		mStroke(panel, Color3.fromRGB(120, 110, 230), 3, 0.1)
		local scale = Instance.new("UIScale"); scale.Parent = panel
		local function rescale()
			local vp = (Workspace.CurrentCamera :: Camera).ViewportSize
			scale.Scale = math.clamp(math.min(vp.X / (W + 60), vp.Y / (H + 60)), 0.42, 1.15)
		end
		rescale()
		;(Workspace.CurrentCamera :: Camera):GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

		-- outer neon glow
		local glow = Instance.new("Frame")
		glow.Name = "Glow"
		glow.BackgroundTransparency = 1
		glow.Size = UDim2.new(1, 12, 1, 12)
		glow.Position = UDim2.fromOffset(-6, -6)
		glow.Parent = panel
		mCorner(glow, 26)
		mStroke(glow, Color3.fromRGB(140, 120, 255), 5, 0.72)

		-- twinkling stars
		local starRng = Random.new(31)
		for i = 1, 46 do
			local s = Instance.new("Frame")
			local sz = starRng:NextInteger(2, 4)
			s.Name = "Star"
			s.BorderSizePixel = 0
			s.BackgroundColor3 = (i % 5 == 0) and Color3.fromRGB(255, 230, 160) or Color3.fromRGB(210, 215, 255)
			s.BackgroundTransparency = starRng:NextNumber(0.15, 0.6)
			s.Size = UDim2.fromOffset(sz, sz)
			s.Position = UDim2.new(starRng:NextNumber(0.02, 0.98), 0, starRng:NextNumber(0.02, 0.98), 0)
			s.Parent = panel
			mCorner(s, 9)
			TweenService:Create(s, TweenInfo.new(starRng:NextNumber(0.9, 2.2), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.9 }):Play()
		end

		-- header: moon + title + subtitle
		local moon = mLabel(panel, "🌙", UDim2.fromOffset(60, 60), UDim2.fromOffset(20, 12), 44, GOLD, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
		moon.TextScaled = true
		local title = mLabel(panel, "NIGHT MERCHANT", UDim2.new(1, -330, 0, 44), UDim2.fromOffset(86, 12), 36, CREAM, Enum.Font.GothamBlack)
		mGrad(title, Color3.fromRGB(255, 244, 210), Color3.fromRGB(255, 196, 92), 90)
		local ts = Instance.new("UIStroke"); ts.Color = Color3.fromRGB(40, 22, 70); ts.Thickness = 2.5; ts.Parent = title
		mLabel(panel, "Open only at night  •  Ore buyback 70%", UDim2.new(1, -330, 0, 22), UDim2.fromOffset(88, 56), 16, MUTED, Enum.Font.GothamBold)

		-- coin pill
		local pill = Instance.new("Frame")
		pill.Name = "CoinPill"
		pill.Size = UDim2.fromOffset(150, 44)
		pill.Position = UDim2.new(1, -226, 0, 20)
		pill.BackgroundColor3 = WHITE
		pill.Parent = panel
		mCorner(pill, 22)
		mGrad(pill, Color3.fromRGB(44, 36, 20), Color3.fromRGB(24, 20, 12), 90)
		mStroke(pill, GOLD, 2.5)
		local coinsLbl = mLabel(pill, "💰 0", UDim2.new(1, -16, 1, 0), UDim2.fromOffset(8, 0), 22, GOLD, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)

		-- red round close button
		local closeBtn = Instance.new("TextButton")
		closeBtn.Name = "Close"
		closeBtn.Size = UDim2.fromOffset(48, 48)
		closeBtn.Position = UDim2.new(1, -64, 0, 18)
		closeBtn.BackgroundColor3 = WHITE
		closeBtn.AutoButtonColor = false
		closeBtn.Text = "✖"
		closeBtn.TextColor3 = WHITE
		closeBtn.TextSize = 24
		closeBtn.Font = Enum.Font.GothamBlack
		closeBtn.Parent = panel
		mCorner(closeBtn, 99)
		mGrad(closeBtn, Color3.fromRGB(255, 92, 92), Color3.fromRGB(190, 28, 44), 90)
		mStroke(closeBtn, Color3.fromRGB(255, 190, 190), 2.5)
		vecCross(closeBtn)

		-- 3×2 neon cards
		local ITEMS = {
			{ Id = "RepairKit",    Icon = "🧰", Name = "Repair Kit",    Desc = "Cleans ALL dirt from your backpack. Night only!", Col = Color3.fromRGB(255, 70, 92),  Btn = "CLEAN" },
			{ Id = "Book",         Icon = "📘", Name = "Book",          Desc = "Read it: +XP and +Strength XP",                      Col = Color3.fromRGB(70, 150, 255), Btn = "BUY" },
			{ Id = "Food",         Icon = "🍔", Name = "Food",          Desc = "Burger &amp; soda go to your supplies. Eat anytime [H]", Col = Color3.fromRGB(255, 150, 40), Btn = "BUY" },
			{ Id = "Potion",       Icon = "🧪", Name = "Miner Potion",  Desc = "+25% coins at $ SELL for 3 minutes",                Col = Color3.fromRGB(80, 230, 110), Btn = "BUY" },
			{ Id = "TopHat",       Icon = "🎩", Name = "Top Hat",       Desc = "Cosmetic: a classy night hat for your miner",        Col = Color3.fromRGB(180, 92, 255), Btn = "BUY" },
			{ Id = "MorningCharm", Icon = "🌅", Name = "Morning Bonus", Desc = "Coins + full energy at sunrise",                     Col = Color3.fromRGB(60, 222, 240), Btn = "BUY" },
		}
		type Card = { Price: TextLabel, Extra: TextLabel, Btn: TextButton, BtnGrad: UIGradient, Col: Color3, Base: string, Stroke: UIStroke }
		local cards: { [string]: Card } = {}
		local last: any = nil
		local CW, CH, GAP = 246, 182, 17
		for i, it in ipairs(ITEMS) do
			local col = (i - 1) % 3
			local rowI = math.floor((i - 1) / 3)
			local x = 26 + col * (CW + GAP)
			local y = 98 + rowI * (CH + GAP)
			local cg = Instance.new("Frame")
			cg.Name = it.Id .. "_Glow"
			cg.BackgroundTransparency = 1
			cg.Size = UDim2.fromOffset(CW + 10, CH + 10)
			cg.Position = UDim2.fromOffset(x - 5, y - 5)
			cg.Parent = panel
			mCorner(cg, 20)
			mStroke(cg, it.Col, 6, 0.75)
			local card = Instance.new("Frame")
			card.Name = it.Id
			card.Size = UDim2.fromOffset(CW, CH)
			card.Position = UDim2.fromOffset(x, y)
			card.BackgroundColor3 = WHITE
			card.Parent = panel
			mCorner(card, 16)
			mGrad(card, CARD_0:Lerp(it.Col, 0.08), CARD_1, 90)
			local cst = mStroke(card, it.Col, 2.5)
			-- round icon
			local ic = Instance.new("Frame")
			ic.Name = "Icon"
			ic.Size = UDim2.fromOffset(66, 66)
			ic.Position = UDim2.fromOffset(14, 14)
			ic.BackgroundColor3 = WHITE
			ic.Parent = card
			mCorner(ic, 99)
			mGrad(ic, it.Col:Lerp(WHITE, 0.15), it.Col:Lerp(Color3.new(0, 0, 0), 0.55), 90)
			mStroke(ic, it.Col:Lerp(WHITE, 0.45), 2.5)
			local em = mLabel(ic, it.Icon, UDim2.fromScale(0.66, 0.66), UDim2.fromScale(0.17, 0.17), 30, WHITE, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
			em.TextScaled = true
			mLabel(card, it.Name, UDim2.new(1, -100, 0, 24), UDim2.fromOffset(90, 14), 19, WHITE, Enum.Font.GothamBlack)
			local d = mLabel(card, it.Desc, UDim2.new(1, -100, 0, 54), UDim2.fromOffset(90, 38), 13, MUTED, Enum.Font.GothamMedium)
			d.TextYAlignment = Enum.TextYAlignment.Top
			local price = mLabel(card, "💰 0", UDim2.new(0.5, -14, 0, 28), UDim2.fromOffset(14, 96), 21, GOLD, Enum.Font.GothamBlack)
			local extra = mLabel(card, "", UDim2.new(0.5, -14, 0, 28), UDim2.new(0.5, 0, 0, 96), 12, it.Col:Lerp(WHITE, 0.35), Enum.Font.GothamBold, Enum.TextXAlignment.Right)
			local btn = Instance.new("TextButton")
			btn.Name = "Buy"
			btn.Size = UDim2.new(1, -28, 0, 40)
			btn.Position = UDim2.fromOffset(14, CH - 54)
			btn.BackgroundColor3 = WHITE
			btn.AutoButtonColor = false
			btn.Text = it.Btn
			btn.TextColor3 = WHITE
			btn.TextSize = 20
			btn.Font = Enum.Font.GothamBlack
			btn.Parent = card
			mCorner(btn, 12)
			local bgr = mGrad(btn, it.Col:Lerp(WHITE, 0.12), it.Col:Lerp(Color3.new(0, 0, 0), 0.35), 90)
			mStroke(btn, it.Col:Lerp(WHITE, 0.5), 2)
			local bts = Instance.new("UIStroke"); bts.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual; bts.Color = it.Col:Lerp(Color3.new(0, 0, 0), 0.6); bts.Thickness = 1.5; bts.Parent = btn
			local gl = Instance.new("Frame")
			gl.BackgroundColor3 = WHITE; gl.BackgroundTransparency = 0.82; gl.BorderSizePixel = 0
			gl.Size = UDim2.new(1, -10, 0.42, 0); gl.Position = UDim2.fromOffset(5, 3); gl.Parent = btn
			mCorner(gl, 9)
			btn.MouseButton1Click:Connect(function()
				press(btn)
				;(NMRemote :: RemoteEvent):FireServer("Buy", it.Id)
			end)
			cards[it.Id] = { Price = price, Extra = extra, Btn = btn, BtnGrad = bgr, Col = it.Col, Base = it.Btn, Stroke = cst }
		end

		-- bottom bar: red backpack icon + "Backpack is empty" / sell 70%
		local bar = Instance.new("Frame")
		bar.Name = "BackpackBar"
		bar.Size = UDim2.new(1, -52, 0, 60)
		bar.Position = UDim2.fromOffset(26, 98 + 2 * (CH + GAP) + 4)
		bar.BackgroundColor3 = WHITE
		bar.Parent = panel
		mCorner(bar, 16)
		mGrad(bar, Color3.fromRGB(34, 30, 64), Color3.fromRGB(18, 16, 40), 90)
		mStroke(bar, Color3.fromRGB(255, 80, 96), 2, 0.35)
		local bi = Instance.new("Frame")
		bi.Size = UDim2.fromOffset(44, 44)
		bi.Position = UDim2.fromOffset(10, 8)
		bi.BackgroundColor3 = WHITE
		bi.Parent = bar
		mCorner(bi, 12)
		mGrad(bi, Color3.fromRGB(255, 92, 100), Color3.fromRGB(176, 26, 44), 90)
		mStroke(bi, Color3.fromRGB(255, 180, 180), 2)
		local bie = mLabel(bi, "🎒", UDim2.fromScale(0.7, 0.7), UDim2.fromScale(0.15, 0.15), 24, WHITE, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
		bie.TextScaled = true
		local barLbl = mLabel(bar, "Backpack is empty", UDim2.new(1, -250, 1, 0), UDim2.fromOffset(66, 0), 19, CREAM, Enum.Font.GothamBlack)
		local sellBtn = Instance.new("TextButton")
		sellBtn.Name = "SellAll"
		sellBtn.Size = UDim2.fromOffset(170, 42)
		sellBtn.Position = UDim2.new(1, -180, 0, 9)
		sellBtn.BackgroundColor3 = WHITE
		sellBtn.AutoButtonColor = false
		sellBtn.Text = "SELL 70%"
		sellBtn.TextColor3 = WHITE
		sellBtn.TextSize = 18
		sellBtn.Font = Enum.Font.GothamBlack
		sellBtn.Visible = false
		sellBtn.Parent = bar
		mCorner(sellBtn, 12)
		mGrad(sellBtn, Color3.fromRGB(255, 186, 70), Color3.fromRGB(226, 110, 20), 90)
		mStroke(sellBtn, Color3.fromRGB(255, 226, 160), 2)
		sellBtn.MouseButton1Click:Connect(function()
			press(sellBtn)
			;(NMRemote :: RemoteEvent):FireServer("Sell")
		end)
		local status = mLabel(panel, "", UDim2.new(1, -40, 0, 26), UDim2.new(0, 20, 1, -34), 16, CREAM, Enum.Font.GothamBold, Enum.TextXAlignment.Center)

		local function setBtn(card: Card, txt: string, enabled: boolean)
			card.Btn.Text = txt
			local c = enabled and card.Col or GREY
			card.BtnGrad.Color = ColorSequence.new(c:Lerp(WHITE, 0.12), c:Lerp(Color3.new(0, 0, 0), 0.35))
			card.Btn.TextTransparency = enabled and 0 or 0.25
			card.Stroke.Transparency = enabled and 0 or 0.45
		end

		local function dirtName(stage: number): string
			if okGC and GC and GC.GetDirtStageName then return GC.GetDirtStageName(stage) end
			return ({ [0] = "Clean", "Slightly Dirty", "Dirty", "Very Dirty", "Extremely Dirty" })[stage] or "Clean"
		end

		local function apply(st: any)
			if type(st) ~= "table" then return end
			last = st
			local coins = math.floor(st.Coins or 0)
			coinsLbl.Text = "💰 " .. tostring(coins)
			for id, card in pairs(cards) do
				local p = (st.Prices and st.Prices[id]) or 0
				card.Price.Text = (p &gt; 0) and ("💰 " .. tostring(p)) or "✔ Owned"
				card.Extra.Text = ""
				local afford = p &lt;= coins
				if id == "RepairKit" then
					local stg = math.floor(st.DirtStage or 0)
					local pen = ({ [0] = 0, 10, 20, 30, 40 })[stg] or 0
					card.Extra.Text = stg &gt; 0 and string.format("%s -%d%%", dirtName(stg), pen) or "✨ Clean"
					if stg &lt;= 0 and (st.Dirt or 0) &lt;= 0 then setBtn(card, "CLEAN ✔", false) else setBtn(card, "CLEAN", afford) end
				elseif id == "Food" then
					card.Extra.Text = string.format("Stock: %d/%d", math.floor(st.FoodStock or 0), math.floor(st.FoodMax or 20))
					if (st.FoodStock or 0) &gt;= (st.FoodMax or 20) then setBtn(card, "FULL", false) else setBtn(card, "BUY", afford) end
				elseif id == "TopHat" and st.OwnsHat then
					setBtn(card, st.HatOn and "UNEQUIP" or "EQUIP", true)
				elseif id == "MorningCharm" and st.Charm then
					card.Extra.Text = "until sunrise"
					setBtn(card, "ACTIVE", false)
				elseif id == "Potion" and (st.PotionLeft or 0) &gt; 0 then
					card.Extra.Text = string.format("%d:%02d left", math.floor(st.PotionLeft / 60), st.PotionLeft % 60)
					setBtn(card, "EXTEND", afford)
				else
					setBtn(card, card.Base, afford)
				end
			end
			local bb = math.floor(st.Buyback or 0)
			if bb &gt; 0 then
				barLbl.Text = string.format("Ore in backpack: %d / %d  →  +%d 💰 (70%%)", math.floor(st.BagUsed or 0), math.floor(st.BagMax or 0), bb)
				sellBtn.Visible = true
			else
				barLbl.Text = "Backpack is empty"
				sellBtn.Visible = false
			end
		end

		local isOpen = false
		local function close()
			if not isOpen then return end
			isOpen = false
			TweenService:Create(dim, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = scale.Scale * 0.85 }):Play()
			task.delay(0.19, function()
				if not isOpen then dim.Visible = false; rescale() end
			end)
			if okIB and IB then pcall(IB.SetMenuOpen, "NightMerchant", false) end
		end
		local function open()
			if okIB and IB then
				pcall(IB.CloseOtherMenus, "NightMerchant")
				pcall(IB.SetMenuOpen, "NightMerchant", true)
			end
			if isOpen then return end
			isOpen = true
			status.Text = ""
			rescale()
			local target = scale.Scale
			scale.Scale = target * 0.85
			dim.Visible = true
			TweenService:Create(dim, TweenInfo.new(0.2), { BackgroundTransparency = 0.4 }):Play()
			TweenService:Create(scale, TweenInfo.new(0.24, Enum.EasingStyle.Back), { Scale = target }):Play()
			if okSM and SM and SM.PlayUISound then pcall(SM.PlayUISound, "UIClick") end
		end
		if okIB and IB then pcall(IB.RegisterCloseCallback, "NightMerchant", close) end
		closeBtn.MouseButton1Click:Connect(function() press(closeBtn); close() end)
		UserInputService.InputBegan:Connect(function(input: InputObject, _gpe: boolean)
			if isOpen and input.KeyCode == Enum.KeyCode.Escape then close() end
		end)

		;(NMRemote :: RemoteEvent).OnClientEvent:Connect(function(kind: any, a: any, b: any, c: any)
			if kind == "Open" then
				apply(a); open()
			elseif kind == "Close" then
				close()
			elseif kind == "Result" then
				status.Text = tostring(b or "")
				status.TextColor3 = (a == true) and Color3.fromRGB(130, 240, 150) or Color3.fromRGB(255, 130, 110)
				if c then apply(c) end
			end
		end)
		-- potion countdown refresh
		task.spawn(function()
			while true do
				task.wait(1)
				if isOpen and last and (last.PotionLeft or 0) &gt; 0 then
					last.PotionLeft -= 1
					apply(last)
				end
			end
		end)
	end
end

-- ============================================================================
-- v32: 🍔 FOOD SUPPLIES — eat a burger anywhere (even in the mine): full energy.
-- Button in the left HUD column + hotkey [H]. Server validates the stock.
-- ============================================================================
do
	local EatRemote = Remotes:WaitForChild("EatFood", 20) :: RemoteEvent?
	if EatRemote then
		local ORANGE_0 = Color3.fromRGB(255, 176, 66)
		local ORANGE_1 = Color3.fromRGB(222, 96, 18)
		local food = Instance.new("TextButton")
		food.Name = "FoodSuppliesButton"
		food.Size = UDim2.fromOffset(214, 54)
		food.AutoButtonColor = false
		food.Text = ""
		food.BackgroundColor3 = C.White
		food.LayoutOrder = 11
		corner(food, 16)
		local fg = gradient(food, ORANGE_0, ORANGE_1, 90)
		local fs = stroke(food, ORANGE_0:Lerp(C.White, 0.55), 3)
		local gl = Instance.new("Frame")
		gl.BackgroundColor3 = C.White; gl.BackgroundTransparency = 0.8; gl.BorderSizePixel = 0
		gl.Size = UDim2.new(1, -12, 0.44, 0); gl.Position = UDim2.fromOffset(6, 3); gl.Parent = food
		corner(gl, 11)
		local ic = label(food, "🍔", UDim2.fromOffset(44, 44), UDim2.fromOffset(8, 5), C.White, 30, Enum.TextXAlignment.Center)
		ic.TextScaled = true
		ic.TextStrokeTransparency = 1
		local cnt = label(food, "x0", UDim2.new(1, -70, 0, 28), UDim2.fromOffset(60, 4), C.White, 22)
		cnt.Font = Enum.Font.GothamBlack
		cnt.TextStrokeTransparency = 0.3
		local hint = label(food, "[H] Eat • full energy", UDim2.new(1, -70, 0, 18), UDim2.fromOffset(60, 31), Color3.fromRGB(255, 240, 210), 12)
		hint.TextStrokeTransparency = 0.6

		local placed = false
		do
			local hudGui = playerGui:FindFirstChild("MinerSimulatorHUD_v8")
			local column = hudGui and hudGui:FindFirstChild("LeftColumn")
			if column and sideMenu.Parent == column then
				food.Parent = column
				placed = true
			end
		end
		if not placed then
			food.AnchorPoint = Vector2.new(0, 1)
			food.Position = UDim2.new(0, 14, 1, -18)
			food.Parent = screenGui
			responsive(food)
		end

		local function refreshFood()
			local n = math.floor(tonumber(player:GetAttribute("FoodStock")) or 0)
			cnt.Text = string.format("x%d  Burgers", n)
			if n &gt; 0 then
				fg.Color = ColorSequence.new(ORANGE_0, ORANGE_1)
				fs.Transparency = 0
				hint.Text = "[H] Eat • full energy"
			else
				fg.Color = ColorSequence.new(C.Gray, C.GrayDark)
				fs.Transparency = 0.5
				hint.Text = "Buy at the 🌙 Night Merchant"
			end
		end
		refreshFood()
		player:GetAttributeChangedSignal("FoodStock"):Connect(refreshFood)

		local lastEat = 0
		local function eat()
			if os.clock() - lastEat &lt; 0.6 then return end
			lastEat = os.clock()
			local sc = food:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
			sc.Parent = food
			;(sc :: UIScale).Scale = 0.92
			TweenService:Create(sc :: UIScale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
			playSound(Sounds.Click, 1.1)
			;(EatRemote :: RemoteEvent):FireServer()
		end
		food.Activated:Connect(eat)
		UserInputService.InputBegan:Connect(function(input: InputObject, gpe: boolean)
			if gpe or UserInputService:GetFocusedTextBox() then return end
			if input.KeyCode == Enum.KeyCode.H then eat() end
		end)
	end
end

refreshAll()
print("✅ [ProgressionUI] Ready")
</ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">BackpackUI</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🎒 КЛИЕНТ: BackpackUI (StarterPlayerScripts.BackpackUI)
-- v52: окно рюкзака с 3D-иконками руды.
--   • Каждая ячейка — ViewportFrame с моделью руды (камень + кристаллы цвета руды),
--     медленное вращение, подсветка; у светящихся руд — мерцающие «✦».
--   • В ячейке: иконка, название, счётчик «×N», цена за штуку. Пустые ячейки затемнены.
--   • Сверху — полоса вместимости «Занято / Всего», меняющая цвет при заполнении.
--   • Пустой рюкзак показывает подсказку «Иди в шахту!».
-- Открывается кнопкой рюкзака в HUD и клавишами B / I (через ClientBus.ToggleBag).
-- Вращение и мерцание работают только пока окно открыто.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
if not player then
	return
end

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local UIKit = require(Modules:WaitForChild("UIKit"))
local ClientBus = require(Modules:WaitForChild("ClientBus"))
local OreIconModels = require(Modules:WaitForChild("OreIconModels"))
local InputBlocker = require(Modules:WaitForChild("InputBlocker"))

local SyncPlayerData = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SyncPlayerData") :: RemoteEvent

local UI = GameConfig.UI
local CFG = GameConfig.BACKPACK_UI
local WIN = CFG.WindowSize
local SLOT = CFG.SlotSize

local State = {
	Inventory = {} :: { [string]: number },
	MorningInventory = {} :: { [string]: number },
	BagUsed = 0,
	BagMax = GameConfig.BASE_BACKPACK_SLOTS,
	BagValue = 0,
	BackpackLevel = 1,
	DirtBlocks = 0,
}

type Slot = {
	Root: Frame,
	Count: TextLabel,
	Price: TextLabel,
	Spin: UIKit.SpinItem?,
	Twinkles: { TextLabel },
}

local IsOpen = false
local OpenToken = 0
local Slots: { [string]: Slot } = {}
local EmptySlots: { Frame } = {}
local ActiveTweens: { Tween } = {}
local LayoutSignature = ""

-- ---------------------------------------------------------------------------
-- Каркас окна
-- ---------------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "BackpackV52"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 29
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Enabled = false
gui.Parent = playerGui

local dim = Instance.new("TextButton")
dim.Name = "Dim"
dim.Size = UDim2.fromScale(1, 1)
dim.BackgroundColor3 = Color3.new(0, 0, 0)
dim.BackgroundTransparency = 1
dim.BorderSizePixel = 0
dim.AutoButtonColor = false
dim.Text = ""
dim.Parent = gui

local window = UIKit.Frame(gui, "Window", UDim2.fromOffset(WIN.X, WIN.Y), UDim2.fromScale(0.5, 0.5), Color3.new(1, 1, 1))
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Active = true
window.ZIndex = 2
UIKit.Corner(window, 22)
UIKit.Gradient(window, UI.BgTop, UI.BgBottom, 90)
local windowStroke = UIKit.Stroke(window, Color3.new(1, 1, 1), 3)
UIKit.Gradient(windowStroke, UI.Green, UI.Blue, 35)
local winScale = Instance.new("UIScale")
winScale.Parent = window
UIKit.BindScale(winScale, WIN.X, WIN.Y, 1.1)

UIKit.Label(window, {
	Name = "Title", Text = "🎒 РЮКЗАК", Size = UDim2.new(0, 300, 0, 38), Position = UDim2.fromOffset(24, 12),
	Font = UI.FontTitle, TextSize = 27, XAlign = Enum.TextXAlignment.Left, Color = UI.Green, Stroke = true, ZIndex = 3,
})
local subtitle = UIKit.Label(window, {
	Name = "Subtitle", Text = "", Size = UDim2.new(1, -120, 0, 16), Position = UDim2.fromOffset(26, 48),
	TextSize = 12, XAlign = Enum.TextXAlignment.Left, Color = UI.TextDim, ZIndex = 3,
})

local closeBtn = UIKit.Button(window, "Close", "✕", UDim2.fromOffset(40, 40), UDim2.new(1, -56, 0, 14), UI.Red, UI.RedDark)
closeBtn.TextSize = 20
closeBtn.ZIndex = 4

-- Полоса вместимости
local barBack = UIKit.Frame(window, "CapacityBar", UDim2.new(1, -48, 0, 30), UDim2.fromOffset(24, 74), UI.SlotEmpty)
barBack.ZIndex = 3
UIKit.Corner(barBack, 15)
UIKit.Stroke(barBack, UI.PanelLight, 2)
local barFill = UIKit.Frame(barBack, "Fill", UDim2.fromScale(0, 1), UDim2.new(), CFG.BarOk)
barFill.ZIndex = 4
UIKit.Corner(barFill, 15)
local barGloss = UIKit.Gradient(barFill, Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170), 90)
barGloss.Name = "Gloss"
local barText = UIKit.Label(barBack, {
	Name = "Text", Text = "0 / 10", Font = UI.FontBlack, TextSize = 15, Stroke = true, ZIndex = 5,
})

-- Сетка ячеек
local scroll = Instance.new("ScrollingFrame")
scroll.Name = "Slots"
scroll.Size = UDim2.new(1, -32, 1, -174)
scroll.Position = UDim2.fromOffset(16, 114)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.ScrollBarImageColor3 = UI.Green
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.CanvasSize = UDim2.new()
scroll.ScrollingDirection = Enum.ScrollingDirection.Y
scroll.ZIndex = 3
scroll.Parent = window
local grid = Instance.new("UIGridLayout")
grid.CellSize = UDim2.fromOffset(SLOT.X, SLOT.Y)
grid.CellPadding = UDim2.fromOffset(10, 10)
grid.SortOrder = Enum.SortOrder.LayoutOrder
grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
grid.Parent = scroll
local gridPad = Instance.new("UIPadding")
gridPad.PaddingTop = UDim.new(0, 6)
gridPad.PaddingBottom = UDim.new(0, 8)
gridPad.Parent = scroll

-- Подсказка для пустого рюкзака
local hint = UIKit.Label(window, {
	Name = "EmptyHint", Text = "⛏️ Иди в шахту!", Size = UDim2.new(1, -80, 0, 44), Position = UDim2.new(0, 40, 0.5, -10),
	Font = UI.FontTitle, TextSize = 34, Color = UI.Gold, Stroke = true, ZIndex = 9,
})
local hintSub = UIKit.Label(window, {
	Name = "EmptyHintSub", Text = "Добытая руда появится в этих ячейках", Size = UDim2.new(1, -80, 0, 20),
	Position = UDim2.new(0, 40, 0.5, 36), TextSize = 14, Color = UI.TextDim, ZIndex = 9,
})

local footer = UIKit.Label(window, {
	Name = "Footer", Text = "", Size = UDim2.new(1, -48, 0, 40), Position = UDim2.new(0, 24, 1, -52),
	TextSize = 13, Color = UI.Green, Wrapped = true, ZIndex = 3,
})

local spinner = UIKit.NewSpinner(CFG.IconSpinSeconds, scroll)

-- ---------------------------------------------------------------------------
-- Ячейки
-- ---------------------------------------------------------------------------
type Stack = { Key: string, OreId: string, Count: number, UnitPrice: number, Morning: boolean }

local function collectStacks(): { Stack }
	local stacks: { Stack } = {}
	for _, info in ipairs(GameConfig.BLOCK_LIST) do
		local reg = State.Inventory[info.Id] or 0
		if reg &gt; 0 then
			table.insert(stacks, { Key = "Reg_" .. info.Id, OreId = info.Id, Count = reg, UnitPrice = info.SellPrice, Morning = false })
		end
		local morn = State.MorningInventory[info.Id] or 0
		if morn &gt; 0 then
			table.insert(stacks, {
				Key = "Morn_" .. info.Id, OreId = info.Id, Count = morn,
				UnitPrice = info.SellPrice * GameConfig.MORNING_VEINS.SellPriceMultiplier, Morning = true,
			})
		end
	end
	table.sort(stacks, function(a, b)
		local va, vb = a.Count * a.UnitPrice, b.Count * b.UnitPrice
		if va ~= vb then
			return va &gt; vb
		end
		return a.Key &lt; b.Key
	end)
	return stacks
end

local function makeSlot(stack: Stack, order: number): Slot
	local info: any = GameConfig.BLOCK_TYPES[stack.OreId]
	local rarity = GameConfig.RARITY[GameConfig.ORE_CATEGORY_RARITY[info.Category] or 1] or GameConfig.RARITY[1]
	local color = stack.Morning and UI.Gold or rarity.Color

	local root = UIKit.Frame(scroll, "Slot_" .. stack.Key, UDim2.fromOffset(SLOT.X, SLOT.Y), UDim2.new(), Color3.new(1, 1, 1))
	root.LayoutOrder = order
	root.ZIndex = 3
	UIKit.Corner(root, 14)
	UIKit.Gradient(root, UI.Slot:Lerp(color, 0.16), UI.BgBottom, 90)
	local stroke = UIKit.Stroke(root, Color3.new(1, 1, 1), 2, 0.1)
	UIKit.Gradient(stroke, color:Lerp(Color3.new(1, 1, 1), 0.3), color:Lerp(Color3.new(0, 0, 0), 0.3), 60)

	-- 3D-иконка руды
	local vp, cam, world = UIKit.Viewport(root, "Icon", UDim2.new(1, -12, 0, 92), UDim2.fromOffset(6, 6))
	vp.ZIndex = 4
	local model = OreIconModels.Build(stack.OreId)
	model.Parent = world
	if model:GetAttribute("Glow") == true then
		vp.Ambient = Color3.fromRGB(190, 190, 215) -- светящиеся руды подсвечены ярче
	end
	local icon = GameConfig.ORE_ICON
	local spin: UIKit.SpinItem = {
		Viewport = vp, Camera = cam, Center = icon.Center, Distance = icon.CameraDistance, Height = icon.CameraHeight, Phase = order * 0.8,
	}
	UIKit.OrbitCamera(spin, 0)

	-- блёстки для светящихся руд и утренних жил (частицы во ViewportFrame не рисуются)
	local twinkles: { TextLabel } = {}
	if model:GetAttribute("Glow") == true or stack.Morning then
		twinkles = UIKit.AddTwinkles(vp, 3, stack.Morning and UI.Gold or info.AccentColor, Random.new(order * 97 + 11), 6)
	end

	local count = UIKit.Label(root, {
		Name = "Count", Text = "×" .. stack.Count, Size = UDim2.fromOffset(70, 22), Position = UDim2.new(1, -76, 0, 6),
		Font = UI.FontBlack, TextSize = 17, XAlign = Enum.TextXAlignment.Right, Stroke = true, ZIndex = 7,
	})
	if stack.Morning then
		local tag = UIKit.Frame(root, "MorningTag", UDim2.fromOffset(44, 18), UDim2.fromOffset(6, 6), UI.Gold:Lerp(Color3.new(0, 0, 0), 0.4))
		tag.ZIndex = 7
		UIKit.Corner(tag, 9)
		UIKit.Label(tag, { Text = "🌅 ×3", Font = UI.FontBlack, TextSize = 10, Color = UI.Gold, ZIndex = 8 })
	end
	local name = UIKit.Label(root, {
		Name = "Name", Text = GameConfig.GetOreNameRu(stack.OreId), Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 100),
		Font = UI.FontBlack, TextSize = 13, Color = color:Lerp(Color3.new(1, 1, 1), 0.55), ZIndex = 5,
	})
	name.TextTruncate = Enum.TextTruncate.AtEnd
	local price = UIKit.Label(root, {
		Name = "Price", Text = "", Size = UDim2.new(1, -8, 0, 30), Position = UDim2.fromOffset(4, 122),
		TextSize = 12, Color = UI.Gold, Wrapped = true, ZIndex = 5,
	})

	return { Root = root, Count = count, Price = price, Spin = spin, Twinkles = twinkles }
end

local function fillSlot(slot: Slot, stack: Stack, order: number)
	slot.Root.LayoutOrder = order
	slot.Count.Text = "×" .. stack.Count
	slot.Price.Text = string.format("🪙 %s/шт\nвсего %s", UIKit.FormatCoins(stack.UnitPrice), UIKit.FormatCoins(stack.Count * stack.UnitPrice))
end

local function makeEmptySlot(order: number): Frame
	local root = UIKit.Frame(scroll, "Empty", UDim2.fromOffset(SLOT.X, SLOT.Y), UDim2.new(), UI.SlotEmpty, 0.25)
	root.LayoutOrder = order
	root.ZIndex = 3
	UIKit.Corner(root, 14)
	UIKit.Stroke(root, UI.PanelLight, 1.5, 0.6)
	UIKit.Label(root, { Text = "＋", TextSize = 30, Color = UI.PanelLight, ZIndex = 4 })
	return root
end

local function registerEffects()
	spinner.Clear()
	UIKit.StopTweens(ActiveTweens)
	for _, slot in pairs(Slots) do
		local spin = slot.Spin
		if spin then
			spinner.Add(spin)
		end
		UIKit.StartTwinkles(slot.Twinkles, ActiveTweens)
	end
end

-- Перестраиваем сетку только когда меняется НАБОР стопок; иначе обновляем числа
local function refresh()
	local stacks = collectStacks()
	local keys = {}
	for _, st in ipairs(stacks) do
		table.insert(keys, st.Key)
	end
	local signature = table.concat(keys, ";")

	if signature ~= LayoutSignature then
		LayoutSignature = signature
		local alive: { [string]: boolean } = {}
		for order, st in ipairs(stacks) do
			alive[st.Key] = true
			local slot = Slots[st.Key]
			if not slot then
				slot = makeSlot(st, order)
				Slots[st.Key] = slot
			end
			fillSlot(slot, st, order)
		end
		for key, slot in pairs(Slots) do
			if not alive[key] then
				slot.Root:Destroy()
				Slots[key] = nil
			end
		end
		-- пустые затемнённые ячейки добивают сетку до минимума и до целого ряда
		for _, f in ipairs(EmptySlots) do
			f:Destroy()
		end
		table.clear(EmptySlots)
		local columns = math.max(1, math.floor((WIN.X - 32 + 10) / (SLOT.X + 10)))
		local total = math.max(CFG.MinSlots, math.ceil(#stacks / columns) * columns)
		for i = #stacks + 1, total do
			table.insert(EmptySlots, makeEmptySlot(1000 + i))
		end
		if IsOpen then
			registerEffects()
		end
	else
		for order, st in ipairs(stacks) do
			local slot = Slots[st.Key]
			if slot then
				fillSlot(slot, st, order)
			end
		end
	end

	-- Полоса вместимости: зелёная -&gt; жёлтая -&gt; красная
	local ratio = math.clamp(State.BagUsed / math.max(1, State.BagMax), 0, 1)
	local barColor = (ratio &gt;= CFG.FullRatio and CFG.BarFull) or (ratio &gt;= CFG.WarnRatio and CFG.BarWarn) or CFG.BarOk
	TweenService:Create(barFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(ratio, 1),
		BackgroundColor3 = barColor,
	}):Play()
	barFill.Visible = ratio &gt; 0.001
	barText.Text = string.format("%d / %d%s", State.BagUsed, State.BagMax, ratio &gt;= 1 and "  ·  ПОЛНЫЙ!" or "")

	local empty = #stacks == 0
	hint.Visible = empty
	hintSub.Visible = empty

	local bagName = GameConfig.RU_NAMES.Backpacks[State.BackpackLevel] or ""
	local penalty = math.floor(GameConfig.GetDirtPenalty(State.DirtBlocks) * 100 + 0.5)
	subtitle.Text = bagName .. (penalty &gt; 0 and string.format("  ·  грязь: −%d%% мест", penalty) or "  ·  чистый")
	footer.Text = empty and "Руда продаётся в зоне $ SELL на поверхности"
		or string.format("💰 Всё содержимое стоит %s 🪙 — продай в зоне $ SELL", UIKit.FormatCoins(State.BagValue))
end

-- ---------------------------------------------------------------------------
-- Открытие / закрытие
-- ---------------------------------------------------------------------------
local function closeBag()
	if not IsOpen then
		return
	end
	IsOpen = false
	OpenToken += 1
	local token = OpenToken
	ClientBus.SetWindowOpen("Bag", false)
	spinner.Stop()
	UIKit.StopTweens(ActiveTweens)
	winScale:SetAttribute("Animating", true)
	TweenService:Create(dim, TweenInfo.new(UI.CloseSeconds), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(winScale, TweenInfo.new(UI.CloseSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Scale = ((winScale:GetAttribute("Fit") :: number?) or 1) * 0.7,
	}):Play()
	task.delay(UI.CloseSeconds, function()
		if token == OpenToken then
			gui.Enabled = false
			winScale:SetAttribute("Animating", nil)
		end
	end)
end

local function openBag()
	if IsOpen then
		return
	end
	pcall(InputBlocker.CloseAllMenus)
	IsOpen = true
	OpenToken += 1
	local token = OpenToken
	ClientBus.SetWindowOpen("Bag", true)
	gui.Enabled = true
	refresh()
	registerEffects()

	local fit = (winScale:GetAttribute("Fit") :: number?) or 1
	winScale:SetAttribute("Animating", true)
	winScale.Scale = fit * 0.6
	dim.BackgroundTransparency = 1
	TweenService:Create(dim, TweenInfo.new(UI.OpenSeconds), { BackgroundTransparency = 0.45 }):Play()
	local tw = TweenService:Create(winScale, TweenInfo.new(UI.OpenSeconds, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fit })
	tw:Play()
	tw.Completed:Once(function()
		if token == OpenToken then
			winScale:SetAttribute("Animating", nil)
			winScale.Scale = (winScale:GetAttribute("Fit") :: number?) or fit
		end
	end)
	UIKit.PlaySfx("Open")
	spinner.Start()
end

closeBtn.Activated:Connect(function()
	UIKit.PlaySfx("Click")
	closeBag()
end)
dim.Activated:Connect(closeBag)
UserInputService.InputBegan:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.Escape and IsOpen then
		closeBag()
	end
end)

ClientBus.ToggleBag.Event:Connect(function()
	if IsOpen then
		closeBag()
	else
		openBag()
	end
end)
ClientBus.CloseAll.Event:Connect(closeBag)
ClientBus.OpenShop.Event:Connect(closeBag) -- открыли магазин — рюкзак закрывается

SyncPlayerData.OnClientEvent:Connect(function(data: any)
	if type(data) ~= "table" then
		return
	end
	if type(data.Inventory) == "table" then
		State.Inventory = data.Inventory
	end
	if type(data.MorningInventory) == "table" then
		State.MorningInventory = data.MorningInventory
	end
	State.BagUsed = tonumber(data.BagUsed) or 0
	State.BagMax = tonumber(data.BagMax) or State.BagMax
	State.BagValue = tonumber(data.BagValue) or 0
	State.BackpackLevel = tonumber(data.BackpackLevel) or State.BackpackLevel
	State.DirtBlocks = tonumber(data.DirtBlocks) or 0
	if IsOpen then
		refresh()
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">BoostShopUI</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- ⚡ КЛИЕНТ: BoostShopUI (StarterPlayerScripts.BoostShopUI)
-- v52: окно бустов (Удача / Скорость / Монеты). Открывается вкладкой «⚡ Бусты»
-- в обычном меню магазина (ClientController) — сам магазин кирок и рюкзаков остался прежним.
--   • Карточки с рамкой цвета буста, диагональным бликом, мерцающими «✦» и «попом» при наведении.
--   • Кнопка «🪙 Цена» / «ПРОДЛИТЬ · 🪙 Цена»; на карточке — живой остаток активного буста.
--   • Не хватает монет — тряска карточки, красный тост и звук ошибки.
--     Покупка — зелёная вспышка, конфетти и звук успеха.
--   • Плавное открытие (Back); закрытие — крестик, клик мимо окна, Esc или уход с площадки магазина.
-- Клиент только отправляет запрос (Remote ShopAction) — цену, монеты, расстояние и кулдаун
-- проверяет сервер (ShopService). Анимации работают только пока окно открыто.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
if not player then
	return
end

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local UIKit = require(Modules:WaitForChild("UIKit"))
local ClientBus = require(Modules:WaitForChild("ClientBus"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SyncPlayerData = Remotes:WaitForChild("SyncPlayerData") :: RemoteEvent
local ShopAction = Remotes:WaitForChild("ShopAction") :: RemoteEvent
local ShopResult = Remotes:WaitForChild("ShopResult") :: RemoteEvent

local UI = GameConfig.UI
local CFG = GameConfig.SHOP_UI
local WIN = CFG.WindowSize
local CARD = CFG.CardSize

type Card = {
	Body: Frame,
	Line1: TextLabel,
	Button: TextButton,
	ButtonGrad: UIGradient,
	Shine: UIGradient,
	Twinkles: { TextLabel },
	Id: string,
}

local Coins = 0
local IsOpen = false
local OpenToken = 0
local Cards: { Card } = {}
local ActiveTweens: { Tween } = {}

-- ---------------------------------------------------------------------------
-- Каркас окна
-- ---------------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "BoostShopV52"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 30
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Enabled = false
gui.Parent = playerGui

-- Затемнение: клик мимо окна закрывает его
local dim = Instance.new("TextButton")
dim.Name = "Dim"
dim.Size = UDim2.fromScale(1, 1)
dim.BackgroundColor3 = Color3.new(0, 0, 0)
dim.BackgroundTransparency = 1
dim.BorderSizePixel = 0
dim.AutoButtonColor = false
dim.Text = ""
dim.Parent = gui

local window = UIKit.Frame(gui, "Window", UDim2.fromOffset(WIN.X, WIN.Y), UDim2.fromScale(0.5, 0.5), Color3.new(1, 1, 1))
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Active = true -- окно «съедает» клики, чтобы они не закрывали его
window.ZIndex = 2
UIKit.Corner(window, 22)
UIKit.Gradient(window, UI.BgTop, UI.BgBottom, 90)
local windowStroke = UIKit.Stroke(window, Color3.new(1, 1, 1), 3)
UIKit.Gradient(windowStroke, UI.Gold, UI.Purple, 35)
local winScale = Instance.new("UIScale")
winScale.Parent = window
UIKit.BindScale(winScale, WIN.X, WIN.Y, 1.1)

-- Слой эффектов (тосты и конфетти) — отдельный всегда включённый ScreenGui поверх окна
local fxGui = Instance.new("ScreenGui")
fxGui.Name = "BoostShopV52Fx"
fxGui.ResetOnSpawn = false
fxGui.IgnoreGuiInset = true
fxGui.DisplayOrder = 40
fxGui.Parent = playerGui
local fxLayer = UIKit.Frame(fxGui, "FxLayer", UDim2.fromScale(1, 1), UDim2.new(), nil, 1)
fxLayer.Active = false

UIKit.Label(window, {
	Name = "Title", Text = "⚡ БУСТЫ", Size = UDim2.new(0, 300, 0, 40), Position = UDim2.fromOffset(24, 14),
	Font = UI.FontTitle, TextSize = 28, XAlign = Enum.TextXAlignment.Left, Color = UI.Gold, Stroke = true, ZIndex = 3,
})
UIKit.Label(window, {
	Name = "Subtitle", Text = "Повторная покупка продлевает буст", Size = UDim2.new(0, 340, 0, 16), Position = UDim2.fromOffset(26, 50),
	TextSize = 12, XAlign = Enum.TextXAlignment.Left, Color = UI.TextDim, ZIndex = 3,
})

local coinsPill = UIKit.Frame(window, "Coins", UDim2.fromOffset(200, 40), UDim2.new(1, -268, 0, 16), UI.Panel)
coinsPill.ZIndex = 3
UIKit.Corner(coinsPill, 20)
UIKit.Stroke(coinsPill, UI.Gold, 2, 0.2)
local coinsLabel = UIKit.Label(coinsPill, {
	Name = "Value", Text = "🪙 0", Font = UI.FontBlack, TextSize = 19, Color = UI.Gold, ZIndex = 4,
})

local closeBtn = UIKit.Button(window, "Close", "✕", UDim2.fromOffset(40, 40), UDim2.new(1, -56, 0, 16), UI.Red, UI.RedDark)
closeBtn.TextSize = 20
closeBtn.ZIndex = 4

local row = UIKit.Frame(window, "Cards", UDim2.new(1, -40, 0, CARD.Y), UDim2.fromOffset(20, 84), nil, 1)
row.ZIndex = 3
local rowLayout = Instance.new("UIListLayout")
rowLayout.FillDirection = Enum.FillDirection.Horizontal
rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
rowLayout.Padding = UDim.new(0, 16)
rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
rowLayout.Parent = row

-- ---------------------------------------------------------------------------
-- Карточки бустов
-- ---------------------------------------------------------------------------
local function boostRemaining(id: string): number
	local endsAt = player:GetAttribute("Boost_" .. id .. "_EndsAt")
	if type(endsAt) ~= "number" then
		return 0
	end
	return math.max(0, endsAt - workspace:GetServerTimeNow())
end

local function failFeedback(card: Card?, message: string)
	UIKit.PlaySfx("Error")
	UIKit.Toast(fxLayer, message, UI.Red)
	if card then
		UIKit.Shake(card.Body)
		UIKit.Flash(card.Body, UI.Red, 16)
	end
end

local function makeCard(cfg: any, order: number, rng: Random): Card
	local rarity = GameConfig.RARITY[cfg.Rarity] or GameConfig.RARITY[1]
	local color: Color3 = cfg.Color

	-- внешний кадр держит место в ряду, внутренний «Body» можно трясти и масштабировать
	local root = UIKit.Frame(row, "Card_" .. cfg.Id, UDim2.fromOffset(CARD.X, CARD.Y), UDim2.new(), nil, 1)
	root.LayoutOrder = order
	root.ZIndex = 3
	local body = UIKit.Frame(root, "Body", UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0.5), Color3.new(1, 1, 1))
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.ZIndex = 3
	UIKit.Corner(body, 16)
	UIKit.Gradient(body, UI.PanelLight:Lerp(color, 0.12), UI.BgBottom, 90)
	local stroke = UIKit.Stroke(body, Color3.new(1, 1, 1), 2.5, 0.15)
	UIKit.Gradient(stroke, color:Lerp(Color3.new(1, 1, 1), 0.35), color:Lerp(Color3.new(0, 0, 0), 0.25), 60)
	local scale = Instance.new("UIScale")
	scale.Parent = body

	local preview = UIKit.Frame(body, "Preview", UDim2.new(1, -20, 0, 118), UDim2.fromOffset(10, 10), Color3.new(1, 1, 1))
	preview.ZIndex = 4
	UIKit.Corner(preview, 12)
	UIKit.Gradient(preview, color:Lerp(UI.BgBottom, 0.55), UI.BgBottom, 90)

	local function tag(text: string, right: boolean)
		local t = UIKit.Frame(preview, right and "MultTag" or "RarityTag", UDim2.fromOffset(right and 54 or 96, 18),
			right and UDim2.new(1, -60, 0, 6) or UDim2.fromOffset(6, 6), color:Lerp(Color3.new(0, 0, 0), 0.45))
		t.ZIndex = 8
		UIKit.Corner(t, 9)
		UIKit.Label(t, { Text = text, Font = UI.FontBlack, TextSize = 10, Color = color:Lerp(Color3.new(1, 1, 1), 0.6), ZIndex = 9 })
	end
	tag(rarity.Name, false)
	tag("×" .. tostring(cfg.Multiplier), true)

	-- крупная иконка в светящемся круге
	local halo = UIKit.Frame(preview, "Halo", UDim2.fromOffset(84, 84), UDim2.new(0.5, -42, 0.5, -36), color, 0.55)
	halo.ZIndex = 5
	UIKit.Corner(halo, 42)
	UIKit.Stroke(halo, color:Lerp(Color3.new(1, 1, 1), 0.4), 2, 0.2)
	UIKit.Label(halo, { Text = cfg.Icon, TextSize = 46, ZIndex = 6 })

	UIKit.Label(body, {
		Name = "Title", Text = cfg.Name .. " ×" .. tostring(cfg.Multiplier), Size = UDim2.new(1, -16, 0, 22),
		Position = UDim2.fromOffset(8, 134), Font = UI.FontBlack, TextSize = 15, Color = color:Lerp(Color3.new(1, 1, 1), 0.55), ZIndex = 5,
	})
	local line1 = UIKit.Label(body, {
		Name = "Line1", Size = UDim2.new(1, -16, 0, 18), Position = UDim2.fromOffset(8, 160), TextSize = 13, ZIndex = 5,
	})
	UIKit.Label(body, {
		Name = "Line2", Text = cfg.Desc, Size = UDim2.new(1, -16, 0, 32), Position = UDim2.fromOffset(8, 180), TextSize = 12,
		Color = UI.TextDim, Wrapped = true, YAlign = Enum.TextYAlignment.Top, ZIndex = 5,
	})

	local button, buttonGrad = UIKit.Button(body, "Action", "", UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 1, -50), UI.Gold, Color3.fromRGB(214, 130, 20))
	button.ZIndex = 6

	local twinkles = UIKit.AddTwinkles(preview, 3, color, rng, 7)
	local shine = UIKit.AddShine(body, 16, 9)

	-- наведение: плавный «поп» и более яркая рамка
	body.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = UI.HoverScale }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.16), { Thickness = 4, Transparency = 0 }):Play()
	end)
	body.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		TweenService:Create(stroke, TweenInfo.new(0.16), { Thickness = 2.5, Transparency = 0.15 }):Play()
	end)

	local card: Card = {
		Body = body, Line1 = line1, Button = button, ButtonGrad = buttonGrad, Shine = shine, Twinkles = twinkles, Id = cfg.Id,
	}
	button.Activated:Connect(function()
		if Coins &lt; cfg.Price then
			failFeedback(card, string.format("Не хватает монет! Нужно ещё %s 🪙", UIKit.FormatCoins(cfg.Price - Coins)))
			return
		end
		UIKit.PlaySfx("Click")
		ShopAction:FireServer("BuyBoost", cfg.Id)
	end)
	return card
end

do
	local rng = Random.new(5203)
	local order = 0
	for _, id in ipairs(GameConfig.BOOSTS.Order) do
		local cfg = GameConfig.BOOSTS.Items[id]
		if cfg and cfg.InShop then
			order += 1
			table.insert(Cards, makeCard(cfg, order, rng))
		end
	end
end

local function refresh()
	coinsLabel.Text = "🪙 " .. UIKit.FormatCoins(Coins)
	for _, card in ipairs(Cards) do
		local cfg = GameConfig.BOOSTS.Items[card.Id]
		local left = boostRemaining(card.Id)
		local price = "🪙 " .. UIKit.FormatCoins(cfg.Price)
		if left &gt; 0 then
			card.Line1.Text = "✅ Активен: " .. UIKit.FormatTime(left)
			card.Line1.TextColor3 = UI.Green
			price = "ПРОДЛИТЬ · " .. price
		else
			card.Line1.Text = "⏱ " .. UIKit.FormatTime(cfg.Duration) .. " за покупку"
			card.Line1.TextColor3 = UI.Text
		end
		card.Button.Text = price
		if Coins &gt;= cfg.Price then
			card.ButtonGrad.Color = ColorSequence.new(UI.Gold, Color3.fromRGB(214, 130, 20))
			card.Button.TextColor3 = Color3.new(1, 1, 1)
		else
			card.ButtonGrad.Color = ColorSequence.new(Color3.fromRGB(120, 108, 92), Color3.fromRGB(70, 60, 56))
			card.Button.TextColor3 = Color3.fromRGB(255, 190, 180)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Открытие / закрытие
-- ---------------------------------------------------------------------------
local function distanceToShop(): number
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return math.huge
	end
	local c = GameConfig.GREEN_SHOP_PAD_POS
	return Vector3.new(root.Position.X - c.X, 0, root.Position.Z - c.Z).Magnitude
end

local function closeWindow()
	if not IsOpen then
		return
	end
	IsOpen = false
	OpenToken += 1
	local token = OpenToken
	ClientBus.SetWindowOpen("Boosts", false)
	UIKit.StopTweens(ActiveTweens)
	winScale:SetAttribute("Animating", true)
	TweenService:Create(dim, TweenInfo.new(UI.CloseSeconds), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(winScale, TweenInfo.new(UI.CloseSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Scale = ((winScale:GetAttribute("Fit") :: number?) or 1) * 0.7,
	}):Play()
	task.delay(UI.CloseSeconds, function()
		if token == OpenToken then
			gui.Enabled = false
			winScale:SetAttribute("Animating", nil)
		end
	end)
end

local function openWindow()
	if IsOpen then
		return
	end
	if distanceToShop() &gt; CFG.AutoCloseDistance then
		UIKit.PlaySfx("Error")
		UIKit.Toast(fxLayer, "Бусты продаются в магазине — подойди к нему!", UI.Red)
		return
	end
	IsOpen = true
	OpenToken += 1
	local token = OpenToken
	ClientBus.SetWindowOpen("Boosts", true)
	gui.Enabled = true
	refresh()
	for _, card in ipairs(Cards) do
		UIKit.StartTwinkles(card.Twinkles, ActiveTweens)
	end

	-- плавное открытие: окно «выпрыгивает» с Back-смягчением
	local fit = (winScale:GetAttribute("Fit") :: number?) or 1
	winScale:SetAttribute("Animating", true)
	winScale.Scale = fit * 0.6
	dim.BackgroundTransparency = 1
	TweenService:Create(dim, TweenInfo.new(UI.OpenSeconds), { BackgroundTransparency = 0.45 }):Play()
	local tw = TweenService:Create(winScale, TweenInfo.new(UI.OpenSeconds, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fit })
	tw:Play()
	tw.Completed:Once(function()
		if token == OpenToken then
			winScale:SetAttribute("Animating", nil)
			winScale.Scale = (winScale:GetAttribute("Fit") :: number?) or fit
		end
	end)
	UIKit.PlaySfx("Open")

	-- один лёгкий цикл, пока окно открыто: остаток бустов, блики, уход с площадки магазина
	task.spawn(function()
		local sinceShine = UI.ShineInterval - 0.5
		while IsOpen and token == OpenToken do
			task.wait(0.25)
			if not IsOpen or token ~= OpenToken then
				break
			end
			if distanceToShop() &gt; CFG.AutoCloseDistance then
				closeWindow()
				break
			end
			refresh()
			sinceShine += 0.25
			if sinceShine &gt;= UI.ShineInterval then
				sinceShine = 0
				for i, card in ipairs(Cards) do
					UIKit.PlayShine(card.Shine, (i - 1) * 0.08)
				end
			end
		end
	end)
end

closeBtn.Activated:Connect(function()
	UIKit.PlaySfx("Click")
	closeWindow()
end)
dim.Activated:Connect(closeWindow)
UserInputService.InputBegan:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.Escape and IsOpen then
		closeWindow()
	end
end)

ClientBus.OpenShop.Event:Connect(openWindow)
ClientBus.CloseShop.Event:Connect(closeWindow)
ClientBus.CloseAll.Event:Connect(closeWindow)
ClientBus.ToggleBag.Event:Connect(closeWindow) -- открыли рюкзак — окно бустов закрывается

-- ---------------------------------------------------------------------------
-- Данные и ответы сервера
-- ---------------------------------------------------------------------------
SyncPlayerData.OnClientEvent:Connect(function(data: any)
	if type(data) ~= "table" then
		return
	end
	Coins = tonumber(data.Coins) or Coins
	if IsOpen then
		refresh()
	end
end)

ShopResult.OnClientEvent:Connect(function(ok: any, action: any, info: any)
	if action ~= "BuyBoost" or type(info) ~= "table" then
		return
	end
	local found: Card? = nil
	for _, card in ipairs(Cards) do
		if card.Id == info.Id then
			found = card
		end
	end
	local cfg = GameConfig.BOOSTS.Items[tostring(info.Id)]
	if ok == true and cfg then
		UIKit.PlaySfx("Success")
		UIKit.Toast(fxLayer, string.format("%s %s ×%s — осталось %s", cfg.Icon, cfg.Name, tostring(cfg.Multiplier),
			UIKit.FormatTime(tonumber(info.Remaining) or cfg.Duration)), UI.Green)
		if found then
			UIKit.Flash(found.Body, UI.Green, 16)
			local center = found.Body.AbsolutePosition + found.Body.AbsoluteSize / 2 - fxLayer.AbsolutePosition
			UIKit.Confetti(fxLayer, center, { UI.Gold, UI.Green, Color3.new(1, 1, 1), UI.Blue }, 18)
		end
	elseif info.Reason == "Far" then
		failFeedback(nil, "Подойди ближе к магазину!")
	else
		failFeedback(found, "Не хватает монет!")
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">NightFX</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🌙 КЛИЕНТ: NightFX (StarterPlayerScripts.NightFX)
-- v52: всё, что игрок ВИДИТ при смене дня и ночи.
--   • Небо идёт вместе с фазой: днём солнце проходит путь от утра до вечера, ночная фаза
--     всегда под ночным небом, рассвет наступает с открытием шахты.
--   • Плавный переход освещения: Bloom, оттенок цветокоррекции и «доля ночи»
--     Lighting.NightBlend (по ней ClientController смешивает яркость, Ambient и атмосферу).
--   • Баннеры: «🌙 НОЧЬ НАСТУПИЛА — вы на базе», «☀️ ШАХТА ОТКРЫТА», предупреждение нарушителю.
--   • Большая стена у входа в шахту: подъём и опускание за 2–3 секунды, гул, пыль у
--     основания, лёгкая тряска камеры у тех, кто рядом, пульсирующие красные руны.
--   • Живой обратный отсчёт «Откроется через: 0:42» на обеих сторонах стены.
-- Состояние задаёт сервер: атрибуты ReplicatedStorage (Phase, PhaseEndsAt) и атрибут
-- Raised у модели стены. Клиент только анимирует. Покадровых циклов нет: твины и
-- редкие task.wait; отсчёт идёт только ночью.
-- ============================================================================

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
if not player then
	return
end

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local UIKit = require(Modules:WaitForChild("UIKit"))

local NightNotice = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("NightNotice") :: RemoteEvent

local UI = GameConfig.UI
local P = GameConfig.PHASE
local FX = GameConfig.NIGHT_FX
local PL = GameConfig.PHASE_LIGHTING
local rng = Random.new()

local function isNightPhase(): boolean
	return ReplicatedStorage:GetAttribute(P.AttrPhase) == "Night"
end

-- ---------------------------------------------------------------------------
-- 1. Освещение: доля ночи 0..1 в Lighting.NightBlend + небо, Bloom, оттенок
-- ---------------------------------------------------------------------------
local existingBlend = Lighting:FindFirstChild("NightBlend")
local blend: NumberValue
if existingBlend and existingBlend:IsA("NumberValue") then
	blend = existingBlend
else
	local created = Instance.new("NumberValue")
	created.Name = "NightBlend"
	created.Parent = Lighting
	blend = created
end

local BlendTween: Tween? = nil

-- Доля ночи 0..1 управляет Bloom и оттенком картинки (яркость, Ambient и атмосферу по ней же
-- смешивает ClientController)
local function applyBlend(b: number)
	local bloom = Lighting:FindFirstChild("NeonBloom")
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Intensity = PL.Day.BloomIntensity + (PL.Night.BloomIntensity - PL.Day.BloomIntensity) * b
		bloom.Size = PL.Day.BloomSize + (PL.Night.BloomSize - PL.Day.BloomSize) * b
	end
	local cc = Lighting:FindFirstChild("ModernColorCorrection")
	if cc and cc:IsA("ColorCorrectionEffect") then
		cc.TintColor = PL.Day.Tint:Lerp(PL.Night.Tint, b)
	end
end
blend.Changed:Connect(applyBlend)

local function setLighting(night: boolean, instant: boolean)
	if BlendTween then
		BlendTween:Cancel()
		BlendTween = nil
	end
	local target = night and 1 or 0
	if instant then
		blend.Value = target
		applyBlend(target)
		return
	end
	local tw = TweenService:Create(blend, TweenInfo.new(P.LightingTweenSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = target })
	BlendTween = tw
	tw:Play()
end

-- Часы неба идут вместе с фазой: день — от утра (ClockStart) до вечера (ClockEnd), ночная фаза —
-- всегда под ночным небом (21:00 -&gt; 04:00), рассвет приходит с открытием шахты. Движение — это
-- несколько длинных линейных твинов Lighting.ClockTime на фазу, без покадрового кода.
local SkyToken = 0
local SkyTween: Tween? = nil

-- Ведёт часы вперёд до toHours (значение больше 24 означает «после полуночи») за seconds секунд.
-- Возвращает false, если за это время фаза сменилась.
local function advanceClock(toHours: number, seconds: number, token: number): boolean
	local function tweenTo(target: number, duration: number)
		local tw = TweenService:Create(Lighting, TweenInfo.new(duration, Enum.EasingStyle.Linear), { ClockTime = target })
		SkyTween = tw
		tw:Play()
		task.wait(duration)
	end
	local from = Lighting.ClockTime
	local to = toHours % 24
	if seconds &lt;= 0.05 then
		Lighting.ClockTime = to
	elseif to &gt;= from or (from - to) &lt; 1 then
		tweenTo(to, seconds)
	else
		-- путь лежит через полночь: до 24:00, затем с 00:00
		local total = (24 - from) + to
		local first = seconds * (24 - from) / total
		tweenTo(23.99, first)
		if token ~= SkyToken then
			return false
		end
		Lighting.ClockTime = 0
		tweenTo(to, seconds - first)
	end
	return token == SkyToken
end

local function runSky(phase: string, instant: boolean)
	SkyToken += 1
	local token = SkyToken
	if SkyTween then
		SkyTween:Cancel()
		SkyTween = nil
	end
	local endsAt = ReplicatedStorage:GetAttribute(P.AttrEndsAt)
	local length = ReplicatedStorage:GetAttribute(P.AttrLength)
	if type(endsAt) ~= "number" or type(length) ~= "number" then
		return
	end
	local cfg = phase == "Night" and PL.Night or PL.Day
	-- положение часов неба в момент серверного времени t
	local function clockAt(t: number): number
		local frac = math.clamp(1 - (endsAt - t) / math.max(1, length), 0, 1)
		return cfg.ClockStart + (cfg.ClockEnd - cfg.ClockStart) * frac
	end
	task.spawn(function()
		local now = Workspace:GetServerTimeNow()
		if instant then
			Lighting.ClockTime = clockAt(now) % 24
		else
			-- смена фазы: закат или рассвет «прокручивается» за время перехода освещения
			local lead = math.clamp(endsAt - now, 0, P.LightingTweenSeconds)
			if not advanceClock(clockAt(now + lead), lead, token) then
				return
			end
		end
		local remaining = endsAt - Workspace:GetServerTimeNow()
		if remaining &gt; 0.1 then
			advanceClock(cfg.ClockEnd, remaining, token)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- 2. Баннер сверху по центру
-- ---------------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "NightFxV52"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 25
gui.Parent = playerGui

local banner = UIKit.Frame(gui, "Banner", UDim2.fromOffset(600, 92), UDim2.new(0.5, 0, 0, -140), Color3.new(1, 1, 1))
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.Visible = false
UIKit.Corner(banner, 22)
local bannerGrad = UIKit.Gradient(banner, UI.BgTop, UI.BgBottom, 90)
local bannerStroke = UIKit.Stroke(banner, UI.Gold, 3.5)
local bannerScale = Instance.new("UIScale")
bannerScale.Parent = banner
local bannerGloss = UIKit.Frame(banner, "Gloss", UDim2.new(1, -16, 0.4, 0), UDim2.fromOffset(8, 5), Color3.new(1, 1, 1), 0.88)
UIKit.Corner(bannerGloss, 16)
local bannerTitle = UIKit.Label(banner, {
	Name = "Title", Size = UDim2.new(1, -28, 0, 40), Position = UDim2.fromOffset(14, 10),
	Font = UI.FontBlack, TextSize = 27, Scaled = true, Stroke = true, ZIndex = 2,
})
local titleLimit = Instance.new("UITextSizeConstraint")
titleLimit.MaxTextSize = 28
titleLimit.Parent = bannerTitle
local bannerSub = UIKit.Label(banner, {
	Name = "Sub", Size = UDim2.new(1, -28, 0, 26), Position = UDim2.fromOffset(14, 54),
	TextSize = 16, Color = Color3.fromRGB(240, 240, 255), Scaled = true, ZIndex = 2,
})
local subLimit = Instance.new("UITextSizeConstraint")
subLimit.MaxTextSize = 17
subLimit.Parent = bannerSub
local bannerShine = UIKit.AddShine(banner, 22, 3)

local BannerToken = 0

local function showBanner(kind: string, subOverride: string?)
	local cfg = (FX.Banners :: any)[kind]
	if not cfg then
		return
	end
	BannerToken += 1
	local token = BannerToken
	bannerTitle.Text = cfg.Title
	bannerSub.Text = subOverride or cfg.Sub
	bannerGrad.Color = ColorSequence.new(cfg.Top, cfg.Bottom)
	bannerStroke.Color = cfg.Stroke
	bannerScale.Scale = math.clamp(UIKit.ViewportSize().X / 660, 0.5, 1.1)
	banner.Position = UDim2.new(0.5, 0, 0, -140)
	banner.Visible = true
	TweenService:Create(banner, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 162),
	}):Play()
	UIKit.PlayShine(bannerShine, 0.35)
	task.delay(P.BannerSeconds, function()
		if token ~= BannerToken then
			return
		end
		local out = TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, 0, 0, -140),
		})
		out:Play()
		out.Completed:Wait()
		if token == BannerToken then
			banner.Visible = false
		end
	end)
end

-- ---------------------------------------------------------------------------
-- 3. Стена у входа в шахту: анимация, пыль, гул, тряска, руны
-- ---------------------------------------------------------------------------
local Wall: Model? = nil
local WallToken = 0
local RuneTweens: { Tween } = {}
local RumbleSound: Sound? = nil
local SlamSound: Sound? = nil

local function wallSound(parent: Instance, key: string, existing: Sound?): Sound?
	if existing and existing.Parent then
		return existing
	end
	local cfg = GameConfig.SFX[key]
	if not cfg then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "V52_" .. key
	s.SoundId = cfg.Id
	s.Volume = cfg.Volume
	s.PlaybackSpeed = cfg.Pitch
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 30
	s.RollOffMaxDistance = 220
	s.Parent = parent
	return s
end

local function setRunesPulsing(on: boolean)
	UIKit.StopTweens(RuneTweens)
	for _, rune in ipairs(CollectionService:GetTagged("NightWallRune")) do
		if rune:IsA("BasePart") then
			if on then
				rune.Color = FX.RuneDim
				local tw = TweenService:Create(
					rune,
					TweenInfo.new(FX.RunePulseSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, rng:NextNumber(0, 0.3)),
					{ Color = FX.RuneBright }
				)
				tw:Play()
				table.insert(RuneTweens, tw)
			else
				rune.Color = FX.RuneDim
			end
		end
	end
end

-- Лёгкая тряска камеры через Humanoid.CameraOffset (только на время движения стены и только рядом)
local function shakeNearWall(wallPos: Vector3, seconds: number, token: number)
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 &lt; seconds and token == WallToken do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and root and root:IsA("BasePart") then
				local dist = (root.Position - wallPos).Magnitude
				local k = math.clamp(1 - dist / FX.ShakeDistance, 0, 1) * FX.ShakeStrength
				if k &gt; 0.01 then
					TweenService:Create(hum, TweenInfo.new(0.07, Enum.EasingStyle.Linear), {
						CameraOffset = Vector3.new(rng:NextNumber(-k, k), rng:NextNumber(-k, k), 0),
					}):Play()
				end
			end
			task.wait(0.08)
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then
			TweenService:Create(hum, TweenInfo.new(0.2), { CameraOffset = Vector3.zero }):Play()
		end
	end)
end

local function wallPoses(wall: Model): (BasePart?, CFrame?, CFrame?)
	local root = wall.PrimaryPart or wall:FindFirstChild("Root")
	local up = wall:GetAttribute("UpCFrame")
	local down = wall:GetAttribute("DownCFrame")
	if root and root:IsA("BasePart") and typeof(up) == "CFrame" and typeof(down) == "CFrame" then
		return root, up, down
	end
	return nil, nil, nil
end

local function animateWall(wall: Model, raised: boolean, instant: boolean)
	WallToken += 1
	local token = WallToken
	local root, up, down = wallPoses(wall)
	if not root or not up or not down then
		return
	end
	local target = raised and up or down
	setRunesPulsing(raised)
	if instant then
		root.CFrame = target
		return
	end

	local seconds = tonumber(wall:GetAttribute("LiftSeconds")) or 2.6
	local info = raised
		and TweenInfo.new(seconds, FX.RiseEasing, Enum.EasingDirection.Out)
		or TweenInfo.new(seconds, FX.LowerEasing, Enum.EasingDirection.In)
	TweenService:Create(root, info, { CFrame = target }):Play()

	-- пыль у основания: залп в начале и поток на время движения
	local dust: { ParticleEmitter } = {}
	for _, e in ipairs(CollectionService:GetTagged("NightWallDust")) do
		if e:IsA("ParticleEmitter") and e:IsDescendantOf(wall.Parent or Workspace) then
			e:Emit(FX.DustBurst)
			e.Enabled = true
			table.insert(dust, e)
		end
	end

	-- гул и финальный удар (звук идёт от стены и затухает с расстоянием)
	local soundHost = wall:FindFirstChild("DustBase", true) or root
	RumbleSound = wallSound(soundHost, "WallRumble", RumbleSound)
	SlamSound = wallSound(soundHost, "WallSlam", SlamSound)
	if RumbleSound then
		RumbleSound:Play()
	end
	shakeNearWall(up.Position, seconds, token)

	task.delay(seconds, function()
		for _, e in ipairs(dust) do
			if e.Parent then
				e.Enabled = false
			end
		end
		if token ~= WallToken then
			return
		end
		if SlamSound then
			SlamSound:Play()
		end
		for _, e in ipairs(dust) do
			if e.Parent then
				e:Emit(math.floor(FX.DustBurst / 2))
			end
		end
	end)
end

local function hookWall(inst: Instance)
	if not inst:IsA("Model") or Wall == inst then
		return
	end
	Wall = inst
	-- при входе в игру стена сразу встаёт в правильную позу (без анимации)
	task.defer(function()
		animateWall(inst, inst:GetAttribute("Raised") == true, true)
	end)
	inst:GetAttributeChangedSignal("Raised"):Connect(function()
		animateWall(inst, inst:GetAttribute("Raised") == true, false)
	end)
end
for _, inst in ipairs(CollectionService:GetTagged("NightMineWall")) do
	hookWall(inst)
end
CollectionService:GetInstanceAddedSignal("NightMineWall"):Connect(hookWall)
-- руны могут прогрузиться позже самой модели — подхватываем их в текущем состоянии
CollectionService:GetInstanceAddedSignal("NightWallRune"):Connect(function(rune: Instance)
	local wall = Wall
	if wall and wall:GetAttribute("Raised") == true and rune:IsA("BasePart") then
		local tw = TweenService:Create(
			rune,
			TweenInfo.new(FX.RunePulseSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Color = FX.RuneBright }
		)
		tw:Play()
		table.insert(RuneTweens, tw)
	end
end)

-- ---------------------------------------------------------------------------
-- 4. Обратный отсчёт на стене (только ночью, 4 раза в секунду)
-- ---------------------------------------------------------------------------
local CountdownToken = 0

local function runCountdown()
	CountdownToken += 1
	local token = CountdownToken
	task.spawn(function()
		local lastText = ""
		while token == CountdownToken and isNightPhase() do
			local endsAt = ReplicatedStorage:GetAttribute(P.AttrEndsAt)
			local remaining = (type(endsAt) == "number") and math.max(0, endsAt - Workspace:GetServerTimeNow()) or 0
			local text = FX.CountdownPrefix .. UIKit.FormatTime(remaining, false)
			if text ~= lastText then
				lastText = text
				for _, lbl in ipairs(CollectionService:GetTagged("NightWallCountdown")) do
					if lbl:IsA("TextLabel") then
						lbl.Text = text
					end
				end
			end
			task.wait(0.25)
		end
	end)
end

-- ---------------------------------------------------------------------------
-- 5. Реакция на фазу и уведомления сервера
-- ---------------------------------------------------------------------------
local PhaseKnown = false

local function onPhaseChanged()
	local phase = ReplicatedStorage:GetAttribute(P.AttrPhase)
	if type(phase) ~= "string" then
		return
	end
	local night = phase == "Night"
	local first = not PhaseKnown
	PhaseKnown = true
	setLighting(night, first)
	runSky(phase, first)
	if night then
		runCountdown()
		if first then
			showBanner("NightJoin") -- игрок зашёл посреди ночи
		end
	else
		CountdownToken += 1
	end
end
ReplicatedStorage:GetAttributeChangedSignal(P.AttrPhase):Connect(onPhaseChanged)
onPhaseChanged()

NightNotice.OnClientEvent:Connect(function(kind: any, veinCount: any, veinList: any)
	if kind == "Night" then
		showBanner("Night")
		UIKit.PlaySfx("PhaseBell")
	elseif kind == "Day" then
		local count = tonumber(veinCount) or 0
		if count &gt; 0 then
			showBanner("Day", string.format("Утренние жилы ×3 💰: %d (%s)", count, tostring(veinList)))
		else
			showBanner("Day")
		end
		UIKit.PlaySfx("PhaseBell")
	elseif kind == "ZoneWarn" then
		showBanner("ZoneWarn")
		UIKit.PlaySfx("Error")
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">PhaseHud</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- ⏱️ КЛИЕНТ: PhaseHud (StarterPlayerScripts.PhaseHud)
-- v52: правый нижний угол экрана.
--   • Карточка таймера День/Ночь: круглая иконка ☀️/🌙 со свечением, крупная надпись
--     «ДЕНЬ» / «НОЧЬ», подпись «до ночи» / «до дня», время мм:сс моноширинным шрифтом
--     и полоса прогресса. Янтарный градиент днём, индиго-фиолетовый ночью, плавный
--     переход между фазами; в последние 10 секунд карточка пульсирует красным.
--   • Над таймером — вертикальный список чипов активных бустов: иконка, название,
--     множитель «×2», остаток мм:сс и убывающая мини-полоса. Чип пульсирует перед
--     окончанием и плавно исчезает, когда буст закончился.
-- Клиент ничего не считает сам: фаза — атрибуты ReplicatedStorage (Phase, PhaseEndsAt,
-- PhaseLength), бусты — атрибуты игрока Boost_&lt;Id&gt;_EndsAt / Boost_&lt;Id&gt;_Total, время —
-- workspace:GetServerTimeNow(). ScreenGui не сбрасывается при возрождении.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
if not player then
	return
end

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local UIKit = require(Modules:WaitForChild("UIKit"))

local UI = GameConfig.UI
local P = GameConfig.PHASE
local HUD = GameConfig.PHASE_HUD
local BOOSTS = GameConfig.BOOSTS

local playerGui = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "PhaseHudV52"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 6
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

-- Колонка: чипы бустов сверху, карточка таймера снизу; растёт вверх от правого нижнего угла
local stack = UIKit.Frame(gui, "Stack", UDim2.fromOffset(HUD.CardSize.X, 0), UDim2.new(1, -HUD.Margin, 1, -HUD.Margin), nil, 1)
stack.AnchorPoint = Vector2.new(1, 1)
stack.AutomaticSize = Enum.AutomaticSize.Y
local stackLayout = Instance.new("UIListLayout")
stackLayout.Padding = UDim.new(0, HUD.ChipGap)
stackLayout.SortOrder = Enum.SortOrder.LayoutOrder
stackLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
stackLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
stackLayout.Parent = stack
local stackScale = Instance.new("UIScale")
stackScale.Parent = stack

-- ---------------------------------------------------------------------------
-- Карточка таймера
-- ---------------------------------------------------------------------------
local card = UIKit.Frame(stack, "PhaseCard", UDim2.fromOffset(HUD.CardSize.X, HUD.CardSize.Y), UDim2.new(), nil, 1)
card.LayoutOrder = 1000
local cardScale = Instance.new("UIScale")
cardScale.Parent = card

local function phaseLayer(name: string, style: any, transparency: number): Frame
	local layer = UIKit.Frame(card, name, UDim2.fromScale(1, 1), UDim2.new(), Color3.new(1, 1, 1), transparency)
	UIKit.Corner(layer, 20)
	UIKit.Gradient(layer, style.Top, style.Bottom, 65)
	return layer
end
local dayLayer = phaseLayer("DayLayer", HUD.Day, 0)
local nightLayer = phaseLayer("NightLayer", HUD.Night, 1)
nightLayer.ZIndex = 2

-- Рамка и блик поверх обоих слоёв
local frameLayer = UIKit.Frame(card, "Frame", UDim2.fromScale(1, 1), UDim2.new(), nil, 1)
frameLayer.ZIndex = 3
UIKit.Corner(frameLayer, 20)
local cardStroke = UIKit.Stroke(frameLayer, HUD.Day.Glow, 3)
local gloss = UIKit.Frame(card, "Gloss", UDim2.new(1, -16, 0.42, 0), UDim2.fromOffset(8, 5), Color3.new(1, 1, 1), 0.86)
gloss.ZIndex = 3
UIKit.Corner(gloss, 14)

-- Круглая иконка со свечением
local glow = UIKit.Frame(card, "IconGlow", UDim2.fromOffset(74, 74), UDim2.fromOffset(6, 3), HUD.Day.Glow, 0.72)
glow.ZIndex = 4
UIKit.Corner(glow, 37)
local iconDisc = UIKit.Frame(card, "IconDisc", UDim2.fromOffset(58, 58), UDim2.fromOffset(14, 11), Color3.fromRGB(20, 18, 40), 0.35)
iconDisc.ZIndex = 5
UIKit.Corner(iconDisc, 29)
local iconStroke = UIKit.Stroke(iconDisc, HUD.Day.Glow, 2.5)
local dayIcon = UIKit.Label(iconDisc, { Name = "DayIcon", Text = HUD.Day.Icon, TextSize = 34, ZIndex = 6 })
local nightIcon = UIKit.Label(iconDisc, { Name = "NightIcon", Text = HUD.Night.Icon, TextSize = 34, ZIndex = 6 })
nightIcon.TextTransparency = 1

local titleLabel = UIKit.Label(card, {
	Name = "Title", Text = HUD.Day.Title, Size = UDim2.fromOffset(88, 30), Position = UDim2.fromOffset(84, 10),
	Font = UI.FontBlack, TextSize = 26, XAlign = Enum.TextXAlignment.Left, Stroke = true, ZIndex = 6,
})
local subLabel = UIKit.Label(card, {
	Name = "Sub", Text = HUD.Day.Sub, Size = UDim2.fromOffset(88, 16), Position = UDim2.fromOffset(85, 42),
	TextSize = 13, XAlign = Enum.TextXAlignment.Left, Color = Color3.fromRGB(255, 244, 228), ZIndex = 6,
})
local timeLabel = UIKit.Label(card, {
	Name = "Time", Text = "--:--", Size = UDim2.fromOffset(92, 36), Position = UDim2.new(1, -104, 0, 16),
	Font = UI.FontMono, TextSize = 29, XAlign = Enum.TextXAlignment.Right, Stroke = true, ZIndex = 6,
})

local barBack = UIKit.Frame(card, "Bar", UDim2.new(1, -28, 0, 9), UDim2.new(0, 14, 1, -20), Color3.fromRGB(12, 10, 26), 0.45)
barBack.ZIndex = 5
UIKit.Corner(barBack, 5)
local barFill = UIKit.Frame(barBack, "Fill", UDim2.fromScale(1, 1), UDim2.new(), HUD.Day.Bar)
barFill.ZIndex = 6
UIKit.Corner(barFill, 5)

local CurrentPhase = ""
local WarningOn = false
local PulseTween: Tween? = nil

local function styleOf(phase: string): any
	return phase == "Night" and HUD.Night or HUD.Day
end

-- Плавная смена оформления между фазами (кроссфейд двух градиентных слоёв)
local function applyPhaseStyle(phase: string, instant: boolean)
	local style = styleOf(phase)
	local night = phase == "Night"
	local info = TweenInfo.new(instant and 0 or HUD.StyleTweenSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(nightLayer, info, { BackgroundTransparency = night and 0 or 1 }):Play()
	TweenService:Create(dayLayer, info, { BackgroundTransparency = night and 1 or 0 }):Play()
	TweenService:Create(nightIcon, info, { TextTransparency = night and 0 or 1 }):Play()
	TweenService:Create(dayIcon, info, { TextTransparency = night and 1 or 0 }):Play()
	TweenService:Create(glow, info, { BackgroundColor3 = style.Glow }):Play()
	TweenService:Create(iconStroke, info, { Color = style.Glow }):Play()
	TweenService:Create(barFill, info, { BackgroundColor3 = style.Bar }):Play()
	if not WarningOn then
		TweenService:Create(cardStroke, info, { Color = style.Glow }):Play()
	end
	titleLabel.Text = style.Title
	subLabel.Text = style.Sub
end

-- Последние секунды фазы: пульсация и предупреждающий цвет
local function setWarning(on: boolean)
	if on == WarningOn then
		return
	end
	WarningOn = on
	if PulseTween then
		PulseTween:Cancel()
		PulseTween = nil
	end
	local quick = TweenInfo.new(0.25)
	if on then
		TweenService:Create(cardStroke, quick, { Color = HUD.Warning }):Play()
		TweenService:Create(timeLabel, quick, { TextColor3 = HUD.Warning:Lerp(Color3.new(1, 1, 1), 0.55) }):Play()
		local pulse = TweenService:Create(cardScale, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.06 })
		pulse:Play()
		PulseTween = pulse
	else
		TweenService:Create(cardStroke, quick, { Color = styleOf(CurrentPhase).Glow }):Play()
		TweenService:Create(timeLabel, quick, { TextColor3 = UI.Text }):Play()
		TweenService:Create(cardScale, quick, { Scale = 1 }):Play()
	end
end

local function updatePhase()
	local phase = ReplicatedStorage:GetAttribute(P.AttrPhase)
	local endsAt = ReplicatedStorage:GetAttribute(P.AttrEndsAt)
	local length = ReplicatedStorage:GetAttribute(P.AttrLength)
	if type(phase) ~= "string" or type(endsAt) ~= "number" or type(length) ~= "number" then
		timeLabel.Text = "--:--"
		return
	end
	if phase ~= CurrentPhase then
		local first = CurrentPhase == ""
		CurrentPhase = phase
		applyPhaseStyle(phase, first)
	end
	local remaining = math.max(0, endsAt - Workspace:GetServerTimeNow())
	timeLabel.Text = UIKit.FormatTime(remaining, true)
	TweenService:Create(barFill, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {
		Size = UDim2.fromScale(math.clamp(remaining / math.max(1, length), 0, 1), 1),
	}):Play()
	setWarning(remaining &gt; 0 and remaining &lt;= P.WarningSeconds)
end

-- ---------------------------------------------------------------------------
-- Чипы бустов
-- ---------------------------------------------------------------------------
type Chip = {
	Root: Frame,
	Scale: UIScale,
	Stroke: UIStroke,
	Time: TextLabel,
	Fill: Frame,
	EndsAt: number,
	Warn: boolean,
	Pulse: Tween?,
	Color: Color3,
}

local Chips: { [string]: Chip } = {}

local function makeChip(id: string, order: number): Chip
	local cfg = BOOSTS.Items[id]
	local root = UIKit.Frame(stack, "Boost_" .. id, UDim2.fromOffset(HUD.ChipSize.X, HUD.ChipSize.Y), UDim2.new(), Color3.new(1, 1, 1))
	root.LayoutOrder = order
	UIKit.Corner(root, 15)
	UIKit.Gradient(root, UI.PanelLight:Lerp(cfg.Color, 0.28), UI.BgBottom, 80)
	local stroke = UIKit.Stroke(root, cfg.Color, 2)
	local scale = Instance.new("UIScale")
	scale.Scale = 0.6
	scale.Parent = root

	local disc = UIKit.Frame(root, "Icon", UDim2.fromOffset(34, 34), UDim2.fromOffset(6, 6), cfg.Color, 0.55)
	UIKit.Corner(disc, 17)
	UIKit.Label(disc, { Text = cfg.Icon, TextSize = 20, ZIndex = 2 })
	UIKit.Label(root, {
		Name = "Name", Text = cfg.Name, Size = UDim2.new(1, -122, 0, 18), Position = UDim2.fromOffset(48, 5),
		Font = UI.FontBlack, TextSize = 14, XAlign = Enum.TextXAlignment.Left, ZIndex = 2,
	})
	UIKit.Label(root, {
		Name = "Mult", Text = "×" .. tostring(cfg.Multiplier), Size = UDim2.fromOffset(40, 14), Position = UDim2.fromOffset(48, 26),
		Font = UI.FontBlack, TextSize = 13, XAlign = Enum.TextXAlignment.Left, Color = cfg.Color:Lerp(Color3.new(1, 1, 1), 0.35), ZIndex = 2,
	})
	local timeText = UIKit.Label(root, {
		Name = "Time", Text = "00:00", Size = UDim2.fromOffset(64, 20), Position = UDim2.new(1, -72, 0, 4),
		Font = UI.FontMono, TextSize = 16, XAlign = Enum.TextXAlignment.Right, ZIndex = 2,
	})
	local back = UIKit.Frame(root, "Bar", UDim2.new(1, -100, 0, 7), UDim2.fromOffset(90, 30), Color3.fromRGB(10, 10, 22), 0.35)
	UIKit.Corner(back, 4)
	local fill = UIKit.Frame(back, "Fill", UDim2.fromScale(1, 1), UDim2.new(), cfg.Color)
	fill.ZIndex = 2
	UIKit.Corner(fill, 4)

	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	return { Root = root, Scale = scale, Stroke = stroke, Time = timeText, Fill = fill, EndsAt = 0, Warn = false, Pulse = nil, Color = cfg.Color }
end

-- Буст закончился: чип плавно растворяется и удаляется
local function fadeOutChip(chip: Chip)
	if chip.Pulse then
		chip.Pulse:Cancel()
	end
	local info = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local root = chip.Root
	TweenService:Create(root, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(chip.Scale, info, { Scale = 0.8 }):Play()
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = 1 }):Play()
		elseif d:IsA("Frame") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
	task.delay(0.5, function()
		root:Destroy()
	end)
end

local function updateBoosts()
	local now = Workspace:GetServerTimeNow()
	for order, id in ipairs(BOOSTS.Order) do
		local endsAt = player:GetAttribute("Boost_" .. id .. "_EndsAt")
		local total = player:GetAttribute("Boost_" .. id .. "_Total")
		local remaining = (type(endsAt) == "number") and (endsAt - now) or 0
		local chip = Chips[id]
		if remaining &gt; 0 and type(endsAt) == "number" then
			if not chip then
				chip = makeChip(id, order)
				Chips[id] = chip
			elseif endsAt &gt; chip.EndsAt + 0.5 then
				-- буст продлили: короткий «поп»
				chip.Scale.Scale = 1.12
				TweenService:Create(chip.Scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			end
			chip.EndsAt = endsAt
			chip.Time.Text = UIKit.FormatTime(remaining, true)
			local window = (type(total) == "number" and total &gt; 0) and total or BOOSTS.Items[id].Duration
			TweenService:Create(chip.Fill, TweenInfo.new(0.2, Enum.EasingStyle.Linear), {
				Size = UDim2.fromScale(math.clamp(remaining / window, 0, 1), 1),
			}):Play()

			local warn = remaining &lt;= BOOSTS.ExpireWarnSeconds
			if warn ~= chip.Warn then
				chip.Warn = warn
				if chip.Pulse then
					chip.Pulse:Cancel()
					chip.Pulse = nil
				end
				if warn then
					chip.Stroke.Color = HUD.Warning
					local pulse = TweenService:Create(chip.Scale, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = 1.06 })
					pulse:Play()
					chip.Pulse = pulse
				else
					chip.Stroke.Color = chip.Color
					chip.Scale.Scale = 1
				end
			end
		elseif chip then
			Chips[id] = nil
			fadeOutChip(chip)
		end
	end
end

-- ---------------------------------------------------------------------------
-- Адаптив: масштаб и отступ над мобильными кнопками; тосты старого HUD — над колонкой
-- ---------------------------------------------------------------------------
local ToastHolder: GuiObject? = nil

local function bottomInset(): number
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local vp = UIKit.ViewportSize()
		return (math.min(vp.X, vp.Y) &lt;= 500) and HUD.TouchBottomInsetPhone or HUD.TouchBottomInsetTablet
	end
	return 0
end

local function layout()
	local vp = UIKit.ViewportSize()
	stackScale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 760), 0.62, 1.1)
	stack.Position = UDim2.new(1, -HUD.Margin, 1, -(HUD.Margin + bottomInset()))
end

local function placeToasts()
	local holder = ToastHolder
	if holder and holder.Parent then
		holder.Position = UDim2.new(1, -16, 1, -(stack.AbsoluteSize.Y + HUD.Margin + bottomInset() + 10))
	end
end

layout()
local camera = Workspace.CurrentCamera
if camera then
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		layout()
		placeToasts()
	end)
end
stack:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeToasts)

-- Тосты ProgressionUI стоят в том же углу — поднимаем их над таймером и чипами
task.spawn(function()
	for _ = 1, 60 do
		local found = playerGui:FindFirstChild("Toasts", true)
		if found and found:IsA("GuiObject") then
			ToastHolder = found
			placeToasts()
			return
		end
		task.wait(0.5)
	end
end)

-- ---------------------------------------------------------------------------
-- Обновление: 5 раз в секунду (без покадровых циклов), мгновенно — при смене атрибутов
-- ---------------------------------------------------------------------------
ReplicatedStorage:GetAttributeChangedSignal(P.AttrPhase):Connect(updatePhase)
player.AttributeChanged:Connect(function(name: string)
	if string.sub(name, 1, 6) == "Boost_" then
		updateBoosts()
	end
end)

task.spawn(function()
	while true do
		updatePhase()
		updateBoosts()
		task.wait(0.2)
	end
end)
</ProtectedString></Properties></Item><Item class="LocalScript"><Properties><string name="Name">PickaxeFX</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- ⛏️ КЛИЕНТ: PickaxeFX (StarterPlayerScripts.PickaxeFX)
-- v52: «живые» эффекты кирки поверх анимации взмаха ToolAnimator.
--   • Взмах: шлейф (Trail) между краями лезвия включается на долю секунды.
--   • Удар: залп искр цвета руды из готового излучателя (:Emit — новые объекты не
--     создаются) и едва заметная тряска камеры. Новых звуков нет: играют прежние звуки пород.
--   • Топовые кирки (FxEpic): пульсирующее свечение кристалла и PointLight.
-- Покадровых циклов нет: бесконечные твины для пульсации и короткие task.delay.
-- Настройки — GameConfig.PICKAXE_SWING_FX.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
if not player then
	return
end

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local UIKit = require(Modules:WaitForChild("UIKit"))
local ClientBus = require(Modules:WaitForChild("ClientBus"))
local ToolAnimator = require(Modules:WaitForChild("ToolAnimator"))

local SWING = GameConfig.PICKAXE_SWING_FX
local rng = Random.new()

local TrailTokens: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any

local function getShownPickaxe(char: Model): Model?
	local pick = char:FindFirstChild("VisualPickaxe")
	if pick and pick:IsA("Model") and pick:GetAttribute("Shown") ~= false then
		return pick
	end
	return nil
end

-- Чужие эффекты проигрываем только рядом с камерой
local function inRange(char: Model): boolean
	local cam = Workspace.CurrentCamera
	local root = char:FindFirstChild("HumanoidRootPart")
	if not cam or not root or not root:IsA("BasePart") then
		return false
	end
	return (root.Position - cam.CFrame.Position).Magnitude &lt;= SWING.FxRange
end

-- Взмах: включаем шлейф между краями лезвия
ToolAnimator.OnSwingStart = function(char: Model, _isCrit: boolean)
	local isLocal = char == player.Character
	if not isLocal and not inRange(char) then
		return
	end
	local pick = getShownPickaxe(char)
	if not pick then
		return
	end
	local trail = pick:FindFirstChild("SwingTrail", true)
	if trail and trail:IsA("Trail") then
		local token = (TrailTokens[trail] or 0) + 1
		TrailTokens[trail] = token
		trail.Enabled = true
		task.delay(SWING.TrailSeconds, function()
			if TrailTokens[trail] == token and trail.Parent then
				trail.Enabled = false
			end
		end)
	end
end

-- Короткая тряска камеры локального игрока (три толчка и возврат)
local function shakeCamera()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	local k = SWING.CameraShake
	task.spawn(function()
		for _ = 1, 3 do
			TweenService:Create(hum, TweenInfo.new(0.03, Enum.EasingStyle.Linear), {
				CameraOffset = Vector3.new(rng:NextNumber(-k, k), rng:NextNumber(-k, k), 0),
			}):Play()
			task.wait(0.035)
		end
		TweenService:Create(hum, TweenInfo.new(0.08), { CameraOffset = Vector3.zero }):Play()
	end)
end

-- Удар: искры цвета руды из готового излучателя
ToolAnimator.OnImpact = function(char: Model)
	local isLocal = char == player.Character
	if not isLocal and not inRange(char) then
		return
	end
	local pick = getShownPickaxe(char)
	if not pick then
		return
	end
	local sparks = pick:FindFirstChild("ImpactSparks", true)
	if sparks and sparks:IsA("ParticleEmitter") then
		local color: Color3
		if isLocal and (os.clock() - ClientBus.LastHitClock) &lt; 1.5 then
			color = ClientBus.LastHitColor
		else
			local neon = pick:GetAttribute("FxNeon")
			color = (typeof(neon) == "Color3") and neon or Color3.fromRGB(255, 230, 170)
		end
		sparks.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.45), color)
		sparks:Emit(pick:GetAttribute("FxEpic") == true and SWING.ImpactSparksEpic or SWING.ImpactSparks)
	end
	if isLocal then
		shakeCamera()
	end
end

-- ---------------------------------------------------------------------------
-- Топовые кирки: пульсация кристалла и света (бесконечные твины, отменяются вместе с киркой)
-- ---------------------------------------------------------------------------
local function startEpicPulse(pick: Model)
	if pick:GetAttribute("FxEpic") ~= true or pick:GetAttribute("PulseStarted") then
		return
	end
	local core = pick:WaitForChild("CrystalCore", 5)
	if not core or not core:IsA("BasePart") then
		return
	end
	pick:SetAttribute("PulseStarted", true)
	local tweens: { Tween } = {}
	local info = TweenInfo.new(SWING.PulseSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

	local baseColor = core:GetAttribute("BaseColor")
	if typeof(baseColor) == "Color3" then
		local tw = TweenService:Create(core, info, { Color = baseColor:Lerp(Color3.new(1, 1, 1), 0.5) })
		tw:Play()
		table.insert(tweens, tw)
	end
	local light = core:WaitForChild("CoreLight", 5)
	if light and light:IsA("PointLight") then
		local baseBrightness = tonumber(light:GetAttribute("BaseBrightness")) or light.Brightness
		light.Brightness = baseBrightness
		local tw = TweenService:Create(light, info, { Brightness = baseBrightness * SWING.PulseMin })
		tw:Play()
		table.insert(tweens, tw)
	end

	pick.AncestryChanged:Connect(function(_child: Instance, parent: Instance?)
		if parent == nil then
			UIKit.StopTweens(tweens)
		end
	end)
end

local function hookCharacter(char: Model)
	local function check(child: Instance)
		if child.Name == "VisualPickaxe" and child:IsA("Model") then
			task.spawn(startEpicPulse, child)
		end
	end
	char.ChildAdded:Connect(check)
	for _, child in ipairs(char:GetChildren()) do
		check(child)
	end
end

local function hookPlayer(plr: Player)
	plr.CharacterAdded:Connect(hookCharacter)
	if plr.Character then
		hookCharacter(plr.Character)
	end
end

Players.PlayerAdded:Connect(hookPlayer)
for _, plr in ipairs(Players:GetPlayers()) do
	hookPlayer(plr)
end
</ProtectedString></Properties></Item></Item>
  </Item>
</roblox>