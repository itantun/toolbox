local bottomDock = Instance.new("Frame", screenGui)
bottomDock.Name = "BottomActionDock"
bottomDock.Size = UDim2.new(0, 100, 0, 104) -- v27: only the Sell tile stays at the bottom
bottomDock.Position = UDim2.new(0.5, -50, 1, -116)
