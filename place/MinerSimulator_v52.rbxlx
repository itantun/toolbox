local hoverSub = makeLabel(hoverBox, "ReqPick", UDim2.new(1, -10, 0, 16), UDim2.new(0, 5, 0, 21), "Pickaxe Lv.1+ · ~2.5 s", Color3.fromRGB(200, 220, 240), 11, Enum.TextXAlignment.Center)

local hoverHpBg = Instance.new("Frame", hoverBox)
hoverHpBg.Size = UDim2.new(1, -16, 0, 14)
hoverHpBg.Position = UDim2.new(0, 8, 0, 42)
hoverHpBg.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
Instance.new("UICorner", hoverHpBg).CornerRadius = UDim.new(1, 0)
local hoverHpFill = Instance.new("Frame", hoverHpBg)
hoverHpFill.Size = UDim2.new(1, 0, 1, 0)
hoverHpFill.BackgroundColor3 = Color3.fromRGB(75, 230, 105)
Instance.new("UICorner", hoverHpFill).CornerRadius = UDim.new(1, 0)
local hoverHpTxt = makeLabel(hoverHpBg, "Txt", UDim2.new(1, 0, 1, 0), UDim2.new(), "42 / 42 HP", Color3.new(1, 1, 1), 11, Enum.TextXAlignment.Center)

local selectionBox = Instance.new("SelectionBox", screenGui)
selectionBox.LineThickness = 0.045
selectionBox.SurfaceTransparency = 0.9

-- ============================================================================
-- 8. ОБНОВЛЕНИЕ ВСЕГО ИНТЕРФЕЙСА И ГОРЯЧИЕ КЛАВИШИ
-- ============================================================================
local function refreshUI()
	if hud then hud:Update(State) end

	local eRatio = math.clamp(State.Energy / math.max(1, State.MaxEnergy), 0, 1)
	TweenService:Create(energyFill, TweenInfo.new(0.25), { Size = UDim2.new(eRatio, 0, 1, 0) }):Play()
	energyFill.BackgroundColor3 = Color3.fromRGB(245, 85, 65):Lerp(Color3.fromRGB(65, 225, 135), eRatio)
	energyLbl.Text = string.format("Energy: %d / %d (+%.1f/s)", State.Energy, State.MaxEnergy, State.EnergyRegen)

	do -- v32: dirt stage instead of %
		local stg = GameConfig.GetDirtStage(State.DirtBlocks or 0)
		local pen = math.floor(GameConfig.GetDirtPenalty(State.DirtBlocks or 0) * 100 + 0.5)
		local dirtTxt = GameConfig.GetDirtStageName(stg) .. (pen &gt; 0 and string.format(" (-%d%%)", pen) or "")
		bagSummaryLbl.Text = string.format("Filled: %d / %d slots · Dirt: %s · 🍔 x%d · Total value: +%d 💰", State.BagUsed, State.BagMax, dirtTxt, State.FoodStock or 0, State.BagValue)
	end

	if bagModal.Visible then
		rebuildInventorySlots()
	end
	if shopModal.Visible then
		refreshShopView()
	end
end

SyncPlayerData.OnClientEvent:Connect(function(data: any)
	if type(data) ~= "table" then return end
	State.Coins = data.Coins or State.Coins
	State.Level = data.Level or State.Level
	State.XP = data.XP or State.XP
	State.RequiredXP = data.RequiredXP or State.RequiredXP
	State.Strength = data.Strength or State.Strength
	State.StrengthXP = data.StrengthXP or State.StrengthXP
	State.RequiredStrengthXP = data.RequiredStrengthXP or State.RequiredStrengthXP
	State.Energy = (data.Energy ~= nil) and data.Energy or State.Energy
	State.MaxEnergy = data.MaxEnergy or State.MaxEnergy
	State.EnergyRegen = data.EnergyRegen or State.EnergyRegen
	State.HitDamage = data.HitDamage or State.HitDamage
	State.PickaxeTier = (data.PickaxeTier ~= nil) and data.PickaxeTier or State.PickaxeTier
	State.UnlockedPickaxes = data.UnlockedPickaxes or State.UnlockedPickaxes
	State.BackpackLevel = data.BackpackLevel or State.BackpackLevel
	State.UnlockedBackpacks = data.UnlockedBackpacks or State.UnlockedBackpacks
	State.BagUsed = data.BagUsed or 0
	State.BagMax = data.BagMax or State.BagMax
	State.BagValue = data.BagValue or 0
	State.BagDirt = data.BackpackDirt or 0
	State.DirtBlocks = data.DirtBlocks or 0
	State.FoodStock = data.FoodStock or 0
	State.MaxDepthReached = data.MaxDepthReached or State.MaxDepthReached
	State.Inventory = data.Inventory or State.Inventory
	State.MorningInventory = data.MorningInventory or State.MorningInventory
	State.AttackCooldown = data.AttackCooldown or State.AttackCooldown
	State.Prestige = data.Prestige or State.Prestige
	refreshUI()
end)

UserInputService.InputBegan:Connect(function(input: InputObject, gpe: boolean)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.B or input.KeyCode == Enum.KeyCode.I then
		shopModal.Visible = false
		ClientBus.ToggleBag:Fire() -- v52: новое окно рюкзака с 3D-иконками руды (BackpackUI)
	elseif input.KeyCode == Enum.KeyCode.M then
		goToShop() -- v27: same as the Shop button
	elseif input.KeyCode == Enum.KeyCode.G then
		if not shopModal.Visible and not bagModal.Visible then
			local now = os.clock()
			if (now - LastSpawnClickClock) &gt;= GameConfig.SPAWN_TELEPORT_COOLDOWN then
				LastSpawnClickClock = now
				TeleportToSpawnRemote:FireServer()
			end
		end
	elseif input.KeyCode == Enum.KeyCode.Escape then
		shopModal.Visible = false
		bagModal.Visible = false
		ClientBus.CloseAll:Fire() -- v52: Esc закрывает и новые окна
	elseif shopModal.Visible and input.KeyCode == Enum.KeyCode.Left then
		stepShopLevel(-1)
	elseif shopModal.Visible and input.KeyCode == Enum.KeyCode.Right then
		stepShopLevel(1)
	end
end)

UserInputService.TouchSwipe:Connect(function(swipeDir: Enum.SwipeDirection, _numTouches: number, gpe: boolean)
	if gpe or not shopModal.Visible then return end
	if swipeDir == Enum.SwipeDirection.Left then
		stepShopLevel(1)
	elseif swipeDir == Enum.SwipeDirection.Right then
		stepShopLevel(-1)
	elseif swipeDir == Enum.SwipeDirection.Down then
		shopModal.Visible = false
	end
end)

-- ============================================================================
-- 9. УДАР КИРКОЙ ПО БЛОКУ + ВРАЩЕНИЕ 3D-МОДЕЛИ В МАГАЗИНЕ + ЗОНЫ SHOP / SELL
-- ============================================================================
local HoveredBlock: BasePart? = nil
local IsMouseDown = false
local LastSwingClock = 0

local function shakeCamera(intensity: number)
	local cam = Workspace.CurrentCamera
	if not cam then return end
	task.spawn(function()
		for _ = 1, 4 do
			local dx = (math.random() - 0.5) * intensity
			local dy = (math.random() - 0.5) * intensity
			cam.CFrame = cam.CFrame * CFrame.new(dx, dy, 0)
			task.wait(0.025)
		end
	end)
end

local function canPlayerMineNow(char: Model?, root: BasePart?): boolean
	if not char or not root then return false end
	-- 1) Must be inside the Mine Zone
	local zb = GameConfig.MINE_ZONE_BOUNDS
	local pos = root.Position
	local inZone = (char:GetAttribute("InMineZone") == true)
		and (pos.X &gt;= zb.MinX and pos.X &lt;= zb.MaxX and pos.Z &gt;= zb.MinZ and pos.Z &lt;= zb.MaxZ and pos.Y &lt;= zb.TopY)
	if not inZone then return false end
	-- 2) Must have an active visible Pickaxe equipped in hand
	local visualPick = char:FindFirstChild("VisualPickaxe")
	if not visualPick or char:GetAttribute("PickaxeHidden") == true or visualPick:GetAttribute("Shown") == false then
		return false
	end
	local hand = (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) :: BasePart?
	if not hand or not hand:FindFirstChild("PickaxeMotor") then
		return false
	end
	return true
end

local function raycastMineBlock(): BasePart?
	local cam = Workspace.CurrentCamera
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local blocksFolder = Workspace:FindFirstChild("MineBlocks")
	if not cam or not char or not root or not blocksFolder then return nil end

	-- v49: Cannot target or mine blocks outside the mine zone or without a pickaxe in hand
	if not canPlayerMineNow(char, root) then
		return nil
	end

	local mPos = UserInputService:GetMouseLocation()
	local ray = cam:ViewportPointToRay(mPos.X, mPos.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { blocksFolder }

	-- Limit camera ray distance so distant blocks can't even be raycasted
	local camToRoot = (cam.CFrame.Position - root.Position).Magnitude
	local maxRayLen = camToRoot + GameConfig.MAX_MINE_DISTANCE + 4
	local res = Workspace:Raycast(ray.Origin, ray.Direction * maxRayLen, params)
	if not res or not res.Instance then return nil end

	local hit = res.Instance
	while hit and hit.Parent and not hit:GetAttribute("IsMineBlock") and hit ~= blocksFolder do
		hit = hit.Parent :: BasePart
	end

	if hit and hit:IsA("BasePart") and hit:GetAttribute("IsMineBlock") then
		local bPos = (hit:GetAttribute("OriginPos") :: Vector3) or hit.Position
		local delta = root.Position - bPos
		local maxAxial = math.max(math.abs(delta.X), math.abs(delta.Y), math.abs(delta.Z))
		-- v49: Strictly first 2 blocks in radius (12.0 studs / 2 * 6.0 block width)
		if delta.Magnitude &lt;= GameConfig.MAX_MINE_DISTANCE and maxAxial &lt;= (GameConfig.BLOCK_WIDTH * 2.08) then
			return hit
		end
	end
	return nil
end

local function swingPickaxeAtBlock()
	if bagModal.Visible or shopModal.Visible or player:GetAttribute("ProgressionUIOpen") or player:GetAttribute("UpgradeUIOpen") then return end
	local target = HoveredBlock or raycastMineBlock()
	if not target then return end

	local now = os.clock()
	if (now - LastSwingClock) &lt; State.AttackCooldown then return end
	LastSwingClock = now

	ToolAnimator.PlaySwing(player.Character, false)

	local hitSoundKey = tostring(target:GetAttribute("HitSound") or "StoneTap")
	SoundManager.PlayQuietTap(hitSoundKey, target.Position, target)

	local accentCol = (target:GetAttribute("AccentColor") :: Color3) or target.Color
	VFXModule.PlayHitShakeAndParticles(target, accentCol)
	-- v52: искры удара красятся в цвет руды, а тряска камеры играет в момент удара (PickaxeFX)
	ClientBus.SetLastHit(accentCol)

	MineBlockRemote:FireServer(target)
end

UserInputService.InputBegan:Connect(function(input: InputObject, gpe: boolean)
	if gpe then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		IsMouseDown = true
		swingPickaxeAtBlock()
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		IsMouseDown = false
	end
end)

local WasOnShopPad = false
local WasOnSellPad = false
local LastDepthAmbientUpdate = 0
local ViewportSpinAngle = 0

task.spawn(function()
	while task.wait(5.5) do
		if CurrentDepthBlocks &gt;= 6 then
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local soundChoice = (math.random() &lt; 0.7) and "CaveDrip" or "CaveEcho"
				SoundManager.PlayQuietTap(soundChoice, root.Position + Vector3.new(math.random(-12, 12), math.random(-4, 8), math.random(-12, 12)))
			end
		end
	end
end)

RunService.RenderStepped:Connect(function(dt: number)
	-- Плавное 3D-вращение модели в окне 3D-Магазина
	if shopModal.Visible and ActiveViewportModel and ActiveViewportModel.PrimaryPart then
		ViewportSpinAngle = (ViewportSpinAngle + dt * 55) % 360
		pcall(function()
			if ShopCategory == "Pickaxes" then
				ActiveViewportModel:PivotTo(CFrame.new(0, -0.2, 0) * CFrame.Angles(math.rad(15), math.rad(ViewportSpinAngle), math.rad(-25)))
			else
				ActiveViewportModel:PivotTo(CFrame.new(0, -0.1, 0) * CFrame.Angles(0, math.rad(ViewportSpinAngle), 0))
			end
		end)
	end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?

	if root then
		local pos = root.Position
		local rawDepth = math.floor((0 - pos.Y) / GameConfig.BLOCK_HEIGHT)
		local clampedDepth = math.clamp(rawDepth, 0, GameConfig.MINE_LEVELS_COUNT)
		if clampedDepth ~= CurrentDepthBlocks then
			CurrentDepthBlocks = clampedDepth
			updateClockAndDepthText()
		end

		-- v49: Smooth progressive darkness with depth + dynamic Hard Hat Headlamp boost
		local now = os.clock()
		if (now - LastDepthAmbientUpdate) &gt; 0.08 then
			LastDepthAmbientUpdate = now
			local inMine = (char:GetAttribute("InMineZone") == true) or (pos.Y &lt; -1.5)
			local totalDepthStuds = GameConfig.MINE_LEVELS_COUNT * GameConfig.BLOCK_HEIGHT
			local smoothDepth = inMine and math.clamp((-pos.Y) / totalDepthStuds, 0, 1) or 0
			-- Non-linear curve so darkness already feels atmospheric by depth 3..8 and pitch-deep below 15
			local darkFactor = math.clamp(smoothDepth ^ 0.72, 0, 1)

			-- v50: shared GameConfig.LIGHTING values; the bottom stays readable instead of pitch black
			local L = GameConfig.LIGHTING
			-- v52: плавный переход день/ночь — доля ночи 0..1 из Lighting.NightBlend (её ведёт NightFX)
			local blendValue = Lighting:FindFirstChild("NightBlend")
			local nightBlend = (blendValue and blendValue:IsA("NumberValue")) and blendValue.Value or (IsNightMode and 1 or 0)
			local PL = GameConfig.PHASE_LIGHTING
			local surfBright = L.DayBrightness + (L.NightBrightness - L.DayBrightness) * nightBlend
			local surfAmbient = L.DayAmbient:Lerp(L.NightAmbient, nightBlend)
			local surfOutdoor = L.DayOutdoorAmbient:Lerp(L.NightOutdoorAmbient, nightBlend)

			Lighting.Brightness = surfBright * (1 - darkFactor * L.DeepDarkness)
			Lighting.Ambient = surfAmbient:Lerp(L.DeepAmbient, darkFactor)
			Lighting.OutdoorAmbient = surfOutdoor:Lerp(L.DeepOutdoorAmbient, darkFactor)
			Lighting.ExposureCompensation = L.DeepExposure * darkFactor

			local atm = Lighting:FindFirstChild("MineAtmosphere") :: Atmosphere?
			if atm then
				atm.Density = PL.Day.AtmosphereDensity + (PL.Night.AtmosphereDensity - PL.Day.AtmosphereDensity) * nightBlend
					+ darkFactor * L.DeepAtmosphereExtraDensity
				atm.Color = PL.Day.AtmosphereColor:Lerp(PL.Night.AtmosphereColor, nightBlend):Lerp(Color3.fromRGB(26, 28, 44), darkFactor)
				atm.Decay = PL.Day.AtmosphereDecay:Lerp(PL.Night.AtmosphereDecay, nightBlend):Lerp(Color3.fromRGB(16, 18, 30), darkFactor)
			end

			-- Boost the player's Hard Hat Headlamp as it gets darker so it illuminates the shaft ahead
			local hat = char:FindFirstChild("MinerHardHat")
			if hat then
				local lensLight = hat:FindFirstChild("MinerHelmetLight", true) :: SpotLight?
				if lensLight then
					lensLight.Brightness = 2.0 + darkFactor * 2.8
					lensLight.Range = 30 + darkFactor * 24
				end
				local mainBeam = hat:FindFirstChild("MinerHelmetSpotLight", true) :: SpotLight?
				if mainBeam then
					mainBeam.Brightness = 2.4 + darkFactor * 3.4
					mainBeam.Range = 36 + darkFactor * 26
				end
				local fillLight = hat:FindFirstChild("MinerHelmetPointLight", true) :: PointLight?
				if fillLight then
					fillLight.Brightness = 1.1 + darkFactor * 1.65
					fillLight.Range = 18 + darkFactor * 12
				end
			end
		end

		-- Зона Неонового Павильона "SHOP"
		local shopPadPos = GameConfig.GREEN_SHOP_PAD_POS + Vector3.new(0, 0.35, 4.0)
		local distShop = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(shopPadPos.X, 0, shopPadPos.Z)).Magnitude
		local onShopPad = (distShop &lt;= 6.2) and (math.abs(pos.Y - shopPadPos.Y) &lt; 6)

		if onShopPad and not WasOnShopPad then
			WasOnShopPad = true
			bagModal.Visible = false
			ClientBus.CloseAll:Fire() -- v52: новое окно рюкзака закрывается
			shopModal.Visible = true
			SoundManager.PlayUISound("ShopOpen") -- v28: shop open swoosh
			refreshShopView()
		elseif not onShopPad and WasOnShopPad then
			WasOnShopPad = false
			shopModal.Visible = false
			ClientBus.CloseShop:Fire() -- v52: окно бустов закрывается вместе с магазином
		end

		-- v14: окно продажи не открывается. Автопродажу выполняет сервер при входе в зону «$ SELL».
	end

	if bagModal.Visible or shopModal.Visible or player:GetAttribute("ProgressionUIOpen") or player:GetAttribute("UpgradeUIOpen") then
		crosshair.Visible = false
		selectionBox.Adornee = nil
		UserInputService.MouseIconEnabled = true
		return
	end

	local mPos = UserInputService:GetMouseLocation()
	crosshair.Position = UDim2.new(0, mPos.X, 0, mPos.Y)

	local target = raycastMineBlock()
	HoveredBlock = target

	if target then
		crosshair.Visible = true
		UserInputService.MouseIconEnabled = false
		selectionBox.Adornee = target

		local hp = (target:GetAttribute("HP") :: number) or 20
		local maxHp = (target:GetAttribute("MaxHP") :: number) or 20
		local bName = tostring(target:GetAttribute("BlockName") or "Stone")
		local minPick = (target:GetAttribute("MinPickaxeLevel") :: number) or 1
		local targetTime = tostring(target:GetAttribute("TargetMineTimeSec") or "2.5 s")
		local reqCfg = GameConfig.PICKAXE_TIERS[minPick] or GameConfig.PICKAXE_TIERS[1]
		local hasPick = State.PickaxeTier &gt;= minPick

		local ratio = math.clamp(hp / math.max(1, maxHp), 0, 1)
		local col = hasPick
			and Color3.fromRGB(245, 65, 65):Lerp(Color3.fromRGB(75, 230, 105), ratio)
			or Color3.fromRGB(255, 75, 75)

		selectionBox.Color3 = col
		chStroke.Color = col
		hoverTitle.Text = bName
		hoverSub.Text = hasPick
			and string.format("⛏️ Lv.%d %s+ · ⏱ %s", minPick, reqCfg.ShortName, targetTime)
			or string.format("⚠️ You need %s (Lv.%d)!", reqCfg.ShortName, minPick)
		hoverSub.TextColor3 = hasPick and Color3.fromRGB(190, 230, 210) or Color3.fromRGB(255, 105, 95)

		hoverHpFill.Size = UDim2.new(ratio, 0, 1, 0)
		hoverHpFill.BackgroundColor3 = col
		hoverHpTxt.Text = string.format("%d / %d HP", math.max(0, hp), maxHp)

		if IsMouseDown then
			swingPickaxeAtBlock()
		end
	else
		crosshair.Visible = false
		selectionBox.Adornee = nil
		UserInputService.MouseIconEnabled = true
	end
end)

refreshUI()
print("✅ [ClientController] Ready")
</ProtectedString>
        </Properties>
      </Item>
    <Item class="LocalScript"><Properties><string name="Name">ProgressionUI</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🌟 КЛИЕНТ: ProgressionUI (StarterPlayerScripts.ProgressionUI)
-- ЗАДАЧА 1 — Интерфейс прокачки в стиле топ-симуляторов 2026:
-- • Кнопки слева: ⚡ Навыки [K] · 🏆 Достижения [J] · 👑 Престиж [P]
-- • Окно навыков: иконки-плитки (скруглённые квадраты с градиентом), прогресс-бары,
--   кнопки «Улучшить» и «MAX»
-- • Окно достижений с прогрессом и наградами, окно престижа с превью ауры
-- • Попап «🎉 Уровень повышен! [X]» с фанфарами и UI-искрами, тосты достижений
-- • Подсветка при наведении (UIStroke) и анимация нажатия (Scale 1.0 → 0.95 → 1.0)
-- ============================================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
if not player then return end
if player:GetAttribute("ProgressionUIActive") then return end
player:SetAttribute("ProgressionUIActive", true)
player:SetAttribute("ProgressionUIOpen", false)

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ProgressionConfig = require(Modules:WaitForChild("ProgressionConfig"))
local GameConfig = require(Modules:WaitForChild("GameConfig"))
-- v26: vector icons shared with the HUD (same pictures as the reference)
local HudModule: any = nil
do
	local okHud, modHud = pcall(function()
		return require(Modules:WaitForChild("HudModule"))
	end)
	if okHud then
		HudModule = modHud
	end
end

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SyncPlayerData = Remotes:WaitForChild("SyncPlayerData") :: RemoteEvent
local UpgradeSkillRemote = Remotes:WaitForChild("UpgradeSkill") :: RemoteEvent
local PrestigeRemote = Remotes:WaitForChild("Prestige") :: RemoteEvent
local ProgressionEvent = Remotes:WaitForChild("ProgressionEvent") :: RemoteEvent

-- ============================================================================
-- 0. СОСТОЯНИЕ (приходит с сервера)
-- ============================================================================
local State = {
	Level = 1,
	XP = 0,
	RequiredXP = 100,
	Coins = 0,
	SkillPoints = 0,
	Skills = {} :: { [string]: number },
	Prestige = 0,
	Achievements = {} :: { [string]: boolean },
	AchievementProgress = {} :: { [string]: number },
	CanPrestige = false,
}

-- ============================================================================
-- 1. ПАЛИТРА И ЗВУКИ
-- ============================================================================
local C = {
	Bg = Color3.fromRGB(20, 20, 30),
	BgLight = Color3.fromRGB(52, 54, 78),
	Row = Color3.fromRGB(34, 36, 52),
	White = Color3.new(1, 1, 1),
	Muted = Color3.fromRGB(190, 200, 225),
	Gold = Color3.fromRGB(255, 210, 60),
	GoldDark = Color3.fromRGB(190, 110, 10),
	Green = Color3.fromRGB(70, 230, 110),
	GreenDark = Color3.fromRGB(20, 130, 60),
	Blue = Color3.fromRGB(60, 190, 255),
	BlueDark = Color3.fromRGB(25, 85, 190),
	Purple = Color3.fromRGB(175, 95, 255),
	PurpleDark = Color3.fromRGB(80, 30, 170),
	Pink = Color3.fromRGB(255, 95, 185),
	PinkDark = Color3.fromRGB(150, 25, 110),
	Red = Color3.fromRGB(245, 70, 80),
	Gray = Color3.fromRGB(110, 115, 135),
	GrayDark = Color3.fromRGB(55, 58, 72),
}

local FONT = Enum.Font.GothamBold

local function makeSound(cfg: { Id: string, Volume: number }): Sound
	local s = Instance.new("Sound")
	s.SoundId = cfg.Id
	s.Volume = cfg.Volume
	s.Parent = SoundService
	return s
end

local Sounds = {
	LevelUp = makeSound(ProgressionConfig.SOUNDS.LevelUp),
	Click = makeSound(ProgressionConfig.SOUNDS.Click),
	Achievement = makeSound(ProgressionConfig.SOUNDS.Achievement),
	Prestige = makeSound(ProgressionConfig.SOUNDS.Prestige),
}

local function playSound(s: Sound, pitch: number?)
	s.PlaybackSpeed = pitch or 1
	s.TimePosition = 0
	s:Play()
end

-- v47: приятный звук нового уровня
local function playLevelUpSound()
	local S = ProgressionConfig.SOUNDS :: any
	local custom = S.LevelUpCustom
	if custom and type(custom.Id) == "string" and custom.Id ~= "" then
		local s = makeSound(custom)
		s:Play()
		task.delay(8, function() s:Destroy() end)
		return
	end
	local chime = S.LevelUpChime
	-- до-ми-соль-до: мажорное арпеджио с лёгким эхо
	local notes = { 1.0, 1.26, 1.5, 2.0 }
	for i, pitch in ipairs(notes) do
		task.delay((i - 1) * 0.11, function()
			local s = Instance.new("Sound")
			s.SoundId = chime.Id
			s.Volume = chime.Volume * ((i == #notes) and 1.15 or 1)
			s.PlaybackSpeed = pitch
			local rv = Instance.new("ReverbSoundEffect")
			rv.DecayTime = 1.2
			rv.WetLevel = -8
			rv.DryLevel = 0
			rv.Parent = s
			local eq = Instance.new("EqualizerSoundEffect")
			eq.HighGain = -6
			eq.MidGain = 0
			eq.LowGain = 0
			eq.Parent = s
			s.Parent = SoundService
			s:Play()
			task.delay(4, function() s:Destroy() end)
		end)
	end
end

local function formatNumber(n: number): string
	if n &gt;= 1e9 then return string.format("%.1fB", n / 1e9) end
	if n &gt;= 1e6 then return string.format("%.1fM", n / 1e6) end
	if n &gt;= 1e4 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end

-- ============================================================================
-- 2. UI-КОНСТРУКТОР (UICorner + UIGradient + UIStroke)
-- ============================================================================
local playerGui = player:WaitForChild("PlayerGui")
local oldGui = playerGui:FindFirstChild("ProgressionHUD")
if oldGui then oldGui:Destroy() end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ProgressionHUD"
screenGui.IgnoreGuiInset = true
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 5
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local function corner(parent: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = parent
	return c
end

local function stroke(parent: Instance, color: Color3, thickness: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function gradient(parent: Instance, c0: Color3, c1: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

local function label(parent: Instance, text: string, size: UDim2, pos: UDim2, color: Color3, textSize: number, alignX: Enum.TextXAlignment?): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = FONT
	l.Text = text
	l.TextColor3 = color
	l.TextSize = textSize
	l.TextXAlignment = alignX or Enum.TextXAlignment.Left
	l.TextStrokeTransparency = 0.5
	l.TextWrapped = true
	l.Parent = parent
	return l
end

local function panel(parent: Instance, name: string, size: UDim2, pos: UDim2, accent: Color3, transparency: number?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = C.White
	f.BackgroundTransparency = math.min(transparency or 0.3, 0.06)
	f.BorderSizePixel = 0
	f.Parent = parent
	corner(f, 14)
	-- v32: modern dark-glass panel + neon accent rim + soft gloss
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(46, 42, 88):Lerp(accent, 0.08)),
		ColorSequenceKeypoint.new(0.55, Color3.fromRGB(26, 24, 54)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(14, 13, 32)),
	})
	g.Rotation = 90
	g.Parent = f
	local os_ = stroke(f, accent, 3)
	os_.Transparency = 0.15
	local glossTop = Instance.new("Frame")
	glossTop.Name = "PanelGloss"
	glossTop.BackgroundColor3 = C.White
	glossTop.BackgroundTransparency = 0.94
	glossTop.BorderSizePixel = 0
	glossTop.Size = UDim2.new(1, -12, 0, 54)
	glossTop.Position = UDim2.fromOffset(6, 4)
	glossTop.Parent = f
	corner(glossTop, 12)
	local rim = Instance.new("Frame")
	rim.Name = "GoldRim"
	rim.BackgroundTransparency = 1
	rim.Size = UDim2.new(1, 12, 1, 12)
	rim.Position = UDim2.fromOffset(-6, -6)
	rim.Parent = f
	corner(rim, 20)
	local rs = stroke(rim, accent, 5)
	rs.Transparency = 0.72
	return f
end

-- Скруглённая «плитка» иконки как на картинке: градиент + глянцевый блик + эмодзи
local function iconTile(parent: Instance, icon: string, c0: Color3, c1: Color3, size: number, pos: UDim2): (Frame, TextLabel, UIGradient)
	local tile = Instance.new("Frame")
	tile.Name = "IconTile"
	tile.Size = UDim2.new(0, size, 0, size)
	tile.Position = pos
	tile.BackgroundColor3 = C.White
	tile.BorderSizePixel = 0
	tile.Parent = parent
	corner(tile, math.floor(size * 0.22))
	local g = gradient(tile, c0, c1, 45)
	stroke(tile, c0:Lerp(C.White, 0.45), 2)

	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.Size = UDim2.new(1, -8, 0.45, 0)
	gloss.Position = UDim2.new(0, 4, 0, 3)
	gloss.BackgroundColor3 = C.White
	gloss.BackgroundTransparency = 0.82
	gloss.BorderSizePixel = 0
	gloss.Parent = tile
	corner(gloss, math.floor(size * 0.18))

	local e = label(tile, icon, UDim2.new(0.72, 0, 0.72, 0), UDim2.new(0.14, 0, 0.14, 0), C.White, 24, Enum.TextXAlignment.Center)
	e.TextScaled = true
	e.TextStrokeTransparency = 1
	e.ZIndex = 2
	return tile, e, g
end

local function progressBar(parent: Instance, size: UDim2, pos: UDim2, c0: Color3, c1: Color3): (Frame, Frame, TextLabel)
	local bg = Instance.new("Frame")
	bg.Name = "Bar"
	bg.Size = size
	bg.Position = pos
	bg.BackgroundColor3 = Color3.fromRGB(8, 8, 20)
	bg.BackgroundTransparency = 0.05
	bg.BorderSizePixel = 0
	bg.Parent = parent
	corner(bg, 99)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = C.White
	fill.BorderSizePixel = 0
	fill.Parent = bg
	corner(fill, 99)
	gradient(fill, c0:Lerp(C.White, 0.1), c1, 0)
	local bst = stroke(bg, C.White, 1)
	bst.Transparency = 0.85
	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.BackgroundColor3 = C.White
	shine.BackgroundTransparency = 0.7
	shine.BorderSizePixel = 0
	shine.Size = UDim2.new(1, -6, 0.38, 0)
	shine.Position = UDim2.fromOffset(3, 1)
	shine.Parent = fill
	corner(shine, 99)

	local txt = label(bg, "", UDim2.new(1, 0, 1, 0), UDim2.new(), C.White, 11, Enum.TextXAlignment.Center)
	txt.ZIndex = 3
	return bg, fill, txt
end

local function setBar(fill: Frame, ratio: number)
	TweenService:Create(fill, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0),
	}):Play()
end

-- Подсветка при наведении + анимация нажатия (1.0 → 0.95 → 1.0) + тихий клик
local function addButtonFx(btn: GuiButton, onClick: () -&gt; ())
	local sc = Instance.new("UIScale")
	sc.Parent = btn
	local st = btn:FindFirstChildOfClass("UIStroke")
	local baseColor = st and st.Color or C.White
	local hovered = false
	local fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	btn.MouseEnter:Connect(function()
		hovered = true
		TweenService:Create(sc, fast, { Scale = 1.04 }):Play()
		if st then TweenService:Create(st, fast, { Color = C.White, Thickness = 3 }):Play() end
	end)
	btn.MouseLeave:Connect(function()
		hovered = false
		TweenService:Create(sc, fast, { Scale = 1 }):Play()
		if st then TweenService:Create(st, fast, { Color = baseColor, Thickness = 2 }):Play() end
	end)
	btn.Activated:Connect(function()
		playSound(Sounds.Click, 1.1)
		sc.Scale = 0.95
		TweenService:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = hovered and 1.04 or 1,
		}):Play()
		onClick()
	end)
end

local function button(parent: Instance, text: string, size: UDim2, pos: UDim2, c0: Color3, c1: Color3, textSize: number?, onClick: () -&gt; ()): (TextButton, UIGradient)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.AnchorPoint = Vector2.new(0, 0)
	b.BackgroundColor3 = C.White
	b.BorderSizePixel = 0
	b.AutoButtonColor = false
	b.Font = FONT
	b.Text = text
	b.TextColor3 = C.White
	b.TextSize = textSize or 16
	b.TextStrokeTransparency = 0.5
	b.Parent = parent
	corner(b, 10)
	local g = gradient(b, c0, c1, 90) -- акцент → тёмный
	stroke(b, c0:Lerp(C.White, 0.3), 2)
	addButtonFx(b, onClick)
	return b, g
end

-- ============================================================================
-- 3. АДАПТИВНЫЙ МАСШТАБ (ПК / планшет / телефон)
-- ============================================================================
local ResponsiveScales: { UIScale } = {}
local function getViewportScale(): number
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 760)
	return math.clamp(math.min(vp.X / 1280, vp.Y / 760), 0.55, 1.15)
end
local function responsive(obj: GuiObject): UIScale
	local sc = Instance.new("UIScale")
	sc.Scale = getViewportScale()
	sc.Parent = obj
	table.insert(ResponsiveScales, sc)
	return sc
end
local function refreshScales()
	local s = getViewportScale()
	for _, sc in ipairs(ResponsiveScales) do
		sc.Scale = s
	end
end
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
end

-- ============================================================================
-- 4. ОКНА (одно открытое за раз)
-- ============================================================================
type Window = { Frame: Frame, Scale: UIScale, Body: Frame, Title: TextLabel }
local Windows: { [string]: Window } = {}
local OpenWindowName: string? = nil
local refreshAll: () -&gt; () = function() end

-- Vector close cross: the font glyphs "✕"/"✖" render as empty boxes in GothamBlack.
local function vecCross(btn: TextButton)
	btn.Text = ""
	btn:SetAttribute("CloseX", true)
	if btn:FindFirstChild("XCross") then
		return
	end
	local holder = Instance.new("Frame")
	holder.Name = "XCross"
	holder.BackgroundTransparency = 1
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromScale(0.6, 0.6)
	holder.ZIndex = btn.ZIndex + 2
	holder.Active = false
	for pass = 1, 2 do
		for _, rot in ipairs({ 45, -45 }) do
			local bar = Instance.new("Frame")
			bar.Name = "XBar"
			bar.BorderSizePixel = 0
			bar.AnchorPoint = Vector2.new(0.5, 0.5)
			bar.Position = UDim2.fromScale(0.5, 0.5)
			bar.Size = UDim2.fromScale(1.08, 0.26)
			bar.Rotation = rot
			bar.BackgroundColor3 = Color3.new(1, 1, 1)
			bar.ZIndex = pass
			bar.Active = false
			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(0.5, 0)
			bc.Parent = bar
			if pass == 1 then
				local bs = Instance.new("UIStroke")
				bs.Color = Color3.fromRGB(110, 6, 18)
				bs.Thickness = 2.5
				bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				bs.Parent = bar
			else
				local bg = Instance.new("UIGradient")
				bg.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(255, 214, 214))
				bg.Rotation = 90 - rot
				bg.Parent = bar
			end
			bar.Parent = holder
		end
	end
	holder.Parent = btn
end

local function closeWindow()
	if not OpenWindowName then return end
	local w = Windows[OpenWindowName]
	OpenWindowName = nil
	player:SetAttribute("ProgressionUIOpen", false)
	if w then
		local target = getViewportScale()
		local t = TweenService:Create(w.Scale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = target * 0.85 })
		t:Play()
		t.Completed:Once(function()
			if OpenWindowName == nil or Windows[OpenWindowName] ~= w then
				w.Frame.Visible = false
			end
			w.Scale.Scale = getViewportScale()
		end)
	end
end

local function openWindow(name: string)
	if OpenWindowName == name then
		closeWindow()
		return
	end
	if OpenWindowName then
		local prev = Windows[OpenWindowName]
		if prev then prev.Frame.Visible = false end
	end
	local w = Windows[name]
	if not w then return end
	OpenWindowName = name
	player:SetAttribute("ProgressionUIOpen", true)
	refreshAll()
	local target = getViewportScale()
	w.Scale.Scale = target * 0.8
	w.Frame.Visible = true
	TweenService:Create(w.Scale, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
end

local function createWindow(name: string, title: string, accent: Color3, width: number, height: number): Window
	local f = panel(screenGui, name, UDim2.new(0, width, 0, height), UDim2.new(0.5, 0, 0.5, 0), accent, 0.3)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Visible = false
	f.ZIndex = 10
	local sc = responsive(f)

	local titleLbl = label(f, title, UDim2.new(1, -200, 0, 34), UDim2.new(0, 20, 0, 12), accent, 22)
	-- v24: wooden title plaque like the reference board
	local plaque = Instance.new("Frame")
	plaque.Name = "TitlePlaque"
	plaque.Size = UDim2.new(0, math.min(width - 220, 300), 0, 42)
	plaque.Position = UDim2.new(0, 12, 0, 8)
	plaque.BackgroundColor3 = C.White
	plaque.BorderSizePixel = 0
	plaque.Parent = f
	corner(plaque, 10)
	gradient(plaque, accent:Lerp(C.White, 0.12), accent:Lerp(Color3.new(0, 0, 0), 0.5), 90)
	stroke(plaque, accent:Lerp(C.White, 0.5), 2)
	local pgl = Instance.new("Frame")
	pgl.BackgroundColor3 = C.White; pgl.BackgroundTransparency = 0.82; pgl.BorderSizePixel = 0
	pgl.Size = UDim2.new(1, -10, 0.42, 0); pgl.Position = UDim2.fromOffset(5, 3); pgl.Parent = plaque
	corner(pgl, 8)
	titleLbl.Parent = plaque
	titleLbl.Size = UDim2.new(1, -16, 1, -6)
	titleLbl.Position = UDim2.fromOffset(8, 3)
	titleLbl.TextColor3 = C.White
	titleLbl.TextStrokeTransparency = 0
	titleLbl.TextStrokeColor3 = Color3.fromRGB(14, 10, 30)
	titleLbl.Font = Enum.Font.GothamBlack
	titleLbl.ZIndex = 2
	titleLbl.TextXAlignment = Enum.TextXAlignment.Center
	titleLbl.TextYAlignment = Enum.TextYAlignment.Center
	titleLbl.TextWrapped = false
	titleLbl.TextScaled = true
	local tsc = Instance.new("UITextSizeConstraint")
	tsc.MaxTextSize = 22
	tsc.Parent = titleLbl

	local xBtn = button(f, "✖", UDim2.new(0, 38, 0, 38), UDim2.new(1, -50, 0, 10), C.Red, Color3.fromRGB(120, 20, 30), 18, function()
		closeWindow()
	end)
	vecCross(xBtn)

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.Size = UDim2.new(1, -32, 1, -64)
	body.Position = UDim2.new(0, 16, 0, 56)
	body.Parent = f

	local w: Window = { Frame = f, Scale = sc, Body = body, Title = titleLbl }
	Windows[name] = w
	return w
end

local function scrollList(parent: Instance, size: UDim2, pos: UDim2): ScrollingFrame
	local sf = Instance.new("ScrollingFrame")
	sf.Size = size
	sf.Position = pos
	sf.BackgroundTransparency = 1
	sf.BorderSizePixel = 0
	sf.ScrollBarThickness = 6
	sf.ScrollBarImageColor3 = C.Muted
	sf.CanvasSize = UDim2.new()
	sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
	sf.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = sf
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = sf
	return sf
end

local function rowFrame(parent: Instance, name: string, height: number, accent: Color3, order: number): Frame
	local r = Instance.new("Frame")
	r.Name = name
	r.LayoutOrder = order
	r.Size = UDim2.new(1, 0, 0, height)
	r.BackgroundColor3 = C.White
	r.BackgroundTransparency = 0.2
	r.BorderSizePixel = 0
	r.Parent = parent
	corner(r, 12)
	gradient(r, Color3.fromRGB(52, 48, 96):Lerp(accent, 0.12), Color3.fromRGB(26, 24, 54), 90) -- v32: modern glass row
	local rst = stroke(r, accent, 1.5)
	rst.Transparency = 0.45
	local strip = Instance.new("Frame")
	strip.Name = "AccentStrip"
	strip.BackgroundColor3 = accent
	strip.BorderSizePixel = 0
	strip.Size = UDim2.new(0, 4, 1, -20)
	strip.Position = UDim2.fromOffset(2, 10)
	strip.Parent = r
	corner(strip, 4)
	local rgl = Instance.new("Frame")
	rgl.Name = "RowGloss"
	rgl.BackgroundColor3 = C.White; rgl.BackgroundTransparency = 0.95; rgl.BorderSizePixel = 0
	rgl.Size = UDim2.new(1, -8, 0.45, 0); rgl.Position = UDim2.fromOffset(4, 2); rgl.Parent = r
	corner(rgl, 10)
	return r
end

-- ============================================================================
