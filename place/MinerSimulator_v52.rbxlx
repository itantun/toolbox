</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">BoostService</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🚀 МОДУЛЬ: BoostService (ServerScriptService.Modules.BoostService)
-- v52: бусты торговца (Удача / Скорость / Монеты) и зелье Ночного торговца.
--   • Сервер хранит ТОЧНОЕ время конца каждого буста (workspace:GetServerTimeNow()).
--   • Клиент только показывает: читает атрибуты игрока Boost_&lt;Id&gt;_EndsAt / Boost_&lt;Id&gt;_Total.
--   • Повторная покупка ПРОДЛЕВАЕТ буст, а не сбрасывает его.
--   • В сохранение пишется остаток секунд: между сессиями буст «стоит на паузе».
-- Цены, длительности и множители — GameConfig.BOOSTS.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local BoostService = {}

type BoostState = {
	EndsAt: number, -- момент конца, сек workspace:GetServerTimeNow()
	Total: number,  -- длина текущего «окна» буста (для полоски прогресса на клиенте)
}

local Active: { [number]: { [string]: BoostState } } = {}
local ChangedCallback: ((Player) -&gt; ())? = nil
local LoopStarted = false

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function attrName(id: string, suffix: string): string
	return "Boost_" .. id .. "_" .. suffix
end

-- Публикуем состояние буста в атрибуты игрока (их читает клиентский HUD)
local function publish(player: Player, id: string)
	local map = Active[player.UserId]
	local st = map and map[id]
	if st then
		player:SetAttribute(attrName(id, "Total"), st.Total)
		player:SetAttribute(attrName(id, "EndsAt"), st.EndsAt)
	else
		player:SetAttribute(attrName(id, "EndsAt"), nil)
		player:SetAttribute(attrName(id, "Total"), nil)
	end
	if id == "Potion" then
		-- совместимость с v51: старые скрипты читают SellBoostUntil (os.time)
		local remaining = st and math.max(0, st.EndsAt - serverNow()) or 0
		player:SetAttribute("SellBoostUntil", remaining &gt; 0 and (os.time() + math.floor(remaining)) or 0)
	end
end

local function notifyChanged(player: Player)
	local cb = ChangedCallback
	if cb then
		task.spawn(cb, player)
	end
end

-- Вызывается при любом изменении набора бустов игрока (сервер пересылает клиенту новые статы)
function BoostService.SetChangedCallback(fn: (Player) -&gt; ())
	ChangedCallback = fn
end

function BoostService.GetRemaining(player: Player, id: string): number
	local map = Active[player.UserId]
	local st = map and map[id]
	if not st then
		return 0
	end
	return math.max(0, st.EndsAt - serverNow())
end

function BoostService.IsActive(player: Player, id: string): boolean
	return BoostService.GetRemaining(player, id) &gt; 0
end

-- Произведение множителей всех активных бустов с данным параметром ("Luck" | "MineSpeed" | "Coins")
function BoostService.GetMultiplier(player: Player, stat: string): number
	local map = Active[player.UserId]
	if not map then
		return 1
	end
	local mult = 1
	local now = serverNow()
	for id, st in pairs(map) do
		local cfg = GameConfig.BOOSTS.Items[id]
		if cfg and cfg.Stat == stat and st.EndsAt &gt; now then
			mult *= cfg.Multiplier
		end
	end
	return mult
end

-- Включает или ПРОДЛЕВАЕТ буст. Возвращает новый остаток в секундах (0 — буст неизвестен).
function BoostService.Activate(player: Player, id: string, seconds: number?): number
	local cfg = GameConfig.BOOSTS.Items[id]
	if not cfg then
		return 0
	end
	local map = Active[player.UserId]
	if not map then
		map = {}
		Active[player.UserId] = map
	end
	local now = serverNow()
	local st = map[id]
	local remaining = (st and st.EndsAt &gt; now) and (st.EndsAt - now) or 0
	local newRemaining = math.min(GameConfig.BOOSTS.MaxSeconds, remaining + math.max(1, seconds or cfg.Duration))
	map[id] = { EndsAt = now + newRemaining, Total = newRemaining }
	publish(player, id)
	notifyChanged(player)
	return newRemaining
end

-- Восстановление из сохранения: saved = { [id] = остаток секунд }
function BoostService.Load(player: Player, saved: any)
	local map: { [string]: BoostState } = {}
	Active[player.UserId] = map
	if type(saved) ~= "table" then
		return
	end
	local now = serverNow()
	for id, value in pairs(saved) do
		local remaining = tonumber(value)
		if type(id) == "string" and GameConfig.BOOSTS.Items[id] and remaining and remaining &gt;= 1 then
			local clamped = math.min(GameConfig.BOOSTS.MaxSeconds, math.floor(remaining))
			map[id] = { EndsAt = now + clamped, Total = clamped }
			publish(player, id)
		end
	end
end

-- Данные для сохранения: остаток секунд по каждому активному бусту
function BoostService.Serialize(player: Player): { [string]: number }
	local out: { [string]: number } = {}
	local map = Active[player.UserId]
	if map then
		local now = serverNow()
		for id, st in pairs(map) do
			local remaining = math.floor(st.EndsAt - now)
			if remaining &gt;= 1 then
				out[id] = remaining
			end
		end
	end
	return out
end

function BoostService.Clear(player: Player)
	Active[player.UserId] = nil
end

-- Фоновая проверка истечения (раз в полсекунды, без покадровых циклов)
function BoostService.Start()
	if LoopStarted then
		return
	end
	LoopStarted = true
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = serverNow()
			for _, player in ipairs(Players:GetPlayers()) do
				local map = Active[player.UserId]
				if map then
					local expired = false
					for id, st in pairs(map) do
						if st.EndsAt &lt;= now then
							map[id] = nil
							publish(player, id)
							expired = true
						end
					end
					if expired then
						notifyChanged(player)
					end
				end
			end
		end
	end)
end

return BoostService
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">NightCycleService</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🌙 МОДУЛЬ: NightCycleService (ServerScriptService.Modules.NightCycleService)
-- v52: серверный цикл День / Ночь, общий для всех игроков.
--   • Состояние — в атрибутах ReplicatedStorage: Phase, PhaseEndsAt, PhaseLength
--     (время конца в секундах workspace:GetServerTimeNow(), клиент считает остаток сам).
--   • В момент наступления ночи ВСЕ игроки мгновенно переносятся на базу
--     (PivotTo + сброс скорости), затем поднимается стена у входа в шахту.
--   • Ночью сервер раз в ~0.5 с проверяет зону шахты: любой, кто оказался внутри,
--     переносится на базу с предупреждением. Копка ночью запрещена на сервере.
--   • Утром стена опускается, шахта открывается, появляются Утренние жилы.
-- Длительности — GameConfig.PHASE.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local NightCycleService = {}

export type Deps = {
	MineManager: any,
	WorldBuilder: any,
	EquipmentManager: any,
	NightWallBuilder: any,
	WallRefs: any,
	BlocksFolder: Folder,
	OnBlockClicked: (Player, BasePart) -&gt; (),
	NoticeRemote: RemoteEvent,  -- сервер -&gt; клиент: разовые уведомления ("Night" | "Day" | "ZoneWarn")
	DayNightEvent: RemoteEvent, -- старый канал v51: баннер «Вечер!»
}

local P = GameConfig.PHASE
local rng = Random.new()
local IsNightNow = false
local Started = false
local LastZoneWarn: { [number]: number } = {}

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

-- Публикуем фазу. Phase пишется последним: к моменту сигнала остальные атрибуты уже новые.
local function setPhase(name: string, length: number): number
	local endsAt = serverNow() + length
	ReplicatedStorage:SetAttribute(P.AttrLength, length)
	ReplicatedStorage:SetAttribute(P.AttrEndsAt, endsAt)
	ReplicatedStorage:SetAttribute(P.AttrPhase, name)
	return endsAt
end

function NightCycleService.IsNight(): boolean
	return IsNightNow
end

-- Зона шахты для ночной проверки: весь карьер по X/Z на любой высоте
function NightCycleService.IsInMineZone(pos: Vector3): boolean
	local b = GameConfig.MINE_ZONE_BOUNDS
	return pos.X &gt;= b.MinX and pos.X &lt;= b.MaxX and pos.Z &gt;= b.MinZ and pos.Z &lt;= b.MaxZ
end

-- Мгновенный перенос игрока на базу. Возвращает true, если персонаж был перенесён.
function NightCycleService.TeleportToBase(player: Player, equipmentManager: any?): boolean
	local char = player.Character
	if not char then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") then
		return false
	end
	-- Погибший персонаж не трогаем: он возродится на базе сам (CharacterAdded в ServerMain)
	if hum and hum.Health &lt;= 0 then
		return false
	end
	if hum then
		hum.Sit = false
	end
	local spread = P.TeleportSpread
	local target = GameConfig.SPAWN_POSITION
		+ Vector3.new(rng:NextNumber(-spread.X, spread.X), 0, rng:NextNumber(-spread.Z, spread.Z))
	char:PivotTo(CFrame.new(target))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	if equipmentManager then
		pcall(equipmentManager.UpdateMinerHardHat, char, false)
	end
	return true
end

function NightCycleService.Start(deps: Deps)
	if Started then
		return
	end
	Started = true

	local function evictFromMine(player: Player)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return
		end
		if not NightCycleService.IsInMineZone(root.Position) then
			return
		end
		if NightCycleService.TeleportToBase(player, deps.EquipmentManager) then
			local now = os.clock()
			if (now - (LastZoneWarn[player.UserId] or 0)) &gt;= P.ZoneWarnCooldown then
				LastZoneWarn[player.UserId] = now
				deps.NoticeRemote:FireClient(player, "ZoneWarn")
			end
		end
	end

	local function beginNight()
		IsNightNow = true
		deps.MineManager.SetNightClosed(true)
		-- 1) сначала все на базу — никто не окажется под поднимающейся стеной
		for _, player in ipairs(Players:GetPlayers()) do
			NightCycleService.TeleportToBase(player, deps.EquipmentManager)
		end
		-- 2) шахта запечатывается: стена, периметр, «крышка» над карьером, ночной свет
		deps.NightWallBuilder.SetRaised(deps.WallRefs, true)
		deps.WorldBuilder.SetNightMineBarrierActive(true)
		deps.WorldBuilder.SetNightLightsActive(true)
		deps.MineManager.ClearMorningVeinsForNight()
		deps.NoticeRemote:FireAllClients("Night")
		-- 3) пока шахта пуста, восстанавливаем выработанные блоки к новому утру
		task.delay(P.BlockRespawnDelay, function()
			if IsNightNow then
				deps.MineManager.RespawnAllBlocksForNight(deps.BlocksFolder, deps.OnBlockClicked)
			end
		end)
	end

	local function beginDay(announce: boolean)
		IsNightNow = false
		deps.MineManager.SetNightClosed(false)
		deps.NightWallBuilder.SetRaised(deps.WallRefs, false)
		deps.WorldBuilder.SetNightMineBarrierActive(false)
		deps.WorldBuilder.SetNightLightsActive(false)
		if announce then
			local veinCount, veinList = deps.MineManager.SpawnMorningVeins()
			deps.NoticeRemote:FireAllClients("Day", veinCount, table.concat(veinList, ", "))
		end
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		LastZoneWarn[player.UserId] = nil
	end)

	-- Ведёт одну фазу. Длительность отсчитывается по монотонным часам сервера, а опубликованный
	-- момент конца подправляется, если серверное время «прыгнуло» (синхронизация часов), —
	-- поэтому ночь не может начаться раньше срока, а таймеры клиентов остаются точными.
	local function runPhase(name: string, length: number, interval: number, onTick: (left: number) -&gt; ())
		local started = os.clock()
		local endsAt = setPhase(name, length)
		while true do
			local left = length - (os.clock() - started)
			if left &lt;= 0 then
				break
			end
			local expected = serverNow() + left
			if math.abs(expected - endsAt) &gt; 0.75 then
				endsAt = expected
				ReplicatedStorage:SetAttribute(P.AttrEndsAt, endsAt)
			end
			onTick(left)
			task.wait(math.clamp(left, 0.05, interval))
		end
	end

	task.spawn(function()
		-- Первая фаза выставляется сразу (до первого ожидания), чтобы атрибуты существовали до входа игроков
		beginDay(false)
		while true do
			-- ДЕНЬ: за N секунд до ночи — предупреждение
			local eveningAnnounced = false
			runPhase("Day", P.DaySeconds, 0.25, function(left: number)
				if not eveningAnnounced and left &lt;= P.EveningWarningSeconds then
					eveningAnnounced = true
					deps.DayNightEvent:FireAllClients(
						"EveningWarning",
						string.format("🌆 Вечер! Шахта закроется через %d с — заканчивай копать!", math.ceil(left))
					)
				end
			end)

			-- НОЧЬ: телепорт, стена, проверка зоны раз в ZoneCheckInterval
			beginNight()
			runPhase("Night", P.NightSeconds, P.ZoneCheckInterval, function(_left: number)
				for _, player in ipairs(Players:GetPlayers()) do
					evictFromMine(player)
				end
			end)

			-- УТРО
			beginDay(true)
		end
	end)
end

return NightCycleService
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">NightWallBuilder</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🌙 МОДУЛЬ: NightWallBuilder (ServerScriptService.Modules.NightWallBuilder)
-- «Большая штука» у входа в шахту: монолит из чёрного базальта с красными рунами,
-- который ночью поднимается из земли и наглухо закрывает проход. Плюс невидимый
-- периметр с видимым красным забором, чтобы карьер нельзя было обойти.
-- Сервер НЕ анимирует стену: SetRaised мгновенно переключает состояние, а плавный
-- подъём/опускание (твин Root.CFrame), пульсацию рун, таймер и звук играет клиент.
-- Все размеры, цвета и тексты — в GameConfig.NIGHT_WALL (config_parts/30_night_wall.lua).
-- ============================================================================

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local PartKit = require(Modules:WaitForChild("PartKit"))

local NightWallBuilder = {}

export type WallRefs = {
	Model: Model,
	Root: BasePart,
	DownCFrame: CFrame,
	UpCFrame: CFrame,
	Blockers: { BasePart },
	FencePanels: { BasePart },
	Emitters: { ParticleEmitter },
	Lights: { Light },
}

local TAG_MODEL = "NightMineWall"
local TAG_RUNE = "NightWallRune"
local TAG_COUNTDOWN = "NightWallCountdown"
local TAG_DUST = "NightWallDust"

-- Токены для защиты от устаревшего применения позы (день→ночь→день за короткое время)
local poseTokens: { [Model]: number } = setmetatable({}, { __mode = "k" }) :: any

-- ----------------------------------------------------------------------------
-- Сборка подвижной стены
-- ----------------------------------------------------------------------------

-- Собирает все видимые детали стены в ПОДНЯТОЙ позе и приваривает их к Root
local function buildWall(model: Model, root: BasePart, upCF: CFrame, rng: Random): ({ Light }, { ParticleEmitter })
	local cfg = GameConfig.NIGHT_WALL
	local col = cfg.Colors
	local H = cfg.Height
	local halfH = H / 2
	local lights: { Light } = {}
	local emitters: { ParticleEmitter } = {}

	local folder = Instance.new("Folder")
	folder.Name = "Wall"
	folder.Parent = model

	-- Добавляет деталь: локальный CFrame задан относительно центра стены
	local function add(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, glow: boolean?): Part
		local p = PartKit.Block(folder, name, size, upCF * localCF, color, material, {
			Anchored = false,
			Massless = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = glow ~= true,
		})
		PartKit.WeldTo(p, root)
		return p
	end

	local function addWedge(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material): WedgePart
		local p = PartKit.Wedge(folder, name, size, upCF * localCF, color, material, {
			Anchored = false,
			Massless = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		})
		PartKit.WeldTo(p, root)
		return p
	end

	-- Основные размеры слоёв
	local bodyBottom = -halfH + cfg.PlinthHeight
	local bodyTop = halfH - cfg.CapHeight
	local bodyH = bodyTop - bodyBottom
	local bodyMidY = (bodyTop + bodyBottom) / 2
	local plinthMidY = -halfH + cfg.PlinthHeight / 2
	local halfBody = cfg.BodyThickness / 2
	local halfThick = cfg.Thickness / 2
	local buttX = cfg.BodyWidth / 2 + cfg.ButtressWidth / 2 -- центр контрфорса по X

	-- Плита-основание (тяжёлый цоколь) и юбка
	add("Plinth", Vector3.new(cfg.Width, cfg.PlinthHeight, cfg.Thickness), CFrame.new(0, plinthMidY, 0), col.BasaltDark, Enum.Material.Basalt)
	add("Skirt", Vector3.new(cfg.SkirtWidth, cfg.SkirtHeight, cfg.SkirtThickness), CFrame.new(0, -halfH + cfg.SkirtHeight / 2, 0), col.Rock, Enum.Material.Rock)

	-- Углублённые плиты на цоколе (обе стороны)
	for _, s in ipairs({ 1, -1 }) do
		for _, x in ipairs({ -9, 0, 9 }) do
			add("PlinthInset", Vector3.new(6, cfg.PlinthHeight - 1.1, 0.2), CFrame.new(x, plinthMidY + 0.2, s * (halfThick + 0.05)), col.Slate, Enum.Material.Slate)
		end
	end

	-- Сколы-клинья на юбке (обе стороны); у задней стороны клин развёрнут на 180°
	for _, s in ipairs({ 1, -1 }) do
		for _, x in ipairs({ -13.5, -4.5, 4.5, 13.5 }) do
			local yaw = if s == 1 then 0 else math.pi
			addWedge("Chip", Vector3.new(1.2, 0.8, 0.4), CFrame.new(x, -halfH + cfg.SkirtHeight + 0.4 - 0.05, s * (halfThick + 0.2)) * CFrame.Angles(0, yaw + math.rad(rng:NextNumber(-8, 8)), 0), col.Rock, Enum.Material.Rock)
		end
	end

	-- Центральное тело, шапка, контрфорсы
	add("Body", Vector3.new(cfg.BodyWidth, bodyH, cfg.BodyThickness), CFrame.new(0, bodyMidY, 0), col.Basalt, Enum.Material.Basalt)
	add("Cap", Vector3.new(cfg.Width, cfg.CapHeight, cfg.Thickness), CFrame.new(0, halfH - cfg.CapHeight / 2, 0), col.BasaltDark, Enum.Material.Basalt)
	for _, sx in ipairs({ -1, 1 }) do
		add("Buttress", Vector3.new(cfg.ButtressWidth, bodyH, cfg.Thickness), CFrame.new(sx * buttX, bodyMidY, 0), col.Slate, Enum.Material.Slate)
		-- Рёбра между телом и контрфорсом (выступают с обеих сторон)
		add("Rib", Vector3.new(0.9, bodyH, cfg.Thickness + 0.2), CFrame.new(sx * (cfg.BodyWidth / 2 - 0.7), bodyMidY, 0), col.SlateLight, Enum.Material.Slate)
		-- Ступенчатое «крыло» по внешней кромке
		add("Wing", Vector3.new(1.2, bodyH * 0.65, cfg.Thickness + 0.6), CFrame.new(sx * (cfg.Width / 2 - 0.6), bodyBottom + bodyH * 0.325, 0), col.Rock, Enum.Material.Rock)
	end

	-- Панель-основа под надпись и выступающие карнизы выше/ниже неё
	local ph = cfg.PanelSize.Y
	local panelTop = cfg.PanelCenterY + ph / 2
	local panelBottom = cfg.PanelCenterY - ph / 2
	local upperLedgeY = panelTop + 0.2
	local lowerLedgeY = panelBottom - 0.2
	add("LedgeUpper", Vector3.new(cfg.BodyWidth, 0.3, cfg.BodyThickness + 0.5), CFrame.new(0, upperLedgeY, 0), col.SlateLight, Enum.Material.Slate)
	add("LedgeLower", Vector3.new(cfg.BodyWidth, 0.3, cfg.BodyThickness + 0.5), CFrame.new(0, lowerLedgeY, 0), col.SlateLight, Enum.Material.Slate)

	-- Углублённые вставки на контрфорсах (обе стороны)
	for _, s in ipairs({ 1, -1 }) do
		for _, sx in ipairs({ -1, 1 }) do
			add("ButtressInset", Vector3.new(1.8, bodyH - 2.2, 0.2), CFrame.new(sx * (buttX - 0.2), bodyMidY, s * (halfThick + 0.1)), col.BasaltDark, Enum.Material.Slate)
		end
	end

	-- Таблички с SurfaceGui. Нормаль +Z (к спавну) = грань Back, нормаль −Z (к яме) = грань Front.
	local panelZ = halfBody + cfg.PanelThickness / 2
	local panelFront = add("SignPanelFront", Vector3.new(cfg.PanelSize.X, ph, cfg.PanelThickness), CFrame.new(0, cfg.PanelCenterY, panelZ), col.Panel, Enum.Material.SmoothPlastic)
	local panelBack = add("SignPanelBack", Vector3.new(cfg.PanelSize.X, ph, cfg.PanelThickness), CFrame.new(0, cfg.PanelCenterY, -panelZ), col.Panel, Enum.Material.SmoothPlastic)
	NightWallBuilder._BuildSign(panelFront, Enum.NormalId.Back)
	NightWallBuilder._BuildSign(panelBack, Enum.NormalId.Front)

	-- Красные неоновые руны (по 14 деталей на сторону), все с тегом NightWallRune
	local runeZBody = halfBody + 0.1
	local runeZButt = halfThick + 0.25
	local rowTopY = (upperLedgeY + 0.15 + bodyTop) / 2
	local rowBottomY = (bodyBottom + lowerLedgeY - 0.15) / 2
	local lightHosts: { Part } = {}

	local function addRune(s: number, x: number, y: number, w: number, h: number, z: number, diamond: boolean): Part
		local rot = if diamond then CFrame.Angles(0, 0, math.rad(45)) else CFrame.identity
		local p = add("Rune", Vector3.new(w, h, 0.2), CFrame.new(x, y, s * z) * rot, col.Rune, Enum.Material.Neon, true)
		CollectionService:AddTag(p, TAG_RUNE)
		return p
	end

	for _, s in ipairs({ 1, -1 }) do
		-- Верхний ряд: ромбы и вертикальные чёрточки (7)
		local mainDiamond = addRune(s, 0, rowTopY, 0.9, 0.9, runeZBody, true)
		table.insert(lightHosts, mainDiamond)
		addRune(s, -5, rowTopY, 0.6, 0.6, runeZBody, true)
		addRune(s, 5, rowTopY, 0.6, 0.6, runeZBody, true)
		for _, x in ipairs({ -7.6, -2.4, 2.4, 7.6 }) do
			addRune(s, x, rowTopY, 0.22, 1.3, runeZBody, false)
		end
		-- Нижний ряд: длинная планка и два ромба (3)
		local bar = addRune(s, 0, rowBottomY, 7, 0.22, runeZBody, false)
		table.insert(lightHosts, bar)
		addRune(s, -5.5, rowBottomY, 0.55, 0.55, runeZBody, true)
		addRune(s, 5.5, rowBottomY, 0.55, 0.55, runeZBody, true)
		-- Боковые колонны на контрфорсах (по 2 на контрфорс = 4)
		for _, sx in ipairs({ -1, 1 }) do
			addRune(s, sx * buttX, bodyMidY + 1.2, 0.28, 6.5, runeZButt, false)
			addRune(s, sx * buttX, bodyMidY - 4.2, 0.8, 0.8, runeZButt, true)
		end
	end

	-- Красные огни: по одному в центральном ромбе и нижней планке каждой стороны (4)
	local lc = cfg.Light
	for _, host in ipairs(lightHosts) do
		local l = PartKit.PointLight(host, lc.Color, lc.Brightness, lc.Range)
		l.Enabled = false
		table.insert(lights, l)
	end

	-- Шипы по верху: клинья-плавники разной высоты, чередуются по направлению
	local n = cfg.SpikeCount
	local span = cfg.Width - 2.4
	for i = 1, n do
		local x = -span / 2 + (i - 1) * span / (n - 1)
		local centerBoost = 1 - math.abs(x) / (cfg.Width / 2)
		local h = cfg.SpikeMinHeight + (cfg.SpikeMaxHeight - cfg.SpikeMinHeight) * (0.3 + 0.7 * centerBoost) * rng:NextNumber(0.85, 1)
		h = math.min(h, cfg.SpikeMaxHeight)
		local yaw = (if i % 2 == 0 then math.pi else 0) + math.rad(rng:NextNumber(-6, 6))
		local color = PartKit.Lighten(col.Spike, rng:NextNumber(0, 0.12))
		addWedge("Spike", Vector3.new(1.8, h, 2.2), CFrame.new(x, halfH + h / 2 - 0.05, 0) * CFrame.Angles(0, yaw, 0), color, Enum.Material.Basalt)
	end
	-- Боковые «рога» на краях: клинья, повёрнутые вдоль X
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -0.8, 0.8 }) do
			local yaw = sx * math.pi / 2
			addWedge("Horn", Vector3.new(1.1, 2.6, 1.6), CFrame.new(sx * (cfg.Width / 2 - 0.8), halfH + 1.25, sz) * CFrame.Angles(0, yaw, 0), col.Spike, Enum.Material.Basalt)
		end
	end

	-- Невидимые точки дыма по верху стены
	local sm = cfg.Smoke
	for _, x in ipairs({ -9, 0, 9 }) do
		local anchor = PartKit.Block(folder, "SmokeAnchor", Vector3.new(1, 0.2, 1), upCF * CFrame.new(x, halfH + 0.1, 0), col.Spike, Enum.Material.SmoothPlastic, {
			Anchored = false,
			Massless = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Transparency = 1,
		})
		PartKit.WeldTo(anchor, root)
		local pe = PartKit.Emitter(anchor, {
			Name = "Smoke",
			Texture = PartKit.TEXTURE_SMOKE,
			Color = sm.Color1,
			Color2 = sm.Color2,
			Rate = sm.Rate,
			Lifetime = sm.Lifetime,
			Speed = sm.Speed,
			SizeStart = sm.SizeStart,
			SizeEnd = sm.SizeEnd,
			Spread = 25,
			LightEmission = 0,
			Transparency = sm.Transparency,
			Acceleration = Vector3.new(0, 1, 0),
			Drag = 0.5,
			RotSpeed = NumberRange.new(-20, 20),
			Enabled = false,
		})
		pe.EmissionDirection = Enum.NormalId.Top
		table.insert(emitters, pe)
	end

	return lights, emitters
end

-- Надпись на табличке: фон, красная обводка, 4 строки (третья — таймер с тегом)
function NightWallBuilder._BuildSign(panel: BasePart, face: Enum.NormalId)
	local g = GameConfig.NIGHT_WALL.Gui

	local gui = Instance.new("SurfaceGui")
	gui.Name = "NightSign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = g.PixelsPerStud
	gui.LightInfluence = 0
	gui.Brightness = g.Brightness
	gui.AlwaysOnTop = false
	gui.MaxDistance = 600
	gui.ResetOnSpawn = false

	local back = Instance.new("Frame")
	back.Name = "Backdrop"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = g.BackdropColor
	back.BackgroundTransparency = g.BackdropTransparency
	back.BorderSizePixel = 0
	back.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, g.CornerRadius)
	corner.Parent = back

	local stroke = Instance.new("UIStroke")
	stroke.Color = g.StrokeColor
	stroke.Thickness = g.StrokeThickness
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = back

	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(34, 10, 18), Color3.fromRGB(8, 5, 12))
	grad.Parent = back

	-- Создаёт строку надписи с крупным шрифтом и контуром
	local function label(name: string, text: string, color: Color3, y: number, h: number): TextLabel
		local t = Instance.new("TextLabel")
		t.Name = name
		t.Position = UDim2.fromScale(0.04, y)
		t.Size = UDim2.fromScale(0.92, h)
		t.BackgroundTransparency = 1
		t.Text = text
		t.TextColor3 = color
		t.Font = g.Font
		t.TextScaled = true
		t.TextXAlignment = Enum.TextXAlignment.Center
		t.TextYAlignment = Enum.TextYAlignment.Center
		local ts = Instance.new("UIStroke")
		ts.Color = g.TextStrokeColor
		ts.Thickness = 3
		ts.Parent = t
		t.Parent = back
		return t
	end

	label("Title", g.Title, g.TitleColor, 0.04, 0.27)
	label("Subtitle", g.Subtitle, g.SubtitleColor, 0.31, 0.26)
	local countdown = label("Countdown", g.Countdown, g.CountdownColor, 0.58, 0.21)
	label("Hint", g.Hint, g.HintColor, 0.8, 0.15)
	CollectionService:AddTag(countdown, TAG_COUNTDOWN)

	gui.Parent = panel
end

-- ----------------------------------------------------------------------------
-- Пыль у основания (не приварена, остаётся на уровне земли)
-- ----------------------------------------------------------------------------
local function buildDust(model: Model): { ParticleEmitter }
	local cfg = GameConfig.NIGHT_WALL
	local d = cfg.Dust
	local base = PartKit.Block(model, "DustBase", Vector3.new(cfg.Width, d.Height, cfg.Thickness + 2), CFrame.new(cfg.CenterX, d.Y, cfg.CenterZ), d.Color1, Enum.Material.SmoothPlastic, {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Transparency = 1,
	})

	-- Три излучателя разного характера: крупные клубы, мелкая быстрая пыль и тёмные облака
	local variants = {
		{ c1 = d.Color1, c2 = d.Color2, s0 = d.SizeStart, s1 = d.SizeEnd, life = d.Lifetime, speed = d.Speed, spread = 55 },
		{ c1 = d.Color2, c2 = d.Color1, s0 = d.SizeStart * 0.5, s1 = d.SizeEnd * 0.55, life = NumberRange.new(1, 1.8), speed = NumberRange.new(8, 14), spread = 70 },
		{ c1 = PartKit.Darken(d.Color2, 0.35), c2 = d.Color2, s0 = d.SizeStart * 1.3, s1 = d.SizeEnd * 1.4, life = NumberRange.new(2.4, 3.6), speed = NumberRange.new(2, 5), spread = 40 },
	}
	local result: { ParticleEmitter } = {}
	for _, v in ipairs(variants) do
		local pe = PartKit.Emitter(base, {
			Name = "Dust",
			Texture = PartKit.TEXTURE_SMOKE,
			Color = v.c1,
			Color2 = v.c2,
			Rate = 0,
			Lifetime = v.life,
			Speed = v.speed,
			SizeStart = v.s0,
			SizeEnd = v.s1,
			Spread = v.spread,
			LightEmission = 0,
			Transparency = d.Transparency,
			Acceleration = Vector3.new(0, 1.5, 0),
			Drag = 2,
			RotSpeed = NumberRange.new(-30, 30),
			Enabled = false,
		})
		pe.Shape = Enum.ParticleEmitterShape.Box
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		pe.EmissionDirection = Enum.NormalId.Top
		CollectionService:AddTag(pe, TAG_DUST)
		table.insert(result, pe)
	end
	return result
end

-- ----------------------------------------------------------------------------
-- Периметр: невидимые блокировщики + красный забор
-- ----------------------------------------------------------------------------
local function buildPerimeter(model: Model): ({ BasePart }, { BasePart })
	local cfg = GameConfig.NIGHT_WALL
	local per = cfg.Perimeter
	local fence = cfg.Fence
	local T = per.Thickness
	local wallTop = GameConfig.WALL_HEIGHT
	local gateX = per.GateHalfWidth
	local sz = cfg.CenterZ

	local blockers: { BasePart } = {}
	local panels: { BasePart } = {}

	local blockerFolder = Instance.new("Folder")
	blockerFolder.Name = "Blockers"
	blockerFolder.Parent = model
	local fenceFolder = Instance.new("Folder")
	fenceFolder.Name = "Fence"
	fenceFolder.Parent = model

	-- Центральный блокировщик в проёме: стена целиком, высота WALL_HEIGHT (не перепрыгнуть)
	local gate = PartKit.Block(blockerFolder, "WallBlocker", Vector3.new(cfg.Width, wallTop, cfg.Thickness), CFrame.new(cfg.CenterX, wallTop / 2, cfg.CenterZ), Color3.new(), Enum.Material.SmoothPlastic, {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Transparency = 1,
	})
	table.insert(blockers, gate)

	-- Участки кольца: a→b по осям; ext — на сколько удлинить конец, чтобы углы перекрывались
	local legs = {
		{ name = "PerimSouthWest", a = Vector3.new(-gateX, 0, sz), b = Vector3.new(per.WestX, 0, sz), extA = 0, extB = T / 2 },
		{ name = "PerimWest", a = Vector3.new(per.WestX, 0, sz), b = Vector3.new(per.WestX, 0, per.NorthZ), extA = T / 2, extB = T / 2 },
		{ name = "PerimNorth", a = Vector3.new(per.WestX, 0, per.NorthZ), b = Vector3.new(per.EastX, 0, per.NorthZ), extA = T / 2, extB = T / 2 },
		{ name = "PerimEast", a = Vector3.new(per.EastX, 0, per.NorthZ), b = Vector3.new(per.EastX, 0, sz), extA = T / 2, extB = T / 2 },
		{ name = "PerimSouthEast", a = Vector3.new(per.EastX, 0, sz), b = Vector3.new(gateX, 0, sz), extA = T / 2, extB = 0 },
	}

	local capEdge = fence.PostWidth / 2 + 0.2
	for li, leg in ipairs(legs) do
		local len = (leg.b - leg.a).Magnitude
		local dir = (leg.b - leg.a).Unit
		local startP = leg.a - dir * leg.extA
		local stopP = leg.b + dir * leg.extB
		local totalLen = len + leg.extA + leg.extB
		local mid = (startP + stopP) / 2
		local alongX = math.abs(dir.X) &gt; 0.5

		-- Невидимый блокировщик (по умолчанию без коллизии, SetRaised включает)
		local bSize = if alongX then Vector3.new(totalLen, wallTop, T) else Vector3.new(T, wallTop, totalLen)
		local blocker = PartKit.Block(blockerFolder, leg.name, bSize, CFrame.new(mid.X, wallTop / 2, mid.Z), Color3.new(), Enum.Material.SmoothPlastic, {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Transparency = 1,
		})
		table.insert(blockers, blocker)

		-- Красная энергопанель (днём полностью прозрачна)
		local pSize = if alongX then Vector3.new(totalLen, fence.PanelHeight, fence.PanelThickness) else Vector3.new(fence.PanelThickness, fence.PanelHeight, totalLen)
		local panel = PartKit.Block(fenceFolder, "FencePanel", pSize, CFrame.new(mid.X, fence.PanelHeight / 2, mid.Z), fence.PanelColor, fence.PanelMaterial, {
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Transparency = 1,
		})
		table.insert(panels, panel)

		-- Столбы через каждые ~PostSpacing studs; у проёма отступаем от стены
		local count = math.max(1, math.ceil(len / fence.PostSpacing))
		local points: { Vector3 } = {}
		for k = 0, count - 1 do
			local offset = len * k / count
			if li == 1 and k == 0 then
				offset = capEdge
			end
			table.insert(points, leg.a + dir * offset)
		end
		if li == #legs then
			table.insert(points, leg.b - dir * capEdge)
		end
		for _, pt in ipairs(points) do
			local postH = fence.PostHeight
			PartKit.Block(fenceFolder, "FencePost", Vector3.new(fence.PostWidth, postH, fence.PostWidth), CFrame.new(pt.X, postH / 2 - 1, pt.Z), fence.PostColor, Enum.Material.Basalt)
			PartKit.Block(fenceFolder, "FenceCap", fence.CapSize, CFrame.new(pt.X, postH - 1 + fence.CapSize.Y / 2, pt.Z), fence.CapDayColor, Enum.Material.Neon, { CastShadow = false })
		end
	end

	return blockers, panels
end

-- ----------------------------------------------------------------------------
-- Публичный API
-- ----------------------------------------------------------------------------

-- Строит стену, периметр и пыль. Модель возвращается в ОПУЩЕННОЙ позе, всё выключено.
function NightWallBuilder.Build(parent: Instance): WallRefs
	local cfg = GameConfig.NIGHT_WALL
	local rng = Random.new(cfg.Seed)

	local upCF = CFrame.new(cfg.CenterX, cfg.Height / 2, cfg.CenterZ)
	local downCF = upCF - Vector3.new(0, cfg.SinkDepth, 0)

	local model = Instance.new("Model")
	model.Name = cfg.Name

	-- Невидимый корень, к которому приварена вся стена; клиент твинит именно его
	local root = PartKit.Block(model, "Root", Vector3.new(1, 1, 1), upCF, cfg.Colors.Basalt, Enum.Material.SmoothPlastic, {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Transparency = 1,
	})
	model.PrimaryPart = root

	local lights, emitters = buildWall(model, root, upCF, rng)
	buildDust(model)
	local blockers, panels = buildPerimeter(model)

	-- Только теперь, когда всё приварено, опускаем корень: сборка следует за ним
	root.CFrame = downCF

	model:SetAttribute("Raised", false)
	model:SetAttribute("DownCFrame", downCF)
	model:SetAttribute("UpCFrame", upCF)
	model:SetAttribute("LiftSeconds", cfg.LiftSeconds)
	CollectionService:AddTag(model, TAG_MODEL)
	model.Parent = parent

	return {
		Model = model,
		Root = root,
		DownCFrame = downCF,
		UpCFrame = upCF,
		Blockers = blockers,
		FencePanels = panels,
		Emitters = emitters,
		Lights = lights,
	}
end

-- Мгновенное авторитетное переключение. Коллизия включается сразу, поза Root
-- выставляется после времени анимации (для поздно зашедших игроков).
function NightWallBuilder.SetRaised(refs: WallRefs, raised: boolean)
	local cfg = GameConfig.NIGHT_WALL
	local model = refs.Model
	local changed = model:GetAttribute("Raised") ~= raised

	model:SetAttribute("Raised", raised)

	for _, b in ipairs(refs.Blockers) do
		b.CanCollide = raised
	end
	for _, e in ipairs(refs.Emitters) do
		e.Enabled = raised
	end
	for _, l in ipairs(refs.Lights) do
		l.Enabled = raised
	end
	for _, p in ipairs(refs.FencePanels) do
		p.Transparency = if raised then cfg.Fence.FenceTransparency else 1
	end

	local fenceFolder = model:FindFirstChild("Fence")
	if fenceFolder then
		local capColor = if raised then cfg.Fence.CapNightColor else cfg.Fence.CapDayColor
		for _, child in ipairs(fenceFolder:GetChildren()) do
			if child.Name == "FenceCap" and child:IsA("BasePart") then
				child.Color = capColor
			end
		end
	end

	-- Повторный вызов с тем же значением не трогает уже запланированную позу
	if not changed then
		return
	end

	local token = (poseTokens[model] or 0) + 1
	poseTokens[model] = token
	local target = if raised then refs.UpCFrame else refs.DownCFrame
	local liftSeconds = model:GetAttribute("LiftSeconds")
	local delaySeconds = (if typeof(liftSeconds) == "number" then liftSeconds else cfg.LiftSeconds) + 0.5

	task.delay(delaySeconds, function()
		if poseTokens[model] == token and model.Parent ~= nil then
			refs.Root.CFrame = target
		end
	end)
end

return NightWallBuilder
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">ShopService</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🛒 МОДУЛЬ: ShopService (ServerScriptService.Modules.ShopService)
-- v52: серверная покупка бустов (вкладка «⚡ Бусты» в меню магазина).
-- Клиент только ПРОСИТ («купи буст Luck»), сервер проверяет всё сам: тип аргументов,
-- кулдаун, расстояние до магазина, цену и монеты. Клиенту возвращается результат для
-- анимации окна. Кирки и рюкзаки покупаются как раньше (Remote-ы BuyPickaxe / BuyBackpack).
-- Настройки — GameConfig.SHOP_UI и GameConfig.BOOSTS.
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local ShopService = {}

export type Deps = {
	DataManager: any,
	BoostService: any,
	SyncRemote: RemoteEvent,
	ActionRemote: RemoteEvent, -- клиент -&gt; сервер: (action: string, arg: any)
	ResultRemote: RemoteEvent, -- сервер -&gt; клиент: (ok: boolean, action: string, info: { [string]: any })
}

local LastAction: { [number]: number } = {}
local Initialized = false

-- Игрок должен стоять у магазина (по горизонтали) и на уровне площади
local function isNearShop(root: BasePart): boolean
	local center = GameConfig.GREEN_SHOP_PAD_POS
	local flat = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude
	return flat &lt;= GameConfig.SHOP_UI.MaxDistance and math.abs(root.Position.Y - center.Y) &lt;= 12
end

function ShopService.Init(deps: Deps)
	if Initialized then
		return
	end
	Initialized = true

	deps.ActionRemote.OnServerEvent:Connect(function(player: Player, action: any, arg: any)
		if action ~= "BuyBoost" or type(arg) ~= "string" then
			return
		end
		local now = os.clock()
		if (now - (LastAction[player.UserId] or 0)) &lt; GameConfig.SHOP_UI.ActionCooldown then
			return
		end
		LastAction[player.UserId] = now

		local cfg = GameConfig.BOOSTS.Items[arg]
		if not cfg or not cfg.InShop then
			return
		end
		local profile = deps.DataManager.GetProfile(player)
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not profile or not hum or hum.Health &lt;= 0 or not root or not root:IsA("BasePart") then
			return
		end
		if not isNearShop(root) then
			deps.ResultRemote:FireClient(player, false, action, { Id = cfg.Id, Reason = "Far" })
			return
		end
		if (profile.Coins or 0) &lt; cfg.Price then
			deps.ResultRemote:FireClient(player, false, action, { Id = cfg.Id, Reason = "NoCoins" })
			return
		end
		profile.Coins -= cfg.Price
		local remaining = deps.BoostService.Activate(player, cfg.Id)
		deps.DataManager.UpdateLeaderstats(player)
		deps.DataManager.SyncToClient(player, deps.SyncRemote)
		deps.ResultRemote:FireClient(player, true, action, { Id = cfg.Id, Remaining = remaining })
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		LastAction[player.UserId] = nil
	end)
end

return ShopService
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">SpawnPlazaBuilder</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🪨 МОДУЛЬ: SpawnPlazaBuilder (ServerScriptService.Modules.SpawnPlazaBuilder)
-- Процедурная каменная площадь спавна: тёмная подложка, плиты «вразбежку» с
-- разной высотой/наклоном/оттенком, трещины, мох, камешки, бордюр-скос,
-- врезанный постамент с неоновой руной, фонари, валуны и кристаллы.
-- Только Part/WedgePart/Neon и встроенные материалы — без изображений.
-- Вся раскладка берётся из Random.new(Seed): площадь всегда одинакова.
-- ============================================================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local GameConfig = require(Modules:WaitForChild("GameConfig"))
local PartKit = require(Modules:WaitForChild("PartKit"))

local SpawnPlazaBuilder = {}

export type PlazaRefs = { Model: Model, SpawnLocation: SpawnLocation }

type Style = { Material: Enum.Material, Weight: number, Colors: { Color3 } }

-- Запись о плите: нужна, чтобы класть детали точно в её локальной системе координат
type Slab = {
	Cf: CFrame, -- центр плиты с учётом рысканья и наклона
	W: number,
	D: number,
	Thick: number,
	Gap: number,
	TopY: number,
	Used: { [number]: boolean }, -- занятые углы (фаска / мох)
}

type SlabSpec = {
	Name: string,
	CX: number,
	CZ: number,
	W: number,
	D: number,
	Gap: number,
	TopMin: number,
	TopMax: number,
	Thick: number,
	Styles: { Style },
}

type Circle = { X: number, Z: number, R: number }

-- Углы плиты в локальных координатах (знаки X/Z)
local CORNERS: { { number } } = { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }

local C = GameConfig.SPAWN_PLAZA

-- ============================== ПОМОЩНИКИ ===================================

local function range(rng: Random, lo: number, hi: number): number
	return lo + (hi - lo) * rng:NextNumber()
end

local function pickStyle(rng: Random, styles: { Style }): Style
	local total = 0
	for _, s in ipairs(styles) do
		total += s.Weight
	end
	local roll = rng:NextNumber() * total
	for _, s in ipairs(styles) do
		roll -= s.Weight
		if roll &lt;= 0 then
			return s
		end
	end
	return styles[#styles]
end

local function pickColor(rng: Random, colors: { Color3 }): Color3
	return colors[rng:NextInteger(1, #colors)]
end

-- Лёгкий разброс яркости, чтобы соседние плиты не были одного оттенка
local function tint(c: Color3, rng: Random, amount: number): Color3
	local k = 1 + (rng:NextNumber() * 2 - 1) * amount
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

-- Делит отрезок [a; b] на неравные части (границы возвращаются списком)
local function splitSpan(a: number, b: number, target: number, jitter: number, rng: Random): { number }
	local n = math.max(1, math.floor((b - a) / target + 0.5))
	local weights: { number } = {}
	local total = 0
	for i = 1, n do
		local w = 1 + (rng:NextNumber() * 2 - 1) * jitter
		weights[i] = w
		total += w
	end
	local bounds: { number } = { a }
	local acc = 0
	for i = 1, n - 1 do
		acc += weights[i]
		bounds[i + 1] = a + (b - a) * acc / total
	end
	bounds[n + 1] = b
	return bounds
end

local function newFolder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- Малый наклон с ограничением перепада высот по плите
local function slabTilt(rng: Random, w: number, d: number, maxRise: number): (number, number, number)
	local S = C.Slab
	local tx = math.rad(range(rng, -S.MaxTiltDeg, S.MaxTiltDeg))
	local tz = math.rad(range(rng, -S.MaxTiltDeg, S.MaxTiltDeg))
	local rise = d / 2 * math.abs(math.sin(tx)) + w / 2 * math.abs(math.sin(tz))
	if rise &gt; maxRise then
		local k = maxRise / rise
		tx *= k
		tz *= k
		rise = maxRise
	end
	return tx, tz, rise
end

-- Создаёт одну плиту (колизия включена) и возвращает запись о ней
local function makeSlab(parent: Instance, spec: SlabSpec, rng: Random): Slab
	local style = pickStyle(rng, spec.Styles)
	local color = tint(pickColor(rng, style.Colors), rng, C.Slab.ColorJitter)
	local yaw = math.rad(range(rng, -C.Slab.MaxYawDeg, C.Slab.MaxYawDeg))
	local tx, tz, rise = slabTilt(rng, spec.W, spec.D, math.min(C.Slab.MaxRise, (spec.TopMax - spec.TopMin) * 0.45))
	local lo, hi = spec.TopMin + rise, spec.TopMax - rise
	local top = if hi &gt; lo then range(rng, lo, hi) else (spec.TopMin + spec.TopMax) / 2
	local cf = CFrame.new(spec.CX, top - spec.Thick / 2, spec.CZ) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(tx, 0, tz)
	PartKit.Block(parent, spec.Name, Vector3.new(spec.W, spec.Thick, spec.D), cf, color, style.Material, { CanCollide = true })
	return { Cf = cf, W = spec.W, D = spec.D, Thick = spec.Thick, Gap = spec.Gap, TopY = top, Used = {} }
end

-- Срезанный угол: плоский тёмный треугольник на верхней грани плиты.
-- Клин лежит «на боку»: локальная X — вверх, прямой угол — в углу плиты.
local function addChamfer(parent: Instance, slab: Slab, corner: number, c1: number, c2: number)
	local sx, sz = CORNERS[corner][1], CORNERS[corner][2]
	local ix = Vector3.new(-sx, 0, 0)
	local iz = Vector3.new(0, 0, -sz)
	local b, a, h, d
	if sx == sz then
		b, a, h, d = ix, iz, c1, c2
	else
		b, a, h, d = iz, ix, c2, c1
	end
	local vertex = Vector3.new(sx * slab.W / 2, slab.Thick / 2 + C.Details.Lift, sz * slab.D / 2)
	local center = vertex + b * (h / 2) + a * (d / 2)
	local localCf = CFrame.fromMatrix(center, Vector3.new(0, 1, 0), b, -a)
	PartKit.Wedge(parent, "Скос", Vector3.new(0.02, h, d), slab.Cf * localCf, C.CrevicePlateColor, Enum.Material.Slate)
	slab.Used[corner] = true
end

-- ============================ ПОДЛОЖКА И БОРДЮР =============================

local function buildPlate(parent: Instance)
	local B, P, W = C.Bounds, C.Plate, C.Border.Width
	local sizeX = (B.MaxX - B.MinX) - 2 * W
	local sizeZ = (B.MaxZ - B.MinZ) - 2 * W
	local cx = (B.MinX + B.MaxX) / 2
	local cz = (B.MinZ + B.MaxZ) / 2
	PartKit.Block(
		parent,
		"ТёмнаяПодложка",
		Vector3.new(sizeX, P.Thickness, sizeZ),
		CFrame.new(cx, P.TopY - P.Thickness / 2, cz),
		P.Color,
		P.Material,
		{ CanCollide = true }
	)
end

-- Один сегмент бордюра: клин-скос (высокая грань — внутрь площади) или плоская вставка у тропы.
-- Клин поднимается к локальной +Z, поэтому поворот задаёт «внутреннюю» сторону.
local function borderPiece(
	parent: Instance,
	rng: Random,
	along0: number,
	along1: number,
	fixed: number,
	side: number,
	flat: boolean
)
	local Bd = C.Border
	local len = along1 - along0
	local mid = (along0 + along1) / 2
	local color = tint(pickColor(rng, Bd.Colors), rng, 0.05)
	local isNS = side &lt;= 2 -- 1 = север, 2 = юг, 3 = запад, 4 = восток
	local pos2d = if isNS then Vector3.new(mid, 0, fixed) else Vector3.new(fixed, 0, mid)
	if flat then
		local h = Bd.PathStripTop
		local size = if isNS then Vector3.new(len, h, Bd.Width) else Vector3.new(Bd.Width, h, len)
		PartKit.Block(parent, "БордюрТропы", size, CFrame.new(pos2d.X, h / 2, pos2d.Z), color, Bd.Material, { CanCollide = true })
		return
	end
	local h = range(rng, Bd.HeightMin, Bd.HeightMax)
	local yaw = 0
	if side == 2 then
		yaw = math.pi
	elseif side == 3 then
		yaw = math.pi / 2
	elseif side == 4 then
		yaw = -math.pi / 2
	end
	PartKit.Wedge(
		parent,
		"БордюрСкос",
		Vector3.new(len, h, Bd.Width),
		CFrame.new(pos2d.X, h / 2, pos2d.Z) * CFrame.Angles(0, yaw, 0),
		color,
		Bd.Material,
		{ CanCollide = true }
	)
end

local function buildBorder(parent: Instance, rng: Random)
	local B, Bd = C.Bounds, C.Border
	local halfN = C.Passages.NorthHalfWidth
	local w = Bd.Width
	local northZ = B.MinZ + w / 2
	local southZ = B.MaxZ - w / 2
	local westX = B.MinX + w / 2
	local eastX = B.MaxX - w / 2

	-- Север: скосы по краям и плоская вставка напротив тропы
	local sections: { { number } } = { { B.MinX, -halfN, 0 }, { -halfN, halfN, 1 }, { halfN, B.MaxX, 0 } }
	for _, s in ipairs(sections) do
		local bounds = splitSpan(s[1], s[2], Bd.SegmentTarget, Bd.SegmentJitter, rng)
		for i = 1, #bounds - 1 do
			borderPiece(parent, rng, bounds[i], bounds[i + 1], northZ, 1, s[3] == 1)
		end
	end
	-- Юг, запад, восток — только скосы
	local south = splitSpan(B.MinX, B.MaxX, Bd.SegmentTarget, Bd.SegmentJitter, rng)
	for i = 1, #south - 1 do
		borderPiece(parent, rng, south[i], south[i + 1], southZ, 2, false)
	end
	local sideSpan = splitSpan(B.MinZ + w, B.MaxZ - w, Bd.SegmentTarget, Bd.SegmentJitter, rng)
	for i = 1, #sideSpan - 1 do
		borderPiece(parent, rng, sideSpan[i], sideSpan[i + 1], westX, 3, false)
	end
	local sideSpanE = splitSpan(B.MinZ + w, B.MaxZ - w, Bd.SegmentTarget, Bd.SegmentJitter, rng)
	for i = 1, #sideSpanE - 1 do
		borderPiece(parent, rng, sideSpanE[i], sideSpanE[i + 1], eastX, 4, false)
	end
end

-- ================================== ПЛИТЫ ===================================

local function buildGridSlabs(parent: Instance, rng: Random): { Slab }
	local B, S, D = C.Bounds, C.Slab, C.Dais
	local w = C.Border.Width
	local x0, x1 = B.MinX + w, B.MaxX - w
	local z0, z1 = B.MinZ + w, B.MaxZ - w
	local cx, cz = C.Center.X, C.Center.Z
	local h = D.Size / 2 + D.RingWidth -- половина квадратного выреза под постамент и кольцо

	-- Четыре области вокруг выреза: { minX, maxX, minZ, maxZ }
	local regions: { { number } } = {
		{ x0, cx - h, z0, z1 },
		{ cx + h, x1, z0, z1 },
		{ cx - h, cx + h, z0, cz - h },
		{ cx - h, cx + h, cz + h, z1 },
	}
	local slabs: { Slab } = {}
	local index = 0
	for _, r in ipairs(regions) do
		if r[2] - r[1] &gt; 0.5 and r[4] - r[3] &gt; 0.5 then
			local rows = splitSpan(r[3], r[4], S.RowTarget, S.RowJitter, rng)
			for ri = 1, #rows - 1 do
				-- каждая строка режется на колонки по-своему: кладка «вразбежку»
				local cols = splitSpan(r[1], r[2], S.ColTarget, S.ColJitter, rng)
				for ci = 1, #cols - 1 do
					local gap = range(rng, S.GapMin, S.GapMax)
					local sw = (cols[ci + 1] - cols[ci]) - gap
					local sd = (rows[ri + 1] - rows[ri]) - gap
					if sw &gt;= S.MinSize and sd &gt;= S.MinSize then
						index += 1
						local slab = makeSlab(parent, {
							Name = "Плита" .. index,
							CX = (cols[ci] + cols[ci + 1]) / 2,
							CZ = (rows[ri] + rows[ri + 1]) / 2,
							W = sw,
							D = sd,
							Gap = gap,
							TopMin = S.TopMin,
							TopMax = S.TopMax,
							Thick = S.Thickness,
							Styles = S.Styles,
						}, rng)
						table.insert(slabs, slab)
					end
				end
			end
		end
	end
	return slabs
end

-- Кольцо подогнанных камней вокруг постамента (внутри выреза сетки плит)
local function buildRing(parent: Instance, rng: Random): { Slab }
	local D = C.Dais
	local cx, cz = C.Center.X, C.Center.Z
	local dh = D.Size / 2
	local h = dh + D.RingWidth
	local slabs: { Slab } = {}
	local index = 0

	-- sideKind: 1 — север, 2 — юг (полная длина, включают углы); 3 — запад, 4 — восток
	local function ringSide(minX: number, maxX: number, minZ: number, maxZ: number, alongX: boolean, sideKind: number)
		local a0, a1 = if alongX then minX else minZ, if alongX then maxX else maxZ
		local bounds = splitSpan(a0, a1, D.RingTarget, 0.25, rng)
		for i = 1, #bounds - 1 do
			local gap = range(rng, C.Slab.GapMin, C.Slab.GapMax)
			local along = (bounds[i] + bounds[i + 1]) / 2
			local length = (bounds[i + 1] - bounds[i]) - gap
			local depth = D.RingWidth - gap
			local px = if alongX then along else (minX + maxX) / 2
			local pz = if alongX then (minZ + maxZ) / 2 else along
			index += 1
			local slab = makeSlab(parent, {
				Name = "КамньКольца" .. index,
				CX = px,
				CZ = pz,
				W = if alongX then length else depth,
				D = if alongX then depth else length,
				Gap = gap,
				TopMin = D.RingTopMin,
				TopMax = D.RingTopMax,
				Thick = C.Slab.Thickness,
				Styles = D.RingStyles,
			}, rng)
			table.insert(slabs, slab)
			-- крайние камни северной/южной сторон получают срез внешнего угла
			if sideKind &lt;= 2 then
				local cut = range(rng, C.Details.ChamferSizeMin, C.Details.ChamferSizeMax)
				if i == 1 then
					addChamfer(parent, slab, if sideKind == 1 then 1 else 4, cut, cut)
				elseif i == #bounds - 1 then
					addChamfer(parent, slab, if sideKind == 1 then 2 else 3, cut, cut)
				end
			end
		end
	end

	ringSide(cx - h, cx + h, cz - h, cz - dh, true, 1)
	ringSide(cx - h, cx + h, cz + dh, cz + h, true, 2)
	ringSide(cx - h, cx - dh, cz - dh, cz + dh, false, 3)
	ringSide(cx + dh, cx + h, cz - dh, cz + dh, false, 4)
	return slabs
end

-- ============================ ДЕТАЛИ НА ПЛИТАХ ==============================

local function addCrack(parent: Instance, slab: Slab, rng: Random)
	local Dt = C.Details
	local theta = range(rng, 0, math.pi)
	local c, s = math.abs(math.cos(theta)), math.abs(math.sin(theta))
	local cxl = range(rng, -slab.W * 0.18, slab.W * 0.18)
	local czl = range(rng, -slab.D * 0.18, slab.D * 0.18)
	local roomX = slab.W / 2 - 0.12 - math.abs(cxl)
	local roomZ = slab.D / 2 - 0.12 - math.abs(czl)
	local maxLen = 2 * math.min(roomX / math.max(c, 0.05), roomZ / math.max(s, 0.05))
	local len = math.min(range(rng, 0.7, 1.9), maxLen)
	if len &lt; 0.35 then
		return
	end
	local y = slab.Thick / 2 + Dt.Lift
	local main = slab.Cf * CFrame.new(cxl, y, czl) * CFrame.Angles(0, theta, 0)
	PartKit.Block(parent, "Трещина", Vector3.new(len, Dt.CrackThickness, Dt.CrackWidth), main, Dt.CrackColor, Enum.Material.Slate)
end

local function addMossCrevice(parent: Instance, slab: Slab, rng: Random)
	local side = rng:NextInteger(1, 4)
	local alongX = side &lt;= 2 -- края ±X тянутся вдоль Z
	local edgeLen = if alongX then slab.D else slab.W
	local len = math.min(range(rng, 0.7, 1.6), edgeLen * 0.8)
	local room = math.max(0, edgeLen / 2 - len / 2 - 0.1)
	local along = range(rng, -room, room)
	local sign = if side % 2 == 1 then 1 else -1
	local offset = sign * ((if alongX then slab.W else slab.D) / 2 + slab.Gap / 2)
	local ly = 0.19 - slab.Cf.Position.Y
	local lpos = if alongX then Vector3.new(offset, ly, along) else Vector3.new(along, ly, offset)
	local size = if alongX then Vector3.new(0.12, 0.06, len) else Vector3.new(len, 0.06, 0.12)
	PartKit.Block(parent, "МохВЩели", size, slab.Cf * CFrame.new(lpos), pickColor(rng, C.Details.MossColors), Enum.Material.Grass)
end

local function addMossCorner(parent: Instance, slab: Slab, rng: Random): boolean
	local corner = rng:NextInteger(1, 4)
	if slab.Used[corner] then
		return false
	end
	local sizeX, sizeZ = range(rng, 0.45, 0.85), range(rng, 0.35, 0.65)
	local r = math.sqrt(sizeX * sizeX + sizeZ * sizeZ) / 2
	local ox, oz = slab.W / 2 - r - 0.03, slab.D / 2 - r - 0.03
	if ox &lt;= 0 or oz &lt;= 0 then
		return false
	end
	local sx, sz = CORNERS[corner][1], CORNERS[corner][2]
	local cf = slab.Cf * CFrame.new(sx * ox, slab.Thick / 2 + C.Details.Lift, sz * oz) * CFrame.Angles(0, range(rng, 0, math.pi), 0)
	PartKit.Block(parent, "МохУгол", Vector3.new(sizeX, 0.03, sizeZ), cf, pickColor(rng, C.Details.MossColors), Enum.Material.Grass)
	slab.Used[corner] = true
	return true
end

local function addPebble(parent: Instance, slab: Slab, rng: Random)
	local Dt = C.Details
	local s = range(rng, Dt.PebbleMin, Dt.PebbleMax)
	local lx = range(rng, -(slab.W / 2 - 0.3), slab.W / 2 - 0.3)
	local lz = range(rng, -(slab.D / 2 - 0.3), slab.D / 2 - 0.3)
	local color = tint(pickColor(rng, Dt.PebbleColors), rng, 0.08)
	local rot = CFrame.Angles(range(rng, -0.4, 0.4), range(rng, 0, math.pi * 2), range(rng, -0.4, 0.4))
	local cf = slab.Cf * CFrame.new(lx, slab.Thick / 2 + s * 0.3, lz) * rot
	if rng:NextNumber() &lt; 0.4 then
		PartKit.Ball(parent, "Камешек", s, cf, color, Enum.Material.Slate)
	else
		PartKit.Block(parent, "Камешек", Vector3.new(s, s * 0.6, s * range(rng, 0.7, 1.1)), cf, color, Enum.Material.Slate)
	end
end

-- Небольшой выпуклый камень: два слоя, верхний чуть светлее и повёрнут
local function addRaisedStone(parent: Instance, slab: Slab, rng: Random)
	local Dt = C.Details
	local bx, bz = range(rng, 0.8, 1.2), range(rng, 0.7, 1.0)
	local r = math.sqrt(bx * bx + bz * bz) / 2
	local roomX, roomZ = slab.W / 2 - r - 0.05, slab.D / 2 - r - 0.05
	if roomX &lt;= 0 or roomZ &lt;= 0 then
		return
	end
	local lx, lz = range(rng, -roomX, roomX), range(rng, -roomZ, roomZ)
	local yaw = range(rng, 0, math.pi)
	local base = slab.Cf * CFrame.new(lx, slab.Thick / 2 + 0.05, lz) * CFrame.Angles(0, yaw, 0)
	PartKit.Block(parent, "ВыпуклыйКамень", Vector3.new(bx, 0.12, bz), base, Dt.RaisedBaseColor, Enum.Material.Slate)
	local cap = slab.Cf
		* CFrame.new(lx, slab.Thick / 2 + 0.135, lz)
		* CFrame.Angles(0, yaw + range(rng, -0.2, 0.2), 0)
	PartKit.Block(parent, "ВыпуклыйКамень", Vector3.new(bx * 0.68, 0.07, bz * 0.68), cap, Dt.RaisedCapColor, Enum.Material.Slate)
end

local function buildDetails(parent: Instance, slabs: { Slab }, rng: Random)
	local Dt = C.Details
	local n = #slabs
	if n == 0 then
		return
	end
	for _ = 1, Dt.ChamferCount do
		local slab = slabs[rng:NextInteger(1, n)]
		local corner = rng:NextInteger(1, 4)
		local c1 = range(rng, Dt.ChamferSizeMin, Dt.ChamferSizeMax)
		local c2 = range(rng, Dt.ChamferSizeMin, Dt.ChamferSizeMax)
		if not slab.Used[corner] and slab.W &gt; c1 * 2.2 and slab.D &gt; c2 * 2.2 then
			addChamfer(parent, slab, corner, c1, c2)
		end
	end
	for _ = 1, Dt.CrackCount do
		addCrack(parent, slabs[rng:NextInteger(1, n)], rng)
	end
	for _ = 1, Dt.MossCreviceCount do
		addMossCrevice(parent, slabs[rng:NextInteger(1, n)], rng)
	end
	local placed = 0
	local tries = 0
	while placed &lt; Dt.MossCornerCount and tries &lt; Dt.MossCornerCount * 6 do
		tries += 1
		if addMossCorner(parent, slabs[rng:NextInteger(1, n)], rng) then
			placed += 1
		end
	end
	for _ = 1, Dt.PebbleCount do
		addPebble(parent, slabs[rng:NextInteger(1, n)], rng)
	end
	for _ = 1, Dt.RaisedCount do
		addRaisedStone(parent, slabs[rng:NextInteger(1, n)], rng)
	end
end

-- ================================ ПОСТАМЕНТ =================================

local function buildDais(parent: Instance, rng: Random): SpawnLocation
	local D = C.Dais
	local cx, cz = C.Center.X, C.Center.Z
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "MainSpawnLocation"
	spawn.Size = Vector3.new(D.Size, D.Thickness, D.Size)
	spawn.CFrame = CFrame.new(cx, D.TopY - D.Thickness / 2, cz)
	spawn.Anchored = true
	spawn.CanCollide = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Enabled = true
	spawn.Color = D.Color
	spawn.Material = D.Material
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Parent = parent

	-- Срезанные углы постамента
	local record: Slab = {
		Cf = spawn.CFrame,
		W = D.Size,
		D = D.Size,
		Thick = D.Thickness,
		Gap = 0,
		TopY = D.TopY,
		Used = {},
	}
	for corner = 1, 4 do
		addChamfer(parent, record, corner, D.ChamferSize, D.ChamferSize)
	end

	local lift = C.Details.Lift
	local grooveY = D.TopY + lift + 0.003
	local inlayY = grooveY + 0.02

	-- Кольца: канавка + тонкая неоновая вставка; в четырёх сторонах света — разрывы под руны
	local function ring(radius: number, segments: number, withGroove: boolean, skipEvery: number)
		local chord = 2 * radius * math.sin(math.pi / segments)
		for i = 0, segments - 1 do
			if skipEvery &lt;= 0 or i % skipEvery ~= 0 then
				local theta = 2 * math.pi * i / segments
				local rot = CFrame.Angles(0, -(theta + math.pi / 2), 0)
				local pos = Vector3.new(cx + radius * math.cos(theta), 0, cz + radius * math.sin(theta))
				if withGroove then
					PartKit.Block(parent, "КанавкаКольца", Vector3.new(chord * 1.04, 0.02, 0.2), CFrame.new(pos.X, grooveY, pos.Z) * rot, D.GrooveColor, D.Material)
				end
				PartKit.Block(
					parent,
					"РунаКольца",
					Vector3.new(chord * 1.04, 0.02, 0.07),
					CFrame.new(pos.X, inlayY, pos.Z) * rot,
					D.InlayColor,
					Enum.Material.Neon,
					{ Transparency = D.InlayTransparency, CastShadow = false }
				)
			end
		end
	end
	ring(D.OuterRingRadius, D.OuterRingSegments, true, 5)
	ring(D.InnerRingRadius, D.InnerRingSegments, false, 0)

	-- Лучи-руны по сторонам света, ромбы у углов и центральный ромб
	for i = 0, 3 do
		local theta = math.pi / 2 * i
		local rot = CFrame.Angles(0, -(theta + math.pi / 2) + math.pi / 2, 0)
		local rr = D.OuterRingRadius + 0.45
		PartKit.Block(parent, "ГрооваЛуча", Vector3.new(0.9, 0.02, 0.2), CFrame.new(cx + rr * math.cos(theta), grooveY, cz + rr * math.sin(theta)) * rot, D.GrooveColor, D.Material)
		PartKit.Block(
			parent,
			"РунаЛуча",
			Vector3.new(0.9, 0.02, 0.07),
			CFrame.new(cx + rr * math.cos(theta), inlayY, cz + rr * math.sin(theta)) * rot,
			D.InlayColor,
			Enum.Material.Neon,
			{ Transparency = D.InlayTransparency, CastShadow = false }
		)
	end
	local diamondOffset = D.Size / 2 - 1.15
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			PartKit.Block(
				parent,
				"РомбУгла",
				Vector3.new(0.5, 0.02, 0.5),
				CFrame.new(cx + sx * diamondOffset, inlayY, cz + sz * diamondOffset) * CFrame.Angles(0, math.pi / 4, 0),
				D.InlayColor,
				Enum.Material.Neon,
				{ Transparency = D.InlayTransparency, CastShadow = false }
			)
		end
	end
	PartKit.Block(
		parent,
		"РомбЦентра",
		Vector3.new(0.5, 0.02, 0.5),
		CFrame.new(cx, inlayY, cz) * CFrame.Angles(0, math.pi / 4 + range(rng, -0.05, 0.05), 0),
		D.InlayColor,
		Enum.Material.Neon,
		{ Transparency = D.InlayTransparency, CastShadow = false }
	)
	return spawn
end

-- ================================ ПЕРИМЕТР ==================================

-- Проверка: деталь с габаритным радиусом r не мешает проходам, кругу вокруг спавна и соседям
local function isFree(x: number, z: number, r: number, placed: { Circle }): boolean
	local B, P, m = C.Bounds, C.Passages, C.EdgeMargin
	if x - r &lt; B.MinX + m or x + r &gt; B.MaxX - m or z - r &lt; B.MinZ + m or z + r &gt; B.MaxZ - m then
		return false
	end
	local half = if z &lt; C.Center.Z then P.NorthHalfWidth else P.SouthHalfWidth
	if math.abs(x) &lt; half + r then
		return false
	end
	if z + r &gt; P.SideZMin and z - r &lt; P.SideZMax then
		return false
	end
	local dx, dz = x - C.Center.X, z - C.Center.Z
	if math.sqrt(dx * dx + dz * dz) &lt; P.FreeRadius + r then
		return false
	end
	for _, c in ipairs(placed) do
		local ex, ez = x - c.X, z - c.Z
		if math.sqrt(ex * ex + ez * ez) &lt; r + c.R - 0.2 then
			return false
		end
	end
	return true
end

-- Подбор места у одного из краёв площади; nil — не нашлось
local function findEdgeSpot(rng: Random, r: number, placed: { Circle }): (number?, number?)
	local B, Bo = C.Bounds, C.Boulders
	for _ = 1, 80 do
		local edge = rng:NextInteger(1, 4)
		local inset = r + range(rng, Bo.EdgeInsetMin, Bo.EdgeInsetMax)
		local x, z
		if edge == 1 then
			x, z = range(rng, B.MinX + r, B.MaxX - r), B.MinZ + inset
		elseif edge == 2 then
			x, z = range(rng, B.MinX + r, B.MaxX - r), B.MaxZ - inset
		elseif edge == 3 then
			x, z = B.MinX + inset, range(rng, B.MinZ + r, B.MaxZ - r)
		else
			x, z = B.MaxX - inset, range(rng, B.MinZ + r, B.MaxZ - r)
		end
		if isFree(x, z, r, placed) then
			return x, z
		end
	end
	return nil, nil
end

-- Каменный фонарь: основание, столб, площадка, клетка со светящимся ядром, крышка
local function buildLantern(parent: Instance, x: number, z: number, yaw: number, index: number)
	local L = C.Lanterns
	local model = Instance.new("Model")
	model.Name = "КаменныйФонарь" .. index
	model.Parent = parent
	local origin = CFrame.new(x, L.BaseY, z) * CFrame.Angles(0, yaw, 0)
	local mat = L.StoneMaterial

	PartKit.Block(model, "Основание", Vector3.new(0.95, 0.22, 0.95), origin * CFrame.new(0, 0.11, 0), L.StoneDarkColor, mat, { CanCollide = true })
	PartKit.Cylinder(model, "Столб", 0.38, 1.0, origin * CFrame.new(0, 0.72, 0), L.StoneColor, mat, { CanCollide = true })
	PartKit.Block(model, "Площадка", Vector3.new(0.8, 0.12, 0.8), origin * CFrame.new(0, 1.28, 0), L.StoneColor, mat)
	local core = PartKit.Block(
		model,
		"Ядро",
		Vector3.new(0.42, 0.48, 0.42),
		origin * CFrame.new(0, 1.58, 0),
		L.CoreColor,
		Enum.Material.Neon,
		{ CastShadow = false }
	)
	PartKit.PointLight(core, L.LightColor, L.LightBrightness, L.LightRange)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			PartKit.Block(model, "СтойкаКлетки", Vector3.new(0.08, 0.52, 0.08), origin * CFrame.new(sx * 0.31, 1.59, sz * 0.31), L.StoneDarkColor, mat)
		end
	end
	PartKit.Block(model, "Крышка", Vector3.new(0.98, 0.14, 0.98), origin * CFrame.new(0, 1.92, 0), L.StoneColor, mat)
	PartKit.Block(model, "КрышкаВерх", Vector3.new(0.6, 0.14, 0.6), origin * CFrame.new(0, 2.06, 0), L.StoneDarkColor, mat)
	PartKit.Ball(model, "Навершие", 0.22, origin * CFrame.new(0, 2.22, 0), L.StoneColor, mat)
end

-- Описание кластера валунов до размещения: нужен габаритный радиус
type BoulderPart = { Kind: number, Off: Vector3, Size: Vector3, Rot: CFrame, Mat: Enum.Material, Color: Color3 }

local function genBoulder(rng: Random): ({ BoulderPart }, number)
	local Bo = C.Boulders
	local parts: { BoulderPart } = {}
	local count = rng:NextInteger(2, 4)
	local radius = 0
	local mainSize = range(rng, Bo.MainSizeMin, Bo.MainSizeMax)
	for i = 1, count do
		local scale = if i == 1 then mainSize else mainSize * range(rng, 0.35, 0.65)
		local size = Vector3.new(scale * range(rng, 0.8, 1.15), scale * range(rng, 0.55, 0.9), scale * range(rng, 0.8, 1.15))
		local off = Vector3.zero
		if i &gt; 1 then
			local ang = range(rng, 0, math.pi * 2)
			local dist = mainSize * 0.45 + scale * 0.25
			off = Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
		end
		local rot = CFrame.Angles(range(rng, -0.35, 0.35), range(rng, 0, math.pi * 2), range(rng, -0.35, 0.35))
		local kind = rng:NextInteger(1, 3) -- 1 блок, 2 клин, 3 эллипсоид
		table.insert(parts, {
			Kind = kind,
			Off = off,
			Size = size,
			Rot = rot,
			Mat = Bo.Materials[rng:NextInteger(1, #Bo.Materials)],
			Color = tint(pickColor(rng, Bo.Colors), rng, 0.07),
		})
		local reach = Vector3.new(off.X, 0, off.Z).Magnitude + math.sqrt(size.X * size.X + size.Z * size.Z) / 2
		radius = math.max(radius, reach)
	end
	return parts, radius
end

local function buildBoulder(parent: Instance, x: number, z: number, parts: { BoulderPart }, index: number)
	local model = Instance.new("Model")
	model.Name = "Валун" .. index
	model.Parent = parent
	for _, p in ipairs(parts) do
		local cf = CFrame.new(x + p.Off.X, 0.2 + p.Size.Y * 0.38, z + p.Off.Z) * p.Rot
		local opts = { CanCollide = true }
		if p.Kind == 2 then
			PartKit.Wedge(model, "Обломок", p.Size, cf, p.Color, p.Mat, opts)
		elseif p.Kind == 3 then
			PartKit.Ellipsoid(model, "Булыжник", p.Size, cf, p.Color, p.Mat, opts)
		else
			PartKit.Block(model, "Глыба", p.Size, cf, p.Color, p.Mat, opts)
		end
	end
end

-- Кластер кристаллов: камень-основание и 3–6 наклонных призм с остриями
local function buildCrystals(parent: Instance, x: number, z: number, index: number, rng: Random)
	local K = C.Crystals
	local model = Instance.new("Model")
	model.Name = "Кристаллы" .. index
	model.Parent = parent
	local tone = K.Palettes[(index - 1) % #K.Palettes + 1]
	local base = PartKit.Block(
		model,
		"ОснованиеКристаллов",
		Vector3.new(1.5, 0.36, 1.2),
		CFrame.new(x, 0.28, z) * CFrame.Angles(0, range(rng, 0, math.pi), 0),
		K.BaseColor,
		Enum.Material.Basalt,
		{ CanCollide = true }
	)
	if index &lt;= K.LightCount then
		PartKit.PointLight(base, tone, K.LightBrightness, K.LightRange)
	end
	local origin = Vector3.new(x, 0.44, z)
	local n = rng:NextInteger(K.PerClusterMin, K.PerClusterMax)
	for i = 1, n do
		local len = range(rng, K.LengthMin, K.LengthMax)
		local width = range(rng, K.WidthMin, K.WidthMax)
		local ang = range(rng, 0, math.pi * 2)
		local dist = range(rng, 0, 0.45)
		local pos = origin + Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
		local tilt = math.rad(range(rng, 6, K.MaxTiltDeg))
		local frame = CFrame.new(pos) * CFrame.Angles(0, ang, 0) * CFrame.Angles(tilt, 0, 0)
		local glowing = i == 1 or rng:NextNumber() &lt; 0.3
		local color = tint(tone, rng, 0.12)
		PartKit.Block(
			model,
			"Кристалл",
			Vector3.new(width, len, width),
			frame * CFrame.new(0, len / 2 - 0.05, 0),
			color,
			if glowing then Enum.Material.Neon else Enum.Material.Glass,
			{ Transparency = if glowing then 0 else K.GlassTransparency, Reflectance = if glowing then 0 else 0.1, CastShadow = false }
		)
		local tip = len * 0.28
		PartKit.Block(
			model,
			"ОстриёКристалла",
			Vector3.new(width * 0.6, tip, width * 0.6),
			frame * CFrame.new(0, len - 0.05 + tip / 2 - 0.01, 0) * CFrame.Angles(0, math.pi / 4, 0),
			PartKit.Lighten(color, 0.25),
			Enum.Material.Neon,
			{ CastShadow = false }
		)
	end
end

local function buildPerimeter(parent: Instance, rng: Random)
	local placed: { Circle } = {}
	local lanterns = newFolder(parent, "Фонари")
	local boulders = newFolder(parent, "Валуны")
	local crystals = newFolder(parent, "Кристаллы")

	for i, p in ipairs(C.Lanterns.Positions) do
		local yaw = range(rng, -0.4, 0.4)
		if isFree(p.X, p.Z, C.Lanterns.Radius, placed) then
			buildLantern(lanterns, p.X, p.Z, yaw, i)
			table.insert(placed, { X = p.X, Z = p.Z, R = C.Lanterns.Radius })
		end
	end

	-- сначала кристаллы (небольшой габарит), затем валуны занимают остаток периметра
	for i = 1, C.Crystals.Clusters do
		local x, z = findEdgeSpot(rng, C.Crystals.Radius, placed)
		if x and z then
			buildCrystals(crystals, x, z, i, rng)
			table.insert(placed, { X = x, Z = z, R = C.Crystals.Radius })
		end
	end

	for i = 1, C.Boulders.Clusters do
		-- не поместился — пробуем другую форму кластера
		for _ = 1, 8 do
			local parts, radius = genBoulder(rng)
			local x, z = findEdgeSpot(rng, radius, placed)
			if x and z then
				buildBoulder(boulders, x, z, parts, i)
				table.insert(placed, { X = x, Z = z, R = radius })
				break
			end
		end
	end
end

-- ============================== ТОЧКА ВХОДА =================================

function SpawnPlazaBuilder.Build(parent: Instance): PlazaRefs
	local old = parent:FindFirstChild("StoneSpawnPlaza")
	if old then
		old:Destroy()
	end

	local rng = Random.new(C.Seed)
	local model = Instance.new("Model")
	model.Name = "StoneSpawnPlaza"

	local baseFolder = newFolder(model, "Основа")
	local borderFolder = newFolder(model, "Бордюр")
	local slabFolder = newFolder(model, "Плиты")
	local detailFolder = newFolder(model, "Детали")
	local daisFolder = newFolder(model, "Постамент")
	local perimeterFolder = newFolder(model, "Периметр")

	buildPlate(baseFolder)
	buildBorder(borderFolder, rng)

	local slabs = buildGridSlabs(slabFolder, rng)
	local ringSlabs = buildRing(daisFolder, rng)
	for _, s in ipairs(ringSlabs) do
		table.insert(slabs, s)
	end
	buildDetails(detailFolder, slabs, rng)

	local spawn = buildDais(daisFolder, rng)
	buildPerimeter(perimeterFolder, rng)

	model.Parent = parent
	return { Model = model, SpawnLocation = spawn }
end

return SpawnPlazaBuilder
</ProtectedString></Properties></Item></Item>
    <Item class="Script">
      <Properties>
        <string name="Name">ServerMain</string>
        <ProtectedString name="Source">--!strict
-- ============================================================================
-- 🚀 ГЛАВНЫЙ СЕРВЕРНЫЙ СКРИПТ: ServerMain (ServerScriptService.ServerMain)
-- Версия: v14.0 (поверх v13) — автопродажа в зоне $ SELL (без меню), бег по Shift,
-- «страж» кирки (перевыдача при потере руки), точный текст ночного запрета, стартовый рюкзак 10 слотов.
-- Связывает механики v13:
-- • Цикл Утро → День → Вечер → Ночь с закрытием входа в шахту ночью (Пункт №10)
--   и случайным спавном 0–3 Утренних залежей ×3 каждое утро (Пункт №7).
-- • Автоматическое надевание Оранжевой Каски при входе в зону шахты и снятие
--   при выходе на поверхность (Пункт №11).
-- • Серверный телепорт по нижней кнопке «К продаже» (в зону автопродажи) с кулдауном 4 сек.
-- • Серверная покупка/экипировка Кирок 1–10 ур. и Рюкзаков 1–10 ур. (Пункты №5 и №9).
-- • Серверная продажа «Продать всё» и «Продать выбранное» в пункте приёма "$ SELL" (Пункт №13).
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterGui = game:GetService("StarterGui")

print("⛏️ [ServerMain] Starting Miner Simulator...")

local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes") :: Folder?
if not remotesFolder then
	local f = Instance.new("Folder")
	f.Name = "Remotes"
	f.Parent = ReplicatedStorage
	remotesFolder = f
end

local function getOrCreateRemote(name: string): RemoteEvent
	local existing = (remotesFolder :: Folder):FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end
	local re = Instance.new("RemoteEvent")
	re.Name = name
	re.Parent = remotesFolder
	return re
end

local MineBlockRemote       = getOrCreateRemote("MineBlock")
local BuyUpgradeRemote      = getOrCreateRemote("BuyUpgrade")
local BuyPickaxeRemote      = getOrCreateRemote("BuyPickaxe")
local BuyBackpackRemote     = getOrCreateRemote("BuyBackpack")
local SellResourcesRemote   = getOrCreateRemote("SellResources")
local TeleportToSpawnRemote = getOrCreateRemote("TeleportToSpawn")
local TeleportToShopRemote = getOrCreateRemote("TeleportToShop") -- v27: Shop button -&gt; teleport to the shop
local SyncPlayerData        = getOrCreateRemote("SyncPlayerData")
local DayNightEvent         = getOrCreateRemote("DayNightEvent")
local UpgradeSkillRemote    = getOrCreateRemote("UpgradeSkill")
local PrestigeRemote        = getOrCreateRemote("Prestige")
local ProgressionEvent      = getOrCreateRemote("ProgressionEvent")
local EquipFXRemote         = getOrCreateRemote("EquipFX")
local SellNotifyRemote      = getOrCreateRemote("SellNotify")   -- сервер -&gt; клиент: «+XXX монет»
local SprintRemote          = getOrCreateRemote("Sprint")       -- клиент -&gt; сервер: бег вкл/выкл
getOrCreateRemote("BlockFX") -- v51: server -&gt; other clients: play the block hit shake (see VFXModule)

local GameConfig         = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local SoundManager       = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("SoundManager"))
local VFXModule          = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("VFXModule"))
local ServerModules      = ServerScriptService:WaitForChild("Modules")
local DataManager        = require(ServerModules:WaitForChild("DataManager"))
local EquipmentManager   = require(ServerModules:WaitForChild("EquipmentManager"))
local WorldBuilder       = require(ServerModules:WaitForChild("WorldBuilder"))
local MineManager        = require(ServerModules:WaitForChild("MineManager"))
local ProgressionManager = require(ServerModules:WaitForChild("ProgressionManager"))

-- v52: модули и Remote-ы «сочного» обновления
local BoostService = require(ServerModules:WaitForChild("BoostService"))
local NightCycleService = require(ServerModules:WaitForChild("NightCycleService"))
local NightWallBuilder = require(ServerModules:WaitForChild("NightWallBuilder"))
local ShopService = require(ServerModules:WaitForChild("ShopService"))
local ShopActionRemote = getOrCreateRemote("ShopAction")   -- клиент -&gt; сервер: запрос магазина
local ShopResultRemote = getOrCreateRemote("ShopResult")   -- сервер -&gt; клиент: результат запроса
local NightNoticeRemote = getOrCreateRemote("NightNotice") -- сервер -&gt; клиент: «ночь / утро / шахта закрыта»

DataManager.SetSyncRemote(SyncPlayerData)
EquipmentManager.SetFxRemote(EquipFXRemote)
ProgressionManager.Init({
	GetProfile = function(player: Player)
		return DataManager.GetProfile(player)
	end,
	Sync = function(player: Player)
		DataManager.SyncToClient(player, SyncPlayerData)
	end,
}, {
	UpgradeSkill = UpgradeSkillRemote,
	Prestige = PrestigeRemote,
	ProgressionEvent = ProgressionEvent,
})

SoundManager.EnsureSoundsFolder()

local function onBuyPickaxeFromPedestal(player: Player, tier: number)
	DataManager.BuyOrEquip3DPickaxe(player, tier, EquipmentManager, SyncPlayerData)
end

local function onClaimCaveChest(player: Player, coinsReward: number, chestPart: BasePart)
	DataManager.GrantCaveChestReward(player, coinsReward, chestPart, SyncPlayerData)
end

local worldRefs = WorldBuilder.BuildWorld(EquipmentManager, onBuyPickaxeFromPedestal, onClaimCaveChest)
local blocksFolder = worldRefs.BlocksFolder

-- v52: большая ночная стена у входа в шахту (состояние — сервер, анимация — клиент)
local nightWallRefs = NightWallBuilder.Build(worldRefs.WorldFolder)

local function handleBlockClick(player: Player, block: BasePart)
	MineManager.HandleMineHit(player, block, DataManager, EquipmentManager, blocksFolder, SyncPlayerData)
end

task.spawn(function()
	MineManager.InitMine(blocksFolder, handleBlockClick)
	local count, list = MineManager.SpawnMorningVeins()
	if count &gt; 0 then
		DayNightEvent:FireAllClients(
			"MorningVeinsSpawned",
			string.format("🌅 Утро! В шахте Утренние жилы (×3 💰): %d (%s)", count, table.concat(list, ", "))
		)
	end
end)

-- ============================================================================
-- 1. ПРОВЕРКА НАХОЖДЕНИЯ В ЗОНЕ ШАХТЫ: ОРАНЖЕВАЯ КАСКА (ПУНКТ №11)
--    И ЗАЩИТА НОЧНОГО ВХОДА В ШАХТУ (ПУНКТ №10) + ЗАЩИТА ГРАНИЦ КАРТЫ (ПУНКТ №12)
-- ============================================================================
local NightWarnCooldown: { [number]: number } = {}

local function isPositionInMineZone(pos: Vector3): boolean
	local b = GameConfig.MINE_ZONE_BOUNDS
	return (pos.X &gt;= b.MinX and pos.X &lt;= b.MaxX and pos.Z &gt;= b.MinZ and pos.Z &lt;= b.MaxZ and pos.Y &lt;= b.TopY)
end

task.spawn(function()
	while task.wait(0.12) do
		local isNight = MineManager.IsNightClosed()

		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if char and root then
				local pos = root.Position

				-- Защита от выпадения за пределы карты (Пункт №12)
				if pos.Y &lt; GameConfig.FALL_THRESHOLD_Y or pos.X &lt; GameConfig.MAP_BOUNDS.MinX - 6 or pos.X &gt; GameConfig.MAP_BOUNDS.MaxX + 6 or pos.Z &lt; GameConfig.MAP_BOUNDS.MinZ - 6 or pos.Z &gt; GameConfig.MAP_BOUNDS.MaxZ + 6 then
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = CFrame.new(GameConfig.SPAWN_POSITION)
					pos = root.Position
				end

				local inMine = isPositionInMineZone(pos)

				-- v52: ночью зону шахты проверяет NightCycleService (раз в 0.5 с, телепорт на базу);
				-- здесь только не выдаём каску тому, кто оказался в зоне ночью
				if isNight and inMine then
					inMine = false
				end

				-- ПУНКТ №11: Автоматическое надевание/снятие Оранжевой Каски на голове!
				EquipmentManager.UpdateMinerHardHat(char, inMine)
			end
		end
	end
end)

-- ============================================================================
-- 2. ЦИКЛ УТРО / ДЕНЬ (360 СЕК) → ВЕЧЕР → НОЧЬ (60 СЕК, ШАХТА ЗАКРЫТА!)
-- ============================================================================
-- v52: цикл вынесен в NightCycleService — атрибуты Phase / PhaseEndsAt / PhaseLength в ReplicatedStorage,
-- мгновенный телепорт всех игроков на базу в момент наступления ночи, стена у входа, проверка зоны.
NightCycleService.Start({
	MineManager = MineManager,
	WorldBuilder = WorldBuilder,
	EquipmentManager = EquipmentManager,
	NightWallBuilder = NightWallBuilder,
	WallRefs = nightWallRefs,
	BlocksFolder = blocksFolder,
	OnBlockClicked = handleBlockClick,
	NoticeRemote = NightNoticeRemote,
	DayNightEvent = DayNightEvent,
})

-- ============================================================================
-- 3. СЕРВЕРНЫЙ ТЕЛЕПОРТ ПО НИЖНЕЙ КНОПКЕ «НАВЕРХ / СПАУН» (ПУНКТ №3 ТЗ)
-- ============================================================================
local SpawnTeleportCooldowns: { [number]: number } = {}

TeleportToSpawnRemote.OnServerEvent:Connect(function(player: Player)
	pcall(function()
		local now = os.clock()
		local last = SpawnTeleportCooldowns[player.UserId] or -999
		if (now - last) &lt; GameConfig.SPAWN_TELEPORT_COOLDOWN then
			local waitLeft = math.ceil(GameConfig.SPAWN_TELEPORT_COOLDOWN - (now - last))
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				VFXModule.SpawnFloatingText(root.Position + Vector3.new(0, 2, 0), string.format("⏳ Teleport cooldown: %d s", waitLeft), Color3.fromRGB(255, 175, 75))
			end
			return
		end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not char or not hum or hum.Health &lt;= 0 or not root then return end

		SpawnTeleportCooldowns[player.UserId] = now
		root.AssemblyLinearVelocity = Vector3.zero
		-- v14: кнопка ведёт сразу в зону автопродажи; сервер продаст руду в течение долей секунды
		local targetPos = GameConfig.SELL_TELEPORT_POSITION + Vector3.new((math.random() - 0.5) * 6, 0, (math.random() - 0.5) * 4)
		root.CFrame = CFrame.new(targetPos)

		EquipmentManager.UpdateMinerHardHat(char, false)
		SoundManager.PlayAt("TeleportWhoosh", targetPos)
		VFXModule.PlayPurchaseOrSellBurst(targetPos, Color3.fromRGB(85, 225, 255))
		VFXModule.SpawnFloatingText(targetPos + Vector3.new(0, 2, 0), "💰 You are at the Sell zone!", Color3.fromRGB(110, 235, 255))

		-- сразу сдаём руду, не дожидаясь очередной проверки зоны
		task.delay(0.2, function()
			local ok, earned, count = pcall(function()
				return DataManager.AutoSellOnWhitePad(player, SyncPlayerData)
			end)
			if ok and earned and earned &gt; 0 then
				SellNotifyRemote:FireClient(player, earned, count)
			end
		end)
	end)
end)

-- ============================================================================
-- 3a. v27: SHOP BUTTON -&gt; SERVER TELEPORT ONTO THE SHOP PAD (the shop menu opens there)
-- ============================================================================
local SHOP_TELEPORT_COOLDOWN = 1.5
local ShopTeleportCooldowns: { [number]: number } = {}

TeleportToShopRemote.OnServerEvent:Connect(function(player: Player)
	pcall(function()
		local now = os.clock()
		local last = ShopTeleportCooldowns[player.UserId] or -999
		if (now - last) &lt; SHOP_TELEPORT_COOLDOWN then return end

		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not char or not hum or hum.Health &lt;= 0 or not root then return end

		ShopTeleportCooldowns[player.UserId] = now
		root.AssemblyLinearVelocity = Vector3.zero
		-- the client opens the shop menu when the player stands on this pad (same zone as walking in)
		local targetPos = GameConfig.GREEN_SHOP_PAD_POS + Vector3.new((math.random() - 0.5) * 2, 3.25, 4 + (math.random() - 0.5) * 2)
		root.CFrame = CFrame.new(targetPos)

		EquipmentManager.UpdateMinerHardHat(char, false)
		SoundManager.PlayAt("TeleportWhoosh", targetPos)
		VFXModule.PlayPurchaseOrSellBurst(targetPos, Color3.fromRGB(85, 225, 255))
	end)
end)

-- ============================================================================
-- 3b. АВТОПРОДАЖА В ЗОНЕ «$ SELL» (v14): меню продажи убрано.
--     Игрок вошёл в зону -&gt; вся руда сразу продана, на экране всплывает «+XXX монет».
--     Пока игрок стоит в зоне, новая добыча сдаётся не чаще, чем раз в RepeatSeconds.
-- ============================================================================
local InSellZone: { [number]: boolean } = {}
local LastAutoSell: { [number]: number } = {}

task.spawn(function()
	local center = GameConfig.WHITE_SELL_PAD_POS
	while task.wait(GameConfig.AUTO_SELL.CheckInterval) do
		local now = os.clock()
		for _, player in ipairs(Players:GetPlayers()) do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				local flat = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude
				local inside = flat &lt;= GameConfig.SELL_ZONE_RADIUS and math.abs(root.Position.Y - center.Y) &lt;= 10
				local wasInside = InSellZone[player.UserId] == true
				InSellZone[player.UserId] = inside

				if inside then
					local due = (not wasInside) or ((now - (LastAutoSell[player.UserId] or 0)) &gt;= GameConfig.AUTO_SELL.RepeatSeconds)
					if due then
						local ok, earned, count = pcall(function()
							return DataManager.AutoSellOnWhitePad(player, SyncPlayerData)
						end)
						LastAutoSell[player.UserId] = now
						if ok and earned and earned &gt; 0 then
							SellNotifyRemote:FireClient(player, earned, count)
						end
					end
				end
			end
		end
	end
end)

-- ============================================================================
-- 3c. БЕГ (SHIFT): сервер ставит скорость, клиент только сообщает «бегу / не бегу»
-- ============================================================================
SprintRemote.OnServerEvent:Connect(function(player: Player, active: any)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local base = GameConfig.SPRINT.WalkSpeed
	hum.WalkSpeed = (active == true) and (base * GameConfig.SPRINT.SprintMultiplier) or base
end)

-- ============================================================================
-- 3d. «СТРАЖ» КИРКИ И РЮКЗАКА (v14): если рука персонажа была заменена (загрузка аватара,
--     смерть, ApplyDescription), кирка остаётся в мире без Motor6D и выглядит «невидимой».
--     Раз в секунду проверяем, что кирка привязана к ТЕКУЩЕЙ правой руке, иначе выдаём заново.
-- ============================================================================
task.spawn(function()
	while task.wait(1) do
		for _, player in ipairs(Players:GetPlayers()) do
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if char and hum and hum.Health &gt; 0 and char:FindFirstChild("HumanoidRootPart") then
				local hand = (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) :: BasePart?
				if hand then
					local motor = hand:FindFirstChild("PickaxeMotor") :: Motor6D?
					local model = char:FindFirstChild("VisualPickaxe") :: Model?
					local healthy = motor ~= nil and model ~= nil and motor.Part0 == hand
						and motor.Part1 ~= nil and motor.Part1:IsDescendantOf(model)
					if not healthy then
						local prof = DataManager.GetProfile(player)
						if prof then
							pcall(EquipmentManager.EquipPickaxe, char, prof.PickaxeTier)
						end
					end
				end
			end
		end
	end
end)

