	Push: number?,
	Inflate: boolean?,
	DepthAxis: string?,
	Tint: boolean?,
	FillGlow: boolean?,
	Shape: Enum.PartType?,
	Rounded: boolean?,
	Wedge: boolean?,
	Reflectance: number?,
	Transparency: number?,
}

