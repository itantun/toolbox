local function shopShortNum(n: number): string
	if n &gt;= 1e6 then
		local s = (string.gsub(string.format("%.1f", n / 1e6), "%.0$", ""))
		return s .. "M"
	elseif n &gt;= 1e3 then
		local s = (string.gsub(string.format("%.1f", n / 1e3), "%.0$", ""))
		return s .. "K"
	end
	return tostring(math.floor(n))
end

