function EquipmentManager.BuildBackpackParts(
	model: Model,
	level: number,
	torsoPartOrCF: BasePart | CFrame,
	anchored: boolean,
	scaleMult: number?
): BasePart
	local lvl = math.clamp(math.floor(level), 1, GameConfig.MAX_BACKPACK_LEVEL)
	local s = GameConfig.GetBackpackScale(lvl) * (scaleMult or 1.0)
	local style = GameConfig.GetBackpackStyle(lvl)

	local isCharTorso = typeof(torsoPartOrCF) == "Instance" and (torsoPartOrCF :: Instance):IsA("BasePart")
	local torsoPart: BasePart? = isCharTorso and (torsoPartOrCF :: BasePart) or nil
	local originCF: CFrame = isCharTorso and (torsoPart :: BasePart).CFrame or (torsoPartOrCF :: CFrame)

	local tW, tH, tZ = 2.0, 2.0, 1.0
	if torsoPart then
		tW, tH, tZ = torsoPart.Size.X, torsoPart.Size.Y, torsoPart.Size.Z
	end

	local BW = 2.0 * s
	local BH = 2.35 * s
	local RC = 0.48 * s
	local BD = 1.02 * s
	local PD = 0.36 * s
	-- v20: every level has its own proportions (W, H, D multipliers)
	local DIM = ({ { 0.9, 0.88, 0.95 }, { 1.0, 0.95, 1.0 }, { 0.98, 1.2, 1.05 }, { 0.95, 1.06, 0.85 }, { 1.05, 1.0, 1.0 },
		{ 1.1, 0.98, 1.14 }, { 1.02, 1.1, 0.95 }, { 1.06, 1.04, 1.0 }, { 1.14, 1.06, 1.12 }, { 1.1, 1.12, 1.05 } })[lvl] or { 1, 1, 1 }
	BW *= DIM[1]
	BH *= DIM[2]
	BD *= DIM[3]
	local topY = isCharTorso and (tH / 2 + 0.42 * s) or (BH / 2 + 0.2 * s)
	local yb = topY - RC - BH / 2
	local zc = isCharTorso and (tZ / 2 + BD / 2 + 0.02) or 0
	local front = zc + BD / 2

	local function add(name: string, size: Vector3, localCF: CFrame, color: Color3, mat: Enum.Material, opts: BagPartOpts?): BasePart
		local o: BagPartOpts = opts or {}
		local p: BasePart
		if o.Wedge then
			p = newWedge(model, name, size, color, mat, o.Reflectance)
		elseif o.Rounded then
			p = newRoundedBox(model, name, size, color, mat, o.Reflectance)
		else
			p = newPart(model, name, size, color, mat, o.Reflectance, o.Shape)
		end
		p.Transparency = o.Transparency or 0
		p.Anchored = anchored
		p.CFrame = originCF * localCF

		if torsoPart and not anchored then
			local w = Instance.new("Weld")
			w.Name = "BagWeld"
			w.Part0 = torsoPart
			w.Part1 = p
			w.C0 = localCF
			w.C1 = CFrame.identity
			w.Parent = p
		end

		if o.Push ~= nil or o.Inflate or o.Tint or o.FillGlow then
			p:SetAttribute("BaseC0", localCF)
			p:SetAttribute("BaseSize", size)
			p:SetAttribute("Push", o.Push or 0)
			p:SetAttribute("Inflate", o.Inflate == true)
			p:SetAttribute("DepthAxis", o.DepthAxis or "Z")
			p:SetAttribute("Tint", o.Tint == true)
			p:SetAttribute("FillGlow", o.FillGlow == true)
			p:SetAttribute("BaseColor", color)
		end
		return p
	end

	local bodyCol, trimCol, fitCol = style.Body, style.Trim, style.Fitting
	local bodyMat, fitMat = style.BodyMaterial, style.FittingMaterial
	local refl, transp = style.Reflectance, style.Transparency
	local bodyOpts = { Push = 0.5, Inflate = true, Tint = true, Rounded = true, Reflectance = refl, Transparency = transp }

	-- ========================================================================
	-- v23: REAL BACKPACK SILHOUETTE (generated + previewed by bag_gen.py):
	-- rounded-rectangle body, puffy front panel, domed lid or zipper arc,
	-- pillow pockets, side pockets, welts, thread stitching, leather colours.
	-- ========================================================================
	bodyMat = Enum.Material.Leather
	local PAL28 = { -- v28: body, trim, metal, camoA, camoB, thread, fit (bag_gen2.py)
		{ 176, 136, 90, 110, 78, 48, 198, 202, 210, 132, 98, 58, 208, 176, 126, 228, 208, 162, 198, 202, 210 },
		{ 156, 86, 46, 98, 56, 32, 200, 204, 212, 128, 70, 38, 178, 106, 62, 230, 196, 150, 200, 204, 212 },
		{ 118, 132, 62, 76, 86, 44, 186, 190, 180, 84, 96, 44, 156, 168, 92, 208, 208, 160, 186, 190, 180 },
		{ 42, 46, 56, 26, 28, 34, 178, 184, 194, 34, 38, 46, 60, 64, 74, 88, 92, 102, 178, 184, 194 },
		{ 28, 108, 232, 24, 26, 32, 196, 202, 212, 22, 90, 200, 70, 140, 245, 18, 70, 160, 246, 249, 255 },
		{ 38, 40, 44, 24, 26, 28, 134, 138, 146, 30, 32, 36, 52, 54, 60, 72, 74, 80, 134, 138, 146 },
		{ 232, 236, 242, 26, 28, 34, 204, 210, 220, 212, 216, 224, 246, 248, 250, 172, 178, 188, 40, 150, 255 },
		{ 30, 28, 38, 18, 16, 24, 122, 112, 142, 24, 22, 30, 46, 42, 56, 72, 62, 92, 170, 70, 255 },
		{ 30, 28, 30, 16, 14, 16, 112, 106, 106, 22, 20, 22, 48, 44, 46, 72, 58, 58, 255, 40, 30 },
		{ 20, 26, 34, 12, 16, 22, 112, 126, 142, 16, 20, 28, 36, 44, 56, 52, 72, 86, 0, 220, 255 },
	}
	local pc = PAL28[lvl] or PAL28[1]
	local function c28(i: number): Color3
		return Color3.fromRGB(pc[i], pc[i + 1], pc[i + 2])
	end
	bodyCol = c28(1)
	trimCol = c28(4)
	fitCol = c28(19)
	local PAL: { [string]: Color3 } = {
		body = bodyCol,
		flap = lighten(bodyCol, 0.05),
		edge = darken(bodyCol, 0.12),
		trim = trimCol,
		welt = darken(trimCol, 0.1),
		metal = c28(7),
		hole = Color3.fromRGB(44, 38, 34),
		thread = c28(16),
		fit = fitCol,
		dark = Color3.fromRGB(46, 40, 44),
		camoA = c28(10),
		camoB = c28(13),
	}
	local MATS: { [string]: Enum.Material } = {
		L = Enum.Material.Leather, M = Enum.Material.Metal, N = Enum.Material.Neon, F = Enum.Material.Fabric,
		W = Enum.Material.Wood, G = Enum.Material.Glass, P = Enum.Material.SmoothPlastic,
	}
	local body: BasePart = nil :: any
	for _, d in ipairs(BAG_SHAPES[lvl] or BAG_SHAPES[1]) do
		local cv = d[12]
		local col: Color3 = bodyCol
		if typeof(cv) == "table" then
			col = Color3.fromRGB(cv[1], cv[2], cv[3])
		else
			col = PAL[cv] or bodyCol
		end
		local mcode: string = d[13]
		local flags: string = d[15]
		local sh: string = d[2]
		local o: BagPartOpts = { Push = d[14] }
		if string.find(flags, "T", 1, true) then o.Tint = true end
		if string.find(flags, "I", 1, true) then o.Inflate = true end
		if sh == "C" then
			o.Shape = Enum.PartType.Cylinder
		elseif sh == "S" then
			o.Shape = Enum.PartType.Ball
		end
		if mcode == "M" then
			o.Reflectance = 0.25
		elseif mcode == "G" then
			o.Transparency = 0.3
			o.Reflectance = 0.1
		end
		local cf = CFrame.new(d[6] * s, yb + d[7] * s, zc + d[8] * s) * CFrame.Angles(math.rad(d[9]), math.rad(d[10]), math.rad(d[11]))
		local p = add(d[1], Vector3.new(d[3] * s, d[4] * s, d[5] * s), cf, col, MATS[mcode] or bodyMat, o)
		if sh == "E" then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		end
		if d[1] == "Body" then body = p end
	end

	-- 6) ПЛЕЧЕВЫЕ ЛЯМКИ (когда рюкзак на спине игрока)
	if isCharTorso then
		local strapCol = darken(trimCol, 0.1)
		local strapW = 0.30 * math.min(s, 1.1)
		for _, sx in ipairs({ -1, 1 }) do
			local x = sx * tW * 0.26
			add("StrapShoulder", Vector3.new(strapW, 0.14, tZ + 0.30), CFrame.new(x, tH / 2 + 0.05, 0.08), strapCol, bodyMat, { Rounded = true })
			local chestLen = tH * 0.82
			local chestTop = tH / 2 + 0.02
			add("StrapChest", Vector3.new(strapW * 0.92, chestLen, 0.12), CFrame.new(x, chestTop - chestLen / 2, -tZ / 2 - 0.07), strapCol, bodyMat, nil)
			add("StrapBuckle", Vector3.new(strapW * 1.15, 0.16, 0.07), CFrame.new(x, -tH * 0.08, -tZ / 2 - 0.15), fitCol, fitMat, { Reflectance = 0.3 })
		end
	end

	model:SetAttribute("BackpackLevel", lvl)
	model:SetAttribute("BodyDepth", BD)
	model:SetAttribute("StyleName", style.Name)
	model.PrimaryPart = body
	return body
end

-- ============================================================================
-- v32: BACKPACK DIRT VISUALS — 5 states like the reference
-- (Clean -&gt; Slightly Dirty -&gt; Dirty -&gt; Very Dirty -&gt; Extremely Dirty):
-- the bag gets an olive/green camo-mud tint and more camo patches each stage.
-- ============================================================================
local DIRT_STAINS = {
	-- part, x, y, w, h, rot
	{ "Body", -0.28, 0.30, 0.30, 0.18, 12 },
	{ "FrontPocket", 0.22, -0.10, 0.34, 0.30, -8 },
	{ "Body", 0.30, 0.18, 0.22, 0.14, -20 },
	{ "FrontPocket", -0.30, 0.15, 0.22, 0.22, 25 },
	{ "Body", 0.02, 0.40, 0.36, 0.10, 4 },
	{ "FrontPocket", 0.0, -0.32, 0.50, 0.14, 0 },
	{ "Body", -0.38, -0.05, 0.16, 0.30, 0 },
	{ "Body", 0.40, -0.10, 0.14, 0.26, 0 },
	{ "FrontPocket", 0.34, 0.25, 0.16, 0.16, 40 },
	{ "Body", -0.10, 0.12, 0.18, 0.12, -35 },
	{ "Body", 0.18, -0.36, 0.30, 0.14, 15 },
	{ "Body", -0.24, -0.30, 0.26, 0.16, -18 },
	{ "FrontPocket", -0.12, 0.34, 0.30, 0.14, 8 },
	{ "FrontPocket", 0.10, 0.05, 0.26, 0.18, -30 },
	{ "Body", 0.36, 0.38, 0.18, 0.12, 22 },
	{ "Body", -0.40, 0.40, 0.16, 0.12, -10 },
	{ "FrontPocket", -0.36, -0.30, 0.20, 0.16, 30 },
	{ "Body", 0.05, -0.10, 0.20, 0.14, 50 },
}
local DIRT_STAGE_PATCHES = { [0] = 0, [1] = 4, [2] = 8, [3] = 13, [4] = 18 }
local DIRT_STAGE_TINT = { [0] = 0, [1] = 0.16, [2] = 0.32, [3] = 0.48, [4] = 0.64 }
local DIRT_CAMO = {
	Color3.fromRGB(104, 128, 54), -- olive
	Color3.fromRGB(62, 86, 36),   -- moss
	Color3.fromRGB(128, 118, 66), -- khaki mud
	Color3.fromRGB(84, 66, 42),   -- brown mud
}
local DIRT_TINT_COLOR = Color3.fromRGB(96, 116, 52)

function EquipmentManager.ApplyBackpackDirt(model: Model, stage: number)
	if not model then return end
	local s = math.clamp(math.floor(tonumber(stage) or 0), 0, 4)
	if model:GetAttribute("DirtStage") == s then return end
	model:SetAttribute("DirtStage", s)
	model:SetAttribute("Dirt", s)
	for _, ch in ipairs(model:GetChildren()) do
		if ch.Name == "DirtStain" then ch:Destroy() end
	end
	-- 1) camo-mud tint of the bag itself (neon trims keep glowing like the reference)
	local k = DIRT_STAGE_TINT[s] or 0
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Name ~= "DirtStain" and p.Material ~= Enum.Material.Neon and p.Transparency &lt; 0.95 then
			local orig = p:GetAttribute("DirtOrigColor")
			if typeof(orig) ~= "Color3" then
				orig = p.Color
				p:SetAttribute("DirtOrigColor", orig)
			end
			p.Color = (orig :: Color3):Lerp(DIRT_TINT_COLOR, k)
		end
	end
	if s &lt;= 0 then return end
	-- 2) camo patches
	for i = 1, (DIRT_STAGE_PATCHES[s] or 0) do
		local st = DIRT_STAINS[i]
		if not st then break end
		local target = model:FindFirstChild(st[1], true)
		if target and target:IsA("BasePart") then
			local tsz = target.Size
			local grow = 1 + 0.12 * (s - 1)
			local p = Instance.new("Part")
			p.Name = "DirtStain"
			p.Size = Vector3.new(math.max(0.08, tsz.X * st[4] * grow), math.max(0.08, tsz.Y * st[5] * grow), 0.04)
			p.Color = DIRT_CAMO[((i - 1) % #DIRT_CAMO) + 1]
			p.Material = (i % 3 == 0) and Enum.Material.Mud or Enum.Material.Sand
			p.Transparency = 0.05
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Massless = true
			p.Anchored = target.Anchored
			p.CFrame = target.CFrame * CFrame.new(tsz.X * st[2], tsz.Y * st[3], tsz.Z / 2 + 0.02) * CFrame.Angles(0, 0, math.rad(st[6]))
			if not target.Anchored then
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = p
				wc.Part1 = target
				wc.Parent = p
			end
			p.Parent = model
		end
	end
end

-- v46: снимаем ВСЕ рюкзаки с персонажа (а не только первый найденный),
-- чтобы при покупке нового на спине всегда был ровно один рюкзак
function EquipmentManager.RemoveAllBackpacks(character: Model)
	if not character then return end
	for _, d in ipairs(character:GetDescendants()) do
		if d.Parent and d:IsA("Model") and (d.Name == "VisualBackpack" or d:GetAttribute("BackpackLevel") ~= nil) then
			d:Destroy()
		end
	end
	-- на всякий случай: отдельные детали рюкзака, приваренные к телу вне модели
	for _, d in ipairs(character:GetDescendants()) do
		if d.Parent and d:IsA("BasePart") and d:FindFirstChild("BagWeld") then
			d:Destroy()
		end
	end
end

function EquipmentManager.EquipBackpack(character: Model, level: number)
	if not character then return end
	EquipmentManager.RemoveAllBackpacks(character)

	local torso = (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")) :: BasePart?
	if not torso or not torso:IsA("BasePart") then return end

	local model = Instance.new("Model")
	model.Name = "VisualBackpack"
	EquipmentManager.BuildBackpackParts(model, level, torso, false, 1.0)
	model.Parent = character
	local ownerPlr = Players:GetPlayerFromCharacter(character)
	if ownerPlr then
		EquipmentManager.ApplyBackpackDirt(model, tonumber(ownerPlr:GetAttribute("BagDirtStage")) or 0)
	end
end

-- ============================================================================
-- 4. ОРАНЖЕВАЯ ШАХТЁРСКАЯ КАСКА ПРИ ВХОДЕ В ШАХТУ (ПУНКТ №11 ТЗ)
-- Построена строго по референсу «Оранжевая каска: виды 3D-модели.png»:
-- купол с центральным и боковыми рёбрами жёсткости, передний козырёк,
-- боковые крепления, тёмный внутренний обод и компактный налобный фонарь!
-- ============================================================================
function EquipmentManager.UpdateMinerHardHat(character: Model?, inMineZone: boolean)
	if not character then return end
	-- v35: pickaxe follows the same zone rule as the hard hat
	if character:GetAttribute("InMineZone") ~= inMineZone then
		character:SetAttribute("InMineZone", inMineZone)
	end
	EquipmentManager.SetPickaxeVisible(character, inMineZone)

	local existing = character:FindFirstChild("MinerHardHat")
	if not inMineZone then
		if existing then existing:Destroy() end
		return
	end
	if existing and existing:GetAttribute("HatVersion") == 49 then return end
	if existing then existing:Destroy() end

	local head = character:FindFirstChild("Head") :: BasePart?
	if not head or not head:IsA("BasePart") then return end

	local hatModel = Instance.new("Model")
	hatModel.Name = "MinerHardHat"
	hatModel:SetAttribute("HatVersion", 49)

	-- v35: smooth hard hat built from ellipsoids (Ball parts can't be stretched, so we use
	-- SpecialMesh Sphere): rounded dome, raised ridges, wide brim with front peak,
	-- dark inner band, side clips with rivets, glossy highlight and a real headlamp.
	local k = math.clamp(head.Size.Y / 1.2, 0.8, 1.35)
	local ORANGE = Color3.fromRGB(255, 124, 22)
	local ORANGE_HI = Color3.fromRGB(255, 154, 52)
	local ORANGE_LO = Color3.fromRGB(222, 92, 12)
	local DARK = Color3.fromRGB(34, 36, 42)
	local METAL = Color3.fromRGB(168, 172, 182)
	local SP = Enum.Material.SmoothPlastic

	local function addHatPart(name: string, size: Vector3, off: CFrame, col: Color3, mat: Enum.Material, kind: string?, refl: number?): BasePart
		local shape = nil
		if kind == "c" then shape = Enum.PartType.Cylinder elseif kind == "b" then shape = Enum.PartType.Ball end
		local p = newPart(hatModel, name, size * k, col, mat, refl or 0.1, shape)
		p.CastShadow = false
		if kind == "s" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
		local offK = off.Rotation + off.Position * k
		p.CFrame = head.CFrame * offK
		local w = Instance.new("Weld")
		w.Name = "HatWeld"
		w.Part0 = head
		w.Part1 = p
		w.C0 = offK
		w.C1 = CFrame.identity
		w.Parent = p
		return p
	end

	-- 1) dark inner suspension band hugging the head
	addHatPart("SuspensionBand", Vector3.new(1.30, 0.16, 1.38), CFrame.new(0, 0.42, 0), DARK, SP, "s", 0)
	-- 2) wide rounded brim + front peak (front = -Z of the head)
	addHatPart("HatBrim", Vector3.new(1.62, 0.12, 1.70), CFrame.new(0, 0.50, -0.06), ORANGE_LO, SP, "s")
	addHatPart("FrontPeak", Vector3.new(1.12, 0.10, 0.82), CFrame.new(0, 0.49, -0.66) * CFrame.Angles(math.rad(-8), 0, 0), ORANGE_LO, SP, "s")
	-- 3) smooth dome
	local dome = addHatPart("HatDome", Vector3.new(1.38, 1.02, 1.48), CFrame.new(0, 0.62, 0.02), ORANGE, SP, "s", 0.14)
	-- 4) raised ridges (centre + two sides)
	addHatPart("CenterRidge", Vector3.new(0.24, 1.00, 1.56), CFrame.new(0, 0.68, 0.02), ORANGE_HI, SP, "s", 0.14)
	for _, sx in ipairs({ -1, 1 }) do
		addHatPart("SideRidge", Vector3.new(0.18, 0.86, 1.40), CFrame.new(sx * 0.38, 0.66, 0.02) * CFrame.Angles(0, 0, math.rad(sx * -22)), ORANGE_HI, SP, "s", 0.14)
		-- side clips with metal rivets
		addHatPart("SideClip", Vector3.new(0.14, 0.22, 0.32), CFrame.new(sx * 0.69, 0.54, 0.02), ORANGE_LO, SP, "s")
		addHatPart("SideRivet", Vector3.new(0.09, 0.09, 0.09), CFrame.new(sx * 0.76, 0.54, 0.02), METAL, Enum.Material.Metal, "b", 0.2)
	end
	-- 5) glossy highlight on the dome
	local gloss = addHatPart("HatGloss", Vector3.new(0.40, 0.22, 0.52), CFrame.new(-0.30, 0.98, -0.20) * CFrame.Angles(math.rad(-20), 0, math.rad(24)), Color3.fromRGB(255, 236, 205), SP, "s", 0)
	gloss.Transparency = 0.55
	-- 6) v49 headlamp: mount plate, housing, chrome bezel, glowing lens + forward SpotLight &amp; fill PointLight
	local lampCF = CFrame.new(0, 0.80, -0.70) * CFrame.Angles(math.rad(12), 0, 0)
	local toFront = CFrame.Angles(0, math.rad(90), 0) -- cylinder local -X (Left) points forward (-Z)
	addHatPart("HeadlampMount", Vector3.new(0.36, 0.26, 0.08), lampCF, DARK, SP, nil, 0)
	addHatPart("HeadlampHousing", Vector3.new(0.18, 0.32, 0.32), lampCF * CFrame.new(0, 0, -0.12) * toFront, DARK, Enum.Material.Metal, "c", 0.05)
	addHatPart("HeadlampBezel", Vector3.new(0.05, 0.38, 0.38), lampCF * CFrame.new(0, 0, -0.215) * toFront, METAL, Enum.Material.Metal, "c", 0.3)
	local lampLens = addHatPart("HeadlampLens", Vector3.new(0.04, 0.28, 0.28), lampCF * CFrame.new(0, 0, -0.235) * toFront, Color3.fromRGB(255, 246, 205), Enum.Material.Neon, "c", 0)
	local spot = Instance.new("SpotLight")
	spot.Name = "MinerHelmetLight"
	spot.Face = Enum.NormalId.Left -- local -X is forward (-Z) after +90 deg Y rotation
	spot.Color = Color3.fromRGB(255, 240, 195)
	spot.Range = 36
	spot.Brightness = 2.6
	spot.Angle = 76
	spot.Shadows = true
	spot.Parent = lampLens

	-- Dedicated forward-oriented emitter angled slightly downward (-14 deg) to light blocks ahead &amp; underfoot
	local emitter = addHatPart("HeadlampBeamEmitter", Vector3.new(0.12, 0.12, 0.12), CFrame.new(0, 0.76, -0.96) * CFrame.Angles(math.rad(-14), 0, 0), Color3.fromRGB(255, 246, 205), Enum.Material.SmoothPlastic, nil, 0)
	emitter.Transparency = 1
	local mainBeam = Instance.new("SpotLight")
	mainBeam.Name = "MinerHelmetSpotLight"
	mainBeam.Face = Enum.NormalId.Front
	mainBeam.Color = Color3.fromRGB(255, 242, 202)
	mainBeam.Range = 46
	mainBeam.Brightness = 3.2
	mainBeam.Angle = 82
	mainBeam.Shadows = true
	mainBeam.Parent = emitter

	local fillLight = Instance.new("PointLight")
	fillLight.Name = "MinerHelmetPointLight"
	fillLight.Color = Color3.fromRGB(255, 232, 185)
	fillLight.Range = 22
	fillLight.Brightness = 1.45
	fillLight.Shadows = false
	fillLight.Parent = emitter

	hatModel.PrimaryPart = dome
	hatModel.Parent = character
end

return EquipmentManager
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">UIManager</string><ProtectedString name="Source">--!strict
-- Модульный фасад клиентского HUD и индикаторов глубины/энергии (раздел 10 ТЗ)
local HudModule = require(script.Parent:WaitForChild("HudModule"))
return HudModule
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">ClientBus</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🔗 МОДУЛЬ: ClientBus (ReplicatedStorage.Modules.ClientBus) — КЛИЕНТ
-- v52: общая шина клиентских скриптов. Модуль кэшируется, поэтому все LocalScript-ы
-- получают одни и те же BindableEvent-ы: старый ClientController просит открыть новое
-- окно магазина или рюкзака, а эффекты кирки узнают цвет последней ударенной руды.
-- ============================================================================

local Players = game:GetService("Players")

local ClientBus = {}

local function event(name: string): BindableEvent
	local e = Instance.new("BindableEvent")
	e.Name = name
	return e
end

ClientBus.OpenShop = event("OpenShop")     -- Fire() — открыть окно бустов (вкладка «Бусты» в меню магазина)
ClientBus.CloseShop = event("CloseShop")   -- Fire() — закрыть окно бустов
ClientBus.ToggleBag = event("ToggleBag")   -- Fire() — открыть / закрыть окно рюкзака
ClientBus.CloseAll = event("CloseAll")     -- Fire() — закрыть все окна v52

-- Цвет руды последнего удара локального игрока (для искр удара)
ClientBus.LastHitColor = Color3.fromRGB(255, 220, 150)
ClientBus.LastHitClock = 0

function ClientBus.SetLastHit(color: Color3)
	ClientBus.LastHitColor = color
	ClientBus.LastHitClock = os.clock()
end

-- Пока открыто окно v52, копка и прицел отключены (ClientController читает этот атрибут)
local OpenWindows: { [string]: boolean } = {}

function ClientBus.SetWindowOpen(id: string, isOpen: boolean)
	if isOpen then
		OpenWindows[id] = true
	else
		OpenWindows[id] = nil
	end
	local player = Players.LocalPlayer
	if player then
		player:SetAttribute("UpgradeUIOpen", next(OpenWindows) ~= nil)
	end
end

function ClientBus.IsWindowOpen(id: string): boolean
	return OpenWindows[id] == true
end

return ClientBus
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">OreIconModels</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 💎 МОДУЛЬ: OreIconModels (ReplicatedStorage.Modules.OreIconModels)
-- v52: 3D-иконка руды для ViewportFrame — базовый камень + кристаллы / самородки
-- цвета руды. Собирается из Part-ов по данным GameConfig.BLOCK_TYPES; форма
-- детерминирована (Random.new от имени руды), поэтому иконка всегда одинакова.
-- Настройки камеры и размеров — GameConfig.ORE_ICON.
-- ============================================================================

local GameConfig = require(script.Parent:WaitForChild("GameConfig"))
local PartKit = require(script.Parent:WaitForChild("PartKit"))

local OreIconModels = {}

-- Руды, у которых вкрапления выглядят как вытянутые кристаллы (остальные — самородки)
local CRYSTAL_STYLES: { [string]: boolean } = {
	CrystalClusters = true,
	EmeraldTiles = true,
	MithrilVeins = true,
	IceFrost = true,
	VoidCracks = true,
}

local function seedOf(text: string): number
	local h = 7
	for i = 1, #text do
		h = (h * 31 + string.byte(text, i)) % 2147483647
	end
	return h
end

-- Собирает модель иконки с центром в начале координат. PrimaryPart — базовый камень.
function OreIconModels.Build(oreId: string): Model
	local info: any = GameConfig.BLOCK_TYPES[oreId] or GameConfig.BLOCK_TYPES.Stone
	local cfg = GameConfig.ORE_ICON
	local rng = Random.new(seedOf(oreId) + cfg.Seed)

	local model = Instance.new("Model")
	model.Name = "OreIcon_" .. oreId

	local rockColor: Color3 = info.Color
	local rockMat: Enum.Material = info.Mat
	local accent: Color3 = info.AccentColor
	local accent2: Color3 = info.SecondaryAccent or PartKit.Lighten(accent, 0.25)
	local glow = info.HasGlow == true
	local inclMat: Enum.Material = glow and Enum.Material.Neon or info.InclusionMat

	-- 1) Базовый камень: центральная глыба и неровные обломки вокруг
	local base = PartKit.Block(
		model, "Rock", Vector3.new(1.7, 1.15, 1.5),
		CFrame.new(0, -0.25, 0) * CFrame.Angles(0, math.rad(rng:NextNumber(-20, 20)), math.rad(rng:NextNumber(-6, 6))),
		rockColor, rockMat
	)
	for i = 1, cfg.RockChunks do
		local a = (i / cfg.RockChunks) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local size = Vector3.new(rng:NextNumber(0.7, 1.1), rng:NextNumber(0.55, 0.95), rng:NextNumber(0.7, 1.1))
		local shade = rng:NextNumber(-0.12, 0.1)
		local color = shade &gt;= 0 and PartKit.Lighten(rockColor, shade) or PartKit.Darken(rockColor, -shade)
		PartKit.Block(
			model, "RockChunk", size,
			CFrame.new(math.cos(a) * 0.72, -0.35 + rng:NextNumber(-0.12, 0.15), math.sin(a) * 0.66)
				* CFrame.Angles(math.rad(rng:NextNumber(-22, 22)), math.rad(rng:NextNumber(0, 90)), math.rad(rng:NextNumber(-22, 22))),
			color, rockMat
		)
	end

	if CRYSTAL_STYLES[info.InclusionStyle] then
		-- 2a) Друза кристаллов: высокий центральный и наклонённые наружу боковые
		local count = cfg.CrystalCount
		for i = 1, count do
			local central = i == 1
			local a = (i / count) * math.pi * 2 + rng:NextNumber(-0.35, 0.35)
			local r = central and 0 or rng:NextNumber(0.32, 0.62)
			local h = central and rng:NextNumber(1.35, 1.6) or rng:NextNumber(0.65, 1.15)
			local w = central and 0.42 or rng:NextNumber(0.24, 0.36)
			local tilt = central and math.rad(rng:NextNumber(-6, 6)) or math.rad(18 + r * 38)
			local color = (i % 3 == 0) and accent2 or accent
			-- ось кристалла: наклон наружу от центра друзы
			local rootCF = CFrame.new(math.cos(a) * r, 0.15, math.sin(a) * r)
				* CFrame.Angles(0, -a, 0)
				* CFrame.Angles(0, 0, -tilt)
			local body = PartKit.Block(
				model, "Crystal", Vector3.new(w, h, w),
				rootCF * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, math.rad(45), 0),
				color, inclMat, { Reflectance = glow and 0 or 0.25, Transparency = (inclMat == Enum.Material.Glass) and 0.15 or 0 }
			)
			-- остриё: куб, поставленный на вершину
			PartKit.Block(
				model, "CrystalTip", Vector3.new(w * 0.72, w * 0.72, w * 0.72),
				rootCF * CFrame.new(0, h, 0) * CFrame.Angles(math.rad(45), 0, math.rad(35.26)),
				PartKit.Lighten(color, 0.2), inclMat, { Reflectance = glow and 0 or 0.25, Transparency = body.Transparency }
			)
		end
	else
		-- 2b) Самородки / вкрапления на верхней половине камня
		local count = cfg.NuggetCount
		for i = 1, count do
			local a = (i / count) * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
			local up = rng:NextNumber(0.15, 0.95)
			local flat = math.sqrt(math.max(0, 1 - up * up))
			local pos = Vector3.new(math.cos(a) * flat * 0.95, -0.2 + up * 0.72, math.sin(a) * flat * 0.85)
			local size = rng:NextNumber(0.26, 0.5)
			local color = (i % 3 == 0) and accent2 or accent
			local cf = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3))
			if i % 2 == 0 then
				PartKit.Ball(model, "Nugget", size, cf, color, inclMat, { Reflectance = glow and 0 or 0.18 })
			else
				PartKit.Block(model, "Nugget", Vector3.new(size, size * 0.8, size * 1.1), cf, color, inclMat, { Reflectance = glow and 0 or 0.18 })
			end
		end
		if info.InclusionStyle == "LavaCracks" then
			-- светящиеся трещины магмы поверх камня
			for i = 1, 3 do
				PartKit.Block(
					model, "LavaCrack", Vector3.new(1.5, 0.06, 0.09),
					CFrame.new(0, 0.34, -0.4 + i * 0.22) * CFrame.Angles(0, math.rad(rng:NextNumber(-40, 40)), 0),
					accent, Enum.Material.Neon
				)
			end
		end
	end

	model.PrimaryPart = base
	model:SetAttribute("Glow", glow)
	return model
end

return OreIconModels
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">PartKit</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🧱 МОДУЛЬ: PartKit (ReplicatedStorage.Modules.PartKit)
-- Общие помощники процедурной 3D-сборки (v52): блоки, клинья, цилиндры, шары,
-- сварка, свет, частицы и надписи на SurfaceGui. Используется и сервером
-- (рынок, площадь спавна, ночная стена), и клиентом (3D-иконки во ViewportFrame).
-- Никаких внешних ассетов: только Part / WedgePart и встроенные текстуры.
-- ============================================================================

local PartKit = {}

export type Opts = {
	Anchored: boolean?,
	CanCollide: boolean?,
	CanQuery: boolean?,
	CanTouch: boolean?,
	CastShadow: boolean?,
	Massless: boolean?,
	Transparency: number?,
	Reflectance: number?,
}

-- Встроенные текстуры частиц Roblox (внешние ассеты не используются)
PartKit.TEXTURE_SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
PartKit.TEXTURE_FIRE = "rbxasset://textures/particles/fire_main.dds"
PartKit.TEXTURE_SMOKE = "rbxasset://textures/particles/smoke_main.dds"

-- Общая настройка детали. По умолчанию деталь — декор: закреплена, без коллизий и касаний.
local function style(p: BasePart, parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, opts: Opts?)
	local o: Opts = opts or {}
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Anchored = if o.Anchored == nil then true else o.Anchored
	p.CanCollide = o.CanCollide == true
	p.CanQuery = if o.CanQuery == nil then o.CanCollide == true else o.CanQuery
	p.CanTouch = o.CanTouch == true
	p.CastShadow = if o.CastShadow == nil then true else o.CastShadow
	p.Massless = o.Massless == true
	p.Transparency = o.Transparency or 0
	p.Reflectance = o.Reflectance or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
end

-- Прямоугольный блок
function PartKit.Block(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, opts: Opts?): Part
	local p = Instance.new("Part")
	style(p, parent, name, size, cf, color, material, opts)
	return p
end

-- Клин (как стандартный WedgePart: высокая вертикальная грань со стороны +Z, скос спускается к -Z)
function PartKit.Wedge(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, opts: Opts?): WedgePart
	local p = Instance.new("WedgePart")
	style(p, parent, name, size, cf, color, material, opts)
	return p
end

-- Цилиндр, ось которого направлена вдоль локальной оси Y переданного CFrame
-- (у стандартного цилиндра ось идёт по X — здесь поворот уже учтён).
function PartKit.Cylinder(parent: Instance, name: string, diameter: number, height: number, cf: CFrame, color: Color3, material: Enum.Material, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	style(p, parent, name, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.rad(90)), color, material, opts)
	return p
end

-- Шар
function PartKit.Ball(parent: Instance, name: string, diameter: number, cf: CFrame, color: Color3, material: Enum.Material, opts: Opts?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	style(p, parent, name, Vector3.new(diameter, diameter, diameter), cf, color, material, opts)
	return p
end

-- Эллипсоид (шар, растянутый по осям через SpecialMesh)
function PartKit.Ellipsoid(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, opts: Opts?): Part
	local p = Instance.new("Part")
	style(p, parent, name, size, cf, color, material, opts)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- Жёсткая сварка детали с корневой деталью (WeldConstraint хранится в привариваемой детали)
function PartKit.WeldTo(part: BasePart, root: BasePart): WeldConstraint
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = part
	w.Parent = part
	return w
end

-- Приварить все детали контейнера к корню и снять с них закрепление (корень остаётся как есть)
function PartKit.WeldAll(container: Instance, root: BasePart)
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("BasePart") and d ~= root then
			PartKit.WeldTo(d, root)
			d.Anchored = false
		end
	end
end

function PartKit.PointLight(parent: Instance, color: Color3, brightness: number, range: number): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

function PartKit.SpotLight(parent: Instance, color: Color3, brightness: number, range: number, angle: number, face: Enum.NormalId): SpotLight
	local l = Instance.new("SpotLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Angle = angle
	l.Face = face
	l.Shadows = false
	l.Parent = parent
	return l
end

export type EmitterProps = {
	Name: string?,
	Texture: string?,
	Color: Color3?,
	Color2: Color3?,
	Rate: number?,
	Lifetime: NumberRange?,
	Speed: NumberRange?,
	SizeStart: number?,
	SizeEnd: number?,
	Spread: number?,
	LightEmission: number?,
	Transparency: number?,
	Acceleration: Vector3?,
	Drag: number?,
	RotSpeed: NumberRange?,
	Enabled: boolean?,
	ZOffset: number?,
}

-- Излучатель частиц на встроенной текстуре (по умолчанию — блёстки sparkles_main.dds)
function PartKit.Emitter(parent: Instance, props: EmitterProps): ParticleEmitter
	local c1 = props.Color or Color3.new(1, 1, 1)
	local c2 = props.Color2 or c1
	local pe = Instance.new("ParticleEmitter")
	pe.Name = props.Name or "Sparkles"
	pe.Texture = props.Texture or PartKit.TEXTURE_SPARKLE
	pe.Color = ColorSequence.new(c1, c2)
	pe.LightEmission = props.LightEmission or 1
	pe.Rate = props.Rate or 6
	pe.Lifetime = props.Lifetime or NumberRange.new(0.6, 1.1)
	pe.Speed = props.Speed or NumberRange.new(0.5, 1.5)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, props.SizeStart or 0.25),
		NumberSequenceKeypoint.new(1, props.SizeEnd or 0),
	})
	local t = props.Transparency or 0
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, t),
		NumberSequenceKeypoint.new(0.7, t),
		NumberSequenceKeypoint.new(1, 1),
	})
	local spread = props.Spread or 180
	pe.SpreadAngle = Vector2.new(spread, spread)
	pe.Acceleration = props.Acceleration or Vector3.zero
	pe.Drag = props.Drag or 0
	pe.RotSpeed = props.RotSpeed or NumberRange.new(-90, 90)
	pe.Rotation = NumberRange.new(0, 360)
	pe.ZOffset = props.ZOffset or 0
	pe.Enabled = if props.Enabled == nil then true else props.Enabled
	pe.Parent = parent
	return pe
end

export type LabelProps = {
	PixelsPerStud: number?,
	Font: Enum.Font?,
	TextColor: Color3?,
	StrokeColor: Color3?,
	StrokeThickness: number?,
	Brightness: number?,
	Name: string?,
}

-- Надпись на грани детали (SurfaceGui + TextLabel на всю грань). Возвращает оба объекта.
function PartKit.SurfaceLabel(part: BasePart, face: Enum.NormalId, text: string, props: LabelProps?): (SurfaceGui, TextLabel)
	local o: LabelProps = props or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = o.Name or "LabelGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.PixelsPerStud or 40
	gui.LightInfluence = 0
	gui.Brightness = o.Brightness or 1
	gui.Parent = part

	local lbl = Instance.new("TextLabel")
	lbl.Name = "Text"
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = o.Font or Enum.Font.GothamBlack -- поддерживает кириллицу
	lbl.TextScaled = true
	lbl.Text = text
	lbl.TextColor3 = o.TextColor or Color3.new(1, 1, 1)
	lbl.Parent = gui

	local stroke = Instance.new("UIStroke")
	stroke.Thickness = o.StrokeThickness or 3
	stroke.Color = o.StrokeColor or Color3.fromRGB(20, 14, 10)
	stroke.Parent = lbl
	return gui, lbl
end

function PartKit.Lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

function PartKit.Darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

return PartKit
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">PickaxeJuice</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- ✨ МОДУЛЬ: PickaxeJuice (ReplicatedStorage.Modules.PickaxeJuice)
-- v52: «сочная» отделка кирки поверх готовой геометрии EquipmentBuilder:
--   • неоновая полоса вдоль лезвия (видна с обеих сторон);
--   • светящийся кристалл в центре головы + PointLight малого радиуса;
--   • постоянные блёстки (sparkles_main.dds, LightEmission = 1) цвета уровня;
--   • шлейф (Trail) между краями лезвия — включается клиентом на время взмаха;
--   • излучатель искр удара (клиент вызывает :Emit, новые объекты не создаются);
--   • топовые уровни: метка FxEpic для пульсации свечения и тяжёлые частицы.
-- Все цвета и сила эффектов — GameConfig.PICKAXE_FX / PICKAXE_SWING_FX.
-- ============================================================================

local GameConfig = require(script.Parent:WaitForChild("GameConfig"))
local PartKit = require(script.Parent:WaitForChild("PartKit"))

local PickaxeJuice = {}

export type JuiceContext = {
	Container: Instance,        -- модель кирки
	Level: number,              -- уровень кирки 1..10
	Scale: number,              -- общий масштаб кирки (в руке 0.65)
	HeadScale: number,          -- масштаб головы по уровню
	HeadY: number,              -- локальный Y центра головы
	Beads: { { number } },      -- профиль лезвия: { x, y, уголDeg, толщина, высота, длина }
	SocketDepth: number,        -- глубина втулки по Z (до масштаба)
	Socket: BasePart,           -- втулка головы (центр эффектов)
	Place: (p: BasePart, localCF: CFrame) -&gt; (), -- ставит деталь в систему кирки и регистрирует сварку
	ForViewport: boolean,       -- превью в магазине: свет и частицы не нужны (они там не рисуются)
	LowDetail: boolean,
}

-- Размер блёсток в конфиге задан для кирки в руке (масштаб 0.65)
local HAND_SCALE = 0.65
-- Смещение центра втулки относительно центра головы (из PICK_SHAPES.Socket), до масштаба головы
local SOCKET_CENTER_Y = 0.0468

function PickaxeJuice.Decorate(ctx: JuiceContext)
	local fx = GameConfig.GetPickaxeFx(ctx.Level)
	local k, hs, headY = ctx.Scale, ctx.HeadScale, ctx.HeadY
	local beads = ctx.Beads
	local n = #beads
	if n &lt; 4 then
		return
	end
	local sizeMul = k / HAND_SCALE

	local function deco(name: string, size: Vector3, localCF: CFrame, color: Color3, material: Enum.Material, transparency: number?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material
		p.Transparency = transparency or 0
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = ctx.Container
		ctx.Place(p, localCF)
		return p
	end

	-- 1) Неоновая полоса: сегменты вдоль осевой линии лезвия, чуть толще самого лезвия
	local first = 2
	while first &lt; n and beads[first][1] &lt; 0.46 do
		first += 1
	end
	local step = ctx.LowDetail and 7 or 4
	local rootHeight = beads[1][5]
	for _, side in ipairs({ -1, 1 }) do
		local i = first
		while i &lt; n - 1 do
			local j = math.min(i + step, n - 1)
			local a, b = beads[i], beads[j]
			local cx = (a[1] + b[1]) / 2 * hs
			local cy = (a[2] + b[2]) / 2 * hs
			local ang = math.rad((a[3] + b[3]) / 2)
			local len = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2) * hs * 1.1
			local thick = math.max(a[4], b[4]) * hs + 0.06
			local height = math.max(0.045, 0.13 * hs * (a[5] + b[5]) / (2 * rootHeight))
			deco(
				"NeonStrip",
				Vector3.new(thick, height, len) * k,
				CFrame.fromMatrix(
					Vector3.new(side * cx, headY + cy, 0) * k,
					Vector3.new(0, 0, 1),
					Vector3.new(side * math.sin(ang), math.cos(ang), 0)
				),
				fx.Neon,
				Enum.Material.Neon
			)
			i = j
		end
	end

	-- 2) Кристалл-сердечник: ромб, проходящий сквозь втулку, и яркая сердцевина
	local coreY = (headY + SOCKET_CENTER_Y * hs) * k
	local coreSize = (0.30 + 0.018 * ctx.Level) * hs
	local coreDepth = ctx.SocketDepth * hs + 0.16
	local core = deco(
		"CrystalCore",
		Vector3.new(coreSize, coreSize, coreDepth) * k,
		CFrame.new(0, coreY, 0) * CFrame.Angles(0, 0, math.rad(45)),
		fx.Core,
		Enum.Material.Neon
	)
	core:SetAttribute("BaseColor", fx.Core)
	deco(
		"CrystalHeart",
		Vector3.new(coreSize * 0.45, coreSize * 0.45, coreDepth + 0.07) * k,
		CFrame.new(0, coreY, 0) * CFrame.Angles(0, 0, math.rad(45)),
		PartKit.Lighten(fx.Core, 0.65),
		Enum.Material.Neon
	)

	ctx.Container:SetAttribute("FxEpic", fx.Epic)
	ctx.Container:SetAttribute("FxNeon", fx.Neon)

	-- В ViewportFrame свет, частицы и шлейфы не рисуются — не создаём их зря
	if ctx.ForViewport then
		return
	end

	-- 3) PointLight малого радиуса
	local light = PartKit.PointLight(core, fx.Core:Lerp(fx.Neon, 0.5), fx.LightBrightness, fx.LightRange * math.max(0.6, k))
	light.Name = "CoreLight"
	light:SetAttribute("BaseBrightness", fx.LightBrightness)

	-- 4) Постоянные блёстки по всей голове: невидимая зона вдоль лезвия
	local tip = beads[n]
	local zone = deco(
		"SparkleZone",
		Vector3.new(tip[1] * 2 * hs, 0.7 * hs, 0.3) * k,
		CFrame.new(0, (headY + tip[2] * 0.4 * hs) * k, 0),
		fx.Neon,
		Enum.Material.SmoothPlastic,
		1
	)
	PartKit.Emitter(zone, {
		Name = "TierSparkles",
		Color = PartKit.Lighten(fx.Neon, 0.4),
		Color2 = fx.Core,
		Rate = fx.SparkleRate,
		SizeStart = fx.SparkleSize * sizeMul,
		Lifetime = NumberRange.new(0.5, 1.0),
		Speed = NumberRange.new(0.4, 1.4),
		Spread = 180,
	})
	if fx.Epic then
		-- Топовые уровни: редкие крупные «звёзды» и (для 10 уровня) язычки огня у кристалла
		PartKit.Emitter(zone, {
			Name = "EpicGlints",
			Color = Color3.new(1, 1, 1),
			Color2 = fx.Neon,
			Rate = 3,
			SizeStart = 0.6 * sizeMul,
			Lifetime = NumberRange.new(0.7, 1.2),
			Speed = NumberRange.new(0.1, 0.5),
			RotSpeed = NumberRange.new(-200, 200),
		})
		if ctx.Level &gt;= GameConfig.MAX_PICKAXE_LEVEL then
			PartKit.Emitter(core, {
				Name = "RoyalFlame",
				Texture = PartKit.TEXTURE_FIRE,
				Color = fx.Neon,
				Color2 = fx.Core,
				Rate = 8,
				SizeStart = 0.55 * sizeMul,
				Lifetime = NumberRange.new(0.35, 0.6),
				Speed = NumberRange.new(0.8, 1.6),
				Spread = 25,
				Acceleration = Vector3.new(0, 2.5, 0),
			})
		end
	end

	-- 5) Искры удара: выключенный излучатель, клиент красит его в цвет руды и вызывает :Emit
	local sparks = PartKit.Emitter(core, {
		Name = "ImpactSparks",
		Color = fx.Neon,
		Rate = 0,
		SizeStart = 0.34 * sizeMul,
		Lifetime = NumberRange.new(0.22, 0.45),
		Speed = NumberRange.new(7, 15),
		Spread = 75,
		Acceleration = Vector3.new(0, -28, 0),
		Drag = 3,
		Enabled = false,
	})
	sparks:SetAttribute("BaseEnabled", false)

	-- 6) Шлейф между краями лезвия (точки крепления — в системе втулки, она без поворота)
	local idx = math.clamp(math.floor(n * fx.TrailWidth + 0.5), 2, n)
	local edge = beads[idx]
	local function tipAttachment(name: string, side: number): Attachment
		local att = Instance.new("Attachment")
		att.Name = name
		att.Position = Vector3.new(side * edge[1] * hs, (edge[2] - SOCKET_CENTER_Y) * hs, 0) * k
		att.Parent = ctx.Socket
		return att
	end
	local swing = GameConfig.PICKAXE_SWING_FX
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = tipAttachment("TipL", -1)
	trail.Attachment1 = tipAttachment("TipR", 1)
	trail.Color = ColorSequence.new(PartKit.Lighten(fx.Neon, 0.3), fx.Core)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.6, 0.7),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Lifetime = swing.TrailLifetime
	trail.MinLength = 0.03
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.FaceCamera = false
	trail.Enabled = false
	trail:SetAttribute("BaseEnabled", false)
	trail.Parent = ctx.Socket
end

return PickaxeJuice
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">UIKit</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🎨 МОДУЛЬ: UIKit (ReplicatedStorage.Modules.UIKit) — КЛИЕНТ
-- v52: общий набор для «живого» интерфейса: градиенты, скругления, обводки,
-- диагональный блик, мерцающие «✦», 3D-превью во ViewportFrame с медленным
-- вращением, тосты, конфетти, тряска карточки, звуки. Палитра — GameConfig.UI.
-- Анимации работают только пока окно открыто: вращением управляет Spinner,
-- который подключается к кадрам при Start и отключается при Stop.
-- ============================================================================

local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(script.Parent:WaitForChild("GameConfig"))

local UI = GameConfig.UI
local UIKit = {}

-- ---------------------------------------------------------------------------
-- Базовые элементы
-- ---------------------------------------------------------------------------
function UIKit.Corner(obj: Instance, radius: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or UI.Corner)
	c.Parent = obj
	return c
end

function UIKit.Stroke(obj: Instance, color: Color3, thickness: number?, transparency: number?): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
	return s
end

function UIKit.Gradient(obj: Instance, c0: Color3, c1: Color3, rotation: number?): UIGradient
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1)
	g.Rotation = rotation or 90
	g.Parent = obj
	return g
end

function UIKit.Frame(parent: Instance, name: string, size: UDim2, pos: UDim2, color: Color3?, transparency: number?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or UI.Panel
	f.BackgroundTransparency = transparency or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

export type LabelProps = {
	Name: string?,
	Text: string?,
	Size: UDim2?,
	Position: UDim2?,
	Font: Enum.Font?,
	Color: Color3?,
	TextSize: number?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Scaled: boolean?,
	Wrapped: boolean?,
	ZIndex: number?,
	Stroke: boolean?,
}

function UIKit.Label(parent: Instance, props: LabelProps): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = props.Name or "Label"
	l.BackgroundTransparency = 1
	l.Size = props.Size or UDim2.fromScale(1, 1)
	l.Position = props.Position or UDim2.new()
	l.Font = props.Font or UI.Font
	l.Text = props.Text or ""
	l.TextColor3 = props.Color or UI.Text
	l.TextSize = props.TextSize or 14
	l.TextScaled = props.Scaled == true
	l.TextWrapped = props.Wrapped == true
	l.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	l.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	l.ZIndex = props.ZIndex or 1
	l.Parent = parent
	if props.Stroke then
		local s = Instance.new("UIStroke")
		s.Thickness = 1.5
		s.Color = Color3.fromRGB(8, 10, 20)
		s.Transparency = 0.25
		s.Parent = l
	end
	return l
end

-- Кнопка с вертикальным градиентом, обводкой и «нажатием» через UIScale
function UIKit.Button(parent: Instance, name: string, text: string, size: UDim2, pos: UDim2, c0: Color3, c1: Color3): (TextButton, UIGradient)
	local b = Instance.new("TextButton")
	b.Name = name
	b.Size = size
	b.Position = pos
	b.AutoButtonColor = false
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.BorderSizePixel = 0
	b.Font = UI.FontBlack
	b.Text = text
	b.TextSize = 15
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = parent
	UIKit.Corner(b, 10)
	local grad = UIKit.Gradient(b, c0, c1, 90)
	UIKit.Stroke(b, Color3.fromRGB(10, 12, 24), 2, 0.2)
	local ts = Instance.new("UIStroke")
	ts.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	ts.Thickness = 1.5
	ts.Color = Color3.fromRGB(10, 12, 24)
	ts.Transparency = 0.3
	ts.Parent = b
	local scale = Instance.new("UIScale")
	scale.Parent = b
	b.MouseButton1Down:Connect(function()
		scale.Scale = 0.94
	end)
	b.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	b.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	return b, grad
end

-- ---------------------------------------------------------------------------
-- Адаптивный масштаб (ПК / планшет / телефон)
-- ---------------------------------------------------------------------------
function UIKit.ViewportSize(): Vector2
	local cam = Workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

-- Масштабирует окно базового размера так, чтобы оно целиком помещалось на экране
function UIKit.BindScale(scale: UIScale, baseW: number, baseH: number, maxScale: number?): RBXScriptConnection?
	local function apply()
		local vp = UIKit.ViewportSize()
		scale:SetAttribute("Fit", math.clamp(math.min(vp.X / (baseW + 24), vp.Y / (baseH + 24)), 0.35, maxScale or 1.1))
		if scale:GetAttribute("Animating") ~= true then
			scale.Scale = scale:GetAttribute("Fit") :: number
		end
	end
	apply()
	local cam = Workspace.CurrentCamera
	if cam then
		return cam:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
	end
	return nil
end

-- ---------------------------------------------------------------------------
-- Блик и мерцание
-- ---------------------------------------------------------------------------
-- Диагональный блик: белая накладка, у которой видна только узкая полоса градиента.
-- Возвращает градиент; UIKit.PlayShine двигает его смещение слева направо.
function UIKit.AddShine(card: GuiObject, corner: number?, zIndex: number?): UIGradient
	local overlay = Instance.new("Frame")
	overlay.Name = "Shine"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = UI.Shine
	overlay.BorderSizePixel = 0
	overlay.Active = false
	overlay.ZIndex = zIndex or 8
	overlay.Parent = card
	UIKit.Corner(overlay, corner)
	local g = Instance.new("UIGradient")
	g.Rotation = 24
	g.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.40, 1),
		NumberSequenceKeypoint.new(0.50, 0.68),
		NumberSequenceKeypoint.new(0.60, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	g.Offset = Vector2.new(-1, 0)
	g.Parent = overlay
	return g
end

function UIKit.PlayShine(grad: UIGradient, delaySeconds: number?)
	grad.Offset = Vector2.new(-1, 0)
	TweenService:Create(
		grad,
		TweenInfo.new(UI.ShineSeconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, false, delaySeconds or 0),
		{ Offset = Vector2.new(1, 0) }
	):Play()
end

-- Мерцающие «✦» в случайных местах карточки. Твины бесконечные — их запускает и
-- останавливает владелец окна (UIKit.StartTwinkles / UIKit.StopTweens).
function UIKit.AddTwinkles(parent: GuiObject, count: number, color: Color3, rng: Random, zIndex: number?): { TextLabel }
	local out: { TextLabel } = {}
	for _ = 1, count do
		local size = rng:NextInteger(10, 18)
		local l = Instance.new("TextLabel")
		l.Name = "Twinkle"
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Size = UDim2.fromOffset(size + 6, size + 6)
		l.Position = UDim2.fromScale(rng:NextNumber(0.08, 0.92), rng:NextNumber(0.06, 0.55))
		l.Font = Enum.Font.GothamBold
		l.Text = "✦"
		l.TextSize = size
		l.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.45)
		l.TextTransparency = 1
		l.ZIndex = zIndex or 7
		l:SetAttribute("Delay", rng:NextNumber(0, 1.6))
		l:SetAttribute("Period", rng:NextNumber(0.7, 1.3))
		l.Parent = parent
		table.insert(out, l)
	end
	return out
end

function UIKit.StartTwinkles(labels: { TextLabel }, into: { Tween })
	for _, l in ipairs(labels) do
		if l.Parent then
			l.TextTransparency = 1
			l.Rotation = 0
			local period = (l:GetAttribute("Period") :: number?) or 1
			local delayTime = (l:GetAttribute("Delay") :: number?) or 0
			local tw = TweenService:Create(
				l,
				TweenInfo.new(period, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, delayTime),
				{ TextTransparency = 0.05, Rotation = 45 }
			)
			tw:Play()
			table.insert(into, tw)
		end
	end
end

function UIKit.StopTweens(tweens: { Tween })
	for _, tw in ipairs(tweens) do
		tw:Cancel()
	end
	table.clear(tweens)
end

-- ---------------------------------------------------------------------------
-- 3D-превью: ViewportFrame + камера, которая медленно облетает модель
-- ---------------------------------------------------------------------------
export type SpinItem = {
	Viewport: ViewportFrame,
	Camera: Camera,
	Center: Vector3,
	Distance: number,
	Height: number,
	Phase: number,
}

function UIKit.Viewport(parent: Instance, name: string, size: UDim2, pos: UDim2): (ViewportFrame, Camera, WorldModel)
	local vp = Instance.new("ViewportFrame")
	vp.Name = name
	vp.Size = size
	vp.Position = pos
	vp.BackgroundTransparency = 1
	vp.Ambient = Color3.fromRGB(150, 156, 180)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = Vector3.new(-1, -1.6, -0.8)
	vp.Parent = parent
	local cam = Instance.new("Camera")
	cam.FieldOfView = 34
	cam.Parent = vp
	vp.CurrentCamera = cam
	local world = Instance.new("WorldModel")
	world.Parent = vp
	return vp, cam, world
end

function UIKit.OrbitCamera(item: SpinItem, angle: number)
	local a = angle + item.Phase
	local eye = item.Center + Vector3.new(math.sin(a) * item.Distance, item.Height, math.cos(a) * item.Distance)
	item.Camera.CFrame = CFrame.lookAt(eye, item.Center)
end

export type Spinner = {
	Add: (item: SpinItem) -&gt; (),
	Remove: (vp: ViewportFrame) -&gt; (),
	Clear: () -&gt; (),
	Start: () -&gt; (),
	Stop: () -&gt; (),
}

-- Spinner вращает камеры всех зарегистрированных превью. clip — прокручиваемая область:
-- превью за её пределами не обновляются (ViewportFrame не перерисовывается зря).
function UIKit.NewSpinner(periodSeconds: number, clip: GuiObject?): Spinner
	local items: { SpinItem } = {}
	local conn: RBXScriptConnection? = nil
	local angle = 0

	local function visible(vp: ViewportFrame): boolean
		if not clip then
			return true
		end
		local top = clip.AbsolutePosition.Y
		local bottom = top + clip.AbsoluteSize.Y
		local y0 = vp.AbsolutePosition.Y
		return (y0 + vp.AbsoluteSize.Y) &gt;= top and y0 &lt;= bottom
	end

	local spinner = {} :: Spinner
	function spinner.Add(item: SpinItem)
		table.insert(items, item)
		UIKit.OrbitCamera(item, angle)
	end
	function spinner.Remove(vp: ViewportFrame)
		for i = #items, 1, -1 do
			if items[i].Viewport == vp then
				table.remove(items, i)
			end
		end
	end
	function spinner.Clear()
		table.clear(items)
	end
	function spinner.Start()
		if conn then
			return
		end
		conn = RunService.Heartbeat:Connect(function(dt: number)
			angle = (angle + dt * (2 * math.pi) / periodSeconds) % (2 * math.pi)
			for _, item in ipairs(items) do
				if item.Viewport.Parent and visible(item.Viewport) then
					UIKit.OrbitCamera(item, angle)
				end
			end
		end)
	end
	function spinner.Stop()
		if conn then
			conn:Disconnect()
			conn = nil
		end
	end
	return spinner
end

-- ---------------------------------------------------------------------------
-- Обратная связь: звук, тост, тряска, вспышка, конфетти
-- ---------------------------------------------------------------------------
local SfxCache: { [string]: Sound } = {}

function UIKit.PlaySfx(key: string)
	local cfg = GameConfig.SFX[key]
	if not cfg then
		return
	end
	local cached = SfxCache[key]
	if cached and cached.Parent then
		cached:Play()
		return
	end
	local s = Instance.new("Sound")
	s.Name = "V52Sfx_" .. key
	s.SoundId = cfg.Id
	s.Volume = cfg.Volume
	s.PlaybackSpeed = cfg.Pitch
	s.Parent = SoundService
	SfxCache[key] = s
	s:Play()
end

-- Всплывающая плашка сверху по центру (красная — ошибка, зелёная — успех)
function UIKit.Toast(layer: Instance, text: string, color: Color3)
	local old = layer:FindFirstChild("V52Toast")
	if old then
		old:Destroy()
	end
	local t = Instance.new("Frame")
	t.Name = "V52Toast"
	t.AnchorPoint = Vector2.new(0.5, 0)
	t.Size = UDim2.fromOffset(420, 46)
	t.Position = UDim2.new(0.5, 0, 0, -60)
	t.BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.55)
	t.BorderSizePixel = 0
	t.ZIndex = 200
	t.Parent = layer
	UIKit.Corner(t, 12)
	UIKit.Stroke(t, color, 2.5)
	local sc = Instance.new("UIScale")
	sc.Scale = math.clamp(UIKit.ViewportSize().X / 520, 0.6, 1)
	sc.Parent = t
	UIKit.Label(t, {
		Text = text,
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Font = UI.FontBlack,
		TextSize = 17,
		Scaled = false,
		Wrapped = true,
		ZIndex = 201,
	})
	TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 64),
	}):Play()
	task.delay(UI.ToastSeconds, function()
		if not t.Parent then
			return
		end
		local out = TweenService:Create(t, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(0.5, 0, 0, -60),
		})
		out:Play()
		out.Completed:Wait()
		t:Destroy()
	end)
end

-- Короткая тряска элемента по горизонтали (элемент не должен управляться UIListLayout / UIGridLayout)
function UIKit.Shake(obj: GuiObject)
	if obj:GetAttribute("Shaking") then
		return
	end
	obj:SetAttribute("Shaking", true)
	local base = obj.Position
	task.spawn(function()
		for _, dx in ipairs({ -9, 8, -6, 5, -3, 0 }) do
			if not obj.Parent then
				return
			end
			TweenService:Create(obj, TweenInfo.new(0.045, Enum.EasingStyle.Quad), {
				Position = base + UDim2.fromOffset(dx, 0),
			}):Play()
			task.wait(0.05)
		end
		obj.Position = base
		obj:SetAttribute("Shaking", nil)
	end)
end

-- Цветная вспышка поверх элемента (зелёная при покупке)
function UIKit.Flash(obj: GuiObject, color: Color3, corner: number?)
	local f = Instance.new("Frame")
	f.Name = "Flash"
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = 0.25
	f.BorderSizePixel = 0
	f.Active = false
	f.ZIndex = 30
	f.Parent = obj
	UIKit.Corner(f, corner)
	local tw = TweenService:Create(f, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1,
	})
	tw:Play()
	tw.Completed:Once(function()
		f:Destroy()
	end)
end

-- Конфетти из искр «✦», разлетающихся из точки экрана (создаются один раз на событие)
function UIKit.Confetti(layer: Instance, center: Vector2, colors: { Color3 }, count: number)
	local rng = Random.new()
	for i = 1, count do
		local l = Instance.new("TextLabel")
		l.Name = "Confetti"
		l.BackgroundTransparency = 1
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Size = UDim2.fromOffset(26, 26)
		l.Position = UDim2.fromOffset(center.X, center.Y)
		l.Font = Enum.Font.GothamBold
		l.Text = (i % 3 == 0) and "✧" or "✦"
		l.TextSize = rng:NextInteger(14, 24)
		l.TextColor3 = colors[((i - 1) % #colors) + 1]
		l.ZIndex = 210
		l.Parent = layer
		local a = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(60, 170)
		local tw = TweenService:Create(l, TweenInfo.new(rng:NextNumber(0.5, 0.8), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(center.X + math.cos(a) * dist, center.Y + math.sin(a) * dist + 30),
			TextTransparency = 1,
			Rotation = rng:NextNumber(-180, 180),
		})
		tw:Play()
		tw.Completed:Once(function()
			l:Destroy()
		end)
	end
end

-- ---------------------------------------------------------------------------
-- Форматирование
-- ---------------------------------------------------------------------------
-- 1234567 -&gt; "1 234 567"
function UIKit.FormatCoins(n: number): string
	local s = tostring(math.floor(n + 0.5))
	local out = s
	while true do
		local replaced, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1 %2")
		out = replaced
		if k == 0 then
			break
		end
	end
	return out
end

-- Секунды -&gt; "мм:сс" (pad = true) или "м:сс"
function UIKit.FormatTime(seconds: number, pad: boolean?): string
	local s = math.max(0, math.ceil(seconds - 0.001))
	local m = math.floor(s / 60)
	return string.format(pad and "%02d:%02d" or "%d:%02d", m, s % 60)
end

return UIKit
