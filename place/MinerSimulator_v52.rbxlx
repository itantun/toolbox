local VECTOR_KEY = {
	Backpack = "BackpackTile", Pickaxe = "PickaxeTile", Coins = "Coins",
	Strength = "Strength", Level = "Level", XP = "XP",
}

-- Polygon row: { "p", {x1,y1, x2,y2, ...}, topHex, bottomHex, strokeHex, strokeW, transparency }
-- Filled with 1px scanlines (smooth vertical gradient), outlined with rounded rotated bars.
local function drawPoly(root: Frame, s: { any }, k: number, z: number, idx: number)
	local pts = s[2]
	local n = math.floor(#pts / 2)
	local c0, c1 = Color3.fromHex(s[3]), Color3.fromHex(s[4])
	local sw = s[6] or 0
	local tr = s[7] or 0
	local holder = Instance.new("Frame")
	holder.Name = "P" .. idx
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = z
	holder.Active = false
	local ymin, ymax = math.huge, -math.huge
	for j = 1, n do
		local y = pts[2 * j]
		ymin = math.min(ymin, y)
		ymax = math.max(ymax, y)
	end
	local span = math.max(1, ymax - ymin)
	local rowH = if tr &gt; 0 then 1 else 2
	for py = math.floor(ymin * k), math.ceil(ymax * k) - 1 do
		local yc = (py + 0.5) / k
		local xs = {}
		for j = 1, n do
			local j2 = j % n + 1
			local x1, y1 = pts[2 * j - 1], pts[2 * j]
			local x2, y2 = pts[2 * j2 - 1], pts[2 * j2]
			if (y1 &lt;= yc and y2 &gt; yc) or (y2 &lt;= yc and y1 &gt; yc) then
				table.insert(xs, x1 + (yc - y1) / (y2 - y1) * (x2 - x1))
			end
		end
		table.sort(xs)
		local col = c0:Lerp(c1, math.clamp((yc - ymin) / span, 0, 1))
		for m = 1, #xs - 1, 2 do
			local a = math.floor(xs[m] * k + 0.5)
			local b = math.floor(xs[m + 1] * k + 0.5)
			if b &gt; a then
				local f = Instance.new("Frame")
				f.Name = "S"
				f.BorderSizePixel = 0
				f.BackgroundColor3 = col
				f.BackgroundTransparency = tr
				f.Position = UDim2.fromOffset(a, py)
				f.Size = UDim2.fromOffset(b - a, math.min(rowH, math.ceil(ymax * k) - py))
				f.ZIndex = 1
				f.Active = false
				f.Parent = holder
			end
		end
	end
	if sw &gt; 0 then
		local w = math.max(1, sw * k)
		local sc = Color3.fromHex(s[5])
		for j = 1, n do
			local j2 = j % n + 1
			local x1, y1 = pts[2 * j - 1] * k, pts[2 * j] * k
			local x2, y2 = pts[2 * j2 - 1] * k, pts[2 * j2] * k
			local dx, dy = x2 - x1, y2 - y1
			local e = Instance.new("Frame")
			e.Name = "E"
			e.BorderSizePixel = 0
			e.BackgroundColor3 = sc
			e.AnchorPoint = Vector2.new(0.5, 0.5)
			e.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
			e.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + w, w)
			e.Rotation = math.deg(math.atan2(dy, dx))
			e.ZIndex = 2
			e.Active = false
			local ec = Instance.new("UICorner")
			ec.CornerRadius = UDim.new(0.5, 0)
			ec.Parent = e
			e.Parent = holder
		end
	end
	holder.Parent = root
end

function HudModule.DrawIcon(parent: Instance, key: string, size: number, z: number?)
	local spec = ICON_SPECS[key]
	if not spec then
		return nil
	end
	local base = z or 3
	local k = size / 100
	local root = Instance.new("Frame")
	root.Name = "VIcon_" .. key
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromOffset(size, size)
	root.ZIndex = base
	root.Active = false
	for i, s in ipairs(spec) do
		if s[1] == "p" then
			drawPoly(root, s, k, base + i, i)
			continue
		end
		local obj
		if s[1] == "x" then
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Font = Enum.Font.GothamBlack
			t.Text = s[14]
			t.TextSize = math.max(6, math.floor(s[5] * k + 0.5))
			t.TextColor3 = Color3.new(1, 1, 1)
			t.TextStrokeTransparency = 1
			obj = t
		else
			local f = Instance.new("Frame")
			f.BackgroundColor3 = Color3.new(1, 1, 1)
			f.BackgroundTransparency = s[13]
			obj = f
		end
		obj.Name = "P" .. i
		obj.BorderSizePixel = 0
		obj.AnchorPoint = Vector2.new(0.5, 0.5)
		obj.Position = UDim2.fromOffset(s[2] * k, s[3] * k)
		obj.Size = UDim2.fromOffset(s[4] * k, s[5] * k)
		obj.Rotation = s[6]
		obj.ZIndex = base + i
		obj.Active = false
		if s[7] &gt; 0 then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, s[7] * math.min(s[4], s[5]) * k)
			c.Parent = obj
		end
		if s[8] ~= s[9] then
			local g = Instance.new("UIGradient")
			g.Color = ColorSequence.new(Color3.fromHex(s[8]), Color3.fromHex(s[9]))
			g.Rotation = s[10]
			g.Parent = obj
		elseif s[1] == "x" then
			obj.TextColor3 = Color3.fromHex(s[8])
		else
			obj.BackgroundColor3 = Color3.fromHex(s[8])
		end
		if s[12] &gt; 0 then
			local st = Instance.new("UIStroke")
			st.Color = Color3.fromHex(s[11])
			st.Thickness = math.max(1, s[12] * k)
			st.LineJoinMode = Enum.LineJoinMode.Round
			if s[1] ~= "x" then
				st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			end
			st.Parent = obj
		end
		obj.Parent = root
	end
	root.Parent = parent
	return root
end

local function makeIcon(parent: Instance, key: string, size: number, pos: UDim2): GuiObject
	local id = HudModule.ICONS[key]
	if id and id ~= "" then
		-- мягкая подложка цвета акцента, чтобы тёмные иконки (рюкзак) читались
		local back = Instance.new("Frame")
		back.Name = "Icon"
		back.Size = UDim2.fromOffset(size, size)
		back.Position = pos
		back.BackgroundColor3 = ACCENT[key]
		back.BackgroundTransparency = 0.78
		back.ZIndex = 3
		back.Parent = parent
		corner(back, 9)
		local img = Instance.new("ImageLabel")
		img.Name = "Image"
		img.BackgroundTransparency = 1
		img.AnchorPoint = Vector2.new(0.5, 0.5)
		img.Position = UDim2.fromScale(0.5, 0.5)
		img.Size = UDim2.fromScale(0.92, 0.92)
		img.Image = id
		img.ScaleType = Enum.ScaleType.Fit
		img.ZIndex = 4
		img.Parent = back
		return back
	end
	-- v26: vector picture copied from the reference (no emoji)
	local vkey = VECTOR_KEY[key] or key
	if ICON_SPECS[vkey] then
		local holder = Instance.new("Frame")
		holder.Name = "Icon"
		holder.BackgroundTransparency = 1
		holder.BorderSizePixel = 0
		holder.Size = UDim2.fromOffset(size, size)
		holder.Position = pos
		holder.ZIndex = 3
		holder.Parent = parent
		HudModule.DrawIcon(holder, vkey, size, 3)
		return holder
	end
	-- Fallback: эмодзи в цветной плитке
	local tile = Instance.new("Frame")
	tile.Name = "Icon"
	tile.Size = UDim2.fromOffset(size, size)
	tile.Position = pos
	tile.BackgroundColor3 = Color3.new(1, 1, 1)
	tile.ZIndex = 3
	tile.Parent = parent
	corner(tile, 9)
	local g = Instance.new("UIGradient")
	local a = TILE[key] or ACCENT[key]
	g.Color = ColorSequence.new(a:Lerp(Color3.new(1, 1, 1), 0.15), a:Lerp(Color3.new(0, 0, 0), 0.45))
	g.Rotation = 90
	g.Parent = tile
	local tst = Instance.new("UIStroke")
	tst.Color = a:Lerp(Color3.new(1, 1, 1), 0.5)
	tst.Thickness = 2
	tst.Parent = tile
	local tgl = Instance.new("Frame")
	tgl.Name = "Gloss"
	tgl.BackgroundColor3 = Color3.new(1, 1, 1)
	tgl.BackgroundTransparency = 0.75
	tgl.BorderSizePixel = 0
	tgl.Size = UDim2.new(1, -6, 0.42, 0)
	tgl.Position = UDim2.fromOffset(3, 2)
	tgl.ZIndex = 3
	tgl.Parent = tile
	corner(tgl, 7)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = EMOJI[key]
	t.TextScaled = true
	t.Font = Enum.Font.GothamBlack
	t.TextColor3 = Color3.new(1, 1, 1)
	t.ZIndex = 4
	t.Parent = tile
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4); pad.PaddingBottom = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4); pad.PaddingRight = UDim.new(0, 4)
	pad.Parent = t
	return tile
end

local function textLabel(parent: Instance, name: string, size: UDim2, pos: UDim2, font: Enum.Font, color: Color3, maxSize: number, align: Enum.TextXAlignment?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = font
	l.TextColor3 = color
	l.TextScaled = true
	l.TextXAlignment = align or Enum.TextXAlignment.Left
	l.ZIndex = 4
	l.Text = ""
	l.TextStrokeTransparency = 0.45
	l.TextStrokeColor3 = Color3.fromRGB(10, 18, 50)
	l.Parent = parent
	local c = Instance.new("UITextSizeConstraint")
	c.MaxTextSize = maxSize
	c.MinTextSize = 8
	c.Parent = l
	return l
end

local function makeCard(parent: Instance, key: string, title: string, size: Vector2, order: number, opts: { Bar: boolean?, Sub: boolean?, Compact: boolean? }): Card
	local accent = ACCENT[key]

	-- Слот в UIListLayout (не двигается)
	local holder = Instance.new("Frame")
	holder.Name = key .. "Card"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size.X, size.Y)
	holder.LayoutOrder = order
	holder.Parent = parent

	-- Обёртка: hover-масштаб и въезд (тень + тело двигаются вместе)
	local wrap = Instance.new("Frame")
	wrap.Name = "Wrap"
	wrap.BackgroundTransparency = 1
	wrap.AnchorPoint = Vector2.new(0.5, 0.5)
	wrap.Position = UDim2.fromScale(0.5, 0.5)
	wrap.Size = UDim2.fromScale(1, 1)
	wrap.Parent = holder
	local hoverScale = Instance.new("UIScale")
	hoverScale.Parent = wrap

	-- Тень (отдельный фрейм — у объекта может быть только один UIStroke)
	local shadow = Instance.new("Frame")
	shadow.Name = "Shadow"
	shadow.BackgroundColor3 = Color3.new(0, 0, 0)
	shadow.BackgroundTransparency = SHADOW_TRANSPARENCY
	shadow.Size = UDim2.fromScale(1, 1)
	shadow.Position = UDim2.fromOffset(SHADOW_OFFSET.X, SHADOW_OFFSET.Y)
	shadow.ZIndex = 1
	shadow.Parent = wrap
	corner(shadow, CORNER)

	local body = Instance.new("Frame")
	body.Name = "Body"
	body.BackgroundColor3 = Color3.new(1, 1, 1)
	body.Size = UDim2.fromScale(1, 1)
	body.ZIndex = 2
	body.ClipsDescendants = false
	body.Parent = wrap
	corner(body, CORNER)
	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(BG_TOP, BG_BOTTOM)
	grad.Rotation = 90
	grad.Parent = body
	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = STROKE
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = body
	-- v25: soft outer glow (behind the plate) + glossy top highlight
	local glow = Instance.new("Frame")
	glow.Name = "Glow"
	glow.BackgroundColor3 = accent
	glow.BackgroundTransparency = 0.72
	glow.Size = UDim2.new(1, 10, 1, 10)
	glow.Position = UDim2.fromOffset(-5, -5)
	glow.ZIndex = 1
	glow.Parent = wrap
	corner(glow, CORNER + 5)
	local gloss = Instance.new("Frame")
	gloss.Name = "Gloss"
	gloss.BackgroundColor3 = Color3.new(1, 1, 1)
	gloss.BackgroundTransparency = 0.9
	gloss.BorderSizePixel = 0
	gloss.Size = UDim2.new(1, -10, 0.46, 0)
	gloss.Position = UDim2.fromOffset(5, 3)
	gloss.ZIndex = 2
	gloss.Parent = body
	corner(gloss, CORNER - 4)

	-- Вспышка при росте значения
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BackgroundColor3 = accent:Lerp(Color3.new(1, 1, 1), 0.5)
	flash.BackgroundTransparency = 1
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 6
	flash.Parent = body
	corner(flash, CORNER)

	local compact = opts.Compact == true
	local iconSize = compact and 30 or 56 -- v26: big picture like the reference
	local pad = compact and 7 or 8
	local icon = makeIcon(body, key, iconSize, compact and UDim2.fromOffset(pad, 8) or UDim2.new(0, pad, 0.5, -iconSize / 2))
	local textX = pad + iconSize + 8

	local titleLbl = textLabel(body, "Title", UDim2.new(1, -textX - pad, 0, compact and 13 or 18), UDim2.fromOffset(textX, compact and 7 or 9),
		Enum.Font.GothamBold, Color3.new(1, 1, 1), compact and 12 or 15)
	titleLbl.Text = title

	local valueLbl = textLabel(body, "Value", UDim2.new(1, -textX - pad, 0, compact and 24 or 30), UDim2.fromOffset(textX, compact and 20 or 28),
		Enum.Font.GothamBlack, Color3.new(1, 1, 1), compact and 22 or 27)
	local valueScale = Instance.new("UIScale")
	valueScale.Parent = valueLbl

	local sub: TextLabel? = nil
	if opts.Sub then
		sub = textLabel(body, "Sub", UDim2.new(0.5, -pad, 0, 14), UDim2.new(0.5, 0, 0, 8),
			Enum.Font.GothamBlack, Color3.fromRGB(230, 240, 255), 14, Enum.TextXAlignment.Right)
	end

	local fill: Frame? = nil
	local fillGrad: UIGradient? = nil
	if opts.Bar then
		local barBg = Instance.new("Frame")
		barBg.Name = "BarBg"
		barBg.BackgroundColor3 = Color3.fromRGB(8, 14, 44)
		barBg.BorderSizePixel = 0
		barBg.ZIndex = 3
		if compact then
			barBg.Size = UDim2.new(1, -pad * 2, 0, 7)
			barBg.Position = UDim2.new(0, pad, 1, -13)
		else
			barBg.Size = UDim2.new(1, -textX - pad, 0, 9)
			barBg.Position = UDim2.new(0, textX, 1, -16)
		end
		barBg.Parent = body
		corner(barBg, 99)
		local f = Instance.new("Frame")
		f.Name = "Fill"
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BorderSizePixel = 0
		f.Size = UDim2.fromScale(0, 1)
		f.ZIndex = 4
		f.Parent = barBg
		corner(f, 99)
		local fg = Instance.new("UIGradient")
		fg.Color = barSequence(0)
		fg.Parent = f
		fill, fillGrad = f, fg
	end

	-- Прозрачная кнопка поверх: hover и клик
	local btn = Instance.new("TextButton")
	btn.Name = "Hit"
	btn.BackgroundTransparency = 1
	btn.Text = ""
	btn.Size = UDim2.fromScale(1, 1)
	btn.ZIndex = 8
	btn.AutoButtonColor = false
	btn.Parent = body
	btn.MouseEnter:Connect(function()
		tween(hoverScale, 0.15, { Scale = 1.05 })
		tween(stroke, 0.15, { Thickness = STROKE + 1 })
	end)
	btn.MouseLeave:Connect(function()
		tween(hoverScale, 0.18, { Scale = 1 })
		tween(stroke, 0.18, { Thickness = STROKE })
	end)

	return {
		Key = key, Holder = holder, Wrap = wrap, Body = body, Stroke = stroke,
		Title = titleLbl, Value = valueLbl, ValueScale = valueScale, Sub = sub,
		Fill = fill, FillGradient = fillGrad, Flash = flash, Icon = icon, Button = btn,
		HomePos = wrap.Position,
	}
end

-- v25: round "+" button on the right side of a plate (like the reference)
local function addPlus(card: Card, c0: Color3, c1: Color3): TextButton
	local b = Instance.new("TextButton")
	b.Name = "PlusBtn"
	b.AnchorPoint = Vector2.new(1, 0.5)
	b.Size = UDim2.fromOffset(38, 38)
	b.Position = UDim2.new(1, -9, 0.5, 0)
	b.BackgroundColor3 = Color3.new(1, 1, 1)
	b.AutoButtonColor = false
	b.Font = Enum.Font.GothamBlack
	b.Text = "" -- v26: drawn chunky plus (PlusBar frames below)
	b.TextSize = 30
	b.TextColor3 = Color3.new(1, 1, 1)
	b.TextStrokeTransparency = 0.35
	b.TextStrokeColor3 = c1:Lerp(Color3.new(0, 0, 0), 0.5)
	b.ZIndex = 9
	b.Parent = card.Body
	corner(b, 99)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c0, c1)
	g.Rotation = 90
	g.Parent = b
	local st = Instance.new("UIStroke")
	st.Color = Color3.new(1, 1, 1)
	st.Thickness = 2.5
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	-- v26: chunky white plus made of two rounded bars with a dark outline (like the reference)
	for pass = 1, 2 do
		for i = 1, 2 do
			local bar = Instance.new("Frame")
			bar.Name = "PlusBar"
			bar.AnchorPoint = Vector2.new(0.5, 0.5)
			bar.Position = UDim2.fromScale(0.5, 0.5)
			bar.Size = (i == 1) and UDim2.fromOffset(20, 7) or UDim2.fromOffset(7, 20)
			bar.BackgroundColor3 = Color3.new(1, 1, 1)
			bar.BorderSizePixel = 0
			bar.ZIndex = 9 + pass
			bar.Active = false
			bar.Parent = b
			corner(bar, 3)
			if pass == 1 then
				local bst = Instance.new("UIStroke")
				bst.Color = c1:Lerp(Color3.new(0, 0, 0), 0.55)
				bst.Thickness = 2
				bst.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				bst.Parent = bar
			end
		end
	end
	local sc = Instance.new("UIScale")
	sc.Parent = b
	b.MouseEnter:Connect(function() tween(sc, 0.12, { Scale = 1.12 }) end)
	b.MouseLeave:Connect(function() tween(sc, 0.12, { Scale = 1 }) end)
	b.MouseButton1Down:Connect(function() sc.Scale = 0.9 end)
	b.MouseButton1Up:Connect(function() sc.Scale = 1.12 end)
	return b
end

local function bounce(card: Card)
	local sc = card.ValueScale
	tween(sc, 0.09, { Scale = 1.2 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out).Completed:Connect(function()
		tween(sc, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
end

local function flash(card: Card, strength: number?)
	card.Flash.BackgroundTransparency = 1 - (strength or 0.45)
	tween(card.Flash, 0.45, { BackgroundTransparency = 1 })
	tween(card.Stroke, 0.08, { Thickness = STROKE + 2 }).Completed:Connect(function()
		tween(card.Stroke, 0.3, { Thickness = STROKE })
	end)
end

local function setBar(card: Card, ratio: number)
	local fill, grad = card.Fill, card.FillGradient
	if not fill or not grad then return end
	ratio = math.clamp(ratio, 0, 1)
	grad.Color = barSequence(ratio)
	tween(fill, 0.35, { Size = UDim2.fromScale(ratio, 1) })
end

-- ============================================================================
-- КОНСТРУКТОР
-- ============================================================================
function HudModule.new(screenGui: ScreenGui, callbacks: { OnBackpackClick: (() -&gt; ())? }?)
	local self = setmetatable({}, HudModule)
	local cb = callbacks or {}
	self._prev = {}
	self._first = true
	self._scales = {}

	-- Верхний ряд
	local top = Instance.new("Frame")
	top.Name = "TopPlates"
	top.BackgroundTransparency = 1
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, TOP_Y)
	top.Size = UDim2.fromOffset(TOP_CARD_SIZE.X * 2 + TOP_GAP, TOP_CARD_SIZE.Y)   -- v14: монеты вынесены вправо
	top.Parent = screenGui
	local tl = Instance.new("UIListLayout")
	tl.FillDirection = Enum.FillDirection.Horizontal
	tl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	tl.Padding = UDim.new(0, TOP_GAP)
	tl.SortOrder = Enum.SortOrder.LayoutOrder
	tl.Parent = top
	self.TopRow = top

	-- Левая колонка
	local left = Instance.new("Frame")
	left.Name = "LeftColumn"
	left.BackgroundTransparency = 1
	left.Position = LEFT_POS
	left.Size = UDim2.fromOffset(LEFT_CARD_SIZE.X, 600)
	left.Parent = screenGui
	local ll = Instance.new("UIListLayout")
	ll.FillDirection = Enum.FillDirection.Vertical
	ll.Padding = UDim.new(0, LEFT_GAP)
	ll.SortOrder = Enum.SortOrder.LayoutOrder
	ll.Parent = left
	self.LeftColumn = left

	-- v14: пилюля монет в правом верхнем углу (как на референсе)
	local topRight = Instance.new("Frame")
	topRight.Name = "TopRightCoins"
	topRight.BackgroundTransparency = 1
	topRight.AnchorPoint = Vector2.new(1, 0)
	topRight.Position = UDim2.new(1, -14, 0, TOP_Y)
	topRight.Size = UDim2.fromOffset(236, TOP_CARD_SIZE.Y)
	topRight.Parent = screenGui
	local trl = Instance.new("UIListLayout")
	trl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	trl.Parent = topRight
	self.TopRight = topRight

	for _, root in ipairs({ top, left, topRight }) do
		local sc = Instance.new("UIScale")
		sc.Scale = getViewportScale()
		sc.Parent = root
		table.insert(self._scales, sc)
	end
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			local s = getViewportScale()
			for _, sc in ipairs(self._scales) do sc.Scale = s end
		end)
	end

	-- v25: top plates in the same style as "Jackpot / Rebirths" on the reference
	self.Cards = {
		Backpack = makeCard(top, "Backpack", "Backpack", TOP_CARD_SIZE, 1, { Bar = true }),
		Pickaxe  = makeCard(top, "Pickaxe", "Pickaxe", TOP_CARD_SIZE, 2, {}),
		Coins    = makeCard(topRight, "Coins", "Coins", Vector2.new(236, TOP_CARD_SIZE.Y), 3, {}),
		Strength = makeCard(left, "Strength", "Strength", LEFT_CARD_SIZE, 1, { Bar = true, Sub = true }),
		Level    = makeCard(left, "Level", "Level", LEFT_CARD_SIZE, 2, { Bar = true, Sub = true }),
		XP       = makeCard(left, "XP", "XP", LEFT_CARD_SIZE, 3, { Bar = true, Sub = true }),
	}

	-- Звёзды кирки (RichText)
	local pick = self.Cards.Pickaxe
	local stars = textLabel(pick.Body, "Stars", UDim2.new(1, -10, 0, 14), UDim2.new(0, 5, 1, -19),
		Enum.Font.GothamBlack, Color3.fromRGB(255, 215, 70), 11, Enum.TextXAlignment.Center)
	stars.RichText = true
	self.Stars = stars
	local starsScale = Instance.new("UIScale")
	starsScale.Parent = stars
	self.StarsScale = starsScale

	-- Монеты: значение на всю ширину снизу (числа бывают длинными)
	local coins = self.Cards.Coins
	coins.Value.Size = UDim2.new(1, -128, 0, 30)
	coins.Value.TextXAlignment = Enum.TextXAlignment.Center -- v26: centred like the reference
	coins.Value.TextColor3 = Color3.new(1, 1, 1)
	stars.Visible = false -- v25: "Level N" only, like the reference
	pick.Value.Size = UDim2.new(1, -80, 0, 30)
	-- v26: only the Backpack title is cyan (Pickaxe / Coins titles are white on the reference)
	self.Cards.Backpack.Title.TextColor3 = Color3.fromRGB(150, 225, 255)
	-- v26: plate bodies like the reference: Strength = dark amber, XP = dark violet, the rest navy
	local function bodyGrad(k, c0, c1)
		local g = self.Cards[k].Body:FindFirstChildOfClass("UIGradient")
		if g then g.Color = ColorSequence.new(c0, c1) end
	end
	bodyGrad("Strength", Color3.fromRGB(100, 62, 32), Color3.fromRGB(58, 34, 16))
	bodyGrad("XP", Color3.fromRGB(54, 46, 126), Color3.fromRGB(26, 22, 72))
	-- v26: no progress bars on the plates (the reference shows only numbers)
	for _, card in pairs(self.Cards) do
		local bb = card.Body:FindFirstChild("BarBg")
		if bb and bb:IsA("GuiObject") then bb.Visible = false end
	end
	-- round "+" buttons (Coins -&gt; shop, Strength -&gt; skills, Level -&gt; prestige; wired in ClientController / ProgressionUI)
	self.Plus = {
		Coins = addPlus(coins, Color3.fromRGB(26, 38, 80), Color3.fromRGB(8, 14, 36)),
		Strength = addPlus(self.Cards.Strength, Color3.fromRGB(255, 200, 70), Color3.fromRGB(240, 120, 18)),
		Level = addPlus(self.Cards.Level, Color3.fromRGB(94, 200, 255), Color3.fromRGB(31, 111, 224)),
	}
	do -- v26: the coins "+" is dark with a thin dark rim (like the reference)
		local cs = self.Plus.Coins:FindFirstChildOfClass("UIStroke")
		if cs then
			cs.Color = Color3.fromRGB(8, 12, 30)
			cs.Thickness = 2
		end
	end
	for _, k in ipairs({ "Strength", "Level" }) do
		local sub = self.Cards[k].Sub
		if sub then
			sub.Size = UDim2.new(0.5, -58, 0, 16)
			sub.Position = UDim2.new(0.5, 0, 0, 10)
		end
		local vl = self.Cards[k].Value
		vl.Size = UDim2.new(1, -128, 0, 30)
	end
	do -- v26: XP "/ 100" sits on the value row at the right (like "/100" on the reference)
		local xs = self.Cards.XP.Sub
		if xs then
			xs.Size = UDim2.new(0.5, -12, 0, 22)
			xs.Position = UDim2.new(0.5, 0, 0, 32)
		end
	end

	-- Отслеживаемое число монет для счётчика
	self._coinValue = Instance.new("NumberValue")
	self._coinValue.Changed:Connect(function(v)
		coins.Value.Text = HudModule.FormatNumber(v)
	end)

	if cb.OnBackpackClick then
		self.Cards.Backpack.Button.MouseButton1Click:Connect(cb.OnBackpackClick)
	end

	self:_playEntrance()
	return self
end

function HudModule:_playEntrance()
	local function run(card: Card, fromOffset: UDim2, delay: number)
		local list = captureFade(card.Wrap)
		hideForFade(list)
		card.Wrap.Position = card.HomePos + fromOffset
		task.delay(delay, function()
			tween(card.Wrap, 0.55, { Position = card.HomePos }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			playFade(list, 0.45)
		end)
	end
	run(self.Cards.Backpack, UDim2.fromOffset(0, -110), 0.15)
	run(self.Cards.Pickaxe, UDim2.fromOffset(0, -110), 0.25)
	run(self.Cards.Coins, UDim2.fromOffset(0, -110), 0.35)
	run(self.Cards.Strength, UDim2.fromOffset(-260, 0), 0.30)
	run(self.Cards.Level, UDim2.fromOffset(-260, 0), 0.40)
	run(self.Cards.XP, UDim2.fromOffset(-260, 0), 0.50)
end

-- Всплывающий "+N" над монетами
function HudModule:_floatText(card: Card, text: string, color: Color3)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 0, 20)
	l.AnchorPoint = Vector2.new(0.5, 0)
	l.Position = UDim2.new(0.5, 0, 1, 4)
	l.Font = Enum.Font.GothamBlack
	l.TextSize = 18
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.4
	l.Text = text
	l.ZIndex = 9
	l.Parent = card.Body
	tween(l, 0.9, { Position = UDim2.new(0.5, 0, 1, 26), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(0.95, function() l:Destroy() end)
end

local function starsText(filled: number): string
	local s = '&lt;font color="#FFD54A"&gt;' .. string.rep("★", filled) .. "&lt;/font&gt;"
	if filled &lt; MAX_PICKAXE_STARS then
		s ..= '&lt;font color="#4A4C5E"&gt;' .. string.rep("★", MAX_PICKAXE_STARS - filled) .. "&lt;/font&gt;"
	end
	return s
end

-- ============================================================================
-- ОБНОВЛЕНИЕ
-- ============================================================================
function HudModule:Update(state)
	local prev = self._prev
	local first = self._first
	local C = self.Cards

	-- 🎒 Рюкзак
	local used, max = state.BagUsed or 0, math.max(1, state.BagMax or 1)
	local bRatio = math.clamp(used / max, 0, 1)
	C.Backpack.Value.Text = string.format("%d/%d", used, max)
	setBar(C.Backpack, bRatio)
	local full = used &gt;= max
	C.Backpack.Value.TextColor3 = full and BAR_RED or Color3.new(1, 1, 1)
	C.Backpack.Title.Text = full and "FULL!" or "Backpack"
	C.Backpack.Title.TextColor3 = full and BAR_RED or Color3.fromRGB(150, 225, 255)
	if not first and used ~= prev.BagUsed then bounce(C.Backpack) end
	if full and not self._bagPulse then
		self._bagPulse = TweenService:Create(C.Backpack.Stroke, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Color = BAR_RED })
		self._bagPulse:Play()
	elseif not full and self._bagPulse then
		self._bagPulse:Cancel()
		self._bagPulse = nil
		C.Backpack.Stroke.Color = ACCENT.Backpack
	end

	-- ⛏️ Кирка
	local tier = state.PickaxeTier or 1
	local pickLevel = math.clamp(tier, 1, 10)
	C.Pickaxe.Value.Text = "Level " .. pickLevel
	self.Stars.Text = starsText(math.clamp(pickLevel, 0, MAX_PICKAXE_STARS))
	if not first and tier ~= prev.PickaxeTier then
		bounce(C.Pickaxe)
		flash(C.Pickaxe)
		self.StarsScale.Scale = 1.35
		tween(self.StarsScale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end

	-- 💰 Монеты (плавный счётчик)
	local coins = state.Coins or 0
	if first then
		self._coinValue.Value = coins
		C.Coins.Value.Text = HudModule.FormatNumber(coins)
	elseif coins ~= prev.Coins then
		tween(self._coinValue, 0.6, { Value = coins })
		bounce(C.Coins)
		local diff = coins - (prev.Coins or 0)
		if diff &gt; 0 then
			flash(C.Coins, 0.35)
			self:_floatText(C.Coins, "+" .. HudModule.FormatNumber(diff), Color3.fromRGB(255, 225, 90))
		else
			self:_floatText(C.Coins, "-" .. HudModule.FormatNumber(-diff), Color3.fromRGB(255, 110, 110))
		end
	end

	-- 💪 Сила
	local str = state.Strength or 1
	C.Strength.Value.Text = HudModule.FormatNumber(str)
	C.Strength.Sub.Text = string.format("%d/%d", state.StrengthXP or 0, state.RequiredStrengthXP or 1)
	setBar(C.Strength, (state.StrengthXP or 0) / math.max(1, state.RequiredStrengthXP or 1))
	if not first and str &gt; (prev.Strength or str) then
		bounce(C.Strength)
		flash(C.Strength)
		SoundManager.PlayUISound("StatUp")
	end

	-- ⭐ Уровень (полоса — путь до престижа)
	local lvl = state.Level or 1
	local need = ProgressionConfig.PRESTIGE_REQUIRED_LEVEL or 50
	C.Level.Value.Text = tostring(lvl)
	local prestige = state.Prestige or 0
	C.Level.Sub.Text = (prestige &gt; 0 and ("P" .. prestige .. " · ") or "") .. string.format("to %d", need)
	setBar(C.Level, lvl / need)
	if not first and lvl &gt; (prev.Level or lvl) then
		bounce(C.Level)
		flash(C.Level, 0.6) -- звук: фанфара уровня из ProgressionUI
	end

	-- ✨ Опыт
	local xp, req = state.XP or 0, math.max(1, state.RequiredXP or 1)
	C.XP.Value.Text = HudModule.FormatNumber(xp)
	C.XP.Sub.Text = "/ " .. HudModule.FormatNumber(req)
	setBar(C.XP, xp / req)
	if not first and xp &gt; (prev.XP or xp) then
		bounce(C.XP)
		flash(C.XP, 0.2)
	end

	prev.BagUsed, prev.PickaxeTier, prev.Coins = used, tier, coins
	prev.Strength, prev.Level, prev.XP = str, lvl, xp
	self._first = false
end

return HudModule
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">SoundManager</string>
          <ProtectedString name="Source">--!strict
-- ============================================================================
-- 🔊 МОДУЛЬ: SoundManager (ReplicatedStorage.Modules.SoundManager) — v10
-- • Настоящие звуки добычи руды (удар кирки + каменная крошка / металлический звон)
-- • Пул вариантов + случайная высота тона → каждый удар звучит немного иначе
-- • Звук играет ЛОКАЛЬНО у каждого клиента (через RemoteEvent "SfxEvent"):
--   - игрок, который бьёт, слышит удар мгновенно (без задержки сети) и без «двойного» звука
--   - остальные игроки рядом (до 90 studs) тоже слышат удары
-- • Больше НЕ создаёт 2 Sound в каждом блоке шахты (раньше это тысячи лишних объектов)
-- API совместим с v8/v9: EnsureSoundsFolder, AttachQuietBlockSounds, PlayQuietTap,
-- PlayQuietCrumble, PlayUISound.
-- ============================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local SoundManager = {}

local IS_SERVER = RunService:IsServer()
local HEAR_DISTANCE = 90
local rng = Random.new()
local preloaded = false
local clientHooked = false
local sfxRemote: RemoteEvent? = nil

type Layer = { Ids: { string }, Volume: number?, PitchMin: number?, PitchMax: number?, Delay: number?, MaxDuration: number? }

local function pick(ids: { string }?): string?
	if not ids or #ids == 0 then return nil end
	return ids[rng:NextInteger(1, #ids)]
end

local function getRemote(): RemoteEvent?
	if sfxRemote then return sfxRemote end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if IS_SERVER then
		if not folder then
			local f = Instance.new("Folder")
			f.Name = "Remotes"
			f.Parent = ReplicatedStorage
			folder = f
		end
		local re = (folder :: Instance):FindFirstChild("SfxEvent")
		if not re then
			local n = Instance.new("RemoteEvent")
			n.Name = "SfxEvent"
			n.Parent = folder
			re = n
		end
		sfxRemote = re :: RemoteEvent
	elseif folder then
		local re = folder:FindFirstChild("SfxEvent")
		if re and re:IsA("RemoteEvent") then sfxRemote = re end
	end
	return sfxRemote
end

-- Плавно глушит звук через maxDuration секунд (чтобы удар не «тянулся»)
local function limit(s: Sound, maxDuration: number?)
	if not maxDuration then return end
	task.delay(maxDuration, function()
		if s.Parent and s.IsPlaying then
			TweenService:Create(s, TweenInfo.new(0.12), { Volume = 0 }):Play()
		end
	end)
end

-- Проигрывает один слой звука (3D, если задана позиция; иначе 2D)
local function playLayer(layer: Layer, position: Vector3?, volumeMul: number)
	local id = pick(layer.Ids)
	if not id then return end
	local function go()
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = (layer.Volume or 0.4) * volumeMul
		s.PlaybackSpeed = rng:NextNumber(layer.PitchMin or 1, layer.PitchMax or 1)
		if position then
			local att = Instance.new("Attachment")
			att.WorldPosition = position
			att.Parent = Workspace.Terrain
			s.RollOffMode = Enum.RollOffMode.InverseTapered
			s.RollOffMinDistance = 10
			s.RollOffMaxDistance = HEAR_DISTANCE
			s.Parent = att
			Debris:AddItem(att, 3)
		else
			s.Parent = SoundService
			Debris:AddItem(s, 6)
		end
		s:Play()
		limit(s, layer.MaxDuration)
	end
	if layer.Delay and layer.Delay &gt; 0 then
		task.delay(layer.Delay, go)
	else
		go()
	end
end

-- Проигрывает звук по ключу из GameConfig.SOUNDS локально (вызывается на клиенте)
local function playLocal(soundKey: string, position: Vector3?)
	local cfg: any = GameConfig.SOUNDS[soundKey]
	if not cfg then return end
	pcall(function()
		playLayer(cfg :: Layer, position, 1)
		if cfg.Layers then
			for _, layer in ipairs(cfg.Layers) do
				playLayer(layer :: Layer, position, 1)
			end
		end
	end)
end

-- На сервере: отправить звук игрокам рядом (кроме exclude); position = nil → 2D звук только target
local function broadcast(soundKey: string, position: Vector3?, exclude: Player?, onlyTarget: Player?)
	local re = getRemote()
	if not re then return end
	if onlyTarget then
		re:FireClient(onlyTarget, soundKey, position)
		return
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= exclude then
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if position == nil or (root and root:IsA("BasePart") and (root.Position - position).Magnitude &lt;= HEAR_DISTANCE) then
				re:FireClient(plr, soundKey, position)
			end
		end
	end
end

local function hookClient()
	if IS_SERVER or clientHooked then return end
	clientHooked = true
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
		local re = folder and folder:WaitForChild("SfxEvent", 30)
		if re and re:IsA("RemoteEvent") then
			sfxRemote = re
			re.OnClientEvent:Connect(function(soundKey: any, position: any)
				if type(soundKey) == "string" then
					playLocal(soundKey, typeof(position) == "Vector3" and position or nil)
				end
			end)
		end
	end)
end

function SoundManager.ResetCleanAudioEnvironment()
	pcall(function()
		SoundService.AmbientReverb = Enum.ReverbType.NoReverb
	end)
end

-- Создаёт папку ReplicatedStorage.Sounds (для предзагрузки) и подключает клиент к SfxEvent
function SoundManager.EnsureSoundsFolder(): Folder
	SoundManager.ResetCleanAudioEnvironment()
	if IS_SERVER then
		getRemote()
	else
		hookClient()
	end

	local existing = ReplicatedStorage:FindFirstChild("Sounds")
	local folder: Folder
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		folder = Instance.new("Folder")
		folder.Name = "Sounds"
		folder.Parent = ReplicatedStorage
	end

	local toPreload: { Instance } = {}
	if IS_SERVER then
		for soundKey, cfgAny in pairs(GameConfig.SOUNDS) do
			local cfg: any = cfgAny
			local ids: { string } = {}
			for _, id in ipairs(cfg.Ids or {}) do table.insert(ids, id) end
			for _, layer in ipairs(cfg.Layers or {}) do
				for _, id in ipairs(layer.Ids or {}) do table.insert(ids, id) end
			end
			for i, id in ipairs(ids) do
				local name = soundKey .. (i == 1 and "" or "_" .. i)
				local found = folder:FindFirstChild(name)
				local snd: Sound
				if found and found:IsA("Sound") then
					snd = found
				else
					snd = Instance.new("Sound")
					snd.Name = name
					snd.Parent = folder
				end
				snd.SoundId = id
				snd.Volume = 0
			end
		end
	else
		for _, s in ipairs(folder:GetChildren()) do
			table.insert(toPreload, s)
		end
		if not preloaded then
			preloaded = true
			task.spawn(function()
				pcall(function()
					ContentProvider:PreloadAsync(toPreload)
				end)
			end)
		end
	end
	return folder
end

-- Оставлено для совместимости: звуки больше не вкладываются в каждый блок
function SoundManager.AttachQuietBlockSounds(_block: BasePart, _hitSoundKey: string) end

-- Удар кирки по блоку.
-- Клиент: играет сразу у себя. Сервер: рассылает остальным игрокам рядом (кроме ударившего).
function SoundManager.PlayQuietTap(soundKey: string, blockPosition: Vector3, _hostBlock: BasePart?, excludePlayer: Player?)
	if not GameConfig.SOUNDS[soundKey] then soundKey = "StoneTap" end
	if IS_SERVER then
		broadcast(soundKey, blockPosition, excludePlayer, nil)
	else
		playLocal(soundKey, blockPosition)
	end
end

-- Разрушение блока (сервер рассылает всем рядом, включая ударившего)
function SoundManager.PlayQuietCrumble(blockPosition: Vector3)
	if IS_SERVER then
		broadcast("StoneCrumble", blockPosition, nil, nil)
	else
		playLocal("StoneCrumble", blockPosition)
	end
end

-- 2D-звук интерфейса. На сервере нужно указать игрока: PlayUISound("CoinChime", player)
function SoundManager.PlayUISound(soundKey: string, targetPlayer: Player?)
	if IS_SERVER then
		if targetPlayer then
			broadcast(soundKey, nil, nil, targetPlayer)
		end
	else
		playLocal(soundKey, nil)
	end
end

-- Звук в точке мира для всех рядом (продажа, покупка)
function SoundManager.PlayAt(soundKey: string, position: Vector3)
	if IS_SERVER then
		broadcast(soundKey, position, nil, nil)
	else
		playLocal(soundKey, position)
	end
end

return SoundManager
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">VFXModule</string>
          <ProtectedString name="Source">--!strict
-- ============================================================================
-- ✨ МОДУЛЬ: VFXModule (ReplicatedStorage.Modules.VFXModule)
-- Описание: Визуальные эффекты современного Симулятора Шахтёра 2026 (v8.0):
-- • Плавная анимация взмаха кирки (0.3 сек через TweenService), синхронизированная со стуком
-- • Лёгкое дрожание блока, частицы осколков, трещины по мере снижения HP
-- • Эффект продажи монет на белой платформе и вспышка света при покупке кирки в 3D-магазине
-- ============================================================================

local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local VFXModule = {}

local ALL_FACES = {
	Enum.NormalId.Top,
	Enum.NormalId.Bottom,
	Enum.NormalId.Front,
	Enum.NormalId.Back,
	Enum.NormalId.Left,
	Enum.NormalId.Right,
}

-- 1. Взмах кирки (v11): вся анимация теперь в ToolAnimator и проигрывается на КЛИЕНТЕ
-- (раньше сервер и клиент двигали руку одновременно — отсюда рывки).
-- Функция оставлена для совместимости со старыми вызовами.
function VFXModule.PlayCharacterSwingAnimation(character: Model?)
	if not character then return end
	if RunService:IsClient() then
		local ok, animator = pcall(function()
			return require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("ToolAnimator")) :: any
		end)
		if ok and animator then
			animator.PlaySwing(character, false)
		end
	end
end

-- 2. Трещины на блоке
function VFXModule.UpdateBlockCracks(block: BasePart, hp: number, maxHp: number)
	if not block or not block.Parent then return end

	pcall(function()
		local ratio = math.clamp(hp / math.max(1, maxHp), 0, 1)
		local damageRatio = 1 - ratio

		local fxFolder = block:FindFirstChild("DamageFX") :: Folder?
		if not fxFolder then
			local f = Instance.new("Folder")
			f.Name = "DamageFX"
			f.Parent = block
			fxFolder = f

			for _, face in ipairs(ALL_FACES) do
				local decal = Instance.new("Decal")
				decal.Name = "CrackDecal_" .. face.Name
				decal.Face = face
				decal.Texture = GameConfig.TEXTURES.CrackDecal
				decal.Color3 = Color3.fromRGB(20, 24, 32)
				decal.Transparency = 0.65
				decal.Parent = f
			end
		end

		for _, child in ipairs((fxFolder :: Folder):GetChildren()) do
			if child:IsA("Decal") then
				child.Transparency = math.clamp(0.75 - damageRatio * 0.68, 0.06, 0.75)
			end
		end
	end)
end

-- 3. Удар по блоку: дрожание + осколки.
-- v51: the WHOLE block shakes together with its decorations (grass cap, fringe, tufts, flowers,
-- clods, crystals). Soft blocks (grass, dirt, sand) wobble much more than rock, and blades of
-- grass and flowers swing wider than the block. Everything plays on the CLIENTS: the server only
-- asks the other players' clients to play it. Before, the server moved the bare block itself
-- (replicated, choppy, decorations stayed still) and the hitting player saw the chips twice.
local IS_SERVER = RunService:IsServer()
local SOFT_BLOCKS: { [string]: boolean } = { Grass = true, Dirt = true, Clay = true }
local SWAY_PARTS: { [string]: boolean } = { GrassTuft = true, FlowerStem = true, FlowerHead = true, FlowerHeart = true }
local FX_DISTANCE = 110

type ShakeRec = { P: BasePart, CF: CFrame, Sway: boolean }
type ShakeState = { Token: number, Parts: { ShakeRec }, Pivot: CFrame }
local ShakeStates: { [Instance]: ShakeState } = setmetatable({}, { __mode = "k" }) :: any
local blockFxRemote: RemoteEvent? = nil

local function getBlockFxRemote(): RemoteEvent?
	if blockFxRemote then return blockFxRemote end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local re = folder and folder:FindFirstChild("BlockFX")
	if re and re:IsA("RemoteEvent") then
		blockFxRemote = re
	end
	return blockFxRemote
end

local function shakeBlockLocal(block: BasePart)
	local found = ShakeStates[block]
	if not found then
		-- rest poses are captured once, before the first shake ever moves anything
		local parts: { ShakeRec } = { { P = block, CF = block.CFrame, Sway = false } }
		for _, d in ipairs(block:GetDescendants()) do
			if d:IsA("BasePart") then
				table.insert(parts, { P = d, CF = d.CFrame, Sway = SWAY_PARTS[d.Name] == true })
			end
		end
		found = { Token = 0, Parts = parts, Pivot = CFrame.new(block.Position) }
		ShakeStates[block] = found
	end
	local state = found :: ShakeState
	state.Token += 1
	local my = state.Token

	local soft = SOFT_BLOCKS[tostring(block:GetAttribute("BlockId"))] == true
	-- v52: дрожание спокойнее — амплитуда и наклон умножаются на GameConfig.BLOCK_HIT_SHAKE
	local shakeCfg = GameConfig.BLOCK_HIT_SHAKE
	local amp = (soft and 0.2 or 0.09) * shakeCfg.Scale
	local tilt = (soft and 0.035 or 0.012) * shakeCfg.Scale
	local steps = soft and 8 or 5
	local pivot = state.Pivot
	local pivotInv = pivot:Inverse()

	task.spawn(function()
		for i = 1, steps do
			if my ~= state.Token or not block.Parent then return end
			local k = 1 - (i - 1) / steps
			local side = (i % 2 == 0) and 1 or -1
			-- sideways wobble plus a little squash downwards (never upwards: players stand on blocks)
			local offset = CFrame.new(side * amp * k * (0.6 + math.random() * 0.4), -amp * 0.35 * k, (math.random() - 0.5) * amp * k)
				* CFrame.Angles((math.random() - 0.5) * tilt * k, 0, side * tilt * k)
			local move = pivot * offset * pivotInv
			for _, rec in ipairs(state.Parts) do
				if rec.P.Parent then
					local cf = move * rec.CF
					if rec.Sway then
						cf = cf * CFrame.Angles(0, 0, side * 0.22 * shakeCfg.SwayScale * k)
					end
					rec.P.CFrame = cf
				end
			end
			task.wait(0.03)
		end
		if my == state.Token then
			for _, rec in ipairs(state.Parts) do
				if rec.P.Parent then
					rec.P.CFrame = rec.CF
				end
			end
		end
	end)
end

local function chipsLocal(block: BasePart, accentColor: Color3)
	local soft = SOFT_BLOCKS[tostring(block:GetAttribute("BlockId"))] == true
	local origin = (block:GetAttribute("OriginPos") :: Vector3?) or block.Position

	local emitterPart = Instance.new("Part")
	emitterPart.Size = Vector3.new(0.2, 0.2, 0.2)
	emitterPart.Position = origin + Vector3.new(0, 1.8, 0)
	emitterPart.Transparency = 1
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.CanQuery = false
	emitterPart.Parent = Workspace

	local chips = Instance.new("ParticleEmitter", emitterPart)
	chips.Color = ColorSequence.new(block.Color, accentColor)
	chips.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, soft and 0.42 or 0.32),
		NumberSequenceKeypoint.new(1, 0.04),
	})
	chips.Lifetime = NumberRange.new(0.22, soft and 0.6 or 0.45)
	chips.Speed = NumberRange.new(6, 13)
	chips.SpreadAngle = Vector2.new(180, 180)
	chips.Acceleration = Vector3.new(0, -28, 0)
	chips.Enabled = false
	chips:Emit(soft and 14 or 8) -- soft ground throws more crumbs

	Debris:AddItem(emitterPart, 0.8)
end

-- hitter: on the server, the player whose own client has already played the effect
function VFXModule.PlayHitShakeAndParticles(block: BasePart, accentColor: Color3, hitter: Player?)
	if not block or not block.Parent then return end

	if IS_SERVER then
		local re = getBlockFxRemote()
		if not re then return end
		local pos = block.Position
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= hitter then
				local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") and (root.Position - pos).Magnitude &lt;= FX_DISTANCE then
					re:FireClient(plr, block, accentColor)
				end
			end
		end
		return
	end

	pcall(function()
		shakeBlockLocal(block)
		chipsLocal(block, accentColor)
	end)
end

if not IS_SERVER then
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", 60)
		local re = folder and folder:WaitForChild("BlockFX", 60)
		if re and re:IsA("RemoteEvent") then
			re.OnClientEvent:Connect(function(block: any, accentColor: any)
				if typeof(block) == "Instance" and block:IsA("BasePart") and typeof(accentColor) == "Color3" then
					VFXModule.PlayHitShakeAndParticles(block, accentColor)
				end
			end)
		end
	end)
end

-- 4. Частицы осколков при разрушении блока
function VFXModule.PlayDestroyVFX(position: Vector3, mainColor: Color3, accentColor: Color3, mat: Enum.Material)
	pcall(function()
		local p = Instance.new("Part")
		p.Size = Vector3.new(0.3, 0.3, 0.3)
		p.Position = position
		p.Transparency = 1
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Parent = Workspace

		local pe = Instance.new("ParticleEmitter", p)
		pe.Color = ColorSequence.new(mainColor, accentColor)
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(1, 0),
		})
		pe.Lifetime = NumberRange.new(0.35, 0.65)
		pe.Speed = NumberRange.new(7, 15)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Acceleration = Vector3.new(0, -25, 0)
		pe.Enabled = false
		pe:Emit(18)

		Debris:AddItem(p, 0.8)

		for i = 1, 5 do
			local shard = Instance.new("Part")
			shard.Size = Vector3.new(0.65, 0.65, 0.65)
			shard.Color = (i &lt;= 2) and accentColor or mainColor
			shard.Material = mat
			shard.Position = position + Vector3.new((math.random() - 0.5) * 1.8, (math.random() - 0.5) * 1.8, (math.random() - 0.5) * 1.8)
			shard.Anchored = false
			shard.CanCollide = true
			shard.CanQuery = false
			shard.Parent = Workspace

			local sm = Instance.new("SpecialMesh", shard)
			sm.MeshType = Enum.MeshType.Sphere
			sm.Scale = Vector3.new(1, 0.85, 1)

			shard.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 16, math.random(7, 14), (math.random() - 0.5) * 16)
			TweenService:Create(shard, TweenInfo.new(0.4), { Transparency = 1 }):Play()
			Debris:AddItem(shard, 0.45)
		end
	end)
end

-- 5. Эффект частиц монет при авто-продаже и вспышки света при покупке (Приоритет №5, п. 5)
function VFXModule.PlayPurchaseOrSellBurst(position: Vector3, burstColor: Color3)
	pcall(function()
		local flash = Instance.new("Part")
		flash.Shape = Enum.PartType.Ball
		flash.Material = Enum.Material.Neon
		flash.Color = burstColor
		flash.Size = Vector3.new(1.5, 1.5, 1.5)
		flash.Position = position
		flash.Transparency = 0.25
		flash.Anchored = true
		flash.CanCollide = false
		flash.CanQuery = false
		flash.Parent = Workspace

		local pe = Instance.new("ParticleEmitter", flash)
		pe.Color = ColorSequence.new(burstColor, Color3.new(1, 1, 1))
		pe.LightEmission = 0.9
		pe.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 0),
		})
		pe.Lifetime = NumberRange.new(0.35, 0.7)
		pe.Speed = NumberRange.new(8, 16)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Enabled = false
		pe:Emit(20)

		TweenService:Create(flash, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(6.5, 6.5, 6.5),
			Transparency = 1,
		}):Play()

		Debris:AddItem(flash, 0.75)
	end)
end

function VFXModule.SpawnFloatingText(position: Vector3, text: string, color: Color3)
	pcall(function()
		local anchor = Instance.new("Part")
		anchor.Size = Vector3.new(0.3, 0.3, 0.3)
		anchor.Position = position + Vector3.new((math.random() - 0.5) * 1.2, 2.5, (math.random() - 0.5) * 1.2)
		anchor.Transparency = 1
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.Parent = Workspace

		local bg = Instance.new("BillboardGui", anchor)
		bg.Size = UDim2.new(0, 230, 0, 48)
		bg.AlwaysOnTop = true

		local lbl = Instance.new("TextLabel", bg)
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBold
		lbl.TextColor3 = color
		lbl.TextStrokeTransparency = 0.15
		lbl.TextScaled = true
		lbl.Text = text

		TweenService:Create(anchor, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = anchor.Position + Vector3.new(0, 3.2, 0),
		}):Play()
		TweenService:Create(lbl, TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()

		Debris:AddItem(anchor, 0.9)
	end)
end

return VFXModule
</ProtectedString>
        </Properties>
      </Item>
    <Item class="ModuleScript"><Properties><string name="Name">ProgressionConfig</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🌟 МОДУЛЬ: ProgressionConfig (ReplicatedStorage.Modules.ProgressionConfig)
-- Версия: v13.0 — Выполнены Пункты №4, №6 и №8:
-- • УБРАНА «Вместимость рюкзака» из навыков (вместимость зависит ТОЛЬКО от купленного
--   рюкзака 1–10 уровня в Магазине).
-- • ДОБАВЛЕН навык «ЭНЕРГИЯ» (⚡): увеличивает макс. запас энергии (+12 ед./ур.)
--   и скорость восстановления энергии (+0.35 ед./сек за уровень).
-- • ТРЕНИРОВКА СИЛЫ («СИЛА» 💪) находится ТОЛЬКО в Навыках (убрана из Магазина).
-- ============================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local ProgressionConfig = {}

ProgressionConfig.START_LEVEL = 1
ProgressionConfig.XP_PER_LEVEL = 100
ProgressionConfig.SKILL_POINTS_PER_LEVEL = 1
ProgressionConfig.LEVEL_UP_COINS_PER_LEVEL = 10
ProgressionConfig.LEVEL_UP_HEAL = true

ProgressionConfig.SOUNDS = {
	LevelUp     = { Id = "rbxassetid://1845399641", Volume = 0.45 }, -- старый звук (больше не играет)
	-- v47: мягкое арпеджио из «колокольчика» вместо резкого звука
	LevelUpChime = { Id = "rbxassetid://9113728756", Volume = 0.22 },
	-- Свой звук: загрузи LevelUp_Chime.ogg и вставь ID, например "rbxassetid://123"
	LevelUpCustom = { Id = "rbxassetid://135458320667545", Volume = 0.5 }, -- v48: звук игрока
	Click       = { Id = "rbxassetid://12221976",   Volume = 0.10 },
	Achievement = { Id = "rbxassetid://1839901345", Volume = 0.07 }, -- тихий мягкий сигнал (было 0.40)
	Prestige    = { Id = "rbxassetid://1845411858", Volume = 0.50 },
}

function ProgressionConfig.GetRequiredXP(level: number): number
	return math.max(1, math.floor(level)) * ProgressionConfig.XP_PER_LEVEL
end

-- ============================================================================
-- 2. НАВЫКИ ПЕРСОНАЖА (БЕЗ ВМЕСТИМОСТИ РЮКЗАКА! ЭНЕРГИЯ + ТРЕНИРОВКА СИЛЫ)
-- ============================================================================
ProgressionConfig.SKILL_MAX_LEVEL = 50
ProgressionConfig.CRIT_MULTIPLIER = 3
ProgressionConfig.BASE_ATTACK_COOLDOWN = 0.44
ProgressionConfig.MIN_ATTACK_COOLDOWN = 0.20

export type SkillInfo = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	PerLevel: number,
	Suffix: string,
	Color: Color3,
	ColorDark: Color3,
}

-- Порядок навыков в окне «⚡ Навыки»: Энергия и Тренировка Силы на первом плане!
ProgressionConfig.SKILL_ORDER = { "Energy", "Power", "Speed", "Luck", "Critical" }

ProgressionConfig.SKILLS = {
	Energy = {
		Id = "Energy", Name = "ENERGY", Icon = "⚡",
		Description = "Max energy (+12) and regen (+0.35/s per level)",
		PerLevel = 12, Suffix = " energy",
		Color = Color3.fromRGB(55, 225, 145), ColorDark = Color3.fromRGB(18, 115, 68),
	},
	Power = {
		Id = "Power", Name = "STRENGTH", Icon = "💪",
		Description = "Pickaxe damage to blocks",
		PerLevel = 5, Suffix = "% damage",
		Color = Color3.fromRGB(255, 125, 55), ColorDark = Color3.fromRGB(150, 42, 18),
	},
	Speed = {
		Id = "Speed", Name = "MINING SPEED", Icon = "⛏️",
		Description = "Pickaxe swing rate",
		PerLevel = 2, Suffix = "% faster",
		Color = Color3.fromRGB(255, 215, 60), ColorDark = Color3.fromRGB(165, 105, 12),
	},
	Luck = {
		Id = "Luck", Name = "GEOLOGIST (LUCK)", Icon = "🍀",
		Description = "Chance to find an extra nugget",
		PerLevel = 1.5, Suffix = "% chance",
		Color = Color3.fromRGB(70, 200, 255), ColorDark = Color3.fromRGB(20, 80, 170),
	},
	Critical = {
		Id = "Critical", Name = "PRECISE HIT (CRIT)", Icon = "🔥",
		Description = "Critical hit chance (×3 damage)",
		PerLevel = 1, Suffix = "% crit",
		Color = Color3.fromRGB(200, 90, 255), ColorDark = Color3.fromRGB(90, 25, 160),
	},
} :: { [string]: SkillInfo }

-- ============================================================================
-- 3. ПРЕСТИЖ И ДОСТИЖЕНИЯ
-- ============================================================================
ProgressionConfig.PRESTIGE_REQUIRED_LEVEL = 50
ProgressionConfig.PRESTIGE_MAX = 10
ProgressionConfig.PRESTIGE_BONUS = 0.10
ProgressionConfig.PRESTIGE_RESETS_SKILLS = false

export type AuraInfo = {
	MinPrestige: number,
	Name: string,
	Colors: { Color3 },
	Rainbow: boolean,
}

ProgressionConfig.PRESTIGE_AURAS = {
	{ MinPrestige = 1, Name = "Golden",  Rainbow = false, Colors = { Color3.fromRGB(255, 230, 90), Color3.fromRGB(255, 170, 30) } },
	{ MinPrestige = 4, Name = "Diamond", Rainbow = false, Colors = { Color3.fromRGB(170, 250, 255), Color3.fromRGB(60, 190, 255) } },
	{ MinPrestige = 7, Name = "Rainbow", Rainbow = true, Colors = {
		Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 200, 50), Color3.fromRGB(80, 255, 110),
		Color3.fromRGB(60, 190, 255), Color3.fromRGB(190, 90, 255),
	} },
} :: { AuraInfo }

function ProgressionConfig.GetAura(prestige: number): AuraInfo?
	local found: AuraInfo? = nil
	for _, aura in ipairs(ProgressionConfig.PRESTIGE_AURAS) do
		if prestige &gt;= aura.MinPrestige then
			found = aura
		end
	end
	return found
end

export type AchievementInfo = {
	Id: string,
	Name: string,
	Icon: string,
	Description: string,
	Stat: string,
	Goal: number,
	RewardCoins: number,
	RewardSkillPoints: number,
}

-- v51: the coin rewards of the early goals are small on purpose (ore near the surface sells
-- for 1–2 coins); the five original achievements keep their original rewards. Depth goals down
-- to 25 m pay almost nothing: plain stone goes that deep, so a starter pickaxe gets there fast.
-- v50: a long ladder of small goals. The ORDER matters: the HUD "Next goal" tracker
-- always shows the first one that is not finished yet, so keep it easy -&gt; hard.
-- Stats: TotalMined, PeakCoins, OresFound, MaxDepth, BestCombo, LuckyOpened,
-- TntExploded, TreasuresFound, DailyStreak (see ProgressionManager.GetStatValue).
ProgressionConfig.ACHIEVEMENTS = {
	{ Id = "FirstSteps", Name = "First Steps",      Icon = "👣", Description = "Break 15 blocks",              Stat = "TotalMined",     Goal = 15,     RewardCoins = 40,    RewardSkillPoints = 1 },
	{ Id = "Depth3",     Name = "Digging Down",     Icon = "⬇️", Description = "Dig down to 3 m",              Stat = "MaxDepth",       Goal = 3,      RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Combo5",     Name = "Combo Starter",    Icon = "🔥", Description = "Get a 5-block combo",          Stat = "BestCombo",      Goal = 5,      RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Found4",     Name = "Rock Spotter",     Icon = "🔍", Description = "Find 4 kinds of blocks",       Stat = "OresFound",      Goal = 4,      RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Mined50",    Name = "Busy Miner",       Icon = "⛏️", Description = "Break 50 blocks",              Stat = "TotalMined",     Goal = 50,     RewardCoins = 10,    RewardSkillPoints = 0 },
	{ Id = "Lucky1",     Name = "Lucky Find",       Icon = "🍀", Description = "Open a Lucky Block",           Stat = "LuckyOpened",    Goal = 1,      RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Depth6",     Name = "Cave Explorer",    Icon = "🔦", Description = "Dig down to 6 m",              Stat = "MaxDepth",       Goal = 6,      RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Miner",      Name = "Miner",            Icon = "⛏️", Description = "Break 150 blocks",             Stat = "TotalMined",     Goal = 150,    RewardCoins = 250,   RewardSkillPoints = 1 },
	{ Id = "Tnt1",       Name = "Kaboom!",          Icon = "💥", Description = "Blow up a TNT block",          Stat = "TntExploded",    Goal = 1,      RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Coins500",   Name = "Piggy Bank",       Icon = "🐷", Description = "Save up 500 coins",            Stat = "PeakCoins",      Goal = 500,    RewardCoins = 0,     RewardSkillPoints = 1 },
	{ Id = "Combo10",    Name = "Combo Pro",        Icon = "🔥", Description = "Get a 10-block combo",         Stat = "BestCombo",      Goal = 10,     RewardCoins = 10,    RewardSkillPoints = 0 },
	{ Id = "Treasure1",  Name = "Treasure Hunter",  Icon = "🧰", Description = "Find a Treasure Chest",        Stat = "TreasuresFound", Goal = 1,      RewardCoins = 10,    RewardSkillPoints = 0 },
	{ Id = "Depth10",    Name = "Deep Diver",       Icon = "🤿", Description = "Dig down to 10 m",             Stat = "MaxDepth",       Goal = 10,     RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Mined400",   Name = "Tunnel Maker",     Icon = "🚇", Description = "Break 400 blocks",             Stat = "TotalMined",     Goal = 400,    RewardCoins = 100,   RewardSkillPoints = 1 },
	{ Id = "Found8",     Name = "Rock Collector",   Icon = "🪨", Description = "Find 8 kinds of blocks",       Stat = "OresFound",      Goal = 8,      RewardCoins = 40,    RewardSkillPoints = 1 },
	{ Id = "Streak3",    Name = "Daily Visitor",    Icon = "📅", Description = "Play 3 days in a row",         Stat = "DailyStreak",    Goal = 3,      RewardCoins = 50,    RewardSkillPoints = 1 },
	{ Id = "Combo25",    Name = "Combo Master",     Icon = "🔥", Description = "Get a 25-block combo",         Stat = "BestCombo",      Goal = 25,     RewardCoins = 20,    RewardSkillPoints = 1 },
	{ Id = "Master",     Name = "Deep Master",      Icon = "🏅", Description = "Break 1000 blocks",            Stat = "TotalMined",     Goal = 1000,   RewardCoins = 2500,  RewardSkillPoints = 3 },
	{ Id = "Depth15",    Name = "Iron Depths",      Icon = "⚙️", Description = "Dig down to 15 m",             Stat = "MaxDepth",       Goal = 15,     RewardCoins = 5,     RewardSkillPoints = 0 },
	{ Id = "Rich",       Name = "Ore Trader",       Icon = "💰", Description = "Save up 10,000 coins",         Stat = "PeakCoins",      Goal = 10000,  RewardCoins = 0,     RewardSkillPoints = 3 },
	{ Id = "Lucky10",    Name = "Lucky Streak",     Icon = "🍀", Description = "Open 10 Lucky Blocks",         Stat = "LuckyOpened",    Goal = 10,     RewardCoins = 100,   RewardSkillPoints = 1 },
	{ Id = "Tnt10",      Name = "Demolition Expert", Icon = "💥", Description = "Blow up 10 TNT blocks",       Stat = "TntExploded",    Goal = 10,     RewardCoins = 100,   RewardSkillPoints = 1 },
	{ Id = "Depth20",    Name = "Magma Zone",       Icon = "🌋", Description = "Dig down to 20 m",             Stat = "MaxDepth",       Goal = 20,     RewardCoins = 10,    RewardSkillPoints = 0 },
	{ Id = "Found12",    Name = "Gem Finder",       Icon = "💠", Description = "Find 12 kinds of blocks",      Stat = "OresFound",      Goal = 12,     RewardCoins = 300,   RewardSkillPoints = 2 },
	{ Id = "Streak7",    Name = "Loyal Miner",      Icon = "📅", Description = "Play 7 days in a row",         Stat = "DailyStreak",    Goal = 7,      RewardCoins = 200,   RewardSkillPoints = 2 },
	{ Id = "Mined2500",  Name = "Mega Miner",       Icon = "🏆", Description = "Break 2,500 blocks",           Stat = "TotalMined",     Goal = 2500,   RewardCoins = 2000,  RewardSkillPoints = 2 },
	{ Id = "Depth25",    Name = "Silver Hunter",    Icon = "🥈", Description = "Dig down to 25 m",             Stat = "MaxDepth",       Goal = 25,     RewardCoins = 10,    RewardSkillPoints = 0 },
	{ Id = "Combo50",    Name = "Unstoppable",      Icon = "🔥", Description = "Get a 50-block combo",         Stat = "BestCombo",      Goal = 50,     RewardCoins = 50,    RewardSkillPoints = 2 },
	{ Id = "Coins100k",  Name = "Gold Tycoon",      Icon = "👑", Description = "Save up 100,000 coins",        Stat = "PeakCoins",      Goal = 100000, RewardCoins = 0,     RewardSkillPoints = 3 },
	{ Id = "Depth30",    Name = "Bottom of the World", Icon = "🌍", Description = "Reach the bottom: 30 m",    Stat = "MaxDepth",       Goal = 30,     RewardCoins = 3000,  RewardSkillPoints = 5 },
	{ Id = "Collector",  Name = "Geologist",        Icon = "💎", Description = "Find all 16 block kinds",      Stat = "OresFound",      Goal = -1,     RewardCoins = 5000,  RewardSkillPoints = 5 },
	{ Id = "Mined5000",  Name = "Legend of the Mine", Icon = "🌟", Description = "Break 5,000 blocks",         Stat = "TotalMined",     Goal = 5000,   RewardCoins = 6000,  RewardSkillPoints = 5 },
} :: { AchievementInfo }

function ProgressionConfig.GetAchievementGoal(ach: AchievementInfo): number
	if ach.Goal &lt; 0 then
		return #GameConfig.BLOCK_LIST
	end
	return ach.Goal
end

-- ============================================================================
-- 4. РАСЧЁТ БОНУСОВ НАВЫКОВ
-- ============================================================================
function ProgressionConfig.GetSkillLevel(skills: { [string]: number }?, skillId: string): number
	if not skills then return 0 end
	return math.clamp(math.floor(skills[skillId] or 0), 0, ProgressionConfig.SKILL_MAX_LEVEL)
end

function ProgressionConfig.GetSkillBonus(skillId: string, level: number): number
	local info = ProgressionConfig.SKILLS[skillId]
	if not info then return 0 end
	return info.PerLevel * level
end

function ProgressionConfig.GetPrestigeMultiplier(prestige: number): number
	return 1 + ProgressionConfig.PRESTIGE_BONUS * math.clamp(prestige, 0, ProgressionConfig.PRESTIGE_MAX)
end

-- Энергия: +12 к макс. энергии и +0.35/с к регенерации за уровень навыка Energy
function ProgressionConfig.GetMaxEnergyBonus(skills: { [string]: number }?): number
	local eLvl = ProgressionConfig.GetSkillLevel(skills, "Energy")
	return eLvl * GameConfig.ENERGY.PerSkillLevelMaxBonus
end

function ProgressionConfig.GetEnergyRegenBonus(skills: { [string]: number }?): number
	local eLvl = ProgressionConfig.GetSkillLevel(skills, "Energy")
	return eLvl * GameConfig.ENERGY.PerSkillLevelRegenBonus
end

function ProgressionConfig.GetDamageMultiplier(skills: { [string]: number }?, prestige: number): number
	local power = ProgressionConfig.GetSkillLevel(skills, "Power")
	return (1 + 0.05 * power) * ProgressionConfig.GetPrestigeMultiplier(prestige)
end

function ProgressionConfig.GetAttackCooldown(skills: { [string]: number }?, prestige: number): number
	local speed = ProgressionConfig.GetSkillLevel(skills, "Speed")
	local cd = ProgressionConfig.BASE_ATTACK_COOLDOWN / ((1 + 0.02 * speed) * ProgressionConfig.GetPrestigeMultiplier(prestige))
	return math.max(ProgressionConfig.MIN_ATTACK_COOLDOWN, cd)
end

-- Вместимость из навыков ВСЕГДА 0 (Пункт №4 ТЗ: вместимость только от рюкзака 1–10 ур.)
function ProgressionConfig.GetCapacityBonus(_skills: { [string]: number }?): number
	return 0
end

function ProgressionConfig.GetLuckChance(skills: { [string]: number }?, prestige: number): number
	local luck = ProgressionConfig.GetSkillLevel(skills, "Luck")
	return math.clamp(0.015 * luck * ProgressionConfig.GetPrestigeMultiplier(prestige), 0, 0.75)
end

function ProgressionConfig.GetCritChance(skills: { [string]: number }?): number
	local crit = ProgressionConfig.GetSkillLevel(skills, "Critical")
	return math.clamp(0.01 * crit, 0, 0.50)
end

function ProgressionConfig.GetXPMultiplier(prestige: number): number
	return ProgressionConfig.GetPrestigeMultiplier(prestige)
end

function ProgressionConfig.GetCoinMultiplier(prestige: number): number
	return ProgressionConfig.GetPrestigeMultiplier(prestige)
end

return ProgressionConfig
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">ToolAnimator</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🎬 МОДУЛЬ: ToolAnimator (ReplicatedStorage.Modules.ToolAnimator) — КЛИЕНТ
-- Версия: v13.0 — Выполнено Требование №1:
-- • Правая рука игрока (Плечо + Локоть + Кисть на R15 и Правая рука на R6)
--   и 3D-кирка двигаются на 100% СИНХРОННО как единое целое!
-- • Привязка через BindToRenderStep с приоритетом RenderPriority.Character.Value + 20
--   гарантирует, что стандартный Animator Roblox не перебивает позу руки во время удара.
-- • Скорость и резкость удара масштабируются от уровня кирки (1..10 ур., SwingAnimSpeed).
-- • 3D-рюкзак на спине плавно надувается по мере заполнения и подпрыгивает при добыче.
-- ============================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local ToolAnimator = {}

-- v52: внешние обработчики эффектов кирки (ставит PickaxeFX): начало взмаха и момент удара
ToolAnimator.OnSwingStart = nil :: ((char: Model, isCrit: boolean) -&gt; ())?
ToolAnimator.OnImpact = nil :: ((char: Model) -&gt; ())?

local SWING = {
	Windup = 0.14,
	Strike = 0.08,
	Hold = 0.04,
	Recover = 0.13,
	ArmWindup = 165,    -- высокий замах плеча вверх-назад
	ArmStrike = 42,     -- резкое опускание руки при ударе по породе
	ElbowWindup = 38,   -- сгиб локтя при замахе (R15)
	ElbowStrike = 12,   -- распрямление локтя в момент удара (R15)
	WristWindup = -24,  -- отвод кисти с киркой назад
	WristStrike = -88,  -- рубящий доворот кисти вниз в точку удара
}
local SWING_TOTAL = SWING.Windup + SWING.Strike + SWING.Hold + SWING.Recover

local FIRST_PERSON_REST_ARM = 28
local IDLE_HOLD_ARM = 22          -- в покое правая рука держит кирку перед собой (не висит отдельно!)
local IDLE_HOLD_ELBOW = 24
local ANIM_RANGE = 160

local SWAY = {
	Stiffness = 140,
	Damping = 11,
	RunLagDeg = 0,   -- v35: кирка жёстко в руке, без раскачки при беге
	BobDeg = 0, -- v35: без покачивания
	BobSpeed = 11,
}

local OUTLINE = {
	Color = Color3.fromRGB(22, 16, 30),
	MaxModels = 14,
	Range = 110,
	Refresh = 0.4,
}

local BAG_COLORS = {
	Empty = Color3.fromRGB(90, 95, 110),
	Ok = Color3.fromRGB(80, 230, 120),
	Yellow = Color3.fromRGB(255, 210, 55),
	Red = Color3.fromRGB(255, 60, 60),
}

type BagPart = {
	Part: BasePart,
	Weld: Weld?,
	BaseC0: CFrame,
	BaseSize: Vector3,
	Push: number,
	Inflate: boolean,
	DepthAxis: string,
	Tint: boolean,
	FillGlow: boolean,
	BaseColor: Color3,
}

type CharState = {
	Char: Model,
	Shoulder: Motor6D?,
	ShoulderOrig: CFrame?,
	Elbow: Motor6D?,
	ElbowOrig: CFrame?,
	WristMotor: Motor6D?,
	WristOrig: CFrame?,
	IsR6: boolean,
	Arm: number,
	ElbowDeg: number,
	Wrist: number,
	SwingT: number?,
	SwingSpeedMul: number,
	FromArm: number,
	FromElbow: number,
	FromWrist: number,
	Queue: number,
	CritFlash: boolean,
	ImpactDone: boolean,
	SwayP: number,
	SwayV: number,
	ArmReleased: boolean?,
	BagModel: Model?,
	BagParts: { BagPart },
	BagDepth: number,
	BagF: number,
	BagLastF: number,
	BounceT: number?,
	LastUsed: number?,
	FullTag: BillboardGui?,
	WasAnimatingBag: boolean,
	BagStage: number,
}

local LocalPlayer = Players.LocalPlayer
local States: { [Model]: CharState } = {}
local OrigMotorC0: { [Motor6D]: CFrame } = setmetatable({}, { __mode = "k" }) :: any
local Started = false

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end
local function easeOutQuad(t: number): number
	return 1 - (1 - t) * (1 - t)
end
local function easeInQuad(t: number): number
	return t * t
end
local function easeInOutSine(t: number): number
	return -(math.cos(math.pi * t) - 1) / 2
end

local function isFirstPerson(char: Model): boolean
	local cam = Workspace.CurrentCamera
	local head = char:FindFirstChild("Head") :: BasePart?
	if not cam or not head then return false end
	return (cam.CFrame.Position - head.Position).Magnitude &lt; 1.6
end

local function getState(char: Model): CharState
	local st = States[char]
	if st then return st end
	local newSt: CharState = {
		Char = char,
		Shoulder = nil,
		ShoulderOrig = nil,
		Elbow = nil,
		ElbowOrig = nil,
		WristMotor = nil,
		WristOrig = nil,
		IsR6 = false,
		Arm = IDLE_HOLD_ARM,
		ElbowDeg = IDLE_HOLD_ELBOW,
		Wrist = 0,
		SwingT = nil,
		SwingSpeedMul = 1.0,
		FromArm = IDLE_HOLD_ARM,
		FromElbow = IDLE_HOLD_ELBOW,
		FromWrist = 0,
		Queue = 0,
		CritFlash = false,
		ImpactDone = false,
		SwayP = 0,
		SwayV = 0,
		BagModel = nil,
		BagParts = {},
		BagDepth = 1,
		BagF = 1,
		BagLastF = -1,
		BounceT = nil,
		LastUsed = nil,
		FullTag = nil,
		WasAnimatingBag = false,
		BagStage = 0,
	}
	States[char] = newSt
	char.AncestryChanged:Connect(function()
		if not char.Parent then
			States[char] = nil
		end
	end)
	return newSt
end

local function resolveArmMotors(st: CharState)
	local char = st.Char
	local ua = char:FindFirstChild("RightUpperArm")
	if ua then
		st.IsR6 = false
		local sh = ua:FindFirstChild("RightShoulder")
		if sh and sh:IsA("Motor6D") then
			st.Shoulder = sh
			if not OrigMotorC0[sh] then OrigMotorC0[sh] = sh.C0 end
			st.ShoulderOrig = OrigMotorC0[sh]
		end
		local la = char:FindFirstChild("RightLowerArm")
		local el = la and la:FindFirstChild("RightElbow")
		if el and el:IsA("Motor6D") then
			st.Elbow = el
			if not OrigMotorC0[el] then OrigMotorC0[el] = el.C0 end
			st.ElbowOrig = OrigMotorC0[el]
		end
		local rh = char:FindFirstChild("RightHand")
		local wr = rh and rh:FindFirstChild("RightWrist")
		if wr and wr:IsA("Motor6D") then
			st.WristMotor = wr
			if not OrigMotorC0[wr] then OrigMotorC0[wr] = wr.C0 end
			st.WristOrig = OrigMotorC0[wr]
		end
	else
		local torso = char:FindFirstChild("Torso")
		local sh = torso and torso:FindFirstChild("Right Shoulder")
		if sh and sh:IsA("Motor6D") then
			st.IsR6 = true
			st.Shoulder = sh
			if not OrigMotorC0[sh] then OrigMotorC0[sh] = sh.C0 end
			st.ShoulderOrig = OrigMotorC0[sh]
		end
	end
end

local function getPickMotor(char: Model): Motor6D?
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local m = hand and hand:FindFirstChild("PickaxeMotor")
	if m and m:IsA("Motor6D") then return m end
	return nil
end

local function critFlash(char: Model)
	local pick = char:FindFirstChild("VisualPickaxe") :: Model?
	if not pick or not pick.PrimaryPart then return end
	local off = pick:GetAttribute("HeadOffset")
	local pos = (typeof(off) == "CFrame") and (pick.PrimaryPart.CFrame * (off :: CFrame)).Position or pick.PrimaryPart.Position

	local flash = Instance.new("Part")
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 170, 50)
	flash.Size = Vector3.new(1, 1, 1)
	flash.CFrame = CFrame.new(pos)
	flash.Transparency = 0.15
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.CanTouch = false
	flash.CastShadow = false
	flash.Parent = Workspace

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 60)
	light.Range = 14
	light.Brightness = 4
	light.Parent = flash

	local info = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(flash, info, { Size = Vector3.new(4.5, 4.5, 4.5), Transparency = 1 }):Play()
	TweenService:Create(light, info, { Brightness = 0 }):Play()
	Debris:AddItem(flash, 0.6)
end

local function startSwing(st: CharState, crit: boolean)
	local motor = getPickMotor(st.Char)
	local speedMul = (motor and (motor:GetAttribute("SwingAnimSpeed") :: number?)) or 1.0
	st.SwingSpeedMul = math.clamp(speedMul, 0.85, 1.65)
	st.FromArm = st.Arm
	st.FromElbow = st.ElbowDeg
	st.FromWrist = st.Wrist
	st.SwingT = os.clock()
	st.CritFlash = crit
	st.ImpactDone = false
	local onSwing = ToolAnimator.OnSwingStart
	if onSwing then
		task.spawn(onSwing, st.Char, crit)
	end
end

function ToolAnimator.PlaySwing(char: Model?, isCrit: boolean?)
	if not char then return end
	local st = getState(char)
	local now = os.clock()
	local mul = st.SwingSpeedMul or 1.0
	if st.SwingT and (now - st.SwingT) * mul &lt; (SWING.Windup + SWING.Strike) then
		if isCrit then
			st.Queue = math.min(st.Queue + 1, 2)
		end
		return
	end
	startSwing(st, isCrit == true)
end

function ToolAnimator.AddCritSwing(char: Model?)
	if not char then return end
	local st = getState(char)
	st.Queue = math.min(st.Queue + 1, 2)
	if not st.SwingT then
		startSwing(st, true)
		st.Queue = math.max(0, st.Queue - 1)
	end
end

-- ============================================================================
-- КАДР: ПРАВАЯ РУКА + КИРКА ДВИГАЮТСЯ СИНХРОННО
-- ============================================================================
local function updatePickaxe(st: CharState, dt: number, now: number, isLocal: boolean)
	local char = st.Char
	resolveArmMotors(st)
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local motor = getPickMotor(char)
	if not motor then return end

	-- v35: on the surface the pickaxe is hidden -&gt; give the arm back to the normal walk animation
	if char:GetAttribute("PickaxeHidden") == true and not st.SwingT then
		if not st.ArmReleased then
			st.ArmReleased = true
			if st.Shoulder and st.ShoulderOrig then st.Shoulder.C0 = st.ShoulderOrig end
			if st.Elbow and st.ElbowOrig then st.Elbow.C0 = st.ElbowOrig end
			if st.WristMotor and st.WristOrig then st.WristMotor.C0 = st.WristOrig end
		end
		st.SwayP, st.SwayV = 0, 0
		return
	end
	st.ArmReleased = false

	local fp = isLocal and isFirstPerson(char)
	local restArm = fp and FIRST_PERSON_REST_ARM or IDLE_HOLD_ARM
	local restElbow = fp and 16 or IDLE_HOLD_ELBOW

	local arm, elbowDeg, wrist = restArm, restElbow, 0
	if st.SwingT then
		local t = (now - st.SwingT) * (st.SwingSpeedMul or 1.0)
		local W, S, H, R = SWING.Windup, SWING.Strike, SWING.Hold, SWING.Recover
		if t &lt; W then
			local a = easeOutQuad(t / W)
			arm = lerp(st.FromArm, SWING.ArmWindup, a)
			elbowDeg = lerp(st.FromElbow, SWING.ElbowWindup, a)
			wrist = lerp(st.FromWrist, SWING.WristWindup, a)
		elseif t &lt; W + S then
			local a = easeInQuad((t - W) / S)
			arm = lerp(SWING.ArmWindup, SWING.ArmStrike, a)
			elbowDeg = lerp(SWING.ElbowWindup, SWING.ElbowStrike, a)
			wrist = lerp(SWING.WristWindup, SWING.WristStrike, a)
		elseif t &lt; W + S + H then
			arm, elbowDeg, wrist = SWING.ArmStrike, SWING.ElbowStrike, SWING.WristStrike
		elseif t &lt; SWING_TOTAL then
			local a = easeInOutSine((t - W - S - H) / R)
			arm = lerp(SWING.ArmStrike, restArm, a)
			elbowDeg = lerp(SWING.ElbowStrike, restElbow, a)
			wrist = lerp(SWING.WristStrike, 0, a)
		else
			st.SwingT = nil
		end

		if t &gt;= W + S and not st.ImpactDone then
			st.ImpactDone = true
			local onImpact = ToolAnimator.OnImpact
			if onImpact then
				task.spawn(onImpact, char)
			end
			if st.CritFlash then
				st.CritFlash = false
				task.spawn(critFlash, char)
			end
		end

		if st.SwingT and st.Queue &gt; 0 and t &gt;= W + S + H then
			st.Queue -= 1
			st.Arm, st.ElbowDeg, st.Wrist = arm, elbowDeg, wrist
			startSwing(st, true)
		elseif not st.SwingT and st.Queue &gt; 0 then
			st.Queue -= 1
			st.Arm, st.ElbowDeg, st.Wrist = arm, elbowDeg, wrist
			startSwing(st, true)
		end
	end
	st.Arm, st.ElbowDeg, st.Wrist = arm, elbowDeg, wrist

	-- Инерция при беге (двигаются и рука, и кирка вместе!)
	local target = 0
	local bob = 0
	if root then
		local v = root.CFrame:VectorToObjectSpace(root.AssemblyLinearVelocity)
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		local k = math.clamp(speed / 16, 0, 1.4)
		target = math.clamp(-v.Z / 16, -1, 1.2) * SWAY.RunLagDeg
		bob = math.sin(now * SWAY.BobSpeed) * SWAY.BobDeg * k
	end
	local accel = (target - st.SwayP) * SWAY.Stiffness - st.SwayV * SWAY.Damping
	st.SwayV += accel * dt
	st.SwayP += st.SwayV * dt
	local swayMul = st.SwingT and 0.20 or 1
	local swayOffset = (st.SwayP + bob) * swayMul

	local finalArm = arm + swayOffset * 0.65
	local finalWrist = wrist + swayOffset * 0.55

	-- Применяем к плечу, локтю и кисти правой руки, чтобы рука всегда держала и била киркой!
	local shoulder = st.Shoulder
	if shoulder and st.ShoulderOrig then
		local rot = st.IsR6
			and CFrame.Angles(0, 0, math.rad(finalArm))
			or CFrame.Angles(math.rad(finalArm), 0, 0)
		shoulder.C0 = st.ShoulderOrig * rot
		shoulder.Transform = CFrame.identity -- v35: walk anim no longer swings the pickaxe arm
	end

	if not st.IsR6 then
		if st.Elbow and st.ElbowOrig then
			st.Elbow.C0 = st.ElbowOrig * CFrame.Angles(math.rad(elbowDeg), 0, 0)
			st.Elbow.Transform = CFrame.identity
		end
		if st.WristMotor and st.WristOrig then
			st.WristMotor.C0 = st.WristOrig * CFrame.Angles(math.rad(finalWrist * 0.35), 0, 0)
			st.WristMotor.Transform = CFrame.identity
		end
	end

	local base = motor:GetAttribute("BaseC0")
	local grip = motor:GetAttribute("GripPos")
	if typeof(base) == "CFrame" and typeof(grip) == "Vector3" then
		local g = CFrame.new(grip :: Vector3)
		motor.C0 = g * CFrame.Angles(math.rad(finalWrist * 0.65), 0, 0) * g:Inverse() * (base :: CFrame)
	end
end

-- ============================================================================
-- КАДР: РЮКЗАК
-- ============================================================================
local function indexBag(st: CharState, bag: Model)
	st.BagModel = bag
	st.BagParts = {}
	st.BagDepth = (bag:GetAttribute("BodyDepth") :: number?) or 1
	st.BagLastF = -1
	st.BagStage = 0
	for _, d in ipairs(bag:GetDescendants()) do
		if d:IsA("BasePart") then
			local baseC0 = d:GetAttribute("BaseC0")
			if typeof(baseC0) == "CFrame" then
				local w = d:FindFirstChild("BagWeld")
				table.insert(st.BagParts, {
					Part = d,
					Weld = (w and w:IsA("Weld")) and w or nil,
					BaseC0 = baseC0 :: CFrame,
					BaseSize = (d:GetAttribute("BaseSize") :: Vector3?) or d.Size,
					Push = (d:GetAttribute("Push") :: number?) or 0,
					Inflate = d:GetAttribute("Inflate") == true,
					DepthAxis = tostring(d:GetAttribute("DepthAxis") or "Z"),
					Tint = d:GetAttribute("Tint") == true,
					FillGlow = d:GetAttribute("FillGlow") == true,
					BaseColor = (d:GetAttribute("BaseColor") :: Color3?) or d.Color,
				})
			else
				-- v47: остальные детали (карманы, канты, замки) тоже прыгают вместе с рюкзаком
				local w = d:FindFirstChild("BagWeld")
				if w and w:IsA("Weld") and not string.find(d.Name, "Strap") then
					table.insert(st.BagParts, {
						Part = d, Weld = w, BaseC0 = w.C0, BaseSize = d.Size, Push = 0,
						Inflate = false, DepthAxis = "Z", Tint = false, FillGlow = false, BaseColor = d.Color,
					} :: any)
				end
			end
		end
	end

	local body = bag:FindFirstChild("Body") :: BasePart?
	if body then
		local bb = Instance.new("BillboardGui")
		bb.Name = "FullTag"
		bb.Size = UDim2.fromOffset(150, 50)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0)
		bb.AlwaysOnTop = true
		bb.MaxDistance = 80
		bb.Enabled = false
		bb.Adornee = body
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.FredokaOne
		lbl.Text = "FULL!"
		lbl.TextScaled = true
		lbl.TextColor3 = Color3.fromRGB(255, 70, 70)
		lbl.Parent = bb
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 3
		stroke.Color = Color3.fromRGB(40, 0, 0)
		stroke.Parent = lbl
		local scale = Instance.new("UIScale")
		scale.Parent = lbl
		bb.Parent = body
		st.FullTag = bb
	end
end

local function spawnSellCoins(bag: Model)
	local body = bag:FindFirstChild("Body") :: BasePart?
	if not body then return end
	local origin = body.Position + Vector3.new(0, body.Size.Y * 0.6, 0)
	for i = 1, 12 do
		local coin = Instance.new("Part")
		coin.Name = "SellCoin"
		coin.Shape = Enum.PartType.Cylinder
		coin.Size = Vector3.new(0.12, 0.55, 0.55)
		coin.Color = Color3.fromRGB(255, 205, 50)
		coin.Material = Enum.Material.Metal
		coin.Reflectance = 0.35
		coin.CanCollide = false
		coin.CanQuery = false
		coin.CanTouch = false
		coin.CastShadow = false
		coin.CFrame = CFrame.new(origin) * CFrame.Angles(math.random() * 6.28, math.random() * 6.28, 0)
		coin.Parent = Workspace
		coin.AssemblyLinearVelocity = Vector3.new((math.random() - 0.5) * 14, 14 + math.random() * 10, (math.random() - 0.5) * 14)
		coin.AssemblyAngularVelocity = Vector3.new(math.random() * 20, math.random() * 20, 0)
		task.delay(0.45, function()
			if coin.Parent then
				TweenService:Create(coin, TweenInfo.new(0.35), { Transparency = 1 }):Play()
			end
		end)
		Debris:AddItem(coin, 0.85)
	end
end

local function updateBackpack(st: CharState, plr: Player?, dt: number, now: number)
	local bag = st.Char:FindFirstChild("VisualBackpack") :: Model?
	if not bag then return end
	if st.BagModel ~= bag then
		indexBag(st, bag)
	end

	local used = (plr and plr:GetAttribute("BagUsed") :: number?) or 0
	local max = math.max(1, (plr and plr:GetAttribute("BagMax") :: number?) or 1)
	local r = math.clamp(used / max, 0, 1)

	if st.LastUsed ~= nil then
		if used &gt; (st.LastUsed :: number) then
			st.BounceT = now
		elseif used == 0 and (st.LastUsed :: number) &gt; 0 then
			st.BounceT = now
			task.spawn(spawnSellCoins, bag)
		end
	end
	st.LastUsed = used

	local pulse = (math.sin(now * 8) + 1) / 2
	local fTarget: number, tintCol: Color3, tintA: number, glowCol: Color3
	local full = r &gt;= 1
	local stage = (r &lt; 0.25 and 1) or (r &lt; 0.5 and 2) or (r &lt; 0.75 and 3) or (full and 5) or 4
	if r &lt; 0.25 then
		fTarget, tintCol, tintA, glowCol = 0.88, Color3.new(0, 0, 0), 0.12, BAG_COLORS.Empty
	elseif r &lt; 0.5 then
		fTarget, tintCol, tintA, glowCol = 0.88 + (r - 0.25) / 0.25 * 0.16, Color3.new(0, 0, 0), 0.0, BAG_COLORS.Ok
	elseif r &lt; 0.75 then
		fTarget, tintCol, tintA, glowCol = 1.06, BAG_COLORS.Yellow, 0.28, BAG_COLORS.Yellow
	elseif not full then
		fTarget, tintCol, tintA, glowCol = 1.12, BAG_COLORS.Red, 0.20 + 0.18 * pulse, BAG_COLORS.Red:Lerp(Color3.new(1, 1, 1), 0.35 * pulse)
	else
		fTarget, tintCol, tintA, glowCol = 1.16, BAG_COLORS.Red, 0.38 + 0.1 * pulse, BAG_COLORS.Red
	end
	st.BagF += (fTarget - st.BagF) * math.min(1, dt * 8)

	local bounceY, squash = 0, 0
	if st.BounceT then
		local t = (now - (st.BounceT :: number)) / 0.36
		if t &lt; 1 then
			bounceY = math.sin(t * math.pi) * 0.5 * (1 - t * 0.4) -- v47: заметнее прыжок
			squash = math.sin(t * math.pi * 2) * 0.06 * (1 - t)
		else
			st.BounceT = nil
		end
	end
	local shake = CFrame.identity
	if full then
		shake = CFrame.new((math.random() - 0.5) * 0.09, (math.random() - 0.5) * 0.05, 0) * CFrame.Angles(0, 0, (math.random() - 0.5) * 0.06)
	end

	local animating = st.BounceT ~= nil or full or (r &gt;= 0.75) or stage ~= st.BagStage or math.abs(st.BagF - st.BagLastF) &gt; 0.002
	st.BagStage = stage
	if not animating and not st.WasAnimatingBag then
		return
	end
	st.WasAnimatingBag = animating
	st.BagLastF = st.BagF

	local df = st.BagF - 1
	local rootOff = CFrame.new(0, bounceY, 0) * CFrame.Angles(-bounceY * 0.35, 0, 0) * shake
	for _, bp in ipairs(st.BagParts) do
		local p = bp.Part
		if p.Parent then
			local push = bp.Push * st.BagDepth * df
			if bp.Weld then
				bp.Weld.C0 = rootOff * CFrame.new(0, 0, push) * bp.BaseC0
			end
			if bp.Inflate then
				local xy = 1 + df * 0.3 + squash
				local s = bp.BaseSize
				if bp.DepthAxis == "X" then
					p.Size = Vector3.new(s.X * (1 + df), s.Y * xy, s.Z * xy)
				else
					p.Size = Vector3.new(s.X * xy, s.Y * (xy - squash * 2), s.Z * (1 + df))
				end
			end
			if bp.Tint then
				p.Color = bp.BaseColor:Lerp(tintCol, tintA)
			elseif bp.FillGlow then
				p.Color = glowCol
			end
		end
	end

	if st.FullTag then
		st.FullTag.Enabled = full
		if full then
			local lbl = st.FullTag:FindFirstChildOfClass("TextLabel")
			local sc = lbl and lbl:FindFirstChildOfClass("UIScale")
			if sc then sc.Scale = 1 + 0.12 * pulse end
		end
	end
end

local function refreshOutlines()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local camPos = cam.CFrame.Position
	local candidates: { { Model: Model, Dist: number } } = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local char = plr.Character
		if char then
			for _, name in ipairs({ "VisualPickaxe", "VisualBackpack" }) do
				local m = char:FindFirstChild(name)
				if m and m:IsA("Model") then
					local pivot = m:GetPivot().Position
					local d = (pivot - camPos).Magnitude
					if plr == LocalPlayer then d = -1 end
					table.insert(candidates, { Model = m, Dist = d })
				end
			end
		end
	end
	table.sort(candidates, function(a, b) return a.Dist &lt; b.Dist end)
	for i, c in ipairs(candidates) do
		local hl = c.Model:FindFirstChild("ToonOutline")
		local want = i &lt;= OUTLINE.MaxModels and c.Dist &lt;= OUTLINE.Range
		if want and not hl then
			local h = Instance.new("Highlight")
			h.Name = "ToonOutline"
			h.Adornee = c.Model
			h.FillTransparency = 1
			h.OutlineTransparency = 0
			h.OutlineColor = OUTLINE.Color
			h.DepthMode = Enum.HighlightDepthMode.Occluded
			h.Parent = c.Model
		elseif not want and hl then
			hl:Destroy()
		end
	end
end

local FP_VISIBLE_PARTS = { "RightUpperArm", "RightLowerArm", "RightHand", "Right Arm" }
local function keepFirstPersonVisible()
	local char = LocalPlayer and LocalPlayer.Character
	if not char or not isFirstPerson(char) then return end
	local pick = char:FindFirstChild("VisualPickaxe")
	if pick then
		for _, d in ipairs(pick:GetDescendants()) do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = 0
			end
		end
	end
	for _, name in ipairs(FP_VISIBLE_PARTS) do
		local p = char:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			p.LocalTransparencyModifier = 0
		end
	end
end

function ToolAnimator.Start()
	if Started then return end
	Started = true

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	task.spawn(function()
		local fx = remotes:WaitForChild("EquipFX", 30)
		if fx and fx:IsA("RemoteEvent") then
			fx.OnClientEvent:Connect(function(kind: any, char: any, isCrit: any, _userId: any)
				if kind ~= "Swing" or typeof(char) ~= "Instance" or not char:IsA("Model") then return end
				local localChar = LocalPlayer and LocalPlayer.Character
				if char == localChar then
					if isCrit == true then
						ToolAnimator.AddCritSwing(char)
					end
				else
					ToolAnimator.PlaySwing(char, false)
					if isCrit == true then
						ToolAnimator.AddCritSwing(char)
					end
				end
			end)
		end
	end)

	local outlineTimer = 0
	-- Выполняем анимацию правой руки и кирки ПОСЛЕ стандартного шага анимации персонажа,
	-- чтобы рука и кирка всегда двигались синхронно!
	RunService:BindToRenderStep("MinerArmAndPickaxeSync", Enum.RenderPriority.Character.Value + 20, function(dt: number)
		local now = os.clock()
		local cam = Workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			if char and char.Parent then
				local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
				local isLocal = plr == LocalPlayer
				if root and (isLocal or (root.Position - camPos).Magnitude &lt;= ANIM_RANGE) then
					local st = getState(char)
					pcall(updatePickaxe, st, dt, now, isLocal)
					pcall(updateBackpack, st, plr, dt, now)
				end
			end
		end
		outlineTimer += dt
		if outlineTimer &gt;= OUTLINE.Refresh then
			outlineTimer = 0
			pcall(refreshOutlines)
		end
	end)

	RunService:BindToRenderStep("MinerFirstPersonTool", Enum.RenderPriority.Camera.Value + 2, function()
		pcall(keepFirstPersonVisible)
	end)
end

return ToolAnimator
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">OreConfig</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 💎 МОДУЛЬ: OreConfig (ReplicatedStorage.Modules.OreConfig)
-- Версия: v13.0 — Конфигурация 16 пород, Утренних залежей (×3), 10 кирок и 10 рюкзаков.
-- ============================================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))

local OreConfig = {}

OreConfig.Blocks = GameConfig.BLOCK_LIST
OreConfig.ById = GameConfig.BLOCK_TYPES
OreConfig.DepthBands = GameConfig.DEPTH_BANDS
OreConfig.Pickaxes = GameConfig.PICKAXE_TIERS
OreConfig.Backpacks = GameConfig.BACKPACK_TIERS
OreConfig.MorningVeins = GameConfig.MORNING_VEINS
OreConfig.Textures = GameConfig.TEXTURES
OreConfig.Energy = GameConfig.ENERGY
OreConfig.AntiFarm = GameConfig.ANTI_FARM

function OreConfig.GetOreInfo(oreId: string)
	return GameConfig.BLOCK_TYPES[oreId] or GameConfig.BLOCK_TYPES.Stone
end

function OreConfig.GetDepthBand(depthBlocks: number)
	return GameConfig.GetDepthBand(depthBlocks)
end

function OreConfig.CanPickaxeMine(pickaxeLevel: number, oreId: string): (boolean, number, string)
	local info = OreConfig.GetOreInfo(oreId)
	local reqLvl = info.MinPickaxeLevel or 1
	local curLvl = math.max(1, math.floor(pickaxeLevel))
	if curLvl &gt;= reqLvl then
		return true, 1.0, ""
	end
	local reqPick = GameConfig.PICKAXE_TIERS[reqLvl]
	local reqName = reqPick and reqPick.Name or ("Pickaxe Lv." .. reqLvl)
	return false, 0.08, string.format("⚠️ Too hard! You need %s (Lv.%d)", reqName, reqLvl)
end

return OreConfig
</ProtectedString></Properties></Item><Item class="ModuleScript"><Properties><string name="Name">EquipmentBuilder</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- 🔨 МОДУЛЬ: EquipmentManager (ReplicatedStorage.Modules.EquipmentBuilder &amp;
--            ServerScriptService.Modules.EquipmentManager)
-- Версия: v13.0 — Выполняет Пункты №1, №5, №9 и №11:
-- 1) 10 уровней 3D-кирок (1..10 ур.) с креплением к правой кисти через Motor6D
--    (PickaxeMotor) и полной синхронизацией с анимацией правой руки R15/R6.
-- 2) 10 уровней 3D-рюкзаков (1..10 ур.) строго по референсу «От классики до киберпанка»:
--    • Ур. 1: Холщовый с клапаном и пряжкой
--    • Ур. 2: Кожаный со спальной скаткой сверху
--    • Ур. 3: Оливковый полевой со скаткой и двойными ремнями
--    • Ур. 4: Чёрный городской кофр со стальным шильдиком
--    • Ур. 5: Синий «Авангард» со светящимся белым ромбом
--    • Ур. 6: Бронированный тактический с подсумками MOLLE
--    • Ур. 7: Белый кибер-корпус «Полярная Звезда» с голубой 4-лучевой звездой
--    • Ур. 8: Тёмно-фиолетовый «Корона» с неоновыми контурами и короной
--    • Ур. 9: Вулканический экзо-ранец с багровыми магмовыми каналами
--    • Ур. 10: Квантовый кибер-ранец с 4 светящимися голубыми крыльями-кристаллами
-- 3) 3D Оранжевая шахтёрская каска (MinerHardHat) по референсу (рёбра жёсткости,
--    козырёк, боковые пазы, внутренняя подвеска и налобный фонарик), автоматически
--    надеваемая при входе в шахту и снимаемая на поверхности!
-- 4) Поддержка рендера в 3D ViewportFrame магазина (BuildShowcaseModelForViewport).
-- ============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("GameConfig"))
local PickaxeJuice = require(script.Parent:WaitForChild("PickaxeJuice"))

local EquipmentManager = {}

local FxRemote: RemoteEvent? = nil

-- v29: кирка в точности по референсу: гладкое лезвие без срезов, рукоять, втулка и колпачок
-- со скошенными рёбрами. 1 px референса = 0.0104 stud; все Y в таблицах — от центра головы HeadY.
local PICK = {
	HeadY = 1.78,
	GripY = -1.55,
	RestTiltDeg = 25,
}

-- Лезвие — цепочка перекрывающихся вытянутых эллипсоидов, вписанных в силуэт референса
-- (гладкая поверхность вместо плоских срезанных сегментов).
-- { x, y, уголГрад, толщина Z, высота, длина } — правое плечо (левое зеркально); угол &gt; 0 — вниз к острию.
local PICK_BEADS: { { number } } = {
	{ 0.1872, 0.0726, 0.56, 0.5881, 0.6203, 1.8607 },
	{ 0.2843, 0.07, 0.56, 0.5813, 0.5976, 1.7926 },
	{ 0.3814, 0.0673, 0.56, 0.5679, 0.5764, 1.7292 },
	{ 0.4761, 0.0608, 1.34, 0.5589, 0.5533, 1.6598 },
	{ 0.565, 0.055, 2.92, 0.5538, 0.5356, 1.6067 },
	{ 0.6506, 0.0467, 4.77, 0.5515, 0.5217, 1.5649 },
	{ 0.7343, 0.0357, 6.76, 0.5507, 0.5075, 1.5226 },
	{ 0.8167, 0.0244, 8.78, 0.5487, 0.4961, 1.4881 },
	{ 0.8977, 0.0105, 10.75, 0.5417, 0.4824, 1.4471 },
	{ 0.9773, -0.0059, 12.62, 0.5302, 0.4684, 1.4052 },
	{ 1.0553, -0.0246, 14.35, 0.5167, 0.4535, 1.3605 },
	{ 1.1313, -0.0453, 15.94, 0.5026, 0.4361, 1.3083 },
	{ 1.2053, -0.0648, 17.4, 0.4888, 0.4185, 1.2556 },
	{ 1.2769, -0.0882, 18.73, 0.4756, 0.4011, 1.2035 },
	{ 1.3462, -0.1151, 19.98, 0.4632, 0.3833, 1.15 },
	{ 1.4132, -0.1403, 21.18, 0.4515, 0.3651, 1.0954 },
	{ 1.4777, -0.1687, 22.37, 0.4402, 0.345, 1.0349 },
	{ 1.54, -0.1977, 23.56, 0.4291, 0.3236, 0.9709 },
	{ 1.6, -0.2272, 24.8, 0.4174, 0.302, 0.9062 },
	{ 1.6578, -0.2573, 26.11, 0.404, 0.2799, 0.8395 },
	{ 1.7131, -0.2853, 27.49, 0.388, 0.2567, 0.77 },
	{ 1.766, -0.3163, 28.95, 0.3669, 0.2351, 0.7053 },
	{ 1.8162, -0.3449, 30.48, 0.3408, 0.2122, 0.6364 },
	{ 1.8635, -0.3736, 32.06, 0.3096, 0.1898, 0.5694 },
	{ 1.9077, -0.3995, 33.67, 0.2766, 0.167, 0.5012 },
	{ 1.9482, -0.4247, 35.26, 0.2427, 0.1453, 0.436 },
	{ 1.9852, -0.449, 36.81, 0.21, 0.1245, 0.3735 },
	{ 2.0181, -0.4691, 38.26, 0.181, 0.1042, 0.3126 },
	{ 2.047, -0.4898, 39.59, 0.1515, 0.087, 0.2611 },
	{ 2.072, -0.5084, 40.77, 0.1253, 0.0717, 0.2149 },
	{ 2.0931, -0.5244, 41.8, 0.1029, 0.058, 0.174 },
	{ 2.1108, -0.5377, 42.68, 0.0841, 0.0461, 0.1383 },
	{ 2.1252, -0.5512, 43.4, 0.0682, 0.0362, 0.1087 },
	{ 2.1377, -0.5606, 44.04, 0.0515, 0.0286, 0.0858 },
	{ 2.1502, -0.5701, 44.68, 0.0384, 0.0192, 0.0577 },
}

-- Призмы вдоль Y: { верхY, низY, ширина X, глубина Z, фаска рёбер }; пластины без фаски — 4 числа.
local PICK_SHAPES: { [string]: { number } } = {
	Handle = { 0.4836, -3.5724, 0.4784, 0.4368, 0.1404 },
	HandleFlare = { -3.4684, -4.134, 0.52, 0.468, 0.1508 },
	HandleTip = { -4.134, -4.1964, 0.3536, 0.312 },
	Socket = { 0.3484, -0.2548, 0.6864, 0.7904, 0.0728 },
	SocketBand = { -0.2444, -0.4108, 0.6656, 0.7696, 0.0832 },
	SocketRim = { 0.4316, 0.338, 0.6032, 0.7072 },
	Cap = { 0.5252, 0.4212, 0.572, 0.52, 0.104 },
	CapTop = { 0.5564, 0.5148, 0.4576, 0.416 },
}

local function getMeshTemplate(name: string): MeshPart?
	local assets = ReplicatedStorage:FindFirstChild(GameConfig.MESH_ASSETS_FOLDER)
	local meshes = assets and assets:FindFirstChild("Meshes")
	local found = meshes and meshes:FindFirstChild(name)
	if not found then return nil end
	if found:IsA("MeshPart") then return found end
	return found:FindFirstChildWhichIsA("MeshPart", true)
end

local function styleBase(p: BasePart, name: string, size: Vector3, color: Color3, mat: Enum.Material, reflectance: number?)
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = mat
	p.Reflectance = reflectance or 0
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
end

local function newPart(parent: Instance, name: string, size: Vector3, color: Color3, mat: Enum.Material, reflectance: number?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	if shape then p.Shape = shape end
	styleBase(p, name, size, color, mat, reflectance)
	p.Parent = parent
	return p
end

local function newWedge(parent: Instance, name: string, size: Vector3, color: Color3, mat: Enum.Material, reflectance: number?): WedgePart
	local w = Instance.new("WedgePart")
	styleBase(w, name, size, color, mat, reflectance)
	w.Parent = parent
	return w
end

local function newRoundedBox(parent: Instance, name: string, size: Vector3, color: Color3, mat: Enum.Material, reflectance: number?): BasePart
	local tpl = getMeshTemplate("RoundedBox")
	if tpl then
		local m = tpl:Clone()
		styleBase(m, name, size, color, mat, reflectance)
		m.Parent = parent
		return m
	end
	return newPart(parent, name, size, color, mat, reflectance)
end

local function lighten(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), a)
end

local function darken(c: Color3, a: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), a)
end

local function getPickTierCfg(level: number)
	local cl = math.clamp(math.floor(level), 1, GameConfig.MAX_PICKAXE_LEVEL)
	return GameConfig.PICKAXE_TIERS[cl] or GameConfig.PICKAXE_TIERS[1]
end

export type PickaxeBuildOptions = { Scale: number?, LowDetail: boolean?, ForViewport: boolean? }

-- ============================================================================
-- 1. СБОРКА 3D-КИРКИ (УРОВНИ 1–10)
-- ============================================================================
function EquipmentManager.BuildModernPickaxeParts(
	container: Instance,
	level: number,
	baseCFrame: CFrame,
	anchored: boolean,
	opts: PickaxeBuildOptions?
): (BasePart, CFrame)
	local o: PickaxeBuildOptions = opts or {}
	local k = o.Scale or 1
	local low = o.LowDetail == true
	local forVp = o.ForViewport == true
	local cfg = getPickTierCfg(level)
	local tierLvl = math.clamp(math.floor(level), 1, GameConfig.MAX_PICKAXE_LEVEL)
	local hs = cfg.HeadScale
	local headY = PICK.HeadY

	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * k, y * k, z * k)
	end
	local function sz(x: number, y: number, z: number): Vector3
		return Vector3.new(x * k, y * k, z * k)
	end

	local placed: { BasePart } = {}
	local function place(p: BasePart, localCF: CFrame)
		p.CFrame = baseCFrame * localCF
		p.Anchored = anchored
		table.insert(placed, p)
	end

	-- Восьмигранная призма вдоль Y (брусок со скошенными продольными рёбрами, как на референсе):
	-- основной брусок + поперечный брусок + 4 клина на рёбрах; s — масштаб вокруг центра головы.
	local function prism(name: string, d: { number }, s: number, color: Color3, mat: Enum.Material, refl: number): BasePart
		local yTop, yBot = d[1] * s, d[2] * s
		local w, dz, ch = d[3] * s, d[4] * s, d[5] * s
		local yc = headY + (yTop + yBot) / 2
		local h = yTop - yBot
		local core = newPart(container, name, sz(w, h, dz - 2 * ch), color, mat, refl)
		place(core, at(0, yc, 0))
		local cross = newPart(container, name .. "Cross", sz(w - 2 * ch, h - 0.004, dz), color, mat, refl)
		place(cross, at(0, yc, 0))
		for _, qx in ipairs({ -1, 1 }) do
			for _, qz in ipairs({ -1, 1 }) do
				local edge = newWedge(container, name .. "Edge", sz(h, ch, ch), color, mat, refl)
				place(edge, CFrame.fromMatrix(
					Vector3.new(qx * (w - ch) / 2, yc, qz * (dz - ch) / 2) * k,
					Vector3.new(0, qx * qz, 0),
					Vector3.new(qx, 0, 0),
					Vector3.new(0, 0, -qz)
				))
			end
		end
		return core
	end

	local function slab(name: string, d: { number }, s: number, color: Color3, mat: Enum.Material, refl: number): BasePart
		local yTop, yBot = d[1] * s, d[2] * s
		local p = newPart(container, name, sz(d[3] * s, yTop - yBot, d[4] * s), color, mat, refl)
		place(p, at(0, headY + (yTop + yBot) / 2, 0))
		return p
	end

	-- Рукоять: восьмигранный брусок, книзу расширение и торец.
	local wood, woodMat = cfg.HandleColor, cfg.HandleMaterial
	local hd = PICK_SHAPES.Handle
	local handle = prism("Handle", hd, 1, wood, woodMat, 0.04)
	local handleLocal = at(0, headY + (hd[1] + hd[2]) / 2, 0)
	prism("HandleFlare", PICK_SHAPES.HandleFlare, 1, wood, woodMat, 0.04)
	slab("HandleEnd", PICK_SHAPES.HandleTip, 1, darken(wood, 0.15), woodMat, 0.04)

	-- Навершие (втулка, обод, колпачок, лезвие) масштабируется по тиру вокруг центра головы.
	local socket = prism("HeadCollar", PICK_SHAPES.Socket, hs, cfg.TrimColor, cfg.TrimMaterial, 0.15)
	prism("HeadBand", PICK_SHAPES.SocketBand, hs, darken(cfg.TrimColor, 0.3), cfg.TrimMaterial, 0.15)
	slab("HeadRim", PICK_SHAPES.SocketRim, hs, darken(cfg.TrimColor, 0.18), cfg.TrimMaterial, 0.15)
	prism("HeadCap", PICK_SHAPES.Cap, hs, lighten(wood, 0.06), woodMat, 0.04)
	slab("HeadCapTop", PICK_SHAPES.CapTop, hs, lighten(wood, 0.1), woodMat, 0.04)

	-- Лезвие: гладкое, из перекрывающихся эллипсоидов (вписаны в силуэт референса, без срезов).
	local nBeads = #PICK_BEADS
	for _, side in ipairs({ -1, 1 }) do
		for i, b in ipairs(PICK_BEADS) do
			if not low or i % 2 == 1 or i == nBeads then
				local a = math.rad(b[3])
				local bead = newPart(container, "Blade", sz(b[4] * hs, b[5] * hs, b[6] * hs), cfg.BladeColor, cfg.HeadMaterial, cfg.HeadReflectance)
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = bead
				place(bead, CFrame.fromMatrix(
					Vector3.new(side * b[1] * hs, headY + b[2] * hs, 0) * k,
					Vector3.new(0, 0, 1),
					Vector3.new(side * math.sin(a), math.cos(a), 0)
				))
			end
		end
	end

	-- v52: «сочная» отделка кирки — неоновая полоса на лезвии, светящийся кристалл, PointLight,
	-- блёстки и шлейф взмаха. Цвета и сила эффектов по уровням — GameConfig.PICKAXE_FX.
	local okJuice, errJuice = pcall(PickaxeJuice.Decorate, {
		Container = container,
		Level = tierLvl,
		Scale = k,
		HeadScale = hs,
		HeadY = headY,
		Beads = PICK_BEADS,
		SocketDepth = PICK_SHAPES.Socket[4],
		Socket = socket,
		Place = place,
		ForViewport = forVp,
		LowDetail = low,
	})
	if not okJuice then
		warn("[EquipmentBuilder] PickaxeJuice: " .. tostring(errJuice))
	end

	if not anchored then
		for _, p in ipairs(placed) do
			if p ~= handle then
				local wc = Instance.new("WeldConstraint")
				wc.Part0 = handle
				wc.Part1 = p
				wc.Parent = p
			end
		end
	end

	if container:IsA("Model") then
		container:SetAttribute("HeadOffset", handleLocal:Inverse() * at(0, headY, 0))
		container:SetAttribute("PickaxeTier", cfg.Level)
		container:SetAttribute("SwingAnimSpeed", cfg.SwingAnimSpeed or 1.0)
	end

	return handle, handleLocal
end

-- ============================================================================
-- 2. ЭКИПИРОВКА КИРКИ В ПРАВУЮ РУКУ (R15 И R6) С ЖЁСТКОЙ ПРИВЯЗКОЙ MOTOR6D
-- ============================================================================
function EquipmentManager.EquipPickaxe(character: Model, level: number)
	local PICK_HAND_SCALE = 0.65 -- v30: smaller pickaxe in hand
	if not character then return end

	for _, child in ipairs(character:GetChildren()) do
		if child.Name == "VisualPickaxe" or (child:IsA("Tool") and child:GetAttribute("IsMinerPickaxe")) then
			child:Destroy()
		end
	end

	local hand = (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")) :: BasePart?
	if not hand or not hand:IsA("BasePart") then return end
	local oldMotor = hand:FindFirstChild("PickaxeMotor")
	if oldMotor then oldMotor:Destroy() end

	local cfg = getPickTierCfg(level)

	local model = Instance.new("Model")
	model.Name = "VisualPickaxe"

	local gripAtt = hand:FindFirstChild("RightGripAttachment")
	local gripPos: Vector3
	if gripAtt and gripAtt:IsA("Attachment") then
		gripPos = gripAtt.Position
	elseif hand.Name == "Right Arm" then
		gripPos = Vector3.new(0, -1, 0)
	else
		gripPos = Vector3.new(0, -0.15, 0)
	end

	local pickToHand = CFrame.new(gripPos)
		* CFrame.Angles(math.rad(PICK.RestTiltDeg), 0, 0)
		* CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(0, 0, -1))
		* CFrame.new(0, -PICK.GripY * PICK_HAND_SCALE, 0)

	local pickSpace = hand.CFrame * pickToHand
	local handle, handleLocal = EquipmentManager.BuildModernPickaxeParts(model, cfg.Level, pickSpace, false, { Scale = PICK_HAND_SCALE })
	model.PrimaryPart = handle
	model.Parent = character

	local motor = Instance.new("Motor6D")
	motor.Name = "PickaxeMotor"
	motor.Part0 = hand
	motor.Part1 = handle
	motor.C0 = pickToHand * handleLocal
	motor.C1 = CFrame.identity
	motor:SetAttribute("BaseC0", motor.C0)
	motor:SetAttribute("GripPos", gripPos)
	motor:SetAttribute("SwingAnimSpeed", cfg.SwingAnimSpeed or 1.0)
	motor.Parent = hand
	-- v35: the pickaxe is only visible inside the mine zone
	EquipmentManager.SetPickaxeVisible(character, character:GetAttribute("InMineZone") == true)
end

-- v35: show / hide the pickaxe in hand (hidden on the surface, shown in the mine)
function EquipmentManager.SetPickaxeVisible(character: Model?, visible: boolean)
	if not character then return end
	if character:GetAttribute("PickaxeHidden") ~= (not visible) then
		character:SetAttribute("PickaxeHidden", not visible)
	end
	local model = character:FindFirstChild("VisualPickaxe")
	if not model then return end
	if model:GetAttribute("Shown") == visible then return end
	model:SetAttribute("Shown", visible)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local base = d:GetAttribute("BaseTransparency")
			if type(base) ~= "number" then
				base = d.Transparency
				d:SetAttribute("BaseTransparency", base)
			end
			d.Transparency = visible and (base :: number) or 1
		elseif d:IsA("Decal") or d:IsA("Texture") then
			local base = d:GetAttribute("BaseTransparency")
			if type(base) ~= "number" then
				base = d.Transparency
				d:SetAttribute("BaseTransparency", base)
			end
			d.Transparency = visible and (base :: number) or 1
		elseif d:IsA("Light") or d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Highlight") then
			local base = d:GetAttribute("BaseEnabled")
			if type(base) ~= "boolean" then
				base = (d :: any).Enabled
				d:SetAttribute("BaseEnabled", base)
			end
			(d :: any).Enabled = visible and (base :: boolean) or false
		end
	end
end

function EquipmentManager.SetFxRemote(remote: RemoteEvent)
	FxRemote = remote
end

function EquipmentManager.BroadcastSwing(player: Player, isCrit: boolean)
	local remote = FxRemote
	local char = player.Character
	if not remote or not char then return end
	pcall(function()
		remote:FireAllClients("Swing", char, isCrit == true, player.UserId)
	end)
end

function EquipmentManager.PlaySwingAnimation(character: Model?)
	if not character then return end
	local plr = Players:GetPlayerFromCharacter(character)
	if plr then
		EquipmentManager.BroadcastSwing(plr, false)
	end
end

